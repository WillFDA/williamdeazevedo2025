---
import CalInline from "@/components/CalInline.astro";
import FadeReveal from "@/components/animations/FadeReveal.astro";
import Layout from "@/layout/Layout.astro";

export const prerender = true;

const usefulIf = [
    "vous envisagez un nouveau site vitrine",
    "votre site actuel paraît lent, flou, daté ou peu crédible",
    "vous avez une maquette ou une interface à intégrer",
    "vous hésitez entre création, refonte ou amélioration ciblée",
    "vous cherchez un interlocuteur capable de relier design et développement",
];

const prepare = [
    "lien de votre site actuel si vous en avez un",
    "objectif principal du projet",
    "pages ou contenus déjà imaginés",
    "exemples de sites que vous aimez ou n'aimez pas",
    "budget ou ordre de grandeur si vous en avez un",
    "date idéale de lancement",
];
---

<Layout
    title="Contact freelance web - William De Azevedo"
    description="Réservez un appel découverte de 15 minutes pour clarifier votre besoin en création de site vitrine, refonte ou développement front-end."
>
    <div class="mx-auto flex w-full max-w-5xl flex-col gap-12 px-4 py-12 md:gap-16 md:py-16">
        <FadeReveal delay={0.1}>
            <section class="mx-auto flex max-w-4xl flex-col items-center gap-5 text-center">
                <h1 class="page-heading">
                    Parlons de ce qui bloque votre site
                </h1>
                <p class="page-subheading max-w-sm sm:max-w-lg">
                    Le premier échange dure 15 minutes. L'objectif est simple :
                    comprendre votre situation, repérer ce qui peut faire hésiter
                    vos visiteurs et définir la prochaine étape pertinente.
                </p>
                <div class="flex flex-col items-center gap-3 sm:flex-row">
                    <a
                        class="flex min-h-14 items-center justify-center rounded-xl bg-coffee-300 px-8 py-3 text-base font-normal text-snow-50 transition-transform hover:scale-[0.98] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-blue-500"
                        href="#cal-booking"
                    >
                        Choisir un créneau
                    </a>
                    <a
                        class="flex min-h-14 items-center justify-center rounded-xl px-8 py-3 text-base font-normal text-gray-900 ring-1 ring-gray-200 transition-colors hover:text-blue-500 focus-visible:text-blue-500 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-blue-500"
                        href="mailto:william.deazevedopro@gmail.com"
                    >
                        Écrire par e-mail
                    </a>
                </div>
            </section>
        </FadeReveal>

        <CalInline />

        <section class="grid gap-4 md:grid-cols-2">
            <article class="rounded-xl bg-snow-50 p-6 ring-1 ring-snow-600">
                <h2 class="mb-4 text-2xl font-normal leading-tight text-gray-900">
                    Ce rendez-vous est utile si...
                </h2>
                <ul class="flex flex-col gap-3">
                    {
                        usefulIf.map((item) => (
                            <li class="text-base font-normal leading-relaxed text-gray-600">
                                {item}
                            </li>
                        ))
                    }
                </ul>
            </article>
            <article class="rounded-xl bg-snow-50 p-6 ring-1 ring-snow-600">
                <h2 class="mb-4 text-2xl font-normal leading-tight text-gray-900">
                    Ce que vous pouvez préparer
                </h2>
                <ul class="flex flex-col gap-3">
                    {
                        prepare.map((item) => (
                            <li class="text-base font-normal leading-relaxed text-gray-600">
                                {item}
                            </li>
                        ))
                    }
                </ul>
            </article>
        </section>

        <section class="grid gap-6 md:grid-cols-[0.9fr_1.1fr] md:items-start md:gap-12">
            <div class="flex flex-col gap-4">
                <h2 class="text-2xl font-normal leading-tight text-gray-900">
                    Pendant les 15 minutes
                </h2>
                <p class="text-base font-normal leading-relaxed text-gray-600">
                    On parle de votre activité, de la situation actuelle, de ce que
                    le site doit rendre plus clair et des contraintes principales :
                    contenu, délai, budget, outils et décision.
                </p>
            </div>
            <div class="rounded-xl bg-gray-100 p-6 ring-1 ring-gray-200">
                <h2 class="mb-3 text-lg font-normal leading-tight text-gray-900">
                    Après le rendez-vous
                </h2>
                <p class="text-base font-normal leading-relaxed text-gray-600">
                    Si le besoin correspond à mon accompagnement, je vous demande les
                    informations nécessaires pour estimer proprement le périmètre. Si
                    ce n'est pas le bon format, je vous le dis clairement.
                </p>
            </div>
        </section>

        <section class="rounded-xl bg-snow-50 p-6 text-center ring-1 ring-snow-600 sm:p-8">
            <div class="mx-auto flex max-w-2xl flex-col items-center gap-4">
                <h2 class="text-2xl font-normal leading-tight text-gray-900">
                    Vous préférez écrire d'abord ?
                </h2>
                <p class="text-base font-normal leading-relaxed text-gray-600">
                    Le calendrier reste disponible plus haut, mais vous pouvez aussi
                    poser le contexte à l'écrit si le projet demande quelques détails.
                </p>
                <a
                    class="flex min-h-14 items-center justify-center rounded-xl bg-coffee-300 px-8 py-3 text-base font-normal text-snow-50 transition-transform hover:scale-[0.98] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-blue-500"
                    href="mailto:william.deazevedopro@gmail.com"
                >
                    Écrire par e-mail
                </a>
            </div>
        </section>
    </div>
</Layout>
