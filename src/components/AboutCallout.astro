---
import { Image } from "astro:assets";
import Msgs from "./icons/nucleo/msgs-fill.svg";
import UserHeart from "./icons/nucleo/user-heart-fill.svg";
import WindowLayout from "./icons/nucleo/window-layout-fill.svg";
import williamPortrait from "../assets/williamdeazevedo.webp";

interface Props {
    title: string;
}

const { title } = Astro.props;
const titleWords = title.replace("design !", "design\u00A0!").split(" ");
const aboutPoints = [
    {
        description:
            "Design graphique, 3D, motion design puis développement web : un parcours complet au service d'interfaces claires.",
        icon: "window-layout",
        title: "+10 ans d'expérience",
    },
    {
        description:
            "Des collaborations cadrées, avec des décisions lisibles et des livraisons fiables.",
        icon: "users",
        title: "+10 clients satisfaits",
    },
    {
        description:
            "Une approche B2B et produit qui relie clarté, usage et contraintes techniques.",
        icon: "product",
        title: "Culture produit SaaS",
    },
];
---

<section class="relative left-1/2 isolate w-[calc(100dvw-1rem)] -translate-x-1/2 overflow-hidden rounded-3xl bg-coffee-300 py-14 sm:w-[calc(100dvw-2rem)] sm:py-24 md:rounded-4xl md:py-28">
    <div class="relative z-10 mx-auto flex max-w-5xl flex-col gap-8 px-4 sm:gap-10 sm:px-8 md:gap-12">
        <h2 class="mx-auto flex max-w-4xl flex-wrap justify-center gap-x-[0.18em] text-center text-3xl font-medium leading-tighter tracking-normal text-snow-50 sm:text-4xl md:text-6xl">
            {
                titleWords.map((word, index) => {
                    const cleanWord = word.replace("\u00A0", " ");
                    const normalizedWord = cleanWord
                        .replace(/[,.!]+$/, "")
                        .trim();
                    const isWilliam = cleanWord === "William,";
                    const isPill =
                        normalizedWord === "développeur" ||
                        normalizedWord === "design";

                    return (
                        <span
                            class:list={[
                                "about-callout-title-word",
                                isPill && "about-callout-title-word--pill",
                                isWilliam &&
                                    "about-callout-title-word--with-avatar",
                                "text-snow-50",
                            ]}
                            style={`--about-callout-word-index: ${index}`}
                        >
                            {isWilliam ? (
                                <>
                                    William
                                    <span
                                        class="about-callout-avatar"
                                        aria-hidden="true"
                                    >
                                        <Image
                                            class="about-callout-avatar__image"
                                            src={williamPortrait}
                                            alt=""
                                            width={72}
                                            height={72}
                                            loading="eager"
                                        />
                                    </span>
                                    ,
                                </>
                            ) : (
                                cleanWord
                            )}
                        </span>
                    );
                })
            }
        </h2>
        <ul class="mx-auto grid w-full max-w-5xl gap-4 sm:grid-cols-3">
            {
                aboutPoints.map((point) => (
                    <li class="about-callout-proof-card">
                        <div class="about-callout-proof-card__header">
                            <span class="about-callout-proof-card__icon">
                                {point.icon === "window-layout" && (
                                    <WindowLayout
                                        aria-hidden="true"
                                        class="size-5"
                                    />
                                )}
                                {point.icon === "users" && (
                                    <UserHeart
                                        aria-hidden="true"
                                        class="size-5"
                                    />
                                )}
                                {point.icon === "product" && (
                                    <svg
                                        aria-hidden="true"
                                        class="size-5"
                                        fill="none"
                                        viewBox="0 0 24 24"
                                        xmlns="http://www.w3.org/2000/svg"
                                    >
                                        <path
                                            d="M4 7.5 12 3l8 4.5-8 4.5-8-4.5Z"
                                            stroke="currentColor"
                                            stroke-linejoin="round"
                                            stroke-width="1.8"
                                        />
                                        <path
                                            d="M4 12.5 12 17l8-4.5"
                                            stroke="currentColor"
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            stroke-width="1.8"
                                        />
                                        <path
                                            d="M4 17.5 12 22l8-4.5"
                                            stroke="currentColor"
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            stroke-width="1.8"
                                        />
                                    </svg>
                                )}
                            </span>
                            <h3 class="about-callout-proof-card__title">
                                {point.title}
                            </h3>
                        </div>
                        <p class="about-callout-proof-card__description">
                            {point.description}
                        </p>
                    </li>
                ))
            }
        </ul>
        <button
            class="about-callout-cta mx-auto inline-flex min-h-[3.25rem] w-fit max-w-full items-center justify-center gap-3 rounded-[1rem] px-7 py-2.5 text-md font-regular focus-visible:outline-2 focus-visible:outline-offset-3 focus-visible:outline-blue-500"
            data-cal-location="about"
            data-cal-open
            type="button"
        >
            <Msgs
                aria-hidden="true"
                class="about-callout-cta__icon size-5"
            />
            <span>Me contacter</span>
        </button>
        <slot />
    </div>
</section>

<style>
    .about-callout-title-word {
        animation: about-callout-title-word 1100ms cubic-bezier(0.16, 1, 0.3, 1)
            backwards;
        animation-delay: calc(var(--about-callout-word-index, 0) * 65ms);
        display: inline-block;
    }

    .about-callout-title-word--with-avatar {
        align-items: center;
        display: inline-flex;
    }

    .about-callout-title-word--pill {
        background: var(--color-blue-500);
        border-radius: 999em;
        box-shadow: 0 0.18em 0.42em -0.24em rgba(62, 96, 212, 0.62);
        color: var(--color-snow-50);
        line-height: 1;
        margin-inline: 0.04em;
        padding: 0 0.28em 0.07em;
    }

    .about-callout-avatar {
        align-self: center;
        aspect-ratio: 1;
        background: var(--color-snow-600);
        border: 0.06em solid #fff;
        border-radius: 9999px;
        box-shadow:
            0 18px 38px -18px rgba(0, 0, 0, 0.72),
            0 4px 14px rgba(0, 0, 0, 0.24);
        display: inline-flex;
        height: 1.08em;
        margin-inline: 0.08em;
        overflow: hidden;
    }

    .about-callout-avatar__image {
        display: block;
        height: 100%;
        object-fit: contain;
        width: 100%;
    }

    .about-callout-proof-card {
        background: var(--color-gray-800);
        border-radius: 0.75rem;
        box-shadow: 0 18px 44px -30px rgba(14, 20, 32, 0.55);
        color: var(--color-snow-50);
        display: flex;
        flex-direction: column;
        gap: 0.95rem;
        min-height: 8.5rem;
        padding: 1.1rem;
    }

    .about-callout-proof-card__header {
        align-items: center;
        display: flex;
        gap: 0.75rem;
    }

    .about-callout-proof-card__icon {
        align-items: center;
        background: var(--color-blue-500);
        border-radius: 0.45rem;
        box-shadow:
            inset 0 1px 0 rgba(255, 255, 255, 0.22),
            inset 0 -1px 0 rgba(31, 54, 130, 0.14),
            0 12px 26px -20px rgba(141, 165, 247, 0.55),
            0 5px 12px -10px rgba(62, 96, 212, 0.58);
        color: var(--color-snow-50);
        display: inline-flex;
        flex: 0 0 auto;
        height: 2rem;
        justify-content: center;
        width: 2rem;
    }

    .about-callout-proof-card__title {
        color: var(--color-snow-50);
        font-size: 1rem;
        font-weight: 500;
        line-height: 1.2;
        margin: 0;
    }

    .about-callout-proof-card__description {
        color: var(--color-coffee-50);
        font-size: 0.875rem;
        font-weight: 300;
        line-height: 1.45;
        margin: 0;
    }

    .about-callout-cta {
        background: transparent;
        border: 0;
        box-shadow: none;
        color: var(--color-snow-50);
        isolation: isolate;
        overflow: hidden;
        position: relative;
        text-decoration: none;
        transition: box-shadow 280ms cubic-bezier(0.2, 0, 0, 1);
    }

    .about-callout-cta::before {
        background: var(--color-blue-500);
        border: 1px solid
            color-mix(in srgb, var(--color-blue-500) 70%, var(--color-blue-600));
        border-radius: inherit;
        box-shadow: inset 0 2px rgba(184, 200, 255, 0.18);
        content: "";
        inset: 0;
        position: absolute;
        transform: scale(1);
        transition: transform 520ms
            var(--wui-ease-standard, cubic-bezier(0.2, 0, 0, 1));
        z-index: -1;
    }

    .about-callout-cta:hover,
    .about-callout-cta:focus-visible {
        box-shadow: none;
    }

    .about-callout-cta:hover::before,
    .about-callout-cta:focus-visible::before {
        transform: scale(0.95);
    }

    .about-callout-cta:hover .about-callout-cta__icon,
    .about-callout-cta:focus-visible .about-callout-cta__icon {
        animation: phone-ring 620ms cubic-bezier(0.2, 0, 0, 1);
        transform-origin: 50% 80%;
    }

    @keyframes about-callout-title-word {
        from {
            filter: blur(10px);
            opacity: 0;
            transform: translateY(-0.65em);
        }

        to {
            filter: none;
            opacity: 1;
            transform: none;
        }
    }

    @keyframes phone-ring {
        0%,
        100% {
            transform: rotate(0deg);
        }

        15% {
            transform: rotate(-12deg);
        }

        30% {
            transform: rotate(10deg);
        }

        45% {
            transform: rotate(-7deg);
        }

        60% {
            transform: rotate(5deg);
        }

        75% {
            transform: rotate(-2deg);
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .about-callout-title-word,
        .about-callout-cta__icon {
            animation: none !important;
            filter: none;
            opacity: 1;
            transform: none;
        }

        .about-callout-cta,
        .about-callout-cta::before {
            transition: none;
        }
    }
</style>
