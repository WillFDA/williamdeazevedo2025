---
const calLink = String(
    import.meta.env.PUBLIC_CAL_LINK ?? "william-de-azevedo-rbyobm/15min",
)
    .replace(/^https?:\/\/(?:app\.)?cal\.com\//, "")
    .replace(/^\/+/, "")
    .replace(/\/+$/, "");
---

<dialog
    aria-label="Planifier un créneau"
    class="cal-drawer fixed overflow-hidden rounded-lg border-0 bg-coffee-700 p-0 text-snow-50"
    data-cal-drawer
    id="cal-drawer"
    transition:persist
>
    <div class="cal-drawer__header flex items-center justify-end p-4">
        <button
            aria-label="Fermer"
            class="cal-drawer__close inline-flex size-11 items-center justify-center rounded-lg border-0 bg-white/10 p-0 text-snow-50"
            data-cal-close
            type="button"
        >
            <svg
                aria-hidden="true"
                class="size-5"
                fill="none"
                viewBox="0 0 24 24"
                xmlns="http://www.w3.org/2000/svg"
            >
                <path
                    d="m6 6 12 12M18 6 6 18"
                    stroke="currentColor"
                    stroke-linecap="round"
                    stroke-width="1.8"
                />
            </svg>
        </button>
    </div>
    <div
        aria-label="Réserver un appel avec William De Azevedo"
        class="cal-drawer__embed mx-auto h-full min-h-0 w-full overflow-auto"
        data-cal-inline
        data-cal-link={calLink}
    ></div>
</dialog>

<script>
    const drawer = document.querySelector("[data-cal-drawer]");
    const inlineEmbed = document.querySelector("[data-cal-inline]");
    const root = document.documentElement;
    const closeAnimationMs = 320;
    let isCalEmbedded = false;
    let isCalConfigured = false;
    let closeTimer;

    function trackZaraz(eventName, eventProperties = {}) {
        if (typeof window.zaraz?.track !== "function") return;
        void window.zaraz.track(eventName, eventProperties);
    }

    function loadCalEmbed() {
        if ("Cal" in window) return;

        (function initCalEmbedSnippet(C, A, L) {
            const push = (api, args) => api.q.push(args);
            const documentRef = C.document;

            if (!C.Cal) {
                C.Cal = function Cal(...args) {
                    const cal = C.Cal;

                    if (!cal.loaded) {
                        cal.ns ||= {};
                        cal.q ||= [];

                        const script = documentRef.createElement("script");
                        script.src = A;
                        documentRef.head.append(script);
                        cal.loaded = true;
                    }

                    if (args[0] === L) {
                        const api = function api(...namespaceArgs) {
                            push(api, namespaceArgs);
                        };
                        const namespace = args[1];

                        api.q ||= [];
                        if (typeof namespace === "string") {
                            cal.ns[namespace] ||= api;
                            push(cal.ns[namespace], args);
                            push(cal, ["initNamespace", namespace]);
                        } else {
                            push(cal, args);
                        }
                        return;
                    }

                    push(cal, args);
                };
            }
        })(window, "https://app.cal.com/embed/embed.js", "init");
    }

    function getCalLink() {
        if (!(inlineEmbed instanceof HTMLElement)) return "";
        return inlineEmbed.dataset.calLink ?? "";
    }

    function configureCalEmbed(calLink) {
        if (isCalConfigured) return;

        loadCalEmbed();
        window.Cal("init", { origin: "https://cal.com" });
        window.Cal("ui", {
            cssVarsPerTheme: {
                dark: {
                    "cal-bg": "#151c27",
                    "cal-bg-muted": "#1b2230",
                    "cal-bg-subtle": "#222a37",
                    "cal-border": "#2f3642",
                    "cal-border-subtle": "#2f3642",
                },
            },
            styles: {
                body: { background: "#151c27" },
                eventTypeListItem: { background: "#222a37" },
            },
            theme: "dark",
        });
        window.Cal("on", {
            action: "bookingSuccessfulV2",
            callback: (event) => {
                const booking = event.detail?.data ?? {};

                trackZaraz("cal_booking_success", {
                    cal_link: calLink,
                    event_type_id: String(booking.eventTypeId ?? ""),
                    status: booking.status ?? "",
                    title: booking.title ?? "",
                });
            },
        });
        window.Cal("preload", { calLink });
        isCalConfigured = true;
    }

    function mountCalEmbed() {
        if (isCalEmbedded || !(inlineEmbed instanceof HTMLElement)) return;

        const calLink = getCalLink();
        if (!calLink) return;

        configureCalEmbed(calLink);
        window.Cal("inline", {
            calLink,
            config: { theme: "dark", "ui.color-scheme": "dark" },
            elementOrSelector: inlineEmbed,
        });
        isCalEmbedded = true;
    }

    function openCalDrawer() {
        if (!(drawer instanceof HTMLDialogElement)) return;
        mountCalEmbed();
        trackZaraz("cal_open", { cal_link: getCalLink() });
        window.clearTimeout(closeTimer);
        drawer.classList.remove("is-closing");
        if (!drawer.open) {
            drawer.showModal();
        }
        root.classList.add("cal-drawer-open");
    }

    function closeCalDrawer() {
        if (!(drawer instanceof HTMLDialogElement) || !drawer.open) return;

        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
            drawer.close();
            return;
        }

        drawer.classList.add("is-closing");
        window.clearTimeout(closeTimer);
        closeTimer = window.setTimeout(() => drawer.close(), closeAnimationMs);
    }

    drawer?.addEventListener("close", () => {
        window.clearTimeout(closeTimer);
        drawer.classList.remove("is-closing");
        root.classList.remove("cal-drawer-open");
    });

    drawer?.addEventListener("cancel", (event) => {
        event.preventDefault();
        closeCalDrawer();
    });

    document.addEventListener("click", (event) => {
        const target = event.target;
        if (!(target instanceof Element)) return;

        const calOpenButton = target.closest("[data-cal-open]");
        if (calOpenButton instanceof HTMLElement) {
            event.preventDefault();
            trackZaraz("cal_cta_click", {
                location: calOpenButton.dataset.calLocation ?? "unknown",
            });
            openCalDrawer();
            return;
        }

        if (
            (target.closest("[data-cal-close]") || target === drawer) &&
            drawer instanceof HTMLDialogElement
        ) {
            closeCalDrawer();
        }
    });

    // Mount the Cal embed lazily on the first sign of booking intent (hovering
    // or keyboard-focusing any CTA) so it's ready by the time the drawer opens,
    // WITHOUT pulling Cal's ~850 KiB of JS/CSS into every page load. Previously
    // this mounted eagerly on load, which tanked Performance (the embed renders
    // a full booking iframe in the hidden dialog for every visitor, even those
    // who never click). openCalDrawer() still mounts on a direct click (touch /
    // keyboard / programmatic) as the final fallback.
    function warmCalEmbed(event) {
        const target = event.target;
        if (!(target instanceof Element) || !target.closest("[data-cal-open]"))
            return;

        mountCalEmbed();
        document.removeEventListener("pointerover", warmCalEmbed);
        document.removeEventListener("focusin", warmCalEmbed);
        document.removeEventListener("touchstart", warmCalEmbed);
    }

    document.addEventListener("pointerover", warmCalEmbed);
    document.addEventListener("focusin", warmCalEmbed);
    document.addEventListener("touchstart", warmCalEmbed, { passive: true });
</script>

<style>
    :global(html.cal-drawer-open),
    :global(html.cal-drawer-open body) {
        overflow: hidden;
    }

    .cal-drawer {
        height: calc(100dvh - 2rem);
        inset: 1rem 1rem 1rem auto;
        margin: auto 0 auto auto;
        max-height: calc(100dvh - 2rem);
        max-width: min(720px, calc(100dvw - 2rem));
        width: min(720px, calc(100dvw - 2rem));
    }

    .cal-drawer::backdrop {
        backdrop-filter: blur(5px);
        background: rgb(211 214 218 / 0.48);
    }

    .cal-drawer[open] {
        animation: cal-drawer-in 440ms cubic-bezier(0.16, 1, 0.3, 1);
        display: grid;
        grid-template-rows: auto minmax(0, 1fr);
    }

    .cal-drawer[open]::backdrop {
        animation: cal-backdrop-in 440ms cubic-bezier(0.16, 1, 0.3, 1);
    }

    .cal-drawer[open].is-closing {
        animation: cal-drawer-out 320ms cubic-bezier(0.4, 0, 0.2, 1) forwards;
    }

    .cal-drawer[open].is-closing::backdrop {
        animation: cal-backdrop-out 320ms cubic-bezier(0.4, 0, 0.2, 1)
            forwards;
    }

    .cal-drawer__close:focus-visible {
        outline: 2px solid var(--color-blue-500);
        outline-offset: 3px;
    }

    .cal-drawer__embed {
        max-width: 640px;
        scrollbar-width: none;
    }

    .cal-drawer__embed::-webkit-scrollbar {
        display: none;
    }

    .cal-drawer__embed :global(iframe) {
        display: block;
        margin: 0 auto;
        max-width: 640px;
        width: 100%;
    }

    @media (max-width: 640px) {
        .cal-drawer {
            height: calc(100dvh - 1rem);
            inset: 0.5rem;
            margin: auto;
            max-height: calc(100dvh - 1rem);
            max-width: calc(100dvw - 1rem);
            width: calc(100dvw - 1rem);
        }

        .cal-drawer__embed {
            width: 100%;
        }
    }

    @keyframes cal-drawer-in {
        from {
            filter: blur(12px);
            opacity: 0;
            transform: translateY(1rem) scale(0.98);
        }
        to {
            filter: blur(0);
            opacity: 1;
            transform: none;
        }
    }

    @keyframes cal-drawer-out {
        from {
            filter: blur(0);
            opacity: 1;
            transform: none;
        }
        to {
            filter: blur(10px);
            opacity: 0;
            transform: translateY(0.75rem) scale(0.985);
        }
    }

    @keyframes cal-backdrop-in {
        from {
            backdrop-filter: blur(0);
            background: rgb(211 214 218 / 0);
        }
        to {
            backdrop-filter: blur(5px);
            background: rgb(211 214 218 / 0.48);
        }
    }

    @keyframes cal-backdrop-out {
        from {
            backdrop-filter: blur(5px);
            background: rgb(211 214 218 / 0.48);
        }
        to {
            backdrop-filter: blur(0);
            background: rgb(211 214 218 / 0);
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .cal-drawer[open],
        .cal-drawer[open]::backdrop,
        .cal-drawer[open].is-closing,
        .cal-drawer[open].is-closing::backdrop {
            animation: none;
        }
    }
</style>
