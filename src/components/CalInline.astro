---
const calLink = String(
    import.meta.env.PUBLIC_CAL_LINK ?? "william-de-azevedo-rbyobm/15min",
)
    .replace(/^https?:\/\/(?:app\.)?cal\.com\//, "")
    .replace(/^\/+/, "")
    .replace(/\/+$/, "");
---

<section
    aria-labelledby="cal-inline-title"
    class="contact-cal-section relative left-1/2 isolate w-[calc(100dvw-1rem)] -translate-x-1/2 overflow-hidden rounded-2xl bg-coffee-300 py-12 text-snow-50 sm:w-[calc(100dvw-2rem)] sm:py-16 md:rounded-3xl"
    id="cal-booking"
>
    <div class="relative z-10 mx-auto flex max-w-5xl flex-col gap-8 px-4 sm:px-8">
        <div class="mx-auto flex max-w-3xl flex-col items-center gap-3 text-center">
            <h2 id="cal-inline-title" class="section-heading section-heading--inverse">
                Choisir un créneau
            </h2>
            <p class="section-subheading section-subheading--inverse">
                Réservez directement l'appel découverte de 15 minutes dans le
                calendrier.
            </p>
        </div>
        <div class="cal-inline__frame overflow-hidden rounded-lg border border-snow-50/15 bg-coffee-700">
            <div
                aria-label="Réserver un appel avec William De Azevedo"
                class="cal-inline__embed w-full overflow-hidden bg-coffee-700"
                data-contact-cal-inline
                data-cal-link={calLink}
            ></div>
        </div>
    </div>
</section>

<script>
    const contactInlineEmbed = document.querySelector("[data-contact-cal-inline]");
    let isContactCalMounted = false;
    let isContactCalConfigured = false;

    function trackContactCal(eventName, eventProperties = {}) {
        if (typeof window.zaraz?.track !== "function") return;
        void window.zaraz.track(eventName, eventProperties);
    }

    function loadContactCalEmbed() {
        if ("Cal" in window) return;

        (function initCalEmbedSnippet(C, A, L) {
            const push = (api, args) => api.q.push(args);
            const documentRef = C.document;

            if (!C.Cal) {
                C.Cal = function Cal(...args) {
                    const cal = C.Cal;

                    if (!cal.loaded) {
                        cal.ns ||= {};
                        cal.q ||= [];

                        const script = documentRef.createElement("script");
                        script.src = A;
                        documentRef.head.append(script);
                        cal.loaded = true;
                    }

                    if (args[0] === L) {
                        const api = function api(...namespaceArgs) {
                            push(api, namespaceArgs);
                        };
                        const namespace = args[1];

                        api.q ||= [];
                        if (typeof namespace === "string") {
                            cal.ns[namespace] ||= api;
                            push(cal.ns[namespace], args);
                            push(cal, ["initNamespace", namespace]);
                        } else {
                            push(cal, args);
                        }
                        return;
                    }

                    push(cal, args);
                };
            }
        })(window, "https://app.cal.com/embed/embed.js", "init");
    }

    function getContactCalLink() {
        if (!(contactInlineEmbed instanceof HTMLElement)) return "";
        return contactInlineEmbed.dataset.calLink ?? "";
    }

    function configureContactCalEmbed(calLink) {
        if (isContactCalConfigured) return;

        loadContactCalEmbed();
        window.Cal("init", { origin: "https://cal.com" });
        window.Cal("ui", {
            cssVarsPerTheme: {
                dark: {
                    "cal-bg": "#151c27",
                    "cal-bg-muted": "#1b2230",
                    "cal-bg-subtle": "#222a37",
                    "cal-border": "#2f3642",
                    "cal-border-subtle": "#2f3642",
                },
            },
            styles: {
                body: { background: "#151c27" },
                eventTypeListItem: { background: "#222a37" },
            },
            theme: "dark",
        });
        window.Cal("on", {
            action: "bookingSuccessfulV2",
            callback: (event) => {
                const booking = event.detail?.data ?? {};

                trackContactCal("cal_booking_success", {
                    cal_link: calLink,
                    event_type_id: String(booking.eventTypeId ?? ""),
                    location: "contact-inline",
                    status: booking.status ?? "",
                    title: booking.title ?? "",
                });
            },
        });
        window.Cal("preload", { calLink });
        isContactCalConfigured = true;
    }

    function mountContactCalEmbed() {
        if (
            isContactCalMounted ||
            !(contactInlineEmbed instanceof HTMLElement)
        )
            return;

        const calLink = getContactCalLink();
        if (!calLink) return;

        configureContactCalEmbed(calLink);
        window.Cal("inline", {
            calLink,
            config: { theme: "dark", "ui.color-scheme": "dark" },
            elementOrSelector: contactInlineEmbed,
        });
        trackContactCal("cal_open", {
            cal_link: calLink,
            location: "contact-inline",
        });
        isContactCalMounted = true;
    }

    mountContactCalEmbed();
    document.addEventListener("astro:page-load", mountContactCalEmbed);
</script>

<style>
    .cal-inline__frame {
        box-shadow:
            inset 0 1px 0 rgba(255, 255, 255, 0.04),
            0 24px 60px -36px rgba(0, 0, 0, 0.9);
    }

    .cal-inline__embed {
        height: min(760px, calc(100dvh - 7rem));
        min-height: 620px;
    }

    .cal-inline__embed :global(cal-inline),
    .cal-inline__embed :global(iframe.cal-embed) {
        height: 100% !important;
        min-height: 100% !important;
        width: 100% !important;
    }

    @media (max-width: 640px) {
        .cal-inline__embed {
            height: 820px;
            min-height: 820px;
        }
    }
</style>
