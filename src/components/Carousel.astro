---
import ChevronLeft from "./icons/nucleo/chevron-left-fill.svg";
import ChevronRight from "./icons/nucleo/chevron-right-fill.svg";
import MediaPause from "./icons/nucleo/media-pause-fill.svg";
import MediaPlay from "./icons/nucleo/media-play-fill.svg";

interface Props {
    autoplay?: boolean;
    autoplayDelay?: number;
    compactControls?: boolean;
    controlsPlacement?: "bottom" | "top";
}

const {
    autoplay = false,
    autoplayDelay = 4500,
    compactControls = false,
    controlsPlacement = "bottom",
} = Astro.props;
---

<div
    class:list={[
        "embla relative group",
        compactControls && "embla--compact-controls",
    ]}
    data-carousel
    data-carousel-autoplay={autoplay ? "true" : undefined}
    data-carousel-autoplay-delay={autoplay ? autoplayDelay : undefined}
    data-carousel-controls-placement={controlsPlacement}
>
    <div class="embla__viewport">
        <div class="embla__container">
            <slot />
        </div>
    </div>
    <div class="embla__controls">
        <button
            class="embla__control-button embla__prev"
            type="button"
            aria-label="Slide précédente"
        >
            <ChevronLeft aria-hidden="true" class="size-5" />
        </button>
        {
            autoplay && (
                <div class="embla__autoplay flex items-center justify-center gap-2">
                    <button
                        type="button"
                        class="embla__autoplay-toggle embla__control-button"
                        data-carousel-autoplay-toggle
                        aria-label="Mettre le carousel en pause"
                        aria-pressed="false"
                    >
                        <MediaPause
                            data-carousel-pause-icon
                            aria-hidden="true"
                            class="size-4"
                        />
                        <MediaPlay
                            data-carousel-play-icon
                            aria-hidden="true"
                            class="size-4"
                        />
                    </button>
                    <div class="embla__timeline" aria-hidden="true">
                        <span class="embla__progress-track">
                            <span class="embla__progress-fill" data-carousel-progress />
                        </span>
                    </div>
                </div>
            )
        }
        <button
            class="embla__control-button embla__next"
            type="button"
            aria-label="Slide suivante"
        >
            <ChevronRight aria-hidden="true" class="size-5" />
        </button>
    </div>
</div>

<script>
    type CarouselModule = typeof import("../scripts/carousel");
    type CarouselLoaderState = {
        observer?: IntersectionObserver;
        root: HTMLElement;
    };

    const windowWithCarouselLoader = window as Window & {
        __wuiCarouselLoaderLifecycleReady?: boolean;
        __wuiCarouselLoaderStates?: Set<CarouselLoaderState>;
        __wuiCarouselModulePromise?: Promise<CarouselModule>;
    };
    const activeCarouselLoaderStates =
        windowWithCarouselLoader.__wuiCarouselLoaderStates ??
        new Set<CarouselLoaderState>();
    windowWithCarouselLoader.__wuiCarouselLoaderStates =
        activeCarouselLoaderStates;

    const carouselLoaderStateByRoot = new WeakMap<
        HTMLElement,
        CarouselLoaderState
    >();

    const loadCarouselModule = () => {
        windowWithCarouselLoader.__wuiCarouselModulePromise ??= import(
            "../scripts/carousel"
        );

        return windowWithCarouselLoader.__wuiCarouselModulePromise;
    };

    const loadCarousel = (root: HTMLElement) => {
        void loadCarouselModule().then(({ initCarousel }) => initCarousel(root));
    };

    const destroyLoader = (state: CarouselLoaderState) => {
        state.observer?.disconnect();
        carouselLoaderStateByRoot.delete(state.root);
        activeCarouselLoaderStates.delete(state);
        delete state.root.dataset.carouselLoaderReady;
    };

    const resetCarouselLoaders = () => {
        Array.from(activeCarouselLoaderStates).forEach(destroyLoader);
        windowWithCarouselLoader.__wuiCarouselModulePromise?.then(
            ({ resetCarousels }) => resetCarousels(),
        );
    };

    const bindCarouselLoader = (root: HTMLElement) => {
        if (carouselLoaderStateByRoot.has(root)) return;
        if (root.dataset.carouselLoaderReady === "true") return;

        const state: CarouselLoaderState = { root };
        const load = () => {
            destroyLoader(state);
            loadCarousel(root);
        };

        root.dataset.carouselLoaderReady = "true";
        carouselLoaderStateByRoot.set(root, state);
        activeCarouselLoaderStates.add(state);

        if (!("IntersectionObserver" in window)) {
            load();
            return;
        }

        state.observer = new IntersectionObserver(
            (entries) => {
                if (!entries[0]?.isIntersecting) return;

                load();
            },
            { rootMargin: "128px 0px" },
        );
        state.observer.observe(root);
    };

    const initCarouselLoaders = () => {
        document
            .querySelectorAll<HTMLElement>("[data-carousel]")
            .forEach(bindCarouselLoader);
    };

    initCarouselLoaders();

    if (windowWithCarouselLoader.__wuiCarouselLoaderLifecycleReady !== true) {
        windowWithCarouselLoader.__wuiCarouselLoaderLifecycleReady = true;
        document.addEventListener("astro:before-swap", resetCarouselLoaders);
        document.addEventListener("astro:page-load", initCarouselLoaders);
    }
</script>

<style>
    .embla {
        --slide-spacing: 0.5rem;
        --slide-size: calc(100vw - 1rem);
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

    .embla__viewport {
        overflow: visible;
    }

    .embla__container {
        backface-visibility: hidden;
        display: flex;
        touch-action: pan-y;
        will-change: transform;
    }

    .embla :global(.embla__slide) {
        aspect-ratio: var(--aspect-video);
        flex: 0 0 calc(var(--slide-size) + var(--slide-spacing));
        min-width: 0;
        padding-left: var(--slide-spacing);
        transform: translateZ(0);
    }

    .embla :global(.embla__slide video) {
        transform: translateZ(0);
    }

    .embla__controls {
        align-items: center;
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        margin: 1.25rem auto 0;
        max-width: var(--slide-size, 64rem);
        padding-inline: 0.5rem;
        width: 100%;
    }

    .embla[data-carousel-controls-placement="top"] .embla__controls {
        margin: 0 auto 0.875rem;
        order: -1;
    }

    .embla--compact-controls .embla__controls {
        background: var(--color-gray-100);
        border-radius: 999px;
        box-shadow:
            0 18px 36px -30px rgba(31, 38, 52, 0.34),
            inset 0 1px 0 rgba(255, 255, 255, 0.62);
        display: flex;
        gap: 0.35rem;
        justify-content: flex-start;
        padding: 0.3rem;
        width: fit-content;
    }

    .embla__control-button {
        align-items: center;
        background: var(--color-gray-100);
        border-radius: 999px;
        color: var(--color-gray-900);
        display: inline-flex;
        height: 3rem;
        justify-content: center;
        transition: transform 180ms ease;
        width: 3rem;
    }

    .embla--compact-controls .embla__control-button {
        background: var(--color-snow-50);
        box-shadow:
            0 16px 34px -24px rgba(31, 38, 52, 0.46),
            0 4px 12px -8px rgba(31, 38, 52, 0.26);
        height: 2.35rem;
        width: 2.35rem;
    }

    .embla--compact-controls .embla__control-button svg {
        height: 1rem;
        width: 1rem;
    }

    .embla__control-button:active {
        transform: scale(0.95);
    }

    .embla__control-button:focus-visible {
        outline: 2px solid var(--color-blue-500);
        outline-offset: 3px;
    }

    .embla__prev {
        justify-self: start;
    }

    .embla__next {
        justify-self: end;
    }

    .embla__autoplay-toggle[aria-pressed="false"] [data-carousel-play-icon],
    .embla__autoplay-toggle[aria-pressed="true"] [data-carousel-pause-icon] {
        display: none;
    }

    .embla__timeline {
        align-items: center;
        background: var(--color-gray-100);
        border-radius: 999px;
        display: flex;
        height: 2.25rem;
        padding-inline: 0.75rem;
        width: 8rem;
    }

    .embla__progress-track {
        background: rgba(255, 255, 255, 0.72);
        border-radius: 999px;
        contain: paint;
        display: block;
        height: 0.375rem;
        position: relative;
        scrollbar-gutter: auto;
        width: 100%;
    }

    .embla__progress-fill {
        background: var(--color-gray-900);
        border-radius: inherit;
        display: block;
        height: 100%;
        transform: scaleX(0);
        transform-origin: left center;
        will-change: transform;
        width: 100%;
    }

    .embla__autoplay {
        filter: blur(4px);
        opacity: 0;
        transform: translateY(0.5rem);
        transition:
            opacity 520ms var(--wui-ease-standard, cubic-bezier(0.2, 0, 0, 1)),
            transform 520ms var(--wui-ease-standard, cubic-bezier(0.2, 0, 0, 1)),
            filter 520ms var(--wui-ease-standard, cubic-bezier(0.2, 0, 0, 1));
    }

    .embla[data-carousel-autoplay-visible="true"] .embla__autoplay {
        filter: none;
        opacity: 1;
        transform: none;
    }

    @media (min-width: 640px) {
        .embla {
            --slide-spacing: 2rem;
            --slide-size: min(64rem, calc(100vw - 2rem));
        }

        .embla__controls {
            padding-inline: 1rem;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .embla__autoplay {
            display: none;
        }
    }
</style>
