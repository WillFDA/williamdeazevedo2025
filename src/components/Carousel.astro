---
interface Props {
    autoplay?: boolean;
    autoplayDelay?: number;
}

const { autoplay = false, autoplayDelay = 4500 } = Astro.props;
---

<div
    class="embla relative group"
    data-carousel
    data-carousel-autoplay={autoplay ? "true" : undefined}
    data-carousel-autoplay-delay={autoplay ? autoplayDelay : undefined}
>
    <div class="embla__viewport">
        <div class="embla__container">
            <slot />
        </div>
    </div>
    <div
        class="w-5xl flex gap-20 items-center justify-between pl-8 mx-auto p-4 absolute top-1/2 left-1/2 -translate-x-1/2 z-10"
    >
        <button
            class="embla__prev backdrop-blur-md p-2 rounded-full active:scale-95 shadow-2xl bg-white/30 group-hover:opacity-100 opacity-0 translate-x-10 group-hover:translate-x-0 duration-200 ease-in-out transition-all"
            ><svg
                xmlns="http://www.w3.org/2000/svg"
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="lucide lucide-chevron-left-icon lucide-chevron-left opacity-70"
                ><path d="m15 18-6-6 6-6"></path></svg
            ></button
        >
        <button
            class="embla__next backdrop-blur-md p-2 rounded-full active:scale-95 shadow-2xl bg-white/30 group-hover:opacity-100 opacity-0 -translate-x-10 group-hover:translate-x-0 duration-200 ease-in-out transition-all"
            ><svg
                xmlns="http://www.w3.org/2000/svg"
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="lucide lucide-chevron-right-icon lucide-chevron-right opacity-70"
                ><path d="m9 18 6-6-6-6"></path></svg
            ></button
        >
    </div>
</div>

<script>
    import EmblaCarousel from "embla-carousel";

    function initCarousel(wrapperNode: HTMLElement) {
        if (wrapperNode.dataset.initialized === "true") return;

        const viewportNode =
            wrapperNode.querySelector<HTMLElement>(".embla__viewport");
        const prevButtonNode = wrapperNode.querySelector(".embla__prev");
        const nextButtonNode = wrapperNode.querySelector(".embla__next");

        if (!viewportNode || !prevButtonNode || !nextButtonNode) return;

        const videos = wrapperNode.querySelectorAll<HTMLVideoElement>("video");

        wrapperNode.dataset.initialized = "true";

        const startCarousel = () => {
            const emblaApi = EmblaCarousel(viewportNode, {
                loop: true,
                align: "center",
            });
            let lastDispatchedIndex = emblaApi.selectedScrollSnap();

            function updateVideos(shouldDispatch = false) {
                const activeIndex = emblaApi.selectedScrollSnap();

                if (shouldDispatch && activeIndex !== lastDispatchedIndex) {
                    const previousIndex = emblaApi.previousScrollSnap();
                    const snapCount = emblaApi.scrollSnapList().length;
                    const delta =
                        (activeIndex - previousIndex + snapCount) % snapCount;
                    const direction = delta <= snapCount / 2 ? "next" : "prev";

                    lastDispatchedIndex = activeIndex;
                    wrapperNode.dispatchEvent(
                        new CustomEvent("carousel:select", {
                            bubbles: true,
                            detail: { direction, index: activeIndex },
                        }),
                    );
                }

                videos.forEach((video, i) => {
                    const isActive = i === activeIndex;
                    const nextPreload = isActive ? "metadata" : "none";

                    if (video.preload !== nextPreload) {
                        video.preload = nextPreload;
                        video.load();
                    }

                    if (isActive) {
                        void video.play().catch(() => {});
                        return;
                    }

                    video.pause();
                    video.currentTime = 0;
                });
            }

            emblaApi.on("select", () => updateVideos(true));
            emblaApi.on("settle", () => updateVideos());
            updateVideos();

            emblaApi.on("init", () => viewportNode.classList.add("is-ready"));

            prevButtonNode.addEventListener("click", () => emblaApi.scrollPrev());
            nextButtonNode.addEventListener("click", () => emblaApi.scrollNext());

            const shouldAutoplay =
                wrapperNode.dataset.carouselAutoplay === "true" &&
                !window.matchMedia("(prefers-reduced-motion: reduce)").matches;

            if (shouldAutoplay) {
                let isPaused = false;
                const delay =
                    Number(wrapperNode.dataset.carouselAutoplayDelay) || 4500;
                const setPaused = (nextPaused: boolean) => {
                    isPaused = nextPaused;
                };
                const timer = window.setInterval(() => {
                    if (!document.contains(wrapperNode)) {
                        window.clearInterval(timer);
                        return;
                    }

                    if (!isPaused) emblaApi.scrollNext();
                }, delay);

                wrapperNode.addEventListener("pointerenter", () => setPaused(true));
                wrapperNode.addEventListener("pointerleave", () => setPaused(false));
                wrapperNode.addEventListener("focusin", () => setPaused(true));
                wrapperNode.addEventListener("focusout", () => setPaused(false));
            }
        };

        const observer = new IntersectionObserver(
            (entries) => {
                if (!entries[0]?.isIntersecting) return;

                observer.disconnect();
                startCarousel();
            },
            { rootMargin: "200px 0px" },
        );

        observer.observe(wrapperNode);
    }

    function init() {
        document
            .querySelectorAll<HTMLElement>("[data-carousel]")
            .forEach(initCarousel);
    }

    init();
    document.addEventListener("astro:page-load", init);
</script>
