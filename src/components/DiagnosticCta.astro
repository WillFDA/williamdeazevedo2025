---
import Msgs from "@/components/icons/nucleo/msgs-fill.svg";
import TargetIcon from "@/components/icons/nucleo/target-fill.svg";
import ViewAllIcon from "@/components/icons/nucleo/view-all-fill.svg";
import WindowLayoutIcon from "@/components/icons/nucleo/window-layout-fill.svg";

type CardIcon = "layout" | "target" | "view-all";

type Card = {
    icon: CardIcon;
    text: string;
    title: string;
};

type TitlePart = {
    media?: boolean;
    pill?: boolean;
    text: string;
};

interface Props {
    buttonLabel: string;
    cards: readonly Card[];
    class?: string;
    copy: string;
    location: string;
    titleParts: readonly TitlePart[];
}

const { buttonLabel, cards, class: className, copy, location, titleParts } =
    Astro.props;

const cardIcons = {
    layout: WindowLayoutIcon,
    target: TargetIcon,
    "view-all": ViewAllIcon,
} as const;
---

<div
    class:list={[
        "w-full",
        className,
    ]}
>
    <section
        class="diagnostic-cta relative isolate flex items-center overflow-hidden rounded-3xl bg-coffee-300 py-14 text-snow-50 sm:py-24 md:rounded-4xl md:py-28"
        data-diagnostic-cta
    >
        <div class="relative z-10 mx-auto flex w-full max-w-7xl flex-col gap-8 px-4 sm:gap-10 sm:px-8 md:gap-12">
            <div class="mx-auto flex max-w-6xl flex-col items-center gap-6 text-center md:gap-7">
                <h2
                    class="diagnostic-cta__title section-heading section-heading--inverse flex flex-wrap justify-center gap-x-[0.18em]"
                >
                    {
                        titleParts.map((part, index) => (
                            <span
                                class:list={[
                                    part.pill && "title-pill",
                                    "inline-flex items-center text-snow-50",
                                ]}
                                style={`--diagnostic-word-index: ${index}`}
                                data-diagnostic-word
                            >
                                {part.media && (
                                    <span
                                        class="diagnostic-cta__inline-image"
                                        aria-hidden="true"
                                        data-diagnostic-media
                                    />
                                )}
                                {part.text}
                            </span>
                        ))
                    }
                </h2>

                <p
                    class="section-subheading section-subheading--inverse max-w-3xl"
                    data-diagnostic-copy
                >
                    {copy}
                </p>
            </div>

            <ul class="mx-auto grid w-full max-w-7xl gap-5 sm:grid-cols-3">
                {
                    cards.map((card) => {
                        const Icon = cardIcons[card.icon];

                        return (
                            <li class="diagnostic-cta__card" data-diagnostic-card>
                                <div class="flex items-center gap-3">
                                    <span class="diagnostic-cta__card-icon">
                                        <Icon aria-hidden="true" class="size-5" />
                                    </span>
                                    <h3>{card.title}</h3>
                                </div>
                                <p>{card.text}</p>
                            </li>
                        );
                    })
                }
            </ul>

            <button
                class="diagnostic-cta__button mx-auto inline-flex min-h-16 w-full max-w-[23rem] items-center justify-center gap-5 rounded-2xl px-10 py-4 text-lg font-normal focus-visible:outline-2 focus-visible:outline-offset-3 focus-visible:outline-blue-500"
                data-cal-location={location}
                data-cal-open
                type="button"
            >
                <Msgs aria-hidden="true" class="size-5" />
                <span>{buttonLabel}</span>
            </button>
        </div>
    </section>
</div>

<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    const activeDiagnosticControllers = new WeakMap<HTMLElement, () => void>();

    const cleanupDiagnosticCtas = () => {
        document.querySelectorAll<HTMLElement>("[data-diagnostic-cta]").forEach((cta) => {
            activeDiagnosticControllers.get(cta)?.();
            activeDiagnosticControllers.delete(cta);
            delete cta.dataset.diagnosticReady;
        });
    };

    const initDiagnosticCtas = () => {
        document.querySelectorAll<HTMLElement>("[data-diagnostic-cta]").forEach((cta) => {
            if (cta.dataset.diagnosticReady === "true") return;
            cta.dataset.diagnosticReady = "true";

            if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
                return;
            }

            const context = gsap.context(() => {
                const words = gsap.utils.toArray<HTMLElement>(
                    "[data-diagnostic-word]",
                    cta,
                );
                const cards = gsap.utils.toArray<HTMLElement>(
                    "[data-diagnostic-card]",
                    cta,
                );
                const media = cta.querySelector<HTMLElement>(
                    "[data-diagnostic-media]",
                );
                const copy = cta.querySelector<HTMLElement>("[data-diagnostic-copy]");

                const timeline = gsap.timeline({
                    scrollTrigger: {
                        trigger: cta,
                        start: "top 82%",
                        end: "bottom 48%",
                        scrub: 0.8,
                    },
                });

                timeline.fromTo(
                    words,
                    { autoAlpha: 0.9, y: 8 },
                    {
                        autoAlpha: 1,
                        y: 0,
                        duration: 0.62,
                        ease: "none",
                        stagger: 0.025,
                    },
                    0,
                );

                if (media) {
                    timeline.fromTo(
                        media,
                        { autoAlpha: 0.9, rotation: -4, scale: 0.9 },
                        {
                            autoAlpha: 1,
                            rotation: 0,
                            scale: 1,
                            duration: 0.58,
                            ease: "none",
                        },
                        0.06,
                    );
                }

                if (copy) {
                    timeline.fromTo(
                        copy,
                        { autoAlpha: 0.92, y: 8 },
                        {
                            autoAlpha: 1,
                            y: 0,
                            duration: 0.48,
                            ease: "none",
                        },
                        0.18,
                    );
                }

                if (cards.length) {
                    timeline.fromTo(
                        cards,
                        {
                            autoAlpha: 0.88,
                            scale: 0.98,
                            y: 16,
                        },
                        {
                            autoAlpha: 1,
                            scale: 1,
                            y: 0,
                            duration: 0.72,
                            ease: "none",
                            stagger: 0.05,
                        },
                        0.16,
                    );
                }
            }, cta);

            activeDiagnosticControllers.set(cta, () => context.revert());
        });

        ScrollTrigger.refresh();
    };

    initDiagnosticCtas();

    document.addEventListener("astro:before-swap", cleanupDiagnosticCtas);
    document.addEventListener("astro:page-load", initDiagnosticCtas);
</script>

<style>
    .diagnostic-cta {
        min-height: min(66rem, calc(100dvh - 2rem));
    }

    .diagnostic-cta__title [data-diagnostic-word] {
        will-change: opacity, transform;
    }

    .diagnostic-cta__inline-image {
        align-self: center;
        aspect-ratio: 1;
        background-color: var(--color-snow-600);
        background-image: url("/pictures/william-low.png");
        background-position: center 34%;
        background-size: cover;
        border: 0.06em solid #fff;
        border-radius: 9999px;
        box-shadow:
            0 18px 38px -18px rgba(0, 0, 0, 0.72),
            0 4px 14px rgba(0, 0, 0, 0.24);
        display: inline-block;
        height: 1.08em;
        margin-right: 0.08em;
        overflow: hidden;
        transform-origin: center;
        width: 1.08em;
        will-change: opacity, transform;
    }

    .diagnostic-cta__card {
        background: var(--color-gray-800);
        border-radius: 0.75rem;
        box-shadow: 0 18px 44px -30px rgba(14, 20, 32, 0.55);
        color: var(--color-snow-50);
        display: flex;
        flex-direction: column;
        gap: 1rem;
        min-height: 10.75rem;
        padding: 1.25rem;
        will-change: opacity, transform;
    }

    .diagnostic-cta__card h3 {
        color: var(--color-snow-50);
        font-size: 1.125rem;
        font-weight: 500;
        line-height: 1.1;
        margin: 0;
    }

    .diagnostic-cta__card p {
        color: var(--color-coffee-50);
        font-size: 1rem;
        font-weight: 300;
        line-height: 1.7;
        margin: 0;
    }

    .diagnostic-cta__card-icon {
        align-items: center;
        background: var(--color-blue-500);
        border-radius: 0.5rem;
        box-shadow:
            inset 0 1px 0 rgba(255, 255, 255, 0.22),
            inset 0 -1px 0 rgba(31, 54, 130, 0.14),
            0 12px 26px -20px rgba(141, 165, 247, 0.55),
            0 5px 12px -10px rgba(62, 96, 212, 0.58);
        color: var(--color-snow-50);
        display: inline-flex;
        flex-shrink: 0;
        height: 2rem;
        justify-content: center;
        width: 2rem;
    }

    .diagnostic-cta__button {
        background: transparent;
        border: 0;
        color: var(--color-snow-50);
        isolation: isolate;
        overflow: hidden;
        position: relative;
        transition: box-shadow 280ms cubic-bezier(0.2, 0, 0, 1);
    }

    .diagnostic-cta__button::before {
        background: var(--color-blue-500);
        border: 1px solid
            color-mix(in srgb, var(--color-blue-500) 70%, var(--color-blue-600));
        border-radius: inherit;
        box-shadow: inset 0 2px rgba(184, 200, 255, 0.18);
        content: "";
        inset: 0;
        position: absolute;
        transform: scale(1);
        transition: transform 520ms
            var(--wui-ease-standard, cubic-bezier(0.2, 0, 0, 1));
        z-index: -1;
    }

    .diagnostic-cta__button:focus-visible::before {
        transform: scale(0.95);
    }

    @media (hover: hover) {
        .diagnostic-cta__button:hover::before {
            transform: scale(0.95);
        }
    }

    @media (max-width: 767px) {
        .diagnostic-cta {
            min-height: auto;
        }
    }

    @media (scripting: none), (prefers-reduced-motion: reduce) {
        .diagnostic-cta__title [data-diagnostic-word] {
            opacity: 1;
        }
    }
</style>
