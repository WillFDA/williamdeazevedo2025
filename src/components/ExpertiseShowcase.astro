---
import ChevronExpandX from "./icons/nucleo/chevron-expand-x-fill.svg";

export type ExpertiseShowcaseItem = {
  description: string[];
  icon: "site" | "refresh" | "code";
  id: string;
  label: string;
  pills: string[];
  title: string;
};

interface Props {
  description: string;
  items: readonly ExpertiseShowcaseItem[];
  title: string;
}

const { description, items, title } = Astro.props;
const firstId = items[0]?.id ?? "";
---

<section class="expertise-showcase" data-expertise-showcase>
  <div class="expertise-showcase__intro">
    <h2>{title}</h2>
    <p>{description}</p>
  </div>
  <div class="expertise-showcase__body">
    <div
      aria-label="Expertises"
      class="expertise-showcase__tabs"
      role="tablist"
    >
      <span
        aria-hidden="true"
        class="expertise-showcase__tab-indicator"
        data-expertise-indicator
      ></span>
      {
        items.map((item) => (
          <button
            aria-controls={`expertise-panel-${item.id}`}
            aria-selected={item.id === firstId ? "true" : "false"}
            class:list={[
              "expertise-showcase__tab",
              item.id === firstId && "is-active",
            ]}
            data-expertise-tab={item.id}
            id={`expertise-tab-${item.id}`}
            role="tab"
            tabindex={item.id === firstId ? undefined : -1}
            type="button"
          >
            <span class="expertise-showcase__tab-icon" aria-hidden="true">
              {item.icon === "site" && (
                <svg fill="none" viewBox="0 0 24 24">
                  <path
                    d="M4.5 7.5h15M8 15h8M7 4.5h10a2.5 2.5 0 0 1 2.5 2.5v10A2.5 2.5 0 0 1 17 19.5H7A2.5 2.5 0 0 1 4.5 17V7A2.5 2.5 0 0 1 7 4.5Z"
                    stroke="currentColor"
                    stroke-linecap="round"
                    stroke-width="1.7"
                  />
                </svg>
              )}
              {item.icon === "refresh" && (
                <svg fill="none" viewBox="0 0 24 24">
                  <path
                    d="M6.5 9.5A6 6 0 0 1 17 7l1.5 1.5M17.5 14.5A6 6 0 0 1 7 17l-1.5-1.5"
                    stroke="currentColor"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="1.7"
                  />
                  <path
                    d="M18.5 5.5v3h-3M5.5 18.5v-3h3"
                    stroke="currentColor"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="1.7"
                  />
                </svg>
              )}
              {item.icon === "code" && (
                <ChevronExpandX class="size-5" />
              )}
            </span>
            <span>{item.label}</span>
          </button>
        ))
      }
    </div>
    <div class="expertise-showcase__panels">
      {
        items.map((item) => (
          <article
            aria-labelledby={`expertise-tab-${item.id}`}
            class:list={[
              "expertise-showcase__panel",
              item.id === firstId && "is-active",
            ]}
            data-expertise-panel={item.id}
            hidden={item.id === firstId ? undefined : true}
            id={`expertise-panel-${item.id}`}
            role="tabpanel"
          >
            <div class="expertise-showcase__visual" aria-hidden="true">
              <div class="expertise-showcase__browser">
                <div class="expertise-showcase__browser-dots">
                  <span />
                  <span />
                  <span />
                </div>
                <div class="expertise-showcase__visual-list">
                  {item.pills.map((pill, pillIndex) => (
                    <div
                      class:list={[
                        "expertise-showcase__visual-item",
                        pillIndex > 2 && "is-muted",
                      ]}
                    >
                      <span class="expertise-showcase__visual-icon">
                        {item.icon === "site" && (
                          <svg fill="none" viewBox="0 0 24 24">
                            <path
                              d="M5 7.5h14M8 15h8M7 4.5h10a2.5 2.5 0 0 1 2.5 2.5v10A2.5 2.5 0 0 1 17 19.5H7A2.5 2.5 0 0 1 4.5 17V7A2.5 2.5 0 0 1 7 4.5Z"
                              stroke="currentColor"
                              stroke-linecap="round"
                              stroke-width="1.8"
                            />
                          </svg>
                        )}
                        {item.icon === "refresh" && (
                          <svg fill="none" viewBox="0 0 24 24">
                            <path
                              d="M6.5 9.5A6 6 0 0 1 17 7l1.5 1.5M17.5 14.5A6 6 0 0 1 7 17l-1.5-1.5"
                              stroke="currentColor"
                              stroke-linecap="round"
                              stroke-linejoin="round"
                              stroke-width="1.8"
                            />
                            <path
                              d="M18.5 5.5v3h-3M5.5 18.5v-3h3"
                              stroke="currentColor"
                              stroke-linecap="round"
                              stroke-linejoin="round"
                              stroke-width="1.8"
                            />
                          </svg>
                        )}
                        {item.icon === "code" && (
                          <ChevronExpandX class="size-5" />
                        )}
                      </span>
                      <span>{pill}</span>
                      <span class="expertise-showcase__visual-dot" />
                    </div>
                  ))}
                </div>
              </div>
            </div>
            <div class="expertise-showcase__content">
              <h3>{item.title}</h3>
              <div class="expertise-showcase__copy">
                {item.description.map((paragraph) => <p>{paragraph}</p>)}
              </div>
              <div class="expertise-showcase__pills" aria-label="Points clés">
                {item.pills.map((pill) => <span>{pill}</span>)}
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<script>
  function initExpertiseShowcase(root) {
    if (!(root instanceof HTMLElement) || root.dataset.expertiseReady) return;

    const tabs = Array.from(
      root.querySelectorAll("[data-expertise-tab]"),
    ).filter((tab) => tab instanceof HTMLButtonElement);
    const panels = Array.from(root.querySelectorAll("[data-expertise-panel]"));
    const indicator = root.querySelector("[data-expertise-indicator]");

    const moveIndicator = (tab) => {
      if (!(indicator instanceof HTMLElement) || !(tab instanceof HTMLElement))
        return;

      indicator.style.setProperty("--indicator-y", `${tab.offsetTop}px`);
      indicator.style.setProperty("--indicator-h", `${tab.offsetHeight}px`);
    };

    const activate = (id) => {
      let activeTab;

      tabs.forEach((tab) => {
        const isActive = tab.dataset.expertiseTab === id;
        tab.classList.toggle("is-active", isActive);
        tab.setAttribute("aria-selected", String(isActive));
        tab.tabIndex = isActive ? 0 : -1;
        if (isActive) activeTab = tab;
      });

      panels.forEach((panel) => {
        if (!(panel instanceof HTMLElement)) return;
        const isActive = panel.dataset.expertisePanel === id;
        panel.hidden = !isActive;
        panel.classList.toggle("is-active", isActive);
      });

      moveIndicator(activeTab);
    };

    tabs.forEach((tab, index) => {
      tab.addEventListener("pointerenter", () => moveIndicator(tab));

      tab.addEventListener("click", () => {
        const id = tab.dataset.expertiseTab;
        if (id) activate(id);
      });

      tab.addEventListener("keydown", (event) => {
        if (event.key !== "ArrowDown" && event.key !== "ArrowUp") return;

        event.preventDefault();
        const nextIndex =
          event.key === "ArrowDown"
            ? (index + 1) % tabs.length
            : (index - 1 + tabs.length) % tabs.length;
        tabs[nextIndex]?.focus();
        const id = tabs[nextIndex]?.dataset.expertiseTab;
        if (id) activate(id);
      });
    });

    root
      .querySelector(".expertise-showcase__tabs")
      ?.addEventListener("pointerleave", () => {
        const activeTab = tabs.find((tab) => tab.classList.contains("is-active"));
        moveIndicator(activeTab);
      });
    moveIndicator(tabs.find((tab) => tab.classList.contains("is-active")));
    root.dataset.expertiseReady = "true";
  }

  function initExpertiseShowcases() {
    document
      .querySelectorAll("[data-expertise-showcase]")
      .forEach(initExpertiseShowcase);
  }

  initExpertiseShowcases();
  document.addEventListener("astro:page-load", initExpertiseShowcases);
</script>

<style>
  .expertise-showcase {
    display: flex;
    flex-direction: column;
    gap: 3.5rem;
    width: 100%;
  }

  .expertise-showcase__intro {
    align-items: center;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    margin-inline: auto;
    max-width: 50rem;
    text-align: center;
  }

  .expertise-showcase__intro h2 {
    color: var(--color-gray-900);
    font-size: clamp(2.35rem, 4.4vw, 4.6rem);
    font-weight: 500;
    line-height: 0.94;
    margin: 0;
  }

  .expertise-showcase__intro p {
    color: var(--color-coffee-300);
    font-size: 0.95rem;
    font-weight: 300;
    line-height: 1.55;
    margin: 0;
    max-width: 42rem;
  }

  .expertise-showcase__body {
    display: grid;
    gap: 2.5rem;
  }

  .expertise-showcase__tabs {
    background: color-mix(in srgb, var(--color-gray-100) 72%, white);
    border-radius: 2em;
    display: grid;
    gap: 0.85rem;
    padding: 1rem;
    position: relative;
  }

  .expertise-showcase__tab-indicator {
    background: var(--color-snow-50);
    border-radius: 1em;
    box-shadow: 0 18px 36px -30px rgba(34, 42, 55, 0.32);
    height: var(--indicator-h, 3rem);
    left: 1rem;
    opacity: 0;
    position: absolute;
    right: 1rem;
    top: 0;
    transform: translateY(var(--indicator-y, 1rem));
    transition:
      transform 420ms cubic-bezier(0.2, 0, 0, 1),
      height 420ms cubic-bezier(0.2, 0, 0, 1),
      opacity 180ms cubic-bezier(0.2, 0, 0, 1);
  }

  .expertise-showcase[data-expertise-ready] .expertise-showcase__tab-indicator {
    opacity: 1;
  }

  .expertise-showcase__tab {
    align-items: center;
    background: transparent;
    border: 0;
    border-radius: 1em;
    color: var(--color-gray-900);
    display: flex;
    font: inherit;
    font-size: 0.95rem;
    font-weight: 400;
    gap: 0.75em;
    min-height: 3rem;
    opacity: 0.5;
    padding: 0.5em 1.5em 0.5em 0.5em;
    position: relative;
    text-align: left;
    transition:
      color 220ms cubic-bezier(0.2, 0, 0, 1),
      opacity 220ms cubic-bezier(0.2, 0, 0, 1),
      transform 220ms cubic-bezier(0.2, 0, 0, 1);
    width: 100%;
    z-index: 1;
  }

  .expertise-showcase__tab:hover,
  .expertise-showcase__tab:focus-visible,
  .expertise-showcase__tab.is-active {
    color: var(--color-gray-900);
    opacity: 1;
  }

  .expertise-showcase:not([data-expertise-ready])
    .expertise-showcase__tab.is-active {
    background: var(--color-snow-50);
    box-shadow: 0 18px 36px -30px rgba(34, 42, 55, 0.32);
  }

  .expertise-showcase__tab:focus-visible {
    outline: 2px solid var(--color-blue-400);
    outline-offset: 3px;
  }

  .expertise-showcase__tab:active {
    transform: scale(0.98);
  }

  .expertise-showcase__tab-icon {
    align-items: center;
    background: var(--color-blue-500);
    border-radius: 0.875em;
    color: var(--color-snow-50);
    display: inline-flex;
    flex: 0 0 auto;
    height: 2rem;
    justify-content: center;
    width: 2rem;
  }

  .expertise-showcase__tab-icon svg {
    height: 1.05rem;
    width: 1.05rem;
  }

  .expertise-showcase__panels {
    min-width: 0;
  }

  .expertise-showcase__panel {
    display: grid;
    gap: 2.5rem;
  }

  .expertise-showcase__panel[hidden] {
    display: none;
  }

  .expertise-showcase__visual {
    align-items: center;
    background: color-mix(in srgb, var(--color-gray-100) 80%, white);
    border-radius: 2rem;
    display: flex;
    justify-content: center;
    min-height: 20rem;
    overflow: hidden;
    padding: 2rem;
  }

  .expertise-showcase__browser {
    align-items: center;
    border: 2px solid var(--color-snow-50);
    border-radius: 1.75rem;
    display: flex;
    flex-direction: column;
    min-height: 17rem;
    padding: 1.5rem 0;
    position: relative;
    width: min(21rem, 100%);
  }

  .expertise-showcase__browser-dots {
    display: flex;
    gap: 0.45rem;
    left: 2rem;
    position: absolute;
    top: 1.6rem;
  }

  .expertise-showcase__browser-dots span {
    background: var(--color-gray-200);
    border-radius: 9999px;
    height: 0.42rem;
    width: 0.42rem;
  }

  .expertise-showcase__visual-list {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    margin-top: 3.75rem;
    width: min(24rem, 112%);
  }

  .expertise-showcase__visual-item {
    align-items: center;
    background: rgba(255, 255, 255, 0.88);
    border: 1px solid var(--color-gray-200);
    border-radius: 0.875rem;
    box-shadow: 0 16px 34px -28px rgba(34, 42, 55, 0.32);
    color: var(--color-gray-800);
    display: flex;
    font-size: 0.86rem;
    font-weight: 500;
    gap: 0.65rem;
    min-height: 3rem;
    padding: 0.65rem 0.9rem;
  }

  .expertise-showcase__visual-item.is-muted {
    opacity: 0.42;
  }

  .expertise-showcase__visual-icon {
    color: var(--color-gray-400);
    display: inline-flex;
    height: 1rem;
    width: 1rem;
  }

  .expertise-showcase__visual-icon svg {
    height: 100%;
    width: 100%;
  }

  .expertise-showcase__visual-dot {
    background: var(--color-blue-500);
    border-radius: 9999px;
    height: 0.35rem;
    margin-left: auto;
    width: 0.35rem;
  }

  .expertise-showcase__content {
    align-self: center;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    min-width: 0;
  }

  .expertise-showcase__content h3 {
    color: var(--color-gray-900);
    font-size: clamp(1.9rem, 2.9vw, 3rem);
    font-weight: 500;
    line-height: 1.02;
    margin: 0;
    text-wrap: balance;
  }

  .expertise-showcase__copy {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .expertise-showcase__copy p {
    color: var(--color-coffee-300);
    font-size: 0.95rem;
    font-weight: 300;
    line-height: 1.55;
    margin: 0;
  }

  .expertise-showcase__pills {
    border-top: 1px solid var(--color-gray-200);
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    padding-top: 1.25rem;
  }

  .expertise-showcase__pills span {
    align-items: center;
    border: 1px solid color-mix(in srgb, currentColor 6%, transparent);
    border-radius: 9999px;
    color: var(--color-coffee-300);
    display: inline-flex;
    font-size: 0.8rem;
    font-weight: 400;
    line-height: 1.2;
    min-height: 2.25rem;
    padding: 0.45rem 0.85rem;
  }

  @media (min-width: 768px) {
    .expertise-showcase {
      gap: 4rem;
    }

    .expertise-showcase__body {
      grid-template-columns: minmax(14rem, 0.72fr) minmax(0, 2.35fr);
      align-items: stretch;
    }

    .expertise-showcase__panel {
      grid-template-columns: minmax(18rem, 1.08fr) minmax(19rem, 1fr);
      min-height: 24rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .expertise-showcase__tab,
    .expertise-showcase__tab-indicator {
      transition: none;
    }
  }
</style>
