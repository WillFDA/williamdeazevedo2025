---
export type ExpertiseShowcaseAction = {
  href: string;
  label: string;
};

export type ExpertiseShowcaseItem = {
  description: string[];
  href?: string;
  icon: "site" | "refresh" | "code";
  id: string;
  label: string;
  pills: string[];
  title: string;
  visualItems: string[];
};

interface Props {
  actions?: readonly ExpertiseShowcaseAction[];
  description: string;
  items: readonly ExpertiseShowcaseItem[];
  title: string;
}

const { actions = [], description, items, title } = Astro.props;
const firstId = items[0]?.id ?? "";
---

<section class="expertise-showcase" data-expertise-showcase>
  <div class="expertise-showcase__intro">
    <h2>{title}</h2>
    <p>{description}</p>
  </div>
  <div class="expertise-showcase__body">
    <div
      aria-label="Expertises"
      class="expertise-showcase__tabs"
      role="tablist"
    >
      {
        items.map((item) => (
          <button
            aria-controls={`expertise-panel-${item.id}`}
            aria-selected={item.id === firstId ? "true" : "false"}
            class:list={[
              "expertise-showcase__tab",
              item.id === firstId && "is-active",
            ]}
            data-expertise-tab={item.id}
            id={`expertise-tab-${item.id}`}
            role="tab"
            tabindex={item.id === firstId ? undefined : -1}
            type="button"
          >
            <span class="expertise-showcase__tab-icon" aria-hidden="true">
              {item.icon === "site" && (
                <svg fill="none" viewBox="0 0 24 24">
                  <path
                    d="M4.5 7.5h15M8 15h8M7 4.5h10a2.5 2.5 0 0 1 2.5 2.5v10A2.5 2.5 0 0 1 17 19.5H7A2.5 2.5 0 0 1 4.5 17V7A2.5 2.5 0 0 1 7 4.5Z"
                    stroke="currentColor"
                    stroke-linecap="round"
                    stroke-width="1.7"
                  />
                </svg>
              )}
              {item.icon === "refresh" && (
                <svg fill="none" viewBox="0 0 24 24">
                  <path
                    d="M6.5 9.5A6 6 0 0 1 17 7l1.5 1.5M17.5 14.5A6 6 0 0 1 7 17l-1.5-1.5"
                    stroke="currentColor"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="1.7"
                  />
                  <path
                    d="M18.5 5.5v3h-3M5.5 18.5v-3h3"
                    stroke="currentColor"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="1.7"
                  />
                </svg>
              )}
              {item.icon === "code" && (
                <svg fill="none" viewBox="0 0 24 24">
                  <path
                    d="m9 18-6-6 6-6M15 6l6 6-6 6"
                    stroke="currentColor"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="1.7"
                  />
                </svg>
              )}
            </span>
            <span>{item.label}</span>
          </button>
        ))
      }
    </div>
    <div class="expertise-showcase__panels">
      {
        items.map((item) => (
          <article
            aria-labelledby={`expertise-tab-${item.id}`}
            class:list={[
              "expertise-showcase__panel",
              item.id === firstId && "is-active",
            ]}
            data-expertise-panel={item.id}
            hidden={item.id === firstId ? undefined : true}
            id={`expertise-panel-${item.id}`}
            role="tabpanel"
          >
            <div class="expertise-showcase__visual" aria-hidden="true">
              <div class="expertise-showcase__device">
                <div class="expertise-showcase__dots">
                  <span />
                  <span />
                  <span />
                </div>
                <div class="expertise-showcase__visual-list">
                  {item.visualItems.map((visualItem, index) => (
                    <span
                      class:list={[
                        "expertise-showcase__visual-item",
                        index > 2 && "is-muted",
                      ]}
                    >
                      {visualItem}
                    </span>
                  ))}
                </div>
              </div>
            </div>
            <div class="expertise-showcase__content">
              <h3>{item.title}</h3>
              <div class="expertise-showcase__copy">
                {item.description.map((paragraph) => <p>{paragraph}</p>)}
              </div>
              <div class="expertise-showcase__pills" aria-label="Points clés">
                {item.pills.map((pill) => <span>{pill}</span>)}
              </div>
              {item.href && (
                <a class="expertise-showcase__link" href={item.href}>
                  Voir le détail
                </a>
              )}
            </div>
          </article>
        ))
      }
    </div>
  </div>
  {
    actions.length > 0 && (
      <div class="expertise-showcase__actions">
        {actions.map((action) => (
          <a href={action.href}>{action.label}</a>
        ))}
      </div>
    )
  }
</section>

<script>
  function initExpertiseShowcase(root) {
    if (!(root instanceof HTMLElement) || root.dataset.expertiseReady) return;

    const tabs = Array.from(
      root.querySelectorAll("[data-expertise-tab]"),
    ).filter((tab) => tab instanceof HTMLButtonElement);
    const panels = Array.from(root.querySelectorAll("[data-expertise-panel]"));

    const activate = (id) => {
      tabs.forEach((tab) => {
        const isActive = tab.dataset.expertiseTab === id;
        tab.classList.toggle("is-active", isActive);
        tab.setAttribute("aria-selected", String(isActive));
        tab.tabIndex = isActive ? 0 : -1;
      });

      panels.forEach((panel) => {
        if (!(panel instanceof HTMLElement)) return;
        const isActive = panel.dataset.expertisePanel === id;
        panel.hidden = !isActive;
        panel.classList.toggle("is-active", isActive);
      });
    };

    tabs.forEach((tab, index) => {
      tab.addEventListener("click", () => {
        const id = tab.dataset.expertiseTab;
        if (id) activate(id);
      });

      tab.addEventListener("keydown", (event) => {
        if (event.key !== "ArrowDown" && event.key !== "ArrowUp") return;

        event.preventDefault();
        const nextIndex =
          event.key === "ArrowDown"
            ? (index + 1) % tabs.length
            : (index - 1 + tabs.length) % tabs.length;
        tabs[nextIndex]?.focus();
        const id = tabs[nextIndex]?.dataset.expertiseTab;
        if (id) activate(id);
      });
    });

    root.dataset.expertiseReady = "true";
  }

  function initExpertiseShowcases() {
    document
      .querySelectorAll("[data-expertise-showcase]")
      .forEach(initExpertiseShowcase);
  }

  initExpertiseShowcases();
  document.addEventListener("astro:page-load", initExpertiseShowcases);
</script>

<style>
  .expertise-showcase {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    width: 100%;
  }

  .expertise-showcase__intro {
    align-items: center;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    margin-inline: auto;
    max-width: 42rem;
    text-align: center;
  }

  .expertise-showcase__intro h2 {
    color: var(--color-snow-50);
    font-size: clamp(1.75rem, 4vw, 3.5rem);
    font-weight: 500;
    line-height: 0.98;
    margin: 0;
  }

  .expertise-showcase__intro p {
    color: var(--color-snow-100);
    font-size: 0.95rem;
    font-weight: 300;
    line-height: 1.55;
    margin: 0;
    max-width: 34rem;
  }

  .expertise-showcase__body {
    display: grid;
    gap: 2rem;
  }

  .expertise-showcase__tabs {
    background: rgba(255, 255, 255, 0.04);
    border-radius: 1.75rem;
    display: grid;
    gap: 0.6rem;
    padding: 0.6rem;
  }

  .expertise-showcase__tab {
    align-items: center;
    background: transparent;
    border: 0;
    border-radius: 1rem;
    color: rgba(248, 250, 252, 0.58);
    display: flex;
    font: inherit;
    font-size: 0.92rem;
    font-weight: 400;
    gap: 0.75rem;
    min-height: 3.25rem;
    padding: 0.65rem 0.75rem;
    text-align: left;
    transition:
      background 220ms cubic-bezier(0.2, 0, 0, 1),
      color 220ms cubic-bezier(0.2, 0, 0, 1),
      transform 220ms cubic-bezier(0.2, 0, 0, 1);
    width: 100%;
  }

  .expertise-showcase__tab:hover,
  .expertise-showcase__tab:focus-visible,
  .expertise-showcase__tab.is-active {
    background: var(--color-snow-50);
    color: var(--color-coffee-300);
  }

  .expertise-showcase__tab:focus-visible {
    outline: 2px solid var(--color-blue-400);
    outline-offset: 3px;
  }

  .expertise-showcase__tab:active {
    transform: scale(0.98);
  }

  .expertise-showcase__tab-icon {
    align-items: center;
    background: var(--color-blue-500);
    border-radius: 0.8rem;
    color: var(--color-snow-50);
    display: inline-flex;
    flex: 0 0 auto;
    height: 2rem;
    justify-content: center;
    width: 2rem;
  }

  .expertise-showcase__tab-icon svg {
    height: 1.05rem;
    width: 1.05rem;
  }

  .expertise-showcase__panels {
    min-width: 0;
  }

  .expertise-showcase__panel {
    display: grid;
    gap: 2rem;
  }

  .expertise-showcase__panel[hidden] {
    display: none;
  }

  .expertise-showcase__visual {
    align-items: center;
    aspect-ratio: 1.06;
    background: rgba(255, 255, 255, 0.07);
    border-radius: 2rem;
    display: flex;
    justify-content: center;
    min-height: 18rem;
    overflow: hidden;
    padding: 2rem;
  }

  .expertise-showcase__device {
    align-items: center;
    border: 2px solid rgba(255, 255, 255, 0.42);
    border-radius: 1.8rem;
    display: flex;
    flex-direction: column;
    min-height: 14rem;
    padding: 1.2rem 1rem;
    position: relative;
    width: min(18rem, 100%);
  }

  .expertise-showcase__dots {
    display: flex;
    gap: 0.42rem;
    justify-content: center;
    margin-bottom: 1.25rem;
    width: 100%;
  }

  .expertise-showcase__dots span {
    background: rgba(255, 255, 255, 0.38);
    border-radius: 9999px;
    height: 0.45rem;
    width: 0.45rem;
  }

  .expertise-showcase__visual-list {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    width: min(20rem, 120%);
  }

  .expertise-showcase__visual-item {
    background: rgba(255, 255, 255, 0.94);
    border-radius: 0.9rem;
    box-shadow: 0 18px 32px -24px rgba(0, 0, 0, 0.55);
    color: var(--color-gray-900);
    display: block;
    font-size: 0.82rem;
    font-weight: 450;
    line-height: 1.2;
    padding: 0.8rem 1rem;
    text-align: left;
  }

  .expertise-showcase__visual-item.is-muted {
    opacity: 0.46;
  }

  .expertise-showcase__content {
    align-self: center;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    min-width: 0;
  }

  .expertise-showcase__content h3 {
    color: var(--color-snow-50);
    font-size: clamp(1.75rem, 3vw, 2.8rem);
    font-weight: 500;
    line-height: 1.02;
    margin: 0;
  }

  .expertise-showcase__copy {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .expertise-showcase__copy p {
    color: var(--color-snow-100);
    font-size: 0.95rem;
    font-weight: 300;
    line-height: 1.55;
    margin: 0;
  }

  .expertise-showcase__pills {
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    padding-top: 1.25rem;
  }

  .expertise-showcase__pills span {
    align-items: center;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 9999px;
    color: var(--color-snow-100);
    display: inline-flex;
    font-size: 0.8rem;
    font-weight: 400;
    line-height: 1.2;
    min-height: 2.25rem;
    padding: 0.45rem 0.85rem;
  }

  .expertise-showcase__link,
  .expertise-showcase__actions a {
    color: var(--color-snow-50);
    font-size: 0.9rem;
    font-weight: 400;
    text-decoration-color: rgba(255, 255, 255, 0.36);
    text-underline-offset: 0.35rem;
    transition: color 180ms cubic-bezier(0.2, 0, 0, 1);
  }

  .expertise-showcase__link:hover,
  .expertise-showcase__link:focus-visible,
  .expertise-showcase__actions a:hover,
  .expertise-showcase__actions a:focus-visible {
    color: var(--color-blue-400);
  }

  .expertise-showcase__link:focus-visible,
  .expertise-showcase__actions a:focus-visible {
    outline: 2px solid var(--color-blue-400);
    outline-offset: 4px;
  }

  .expertise-showcase__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: center;
  }

  @media (min-width: 768px) {
    .expertise-showcase {
      gap: 3.25rem;
    }

    .expertise-showcase__body {
      grid-template-columns: minmax(13rem, 0.78fr) minmax(0, 2fr);
      align-items: stretch;
    }

    .expertise-showcase__panel {
      grid-template-columns: minmax(18rem, 1fr) minmax(18rem, 0.95fr);
      min-height: 25rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .expertise-showcase__tab {
      transition: none;
    }
  }
</style>
