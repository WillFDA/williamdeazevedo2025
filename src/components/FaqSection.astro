---
import ArrowRight from "./icons/nucleo/arrow-right-fill.svg";
import ChevronUp from "./icons/nucleo/chevron-up-fill.svg";
import WaveIcon from "./ui/WaveIcon.astro";
import WaveText from "./ui/WaveText.astro";

const faqItems = [
    {
        question: "Est-ce qu'un site à 2 000 € suffit toujours ?",
        answer:
            "Non. C'est une base pour lancer ou moderniser une présence web claire. Le budget évolue selon le nombre de pages, le contenu à produire, les animations, le formulaire, le CMS ou les besoins SEO plus poussés.",
    },
    {
        question: "Je n'ai pas encore de site, par quoi on commence ?",
        answer:
            "On commence par votre offre, vos clients et l'action que le site doit provoquer. Ensuite seulement on structure les pages, les messages, les priorités visuelles et le parcours de contact.",
    },
    {
        question: "J'ai déjà un site, tu peux le reprendre ?",
        answer:
            "Oui. Je regarde ce qui fonctionne déjà, puis ce qui crée du doute : message flou, design daté, mobile inconfortable, lenteur, SEO technique ou parcours de contact fragile.",
    },
    {
        question: "Quelle différence avec un site généré par IA ?",
        answer:
            "L'IA peut produire vite quelque chose de présentable, mais souvent générique. Je l'utilise pour accélérer la recherche, les pistes et certains contrôles, puis je tranche côté stratégie, design, contenu et intégration.",
    },
    {
        question: "Est-ce que je pourrai modifier le contenu après ?",
        answer:
            "Oui, si c'est un besoin important, on peut prévoir un CMS ou des contenus modifiables. Sinon, on peut garder une base plus simple, rapide et maintenable pour éviter d'ajouter de la complexité inutile.",
    },
    {
        question: "Tu travailles aussi sur des SaaS ou interfaces produit ?",
        answer:
            "Oui. Pour une interface produit, je cadre d'abord les écrans, les rôles, les états, les données et les intégrations. Le devis dépend surtout de cette complexité, pas seulement du nombre de pages.",
    },
] as const;
---

<section
    id="faq"
    class="mx-auto w-full max-w-7xl px-4 py-12 sm:px-8 md:py-16"
    aria-labelledby="faq-title"
>
    <div class="mx-auto flex max-w-4xl flex-col items-center gap-4 text-center">
        <h2 id="faq-title" class="section-heading">
            Les questions qui reviennent avant de se lancer
        </h2>
        <p class="section-subheading">
            L'objectif est de savoir vite si on part sur une création, une
            refonte ou une interface produit, avec un périmètre réaliste.
        </p>
    </div>

    <div class="mx-auto mt-12 grid max-w-5xl gap-3 md:grid-cols-2">
        {
            faqItems.map((item) => (
                <details class="faq-item group rounded-xl bg-snow-50 shadow-[0_18px_44px_-34px_rgba(34,42,55,0.42)] ring-1 ring-snow-600">
                    <summary class="faq-summary grid cursor-pointer list-none grid-cols-[1fr_auto] items-center gap-4 rounded-xl px-5 py-4 text-left text-base font-normal leading-tight text-gray-900 outline-none focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-blue-500">
                        <span>{item.question}</span>
                        <span class="faq-icon inline-flex size-8 items-center justify-center rounded-lg bg-gray-100 text-gray-900">
                            <ChevronUp class="size-3" aria-hidden="true" />
                        </span>
                    </summary>
                    <div class="faq-answer px-5 pb-5 pr-14">
                        <p class="m-0 text-base font-light leading-normal text-gray-600">
                            {item.answer}
                        </p>
                    </div>
                </details>
            ))
        }
    </div>

    <div class="mt-10 flex justify-center">
        <button
            class="faq-cta inline-flex min-h-14 items-center justify-center gap-5 rounded-xl bg-coffee-300 px-8 py-3 text-base font-normal text-snow-50 shadow-[0_24px_52px_-34px_rgba(34,42,55,0.78)] transition-transform hover:scale-[0.98] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-blue-500"
            data-cal-location="faq"
            data-cal-open
            type="button"
        >
            <WaveText text="Parler de mon cas" trigger="parent" />
            <WaveIcon
                style="--wui-wave-icon-size: 1rem;"
                direction="right"
                trigger="parent"
            >
                <ArrowRight class="size-full" aria-hidden="true" />
            </WaveIcon>
        </button>
    </div>
</section>

<style>
    .faq-summary::-webkit-details-marker {
        display: none;
    }

    .faq-icon {
        box-shadow:
            inset 0 1px 0 rgba(255, 255, 255, 0.28),
            0 12px 24px -18px rgba(34, 42, 55, 0.34);
        transition:
            background-color 220ms ease,
            color 220ms ease,
            transform 260ms cubic-bezier(0.16, 1, 0.3, 1);
    }

    .faq-item[open] .faq-icon {
        background: var(--color-blue-500);
        color: var(--color-snow-50);
        transform: rotate(180deg);
    }

    .faq-answer {
        display: grid;
        grid-template-rows: 1fr;
    }

    @media (hover: hover) {
        .faq-item {
            transition:
                background-color 220ms ease,
                box-shadow 220ms ease,
                transform 220ms ease;
        }

        .faq-item:hover {
            box-shadow: 0 24px 54px -38px rgba(34, 42, 55, 0.5);
            transform: translateY(-1px);
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .faq-icon,
        .faq-item {
            transition: none;
        }

        .faq-item:hover {
            transform: none;
        }
    }
</style>
