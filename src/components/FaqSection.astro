---
import ArrowRight from "./icons/nucleo/arrow-right-fill.svg";
import Accordion from "./ui/Accordion.astro";
import WaveIcon from "./ui/WaveIcon.astro";
import WaveText from "./ui/WaveText.astro";
import { getProjectById } from "@/data/projects";

type FaqItem = {
    answer: string;
    link?: {
        href: string;
        label: string;
    };
    question: string;
};

interface Props {
    class?: string;
    ctaLabel?: string;
    ctaLocation?: string;
    description?: string;
    id?: string;
    items?: readonly FaqItem[];
    padded?: boolean;
    showCta?: boolean;
    title?: string;
}

const getDefaultFaqItems = () => {
    const persistanceProject = getProjectById("persistance");

    if (!persistanceProject) {
        throw new Error("Projet Persistance introuvable pour la FAQ.");
    }

    return [
        {
            question:
                "Quel budget prévoir pour créer ou refondre un site avec vous ?",
            answer:
                "Le budget démarre généralement à 2 000 € HT pour un site vitrine simple et bien cadré. Il évolue selon le nombre de pages, les contenus, l'identité visuelle et les fonctionnalités attendues. Un premier échange permet de définir le périmètre, puis vous recevez un devis détaillé avant le démarrage.",
            link: {
                href: "/tarifs/",
                label: "Comprendre les tarifs et le devis",
            },
        },
        {
            question:
                "Comment se déroule la création d'un site avec un freelance ?",
            answer:
                "Nous commençons par cadrer votre offre, vos clients et l'objectif du site. Je prépare ensuite la structure, les messages et la direction visuelle, puis je développe et teste le site avant sa mise en ligne. Vous validez les étapes importantes sans avoir à piloter toute la production.",
        },
        {
            question:
                "Combien de temps faut-il pour créer et mettre en ligne le site ?",
            answer:
                "Comptez généralement entre 10 jours et 5 semaines. Le délai dépend du périmètre, du nombre de pages, des contenus à préparer et du rythme des validations. Le calendrier est défini dès le cadrage pour que chacun sache quand intervenir.",
        },
        {
            question:
                "Pouvez-vous m'accompagner si je n'ai ni logo, ni charte, ni contenus finalisés ?",
            answer:
                "Oui. Je vous aide à clarifier les messages et à organiser les contenus utiles au site. Pour une identité visuelle complète, je peux intégrer Persistance, graphiste partenaire, au projet : logo, palette, typographies et direction artistique sont alors cadrés avant la conception du site.",
            link: {
                href: persistanceProject.href,
                label: `Voir le site de ${persistanceProject.title}`,
            },
        },
        {
            question:
                "Quelle différence entre un site sur mesure et un site généré avec l'IA ?",
            answer:
                "Un site sur mesure part de votre offre, de vos clients et de vos priorités pour construire une structure, des messages et une interface cohérents. J'utilise l'IA pour accélérer certaines recherches ou vérifications, mais les choix de stratégie, de design, de contenu et d'intégration restent guidés et validés humainement.",
        },
        {
            question:
                "Est-ce que je reste propriétaire de mon domaine, de mon hébergement et de mon site ?",
            answer:
                "Oui, vous gardez la maîtrise de votre domaine, de votre hébergement et des accès associés. Ils peuvent être ouverts directement à votre nom, puis tous les identifiants utiles vous sont remis. Les modalités de livraison et les droits liés au site sont précisés dans le devis.",
        },
    ] as const;
};

const {
    class: className,
    ctaLabel = "Parler de mon cas",
    ctaLocation = "faq",
    description,
    id = "faq",
    items,
    padded = true,
    showCta = true,
    title = "FAQ",
} = Astro.props;
const faqItems = Array.from(items ?? getDefaultFaqItems());

const accordionClasses = {
    content:
        "px-5 pb-5 pr-14 text-base font-light leading-normal text-gray-600 sm:px-6 sm:pr-16",
    icon: "text-gray-900",
    item: "bg-gray-100 shadow-sm ring-1 ring-gray-200",
    summary:
        "px-5 py-4 text-base font-normal leading-tight text-gray-900 sm:px-6",
};
---

<section
    id={id}
    class:list={[
        "mx-auto w-full max-w-7xl py-12 md:py-16",
        padded ? "px-4 sm:px-8" : "px-0",
        className,
    ]}
    aria-labelledby={`${id}-title`}
>
    <div class="mx-auto flex max-w-4xl flex-col items-center text-center">
        <h2 id={`${id}-title`} class="section-heading">{title}</h2>
        {
            description && (
                <p class="section-subheading mt-5 max-w-2xl">
                    {description}
                </p>
            )
        }
    </div>

    <Accordion
        class="mx-auto mt-12 max-w-4xl"
        items={faqItems}
        itemClass={accordionClasses.item}
        summaryClass={accordionClasses.summary}
        contentClass={accordionClasses.content}
        iconClass={accordionClasses.icon}
    />

    {
        showCta && (
            <div class="mt-10 flex justify-center">
                <button
                    aria-controls="cal-drawer"
                    aria-haspopup="dialog"
                    class="faq-cta inline-flex min-h-14 items-center justify-center gap-5 rounded-xl bg-coffee-300 px-8 py-3 text-base font-normal text-snow-50 shadow-lg transition-transform hover:scale-[0.98] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-blue-500"
                    data-cal-location={ctaLocation}
                    data-cal-open
                    type="button"
                >
                    <WaveText text={ctaLabel} trigger="parent" />
                    <WaveIcon
                        style="--wui-wave-icon-size: 1rem;"
                        direction="right"
                        trigger="parent"
                    >
                        <ArrowRight class="size-full" aria-hidden="true" />
                    </WaveIcon>
                </button>
            </div>
        )
    }
</section>
