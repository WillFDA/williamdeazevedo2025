---
const year = new Date().getFullYear();
const linkGroups = [
    {
        title: "Services",
        links: [
            { href: "/services/creation-site-vitrine", label: "Création site vitrine" },
            { href: "/services/refonte-site-internet", label: "Refonte site internet" },
            { href: "/services/developpeur-web-freelance", label: "Développeur freelance" },
        ],
    },
    {
        title: "Réalisations",
        links: [
            { href: "/realisations/le-fellic", label: "Le Fellic" },
            { href: "/realisations/persistance", label: "Persistance" },
            { href: "/realisations/motivai", label: "Motivai" },
        ],
    },
    {
        title: "Ressources",
        links: [
            { href: "/tarifs", label: "Tarifs" },
            { href: "/methode", label: "Méthode" },
            { href: "/articles", label: "Conseils" },
            { href: "/mentions-legales", label: "Mentions légales" },
        ],
    },
];
---

<footer
    class="relative left-1/2 mt-24 w-[calc(100dvw-1rem)] -translate-x-1/2 rounded-t-3xl bg-blue-500 px-4 py-14 text-sm text-snow-50 sm:w-[calc(100dvw-2rem)] sm:px-8 sm:py-16 md:mt-32 md:rounded-t-4xl md:py-20"
>
    <div class="mx-auto flex max-w-5xl flex-col gap-12">
        <div class="flex flex-col gap-8 md:flex-row md:items-end md:justify-between">
            <div class="max-w-xl">
                <p class="flex items-center gap-3 text-base font-medium text-snow-50">
                    <svg
                        class="h-5 w-auto"
                        viewBox="0 0 53 30"
                        fill="currentColor"
                        aria-hidden="true"
                    >
                        <path d="M53 0L44.985 13.8765L37.0616 0H53Z"></path>
                        <path d="M35.6656 30L40.8419 21.0452L28.8221 0H18.5282L23.1758 8.12843L23.1724 8.13363L28.302 17.1144L28.3037 17.1109L35.6656 30Z"></path>
                        <path d="M17.1391 30L22.3137 21.0452L10.2938 0H0L4.64761 8.12843L4.64415 8.13363L9.7738 17.1144L9.77553 17.1109L17.1391 30Z"></path>
                    </svg>
                    William De Azevedo
                </p>
                <p class="mt-4 max-w-lg text-base font-light leading-relaxed text-snow-50/75">
                    Développeur front-end freelance pour sites clairs, rapides,
                    accessibles et crédibles.
                </p>
                <a
                    class="mt-5 inline-flex text-snow-50/85 transition-colors hover:text-snow-50 focus-visible:text-snow-50 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-snow-50"
                    href="mailto:william.deazevedopro@gmail.com"
                >
                    william.deazevedopro@gmail.com
                </a>
            </div>
            <button
                class="inline-flex min-h-14 w-full cursor-pointer items-center justify-center rounded-xl border-0 bg-snow-50 px-8 py-3 text-sm font-medium text-blue-500 shadow-[0_24px_46px_-22px_rgba(14,23,37,0.5),inset_0_-2px_5px_rgba(34,42,55,0.08),inset_0_0_0_1px_rgba(34,42,55,0.06)] transition-shadow hover:shadow-[0_30px_58px_-22px_rgba(14,23,37,0.64),inset_0_-2px_7px_rgba(34,42,55,0.1),inset_0_0_0_1px_rgba(34,42,55,0.08)] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-snow-50 sm:w-auto"
                data-cal-location="footer"
                data-cal-open
                type="button"
            >
                Parlons de votre projet
            </button>
        </div>
        <nav aria-label="Navigation pied de page">
            <div class="grid gap-8 border-t border-snow-50/15 pt-10 sm:grid-cols-3">
                {
                    linkGroups.map((group) => (
                        <div>
                            <h2 class="mb-3 text-xs font-medium uppercase tracking-[0.12em] text-snow-50/55">
                                {group.title}
                            </h2>
                            <ul class="flex flex-col gap-2">
                                {group.links.map((link) => (
                                    <li>
                                        <a
                                            class="text-snow-50/80 transition-colors hover:text-snow-50 focus-visible:text-snow-50 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-snow-50"
                                            href={link.href}
                                        >
                                            {link.label}
                                        </a>
                                    </li>
                                ))}
                            </ul>
                        </div>
                    ))
                }
            </div>
        </nav>
        <p class="border-t border-snow-50/15 pt-6 text-xs text-snow-50/60">
            © {year} William De Azevedo
        </p>
    </div>
</footer>
