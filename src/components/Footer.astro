---
const year = new Date().getFullYear();
const linkGroups = [
    {
        title: "Services",
        links: [
            { href: "/services/creation-site-vitrine", label: "Création site vitrine" },
            { href: "/services/refonte-site-internet", label: "Refonte site internet" },
            { href: "/services/developpeur-web-freelance", label: "Développeur freelance" },
        ],
    },
    {
        title: "Réalisations",
        links: [
            { href: "/realisations/le-fellic", label: "Le Fellic" },
            { href: "/realisations/persistance", label: "Persistance" },
            { href: "/realisations/motivai", label: "Motivai" },
        ],
    },
    {
        title: "Ressources",
        links: [
            { href: "/tarifs", label: "Tarifs" },
            { href: "/methode", label: "Méthode" },
            { href: "/articles", label: "Conseils" },
            { href: "/mentions-legales", label: "Mentions légales" },
        ],
    },
];
---

<footer
    class="mt-16 border-t border-snow-600/80 px-2 py-8 text-sm text-gray-600 sm:px-4"
>
    <div class="mx-auto grid max-w-5xl gap-8 md:grid-cols-[1.1fr_1.9fr]">
        <div class="max-w-md">
            <p class="flex items-center gap-3 text-base font-medium text-gray-900">
                <svg
                    class="h-5 w-auto"
                    viewBox="0 0 53 30"
                    fill="currentColor"
                    aria-hidden="true"
                >
                    <path d="M53 0L44.985 13.8765L37.0616 0H53Z"></path>
                    <path d="M35.6656 30L40.8419 21.0452L28.8221 0H18.5282L23.1758 8.12843L23.1724 8.13363L28.302 17.1144L28.3037 17.1109L35.6656 30Z"></path>
                    <path d="M17.1391 30L22.3137 21.0452L10.2938 0H0L4.64761 8.12843L4.64415 8.13363L9.7738 17.1144L9.77553 17.1109L17.1391 30Z"></path>
                </svg>
                William De Azevedo
            </p>
            <p class="mt-2 font-light leading-relaxed">
                Développeur front-end freelance pour sites rapides, accessibles
                et soignés.
            </p>
            <a
                class="mt-4 inline-flex transition-colors hover:text-blue-500 focus-visible:text-blue-500 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-blue-500"
                href="mailto:william.deazevedopro@gmail.com"
            >
                william.deazevedopro@gmail.com
            </a>
        </div>
        <nav aria-label="Navigation pied de page">
            <div class="grid gap-6 sm:grid-cols-3">
                {
                    linkGroups.map((group) => (
                        <div>
                            <h2 class="mb-3 text-xs font-medium uppercase tracking-[0.12em] text-gray-500">
                                {group.title}
                            </h2>
                            <ul class="flex flex-col gap-2">
                                {group.links.map((link) => (
                                    <li>
                                        <a
                                            class="transition-colors hover:text-blue-500 focus-visible:text-blue-500 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-blue-500"
                                            href={link.href}
                                        >
                                            {link.label}
                                        </a>
                                    </li>
                                ))}
                            </ul>
                        </div>
                    ))
                }
            </div>
        </nav>
        <p class="text-xs text-gray-600 md:col-span-2">© {year} William De Azevedo</p>
    </div>
</footer>
