<header class="site-header sticky top-0 z-50 w-full" data-site-header>
    <div class="header-bg" aria-hidden="true">
        <div></div>
        <div></div>
        <div></div>
        <div></div>
    </div>
    <nav
        aria-label="Navigation principale"
        class="relative mx-auto flex min-h-16 max-w-5xl items-center justify-center px-4 py-3"
    >
        <a
            class="inline-flex text-gray-900 transition-colors hover:text-blue-500 focus-visible:text-blue-500 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-blue-500"
            href="/"
            aria-label="William De Azevedo - Accueil"
        >
            <svg
                class="h-6 w-auto"
                viewBox="0 0 53 30"
                fill="currentColor"
                aria-hidden="true"
            >
                <path d="M53 0L44.985 13.8765L37.0616 0H53Z"></path>
                <path d="M35.6656 30L40.8419 21.0452L28.8221 0H18.5282L23.1758 8.12843L23.1724 8.13363L28.302 17.1144L28.3037 17.1109L35.6656 30Z"></path>
                <path d="M17.1391 30L22.3137 21.0452L10.2938 0H0L4.64761 8.12843L4.64415 8.13363L9.7738 17.1144L9.77553 17.1109L17.1391 30Z"></path>
            </svg>
        </a>
    </nav>
</header>

<style>
    .site-header {
        isolation: isolate;
    }

    .site-header > nav {
        position: relative;
        z-index: 1;
    }

    .header-bg {
        height: 190%;
        left: 0;
        pointer-events: none;
        position: absolute;
        top: -45%;
        transform: scaleY(0) translateY(-20%);
        transform-origin: center top;
        transition: transform 360ms cubic-bezier(0.2, 0, 0, 1);
        width: 100%;
        will-change: transform;
        z-index: 0;
    }

    .site-header[data-scrolled] .header-bg {
        transform: scaleY(1) translateY(0);
    }

    .header-bg > div {
        inset: 0;
        position: absolute;
    }

    .header-bg > div:nth-child(1) {
        -webkit-backdrop-filter: blur(1px);
        backdrop-filter: blur(1px);
        -webkit-mask: linear-gradient(
            to top,
            transparent 0%,
            #fff 12.5%,
            #fff 37.5%,
            transparent 50%
        );
        mask: linear-gradient(
            to top,
            transparent 0%,
            #fff 12.5%,
            #fff 37.5%,
            transparent 50%
        );
        z-index: 2;
    }

    .header-bg > div:nth-child(2) {
        -webkit-backdrop-filter: blur(2px);
        backdrop-filter: blur(2px);
        -webkit-mask: linear-gradient(
            to top,
            transparent 12.5%,
            #fff 37.5%,
            #fff 50%,
            transparent 62.5%
        );
        mask: linear-gradient(
            to top,
            transparent 12.5%,
            #fff 37.5%,
            #fff 50%,
            transparent 62.5%
        );
        z-index: 3;
    }

    .header-bg > div:nth-child(3) {
        -webkit-backdrop-filter: blur(5px);
        backdrop-filter: blur(5px);
        -webkit-mask: linear-gradient(
            to top,
            transparent 37.5%,
            #fff 50%,
            #fff 62.5%,
            transparent 75%
        );
        mask: linear-gradient(
            to top,
            transparent 37.5%,
            #fff 50%,
            #fff 62.5%,
            transparent 75%
        );
        z-index: 4;
    }

    .header-bg > div:nth-child(4) {
        -webkit-backdrop-filter: blur(6px);
        backdrop-filter: blur(6px);
        -webkit-mask: linear-gradient(
            to top,
            transparent 50%,
            #fff 62.5%,
            #fff 75%,
            transparent 87.5%
        );
        mask: linear-gradient(
            to top,
            transparent 50%,
            #fff 62.5%,
            #fff 75%,
            transparent 87.5%
        );
        z-index: 5;
    }

    @media (prefers-reduced-motion: reduce) {
        .header-bg {
            transition: none;
        }
    }
</style>

<script>
    const windowWithHeaderBg = window as Window & {
        __wuiHeaderBgReady?: boolean;
    };

    const syncHeaderBg = () => {
        document
            .querySelectorAll<HTMLElement>("[data-site-header]")
            .forEach((header) => {
                header.toggleAttribute("data-scrolled", window.scrollY > 72);
            });
    };

    if (!windowWithHeaderBg.__wuiHeaderBgReady) {
        window.addEventListener("scroll", syncHeaderBg, { passive: true });
        document.addEventListener("astro:page-load", syncHeaderBg);
        windowWithHeaderBg.__wuiHeaderBgReady = true;
    }

    syncHeaderBg();
</script>
