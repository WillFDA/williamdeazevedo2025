    .hero-dot-matrix {
        display: block;
        margin: -0.25rem auto 0;
        max-width: 54rem;
        aspect-ratio: 1372 / 59;
        width: 100%;
    }

    .hero-dot-matrix__canvas {
        display: block;
        height: 100%;
        width: 100%;
    }

    .hero-dot-matrix__source {
        display: none;
    }
</style>
