---
import CalButton from "@/components/CalButton.astro";
import FadeRevealOnScroll from "@/components/animations/FadeRevealOnScroll.astro";
import CheckIcon from "@/components/icons/nucleo/check-2-outline.svg";
import XMarkIcon from "@/components/icons/nucleo/xmark-fill.svg";

type OfferCell =
    | {
          type: "check" | "x";
      }
    | {
          type: "text";
          text: string;
      };

type OfferRow = {
    complete: string;
    focused: OfferCell;
    label: string;
    solo: OfferCell;
};

const rows: OfferRow[] = [
    {
        label: "Compréhension du besoin",
        solo: { type: "text", text: "À votre charge" },
        focused: { type: "text", text: "Brief rapide" },
        complete: "Lecture de l'offre, des freins et du contexte",
    },
    {
        label: "Stratégie de contenu",
        solo: { type: "text", text: "Non incluse" },
        focused: { type: "text", text: "Souvent séparée" },
        complete: "Messages, pages et preuves reliés au parcours",
    },
    {
        label: "Design et direction visuelle",
        solo: { type: "text", text: "Template générique" },
        focused: { type: "text", text: "Joli, parfois isolé" },
        complete: "Interface cohérente avec votre activité réelle",
    },
    {
        label: "Parcours de conversion",
        solo: { type: "x" },
        focused: { type: "text", text: "Dépend du brief" },
        complete: "CTA, objections et prise de contact pensés ensemble",
    },
    {
        label: "Développement front-end",
        solo: { type: "text", text: "Base standard" },
        focused: { type: "check" },
        complete: "Code propre, responsive, accessible et maintenable",
    },
    {
        label: "Performance et accessibilité",
        solo: { type: "x" },
        focused: { type: "text", text: "Souvent à part" },
        complete: "Contrôles intégrés pendant le développement",
    },
    {
        label: "SEO technique initial",
        solo: { type: "text", text: "Léger" },
        focused: { type: "text", text: "Souvent isolé" },
        complete: "Métadonnées, structure et indexation",
    },
    {
        label: "Mise en ligne",
        solo: { type: "text", text: "À organiser" },
        focused: { type: "text", text: "Selon mission" },
        complete: "Publication, formulaires et vérifications finales",
    },
    {
        label: "Mesure et suivi",
        solo: { type: "x" },
        focused: { type: "text", text: "Rare" },
        complete: "Search Console, conversions et point de suivi",
    },
    {
        label: "Pilotage",
        solo: { type: "text", text: "Vous coordonnez" },
        focused: { type: "text", text: "Intervenants à relier" },
        complete: "Un interlocuteur du cadrage à la livraison",
    },
    {
        label: "Investissement type",
        solo: { type: "text", text: "600 - 2 000 €" },
        focused: { type: "text", text: "Variable" },
        complete: "Dès 2 000 € HT selon périmètre",
    },
];
---

<section
    class="relative left-1/2 w-[calc(100dvw-2rem)] max-w-7xl -translate-x-1/2 px-4 py-12 sm:px-8 md:py-16"
    aria-labelledby="offer-comparison-title"
>
    <FadeRevealOnScroll>
        <div class="mx-auto flex max-w-3xl flex-col items-center gap-4 text-center">
            <h2 id="offer-comparison-title" class="section-heading max-w-3xl">
                Ce qui change face aux offres classiques.
            </h2>
            <p class="section-subheading max-w-2xl">
                Beaucoup d'offres produisent une page ou un livrable. Mon
                approche relie le cadrage, le design, le front-end et la mise en
                ligne pour que le site serve vraiment la décision du visiteur.
            </p>
        </div>
    </FadeRevealOnScroll>

    <FadeRevealOnScroll class="mx-auto mt-12 max-w-6xl" delay={0.08}>
        <div class="overflow-hidden rounded-[1.75rem] bg-snow-50 ring-1 ring-gray-200">
            <div class="overflow-x-auto">
                <table class="w-full min-w-[62rem] border-separate border-spacing-0 text-left">
                    <caption class="sr-only">
                        Comparaison entre des offres concurrentes classiques et
                        l'approche de William De Azevedo pour créer ou refondre
                        un site internet.
                    </caption>
                    <thead>
                        <tr>
                            <th
                                class="sticky left-0 z-10 w-[28%] border-b border-r border-gray-200 bg-snow-50 px-6 py-6 align-bottom"
                                scope="col"
                            >
                                <span class="text-sm font-normal leading-tight text-gray-500">
                                    Point de comparaison
                                </span>
                            </th>
                            <th
                                class="w-[22%] border-b border-r border-gray-200 px-6 py-6 text-center align-bottom"
                                scope="col"
                            >
                                <span class="block text-sm font-normal text-gray-500">
                                    Concurrence
                                </span>
                                <strong class="mt-1 block text-lg font-normal leading-tight text-gray-900">
                                    Site rapide
                                </strong>
                                <span class="mt-1.5 block text-xs font-light leading-snug text-gray-500">
                                    Template, page générée ou pack standard
                                </span>
                            </th>
                            <th
                                class="w-[22%] border-b border-r border-gray-200 px-6 py-6 text-center align-bottom"
                                scope="col"
                            >
                                <span class="block text-sm font-normal text-gray-500">
                                    Concurrence
                                </span>
                                <strong class="mt-1 block text-lg font-normal leading-tight text-gray-900">
                                    Prestataire classique
                                </strong>
                                <span class="mt-1.5 block text-xs font-light leading-snug text-gray-500">
                                    Design, développement ou SEO séparés
                                </span>
                            </th>
                            <th
                                class="offer-highlight w-[28%] border-b px-6 py-6 text-center align-bottom text-snow-50"
                                scope="col"
                            >
                                <span class="inline-flex rounded-full bg-snow-50/15 px-3 py-1 text-[0.68rem] font-medium uppercase tracking-widest text-snow-50 ring-1 ring-snow-50/25">
                                    Mon approche
                                </span>
                                <strong class="mt-2 block text-2xl font-medium leading-tight">
                                    Avec William
                                </strong>
                                <span class="mt-1.5 block text-sm font-light leading-snug text-snow-50/80">
                                    Cadrage, design, front-end, SEO technique
                                </span>
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        {
                            rows.map((row, rowIndex) => (
                                <tr class="offer-row group" style={`--row-index: ${rowIndex}`}>
                                    <th
                                        class="sticky left-0 z-10 bg-snow-50 px-6 py-5 text-base font-normal leading-tight text-gray-900 transition-colors group-hover:bg-snow-200"
                                        scope="row"
                                    >
                                        {row.label}
                                    </th>
                                    {[row.solo, row.focused].map((cell) => (
                                        <td class="px-6 py-5 text-center text-base font-normal leading-tight text-gray-500 transition-colors group-hover:bg-snow-200">
                                            {cell.type === "check" && (
                                                <span
                                                    class="inline-flex size-9 items-center justify-center rounded-full bg-blue-50 text-blue-500"
                                                    aria-label="Inclus"
                                                >
                                                    <CheckIcon class="size-4" />
                                                </span>
                                            )}
                                            {cell.type === "x" && (
                                                <span
                                                    class="inline-flex size-9 items-center justify-center rounded-full bg-gray-100 text-gray-900"
                                                    aria-label="Non inclus"
                                                >
                                                    <XMarkIcon class="size-3" />
                                                </span>
                                            )}
                                            {cell.type === "text" && (
                                                <span>{cell.text}</span>
                                            )}
                                        </td>
                                    ))}
                                    <td class="offer-highlight px-6 py-5 text-base font-normal leading-tight text-snow-50">
                                        <span class="flex items-center gap-3">
                                            <span
                                                class="inline-flex size-9 flex-none items-center justify-center rounded-full bg-snow-50 text-blue-500"
                                                aria-hidden="true"
                                            >
                                                <CheckIcon class="size-4" />
                                            </span>
                                            <span>{row.complete}</span>
                                        </span>
                                    </td>
                                </tr>
                            ))
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <p class="mt-3 text-center text-xs font-normal text-gray-500 lg:hidden">
            Faites défiler le tableau horizontalement pour comparer les approches.
        </p>
    </FadeRevealOnScroll>

    <FadeRevealOnScroll delay={0.12}>
        <div class="mx-auto mt-8 flex max-w-2xl flex-col items-center gap-5 text-center">
            <p class="text-sm font-normal leading-relaxed text-gray-500">
                Le but n'est pas de dire que toutes les offres concurrentes sont
                mauvaises. C'est de montrer ce qui est souvent oublié quand le
                site est traité comme un simple livrable.
            </p>
            <CalButton
                class="rounded-xl text-base font-normal"
                label="Choisir la bonne offre"
                location="offres-comparaison"
            />
        </div>
    </FadeRevealOnScroll>
</section>

<style>
    tbody th,
    tbody td {
        border-bottom: 1px solid var(--color-gray-200);
    }

    tbody th,
    tbody td:not(.offer-highlight) {
        border-right: 1px solid var(--color-gray-200);
    }

    tbody tr:last-child th,
    tbody tr:last-child td {
        border-bottom: 0;
    }

    .offer-highlight {
        background:
            radial-gradient(
                circle at 80% 12%,
                rgba(255, 255, 255, 0.16),
                transparent 24rem
            ),
            linear-gradient(135deg, var(--color-blue-500), var(--color-blue-600));
        box-shadow: inset 1px 0 0 rgba(255, 255, 255, 0.16);
    }

    thead .offer-highlight {
        border-bottom-color: rgba(255, 255, 255, 0.22);
    }

    tbody .offer-highlight {
        border-bottom-color: rgba(255, 255, 255, 0.18);
        transition: filter 200ms ease;
    }

    tbody tr:hover .offer-highlight {
        filter: brightness(0.98);
    }

    @media (scripting: enabled) and (prefers-reduced-motion: no-preference) {
        .offer-row {
            transition: opacity 700ms cubic-bezier(0.2, 0, 0, 1);
            transition-delay: calc(var(--row-index, 0) * 55ms);
        }

        :global(.fade-reveal-on-scroll.is-reveal-ready:not(.is-visible))
            .offer-row {
            opacity: 0;
            transition: none;
        }
    }
</style>
