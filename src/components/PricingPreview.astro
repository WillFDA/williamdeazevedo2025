---
import ArrowRight from "./icons/nucleo/arrow-right-fill.svg";
import Msgs from "./icons/nucleo/msgs-fill.svg";
import WindowPaintbrush from "./icons/nucleo/window-paintbrush-fill.svg";
import WaveIcon from "./ui/WaveIcon.astro";
import WaveText from "./ui/WaveText.astro";

const formatEuro = (value: number) =>
    new Intl.NumberFormat("fr-FR").format(value);

const sitePricingOptions = [
    { icon: "paint", label: "Animations sobres", price: 650 },
    { icon: "message", label: "Formulaire contact personnalisé", price: 450 },
] as const;

const pricingCards = [
    {
        title: "Site web",
        subtitle:
            "Pour lancer, clarifier ou moderniser une présence web qui inspire confiance.",
        priceValue: 3500,
        delay: "Livré en 10 jours à 5 semaines selon périmètre",
        cta: "Parlons de votre site web",
        variant: "blue",
        features: [
            "Architecture et parcours de conversion",
            "Design responsive sur mesure",
            "Développement front-end propre",
            "SEO technique et performance",
            "Mise en ligne",
        ],
    },
    {
        title: "Interface produit",
        subtitle:
            "Pour construire ou améliorer un SaaS, dashboard, espace client ou outil métier.",
        price: "Sur devis",
        budget: "Cadrage possible dès 900 € HT",
        delay: "Planning défini après lecture du périmètre",
        cta: "Cadrer votre interface",
        footnote:
            "Le prix dépend surtout des écrans, états, rôles, données et intégrations.",
        variant: "dark",
        features: [
            "Intégration Figma ou design système",
            "React / Next.js",
            "Authentification ou espace client",
            "Dashboard ou back-office",
            "IA, paiement ou API externe",
            "Mise en ligne",
        ],
    },
] as const;
---

<section
    id="tarifs"
    class="mx-auto w-full max-w-7xl px-4 pt-10 pb-20 sm:px-8 md:pt-12 md:pb-24"
    aria-labelledby="pricing-title"
>
    <div class="mx-auto flex max-w-4xl flex-col items-center gap-4 text-center">
        <h2 id="pricing-title" class="section-heading">
            Un site clair à lancer. Simple à faire évoluer.
        </h2>
        <p class="section-subheading">
            Chaque projet dépend du nombre de pages, du contenu, du niveau de
            design, des animations et des fonctionnalités attendues. Voici des
            budgets de départ pour vous aider à vous situer avant un premier
            échange.
        </p>
    </div>

    <div
        class="mx-auto mt-12 grid max-w-[32rem] grid-cols-1 gap-4 lg:max-w-[53.375rem] lg:grid-cols-2"
    >
        {
            pricingCards.map((card) => (
                <article
                    class:list={[
                        "flex min-h-0 flex-col overflow-hidden rounded-[28px] text-snow-50 ",
                        card.variant === "blue"
                            ? "border-white/10 bg-blue-500 shadow-[0_28px_70px_-48px_rgba(66,102,219,0.85)]"
                            : "border-white/10 bg-coffee-300 shadow-[0_28px_70px_-50px_rgba(34,42,55,0.8)]",
                    ]}
                    data-pricing-card={
                        "priceValue" in card ? "site" : undefined
                    }
                >
                    <div class="min-h-0 rounded-[24px] ring ring-white/5 bg-white/8 mx-1 mt-1 py-9 px-8">
                        <h3 class="mb-4 text-2xl font-normal leading-none tracking-tight text-inherit">
                            {card.title}
                        </h3>
                        <p class="text-xl font-light tracking-tight text-snow-50/80">
                            {card.subtitle}
                        </p>
                    </div>

                    <div class="flex flex-col mx-9 my-10">
                        {"priceValue" in card ? (
                            <strong class="flex flex-col gap-1 font-semibold leading-none tracking-tight text-inherit">
                                <span class="text-sm font-light leading-none tracking-[-0.04em] text-snow-50/70">
                                    À partir de
                                </span>
                                <span class="inline-flex items-baseline whitespace-nowrap text-5xl font-semibold tracking-tight text-snow-50 [font-variant-numeric:tabular-nums]">
                                    <span
                                        class="inline-block min-w-[4.25ch] [font-variant-numeric:tabular-nums]"
                                        data-pricing-price
                                        data-value={card.priceValue}
                                    >
                                        {formatEuro(card.priceValue)}
                                    </span>
                                    € HT
                                </span>
                            </strong>
                        ) : (
                            <strong class="text-[2.75rem] font-semibold leading-none tracking-[-0.04em] text-inherit">
                                {card.price}
                            </strong>
                        )}
                        {"budget" in card && (
                            <span class="text-sm font-light tracking-tight text-snow-50/75">
                                {card.budget}
                            </span>
                        )}
                        <span class="text-sm font-light tracking-tight text-snow-50/75">
                            {card.delay}
                        </span>
                    </div>

                    {"priceValue" in card && (
                        <div class="grid px-9" data-pricing-site>
                            {sitePricingOptions.map((option) => (
                                <label class="relative flex min-h-[2.4rem] cursor-pointer items-center justify-between gap-4 text-inherit">
                                    <span class="inline-flex min-w-0 items-center gap-3">
                                        <span
                                            class="inline-flex size-6 flex-none items-center justify-center text-snow-50/80 [&>svg]:size-full"
                                            aria-hidden="true"
                                        >
                                            {option.icon === "paint" ? (
                                                <WindowPaintbrush />
                                            ) : (
                                                <Msgs />
                                            )}
                                        </span>
                                        <span class="text-md font-normal tracking-tight">
                                            {option.label}
                                        </span>
                                    </span>
                                    <input
                                        class="relative z-[1] h-[1.35rem] w-[2.35rem] flex-none cursor-pointer appearance-none rounded-full bg-white/20 transition-colors after:absolute after:left-[0.2rem] after:top-[0.2rem] after:size-[0.95rem] after:rounded-full after:bg-snow-50 after:shadow-[0_0.2rem_0.5rem_rgba(34,42,55,0.18)] after:transition-transform after:content-[''] checked:bg-snow-50 checked:after:translate-x-4 checked:after:bg-blue-500 focus-visible:outline-2 focus-visible:outline-offset-3 focus-visible:outline-snow-50"
                                        type="checkbox"
                                        data-pricing-option
                                        data-price={option.price}
                                    />
                                </label>
                            ))}
                        </div>
                    )}

                    <ul class=" flex list-none flex-col mx-10 gap-2 my-10">
                        {card.features.map((feature) => (
                            <li class="flex items-baseline gap-4 text-sm font-normal tracking-tight text-snow-50/80">
                                <span
                                    class="mt-[0.08em] h-[0.72rem] w-[0.38rem] flex-none rotate-45 border-r-[1.8px] border-b-[1.8px] border-current"
                                    aria-hidden="true"
                                />
                                <span>{feature}</span>
                            </li>
                        ))}
                    </ul>

                    {"footnote" in card && (
                        <p class="mx-9 mb-9 text-sm leading-normal tracking-tight text-snow-50/80">
                            {card.footnote}
                        </p>
                    )}

                    <button
                        class="mb-9 mx-8 h-13 mt-auto inline-flex cursor-pointer items-center justify-center gap-3 rounded-xl border-0 bg-snow-50 px-5 font-medium text-coffee-300 shadow-[0_20px_46px_-22px_rgba(14,23,37,0.72)] transition-shadow hover:shadow-[0_26px_54px_-22px_rgba(14,23,37,0.86)] focus-visible:outline-2 focus-visible:outline-offset-3 focus-visible:outline-blue-500"
                        data-cal-location={`pricing-${card.title.toLowerCase().replaceAll(" ", "-")}`}
                        data-cal-open
                        type="button"
                    >
                        <WaveText text={card.cta} trigger="parent" />
                        <WaveIcon direction="right" trigger="parent">
                            <ArrowRight aria-hidden="true" class="size-full" />
                        </WaveIcon>
                    </button>
                </article>
            ))
        }
    </div>

    <a
        class="mx-auto mt-[2.35rem] table text-base font-normal text-gray-900 underline decoration-gray-300 underline-offset-4 transition-colors hover:text-blue-500 focus-visible:text-blue-500 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-blue-500"
        href="/tarifs"
    >
        Voir ce qui fait varier un devis
    </a>
</section>

<script>
    import { animate, utils } from "animejs";

    const pricingFormatter = new Intl.NumberFormat("fr-FR");
    const activePricingControllers = new WeakMap<HTMLElement, () => void>();

    const cleanupPricingCalculators = () => {
        document
            .querySelectorAll<HTMLElement>('[data-pricing-card="site"]')
            .forEach((root) => {
                activePricingControllers.get(root)?.();
                activePricingControllers.delete(root);
            });
    };

    const initPricingCalculators = () => {
        document
            .querySelectorAll<HTMLElement>('[data-pricing-card="site"]')
            .forEach((root) => {
                if (root.dataset.pricingReady === "true") return;

                const priceTarget = root.querySelector<HTMLElement>(
                    "[data-pricing-price]",
                );
                const options = Array.from(
                    root.querySelectorAll<HTMLInputElement>(
                        "[data-pricing-option]",
                    ),
                );

                if (!priceTarget) return;

                const baseValue = Number(priceTarget.dataset.value) || 0;
                const state = { value: baseValue };
                let animation: ReturnType<typeof animate> | undefined;
                const controller = new AbortController();

                const renderPrice = (value: number) => {
                    const roundedValue = Math.round(value);
                    priceTarget.textContent =
                        pricingFormatter.format(roundedValue);
                    priceTarget.dataset.value = String(roundedValue);
                };

                const getPrice = () =>
                    baseValue +
                    options.reduce(
                        (total, option) =>
                            total +
                            (option.checked
                                ? Number(option.dataset.price) || 0
                                : 0),
                        0,
                    );

                const updatePrice = () => {
                    const nextValue = getPrice();

                    animation?.cancel();

                    if (
                        window.matchMedia("(prefers-reduced-motion: reduce)")
                            .matches
                    ) {
                        state.value = nextValue;
                        renderPrice(nextValue);
                        return;
                    }

                    animation = animate(state, {
                        value: nextValue,
                        duration: 720,
                        ease: "out(4)",
                        modifier: utils.round(0),
                        onRender: () => renderPrice(state.value),
                    });
                };

                options.forEach((option) => {
                    option.addEventListener("change", updatePrice, {
                        signal: controller.signal,
                    });
                });

                root.dataset.pricingReady = "true";
                updatePrice();
                activePricingControllers.set(root, () => {
                    animation?.cancel();
                    controller.abort();
                    delete root.dataset.pricingReady;
                });
            });
    };

    const pricingWindow = window as Window & {
        __wuiPricingPreviewReady?: boolean;
    };

    initPricingCalculators();

    if (!pricingWindow.__wuiPricingPreviewReady) {
        pricingWindow.__wuiPricingPreviewReady = true;
        document.addEventListener(
            "astro:before-swap",
            cleanupPricingCalculators,
        );
        document.addEventListener("astro:page-load", initPricingCalculators);
    }
</script>
