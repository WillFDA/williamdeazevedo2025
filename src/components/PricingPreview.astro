---
import WaveText from "./ui/WaveText.astro";

const formatEuro = (value: number) =>
    new Intl.NumberFormat("fr-FR").format(value);

const pricingCards = [
    {
        title: "Intégration essentielle",
        subtitle:
            "Vous avez déjà la maquette finale, les textes et les visuels. Je transforme l'ensemble en une page propre et responsive.",
        priceValue: 1000,
        delay: "Pour une landing page simple · 7 à 10 jours",
        cta: "Obtenir mon estimation gratuite",
        location: "pricing-integration-essentielle",
        featured: false,
        features: [
            "Maquette finale fournie",
            "Textes et visuels prêts",
            "Intégration responsive d'une page",
            "Formulaire de contact standard",
            "SEO technique initial et mise en ligne",
            "1 série de retours",
        ],
    },
    {
        title: "Site vitrine complet",
        subtitle:
            "Je cadre l'offre, la structure et les contenus avant de concevoir un site sur mesure qui présente vraiment votre activité.",
        priceValue: 2000,
        delay: "Pour un site de 3 à 5 pages · 3 à 5 semaines",
        cta: "Obtenir mon estimation gratuite",
        location: "pricing-site-vitrine-complet",
        featured: true,
        features: [
            "Cadrage de l'offre et de l'arborescence",
            "Hiérarchie et aide sur les contenus",
            "Design responsive sur mesure",
            "Développement de 3 à 5 pages",
            "SEO, performance et accessibilité",
            "Mise en ligne et accompagnement",
        ],
    },
    {
        title: "Site essentiel",
        subtitle:
            "Vous avez déjà les textes et l'identité visuelle. Je conçois l'interface et réalise un site court, clair et crédible.",
        priceValue: 1600,
        delay: "Pour une landing page ou un site très court · 2 à 3 semaines",
        cta: "Obtenir mon estimation gratuite",
        location: "pricing-site-essentiel",
        featured: false,
        features: [
            "Textes et identité visuelle fournis",
            "Structure et design d'une page",
            "Développement responsive",
            "Formulaire de contact",
            "SEO technique et performance",
            "Mise en ligne et 2 séries de retours",
        ],
    },
] as const;
---

<section
    id="tarifs"
    class="mx-auto w-full max-w-7xl px-4 py-12 sm:px-8 md:py-16"
    aria-labelledby="pricing-title"
>
    <div class="mx-auto flex max-w-4xl flex-col items-center gap-4 text-center">
        <h2 id="pricing-title" class="section-heading">
            Un site clair à lancer. Simple à faire évoluer.
        </h2>
        <p class="section-subheading">
            Trois niveaux d'accompagnement selon ce que vous avez déjà préparé :
            maquette prête, identité existante ou site complet à construire.
            Chaque formule est ajustée au périmètre avant le démarrage.
        </p>
    </div>

    <div
        class="mx-auto mt-12 grid max-w-lg grid-cols-1 gap-4 lg:max-w-7xl lg:grid-cols-3 lg:items-stretch"
    >
        {
            pricingCards.map((card) => (
                <article
                    class:list={[
                        "flex min-h-0 flex-col overflow-hidden rounded-4xl",
                        card.featured
                            ? "bg-blue-500 text-snow-50"
                            : "bg-gray-100 text-gray-900",
                    ]}
                >
                    <div
                        class:list={[
                            "mx-1 mt-1 min-h-0 rounded-3xl p-8",
                            card.featured
                                ? "bg-white/10 ring ring-white/5"
                                : "bg-snow-50/70",
                        ]}
                    >
                        <h3 class="mb-4 text-2xl font-normal leading-none tracking-tight text-inherit">
                            {card.title}
                        </h3>
                        <p
                            class:list={[
                                "text-xl font-light tracking-tight",
                                card.featured
                                    ? "text-snow-50/90"
                                    : "text-gray-600",
                            ]}
                        >
                            {card.subtitle}
                        </p>
                    </div>

                    <div class="mx-8 my-10 flex flex-col">
                        <strong class="flex flex-col gap-1 font-semibold leading-none tracking-tight text-inherit">
                            <span
                                class:list={[
                                    "text-sm font-light leading-none tracking-tight",
                                    card.featured
                                        ? "text-snow-50/90"
                                        : "text-gray-600",
                                ]}
                            >
                                À partir de
                            </span>
                            <span
                                class:list={[
                                    "inline-flex items-baseline whitespace-nowrap text-5xl font-semibold tracking-tight [font-variant-numeric:tabular-nums]",
                                    card.featured
                                        ? "text-snow-50"
                                        : "text-gray-900",
                                ]}
                            >
                                {formatEuro(card.priceValue)} € HT
                            </span>
                        </strong>
                        <span
                            class:list={[
                                "mt-2 text-sm font-light leading-normal tracking-tight",
                                card.featured
                                    ? "text-snow-50/90"
                                    : "text-gray-600",
                            ]}
                        >
                            {card.delay}
                        </span>
                    </div>

                    <ul class="mx-8 mb-10 flex flex-col gap-2">
                        {card.features.map((feature) => (
                            <li
                                class:list={[
                                    "flex items-baseline gap-4 text-sm font-normal tracking-tight",
                                    card.featured
                                        ? "text-snow-50"
                                        : "text-gray-800",
                                ]}
                            >
                                <span
                                    class="mt-[0.08em] h-[0.72rem] w-[0.38rem] flex-none rotate-45 border-r-[1.8px] border-b-[1.8px] border-current"
                                    aria-hidden="true"
                                />
                                <span>{feature}</span>
                            </li>
                        ))}
                    </ul>

                    <button
                        aria-controls="cal-drawer"
                        aria-haspopup="dialog"
                        class:list={[
                            "mx-8 mb-8 mt-auto inline-flex min-h-14 cursor-pointer items-center justify-center rounded-xl border-0 bg-snow-50 px-5 font-medium text-coffee-300 focus-visible:outline-2 focus-visible:outline-offset-3",
                            card.featured
                                ? "focus-visible:outline-snow-50"
                                : "focus-visible:outline-blue-500",
                        ]}
                        data-cal-location={card.location}
                        data-cal-open
                        type="button"
                    >
                        <WaveText text={card.cta} trigger="parent" />
                    </button>
                </article>
            ))
        }
    </div>

    <a
        class="group relative mx-auto mt-12 table text-base font-normal text-gray-900 no-underline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-blue-500"
        href="#faq"
    >
        Voir ce qui fait varier un devis
        <span
            class="absolute left-0 bottom-0 h-px w-full origin-left scale-x-0 bg-gray-900 transition-transform duration-300 ease-out group-hover:scale-x-100 group-focus-visible:scale-x-100"
            aria-hidden="true"></span>
    </a>
</section>
