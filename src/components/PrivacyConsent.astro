---
const googleEnabled = Boolean(import.meta.env.PUBLIC_ZARAZ_AUDIENCE_PURPOSE && import.meta.env.PUBLIC_ZARAZ_MARKETING_PURPOSE);
---
<section
    aria-label="Préférences de confidentialité"
    class="privacy-panel fixed bottom-4 left-4 right-4 z-[90] mx-auto max-w-2xl rounded-2xl border border-gray-300 bg-white p-5 text-gray-900 shadow-xl sm:p-6"
    data-privacy-panel
    hidden
    transition:persist
>
    <h2 class="text-lg font-medium" tabindex="-1" data-privacy-title>Votre confidentialité</h2>
    <p class="mt-2 text-sm leading-relaxed">
        {googleEnabled
            ? "Avec votre accord, Rybbit et Google Analytics mesurent les visites et les interactions. Google Ads mesure les rendez-vous provenant des annonces. Vous pouvez refuser ces outils et continuer à utiliser le site. "
            : "Avec votre accord, Rybbit mesure les visites et les interactions. Vous pouvez refuser cet outil et continuer à utiliser le site. "}
        <a class="underline" href="/mentions-legales/#cookies">En savoir plus</a>.
    </p>
    <fieldset class="mt-4 flex flex-col gap-3 text-sm">
        <legend class="sr-only">Choisir les outils facultatifs</legend>
        <label class="flex items-start gap-3">
            <input class="mt-1 size-4" type="checkbox" data-consent-audience />
            <span>Mesure d’audience — {googleEnabled ? "Rybbit et Google Analytics" : "Rybbit"}</span>
        </label>
        <label class="flex items-start gap-3" hidden={!googleEnabled}>
            <input class="mt-1 size-4" type="checkbox" data-consent-marketing disabled={!googleEnabled} />
            <span>Mesure publicitaire — Google Ads, sans publicité personnalisée</span>
        </label>
    </fieldset>
    <div class="mt-5 grid gap-2 sm:grid-cols-3">
        <button class="privacy-choice" type="button" data-consent-refuse>Tout refuser</button>
        <button class="privacy-choice" type="button" data-consent-accept>Tout accepter</button>
        <button class="privacy-choice" type="button" data-consent-save>Enregistrer mes choix</button>
    </div>
    <p class="mt-3 text-xs leading-relaxed">Votre choix est mémorisé pendant 180 jours. Vous pouvez le modifier dans le pied de page.</p>
</section>

<script>
    import { initAnalytics } from "../scripts/analytics";
    import { consentLifetimeMs, getPrivacyConsent, savePrivacyConsent } from "../scripts/privacyConsent";

    const googleEnabled = Boolean(import.meta.env.PUBLIC_ZARAZ_AUDIENCE_PURPOSE && import.meta.env.PUBLIC_ZARAZ_MARKETING_PURPOSE);
    const panel = document.querySelector<HTMLElement>("[data-privacy-panel]");
    const audience = panel?.querySelector<HTMLInputElement>("[data-consent-audience]");
    const marketing = panel?.querySelector<HTMLInputElement>("[data-consent-marketing]");
    let returnFocus: HTMLElement | null = null;
    let expiryTimer: number | undefined;
    const scheduleExpiry = () => {
        window.clearTimeout(expiryTimer);
        const consent = getPrivacyConsent();
        if (!consent) return;
        const remaining = consent.savedAt + consentLifetimeMs - Date.now();
        expiryTimer = window.setTimeout(() => {
            if (getPrivacyConsent()) scheduleExpiry();
            else window.location.reload();
        }, Math.min(remaining + 1, 2147483647));
    };

    const openPreferences = (focus = false) => {
        if (!panel || !audience || !marketing) return;
        const consent = getPrivacyConsent();
        audience.checked = consent?.audience ?? false;
        marketing.checked = consent?.marketing ?? false;
        panel.hidden = false;
        if (focus) panel.querySelector<HTMLElement>("[data-privacy-title]")?.focus();
    };

    const saveChoices = (allowAudience: boolean, allowMarketing: boolean) => {
        const previous = getPrivacyConsent();
        const withdrawal = (previous?.audience && !allowAudience) || (previous?.marketing && !allowMarketing);
        savePrivacyConsent(allowAudience, allowMarketing);
        if (panel) panel.hidden = true;
        if (withdrawal) {
            // Reload discards already-running third-party handlers and queued requests.
            // It cannot retract events sent before the visitor withdrew consent.
            try {
                for (const key of ["rybbit-visitor-id", "rybbit-user-id", "zaraz-consent", "google_consent_default", "google_consent_update"]) {
                    window.localStorage.removeItem(key);
                }
                window.sessionStorage.removeItem("wui:rybbit-events");
            } catch { /* Browser storage may be unavailable. */ }
            window.location.reload();
            return;
        }
        initAnalytics();
        scheduleExpiry();
        returnFocus?.focus();
    };

    panel?.querySelector("[data-consent-refuse]")?.addEventListener("click", () => saveChoices(false, false));
    panel?.querySelector("[data-consent-accept]")?.addEventListener("click", () => saveChoices(true, googleEnabled));
    panel?.querySelector("[data-consent-save]")?.addEventListener("click", () => saveChoices(audience?.checked ?? false, marketing?.checked ?? false));
    document.addEventListener("click", (event) => {
        const target = event.target;
        const button = target instanceof Element ? target.closest<HTMLElement>("[data-privacy-open]") : null;
        if (!button) return;
        returnFocus = button;
        openPreferences(true);
    });
    document.addEventListener("storage", (event) => {
        if (event.key === "wui:privacy-consent:v1" || event.key === null) window.location.reload();
    });
    const refreshConsent = () => {
        if (!getPrivacyConsent()) openPreferences();
    };
    document.addEventListener("astro:page-load", refreshConsent);
    refreshConsent();
    scheduleExpiry();
</script>

<style>
    label[hidden] { display: none; }
    .privacy-panel { max-height: calc(100dvh - 2rem); overflow-y: auto; }
    .privacy-panel[hidden] { display: none; }
    .privacy-choice {
        min-height: 44px;
        cursor: pointer;
        border: 1px solid #6b7280;
        border-radius: 0.6rem;
        padding: 0.65rem 0.8rem;
        background: white;
        color: #111827;
        font-size: 0.875rem;
    }
    .privacy-choice:hover { background: #f1f5f9; }
    .privacy-choice:focus-visible { outline: 2px solid #1d4ed8; outline-offset: 3px; }
</style>
