---
import XMark from "./icons/nucleo/xmark-fill.svg";

const problemItems = [
    "Votre site est daté, peu accessible ou pas au niveau de votre travail ?",
    "Vous n'avez pas encore de site et vous ne savez pas par où commencer ?",
    "Votre produit a besoin d'un développeur capable de relier design, front-end et logique métier ?",
    "Vous en avez assez des prestataires flous et des livraisons bancales ?",
] as const;
---

<section
    class="problems-section mx-auto w-full max-w-5xl px-4 py-12 sm:px-8 md:py-16"
    aria-labelledby="problems-title"
>
    <div class="mx-auto flex max-w-4xl flex-col items-center gap-4 text-center">
        <h2
            id="problems-title"
            class="problems-reveal section-heading"
            style="--problem-reveal-delay: 80ms"
        >
            Vous vous reconnaissez ?
        </h2>
        <p
            class="problems-reveal section-subheading"
            style="--problem-reveal-delay: 220ms"
        >
            Une bonne offre peut rester invisible si votre site ne donne pas
            assez vite envie de comprendre, de faire confiance et de passer à
            l'action.
        </p>
    </div>
    <ul class="mx-auto mt-12 flex max-w-2xl flex-col gap-5">
        {
            problemItems.map((problem, index) => (
                <li
                    class="problems-reveal flex items-center gap-3"
                    style={`--problem-reveal-delay: ${380 + index * 120}ms`}
                >
                    <span class="flex size-10 shrink-0 items-center justify-center rounded-lg bg-snow-50 text-red-500 shadow-[0_14px_32px_-24px_rgba(34,42,55,0.55)] ring-1 ring-gray-200/70">
                        <XMark class="size-4 drop-shadow-[-1px_-1px_2px_rgba(239,68,68,0.24)]" />
                    </span>
                    <p class="text-base font-normal leading-snug text-gray-900 sm:text-lg">
                        {problem}
                    </p>
                </li>
            ))
        }
    </ul>
</section>

<style>
    .problems-section.section-fade-reveal.is-reveal-ready
        .problems-reveal {
        filter: blur(8px);
        opacity: 0;
        transform: translate3d(0, 1.25rem, 0);
    }

    .problems-section.section-fade-reveal.is-visible .problems-reveal,
    .problems-section.section-fade-reveal.is-reveal-complete
        .problems-reveal {
        animation: problems-reveal-in 1050ms cubic-bezier(0.16, 1, 0.3, 1)
            both;
        animation-delay: var(--problem-reveal-delay, 0ms);
    }

    @keyframes problems-reveal-in {
        to {
            filter: none;
            opacity: 1;
            transform: none;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .problems-section.section-fade-reveal.is-reveal-ready
            .problems-reveal {
            animation: none;
            filter: none;
            opacity: 1;
            transform: none;
        }
    }
</style>
