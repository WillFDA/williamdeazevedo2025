---
import Globe from "./icons/nucleo/globe-outline.svg";
import Link from "./icons/Link.astro";
import WaveIcon from "./ui/WaveIcon.astro";
import WaveText from "./ui/WaveText.astro";

interface Props {
    detailsHref?: string;
    href: string;
    stack?: string[];
    title: string;
}

const { detailsHref, href, stack = [], title } = Astro.props;
const isExternal = href.startsWith("http");
const isDetailsExternal = detailsHref?.startsWith("http");
---

<div
    class="project-intro flex flex-col items-center gap-4 text-center sm:items-start sm:text-left"
    data-project-intro
>
    <a
        class="project-intro__title flex w-fit items-center gap-4 no-underline"
        href={href}
        rel={isExternal ? "noreferrer" : undefined}
        target={isExternal ? "_blank" : undefined}
    >
        <h2 class="text-2xl font-medium leading-tight text-gray-900">
            {title}
        </h2>
        <span
            class="project-intro__icon inline-flex text-gray-500"
            data-project-intro-icon
        >
            <Link class="size-5" />
        </span>
    </a>
    <p class="project-intro__description text-base font-light leading-normal text-gray-600">
        <slot />
    </p>
    {
        stack.length > 0 && (
            <ul
                class="flex flex-wrap justify-center gap-2 sm:justify-start"
                aria-label="Stack technique"
            >
                {stack.map((item) => (
                    <li class="rounded-full bg-snow-600 px-3 py-2 text-xs font-light leading-none text-gray-700">
                        {item}
                    </li>
                ))}
            </ul>
        )
    }
    <div class="mt-1 flex w-full flex-col gap-3 sm:w-auto sm:flex-row sm:flex-wrap">
        <a
            class="project-intro__button project-intro__button--site relative isolate flex min-h-14 w-full items-center justify-center gap-3 rounded-xl px-8 py-3 text-base font-normal text-coffee-300 no-underline sm:w-auto"
            href={href}
            rel={isExternal ? "noreferrer" : undefined}
            target={isExternal ? "_blank" : undefined}
        >
            <span>Voir le site</span>
            <WaveIcon direction="up" trigger="parent">
                <Globe aria-hidden="true" />
            </WaveIcon>
        </a>
        {
            detailsHref && (
                <a
                    class="project-intro__button project-intro__button--details relative isolate flex min-h-14 w-full items-center justify-center gap-3 rounded-xl px-8 py-3 text-base font-normal text-coffee-300 no-underline sm:w-auto"
                    data-wui-wave-parent
                    href={detailsHref}
                    rel={isDetailsExternal ? "noreferrer" : undefined}
                    target={isDetailsExternal ? "_blank" : undefined}
                >
                    <WaveText text="Détails du projet" trigger="parent" />
                </a>
            )
        }
    </div>
</div>

<style>
    .project-intro__icon {
        filter: blur(5px);
        opacity: 0;
        transform: translateX(-1.25rem);
        transition:
            opacity 260ms ease,
            transform 420ms cubic-bezier(0.34, 1.56, 0.64, 1),
            filter 260ms ease;
    }

    .project-intro:focus-within .project-intro__icon,
    :global(.project-showcase:focus-within) .project-intro__icon {
        filter: blur(0);
        opacity: 1;
        transform: translateX(0);
    }

    /* Emphasised words inside the slotted description. */
    .project-intro__description :global(span) {
        color: var(--color-gray-900);
        font-weight: 400;
    }

    .project-intro__button::before {
        background: var(--project-button-bg);
        border: 1px solid var(--project-button-border);
        border-radius: inherit;
        content: "";
        inset: 0;
        position: absolute;
        transform: scale(1);
        transition: transform 520ms
            var(--wui-ease-standard, cubic-bezier(0.2, 0, 0, 1));
        z-index: -1;
    }

    .project-intro__button:focus-visible::before {
        transform: scale(0.95);
    }

    @media (hover: hover) {
        .project-intro:hover .project-intro__icon,
        :global(.project-showcase:hover) .project-intro__icon {
            filter: blur(0);
            opacity: 1;
            transform: translateX(0);
        }

        .project-intro__button:hover::before {
            transform: scale(0.95);
        }
    }

    .project-intro__button:focus-visible {
        outline: 2px solid var(--color-blue-500);
        outline-offset: 3px;
    }

    .project-intro__button--site {
        --project-button-bg: var(--color-gray-100);
        --project-button-border: transparent;
    }

    .project-intro__button--details {
        --project-button-bg: transparent;
        --project-button-border: var(--color-gray-200);
    }

    @media (prefers-reduced-motion: reduce) {
        .project-intro__icon {
            filter: none !important;
            opacity: 1 !important;
            transform: none !important;
            transition: none;
        }

        .project-intro__button::before {
            transition: none;
        }
    }
</style>
