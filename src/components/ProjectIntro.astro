---
import Link from "./icons/Link.astro";
import WaveIcon from "./ui/WaveIcon.astro";
import WaveText from "./ui/WaveText.astro";

interface Props {
    detailsHref?: string;
    href: string;
    stack?: string[];
    title: string;
}

const { detailsHref, href, stack = [], title } = Astro.props;
const isExternal = href.startsWith("http");
const isDetailsExternal = detailsHref?.startsWith("http");
---

<div class="project-intro" data-project-intro>
    <a
        class="project-intro__title"
        href={href}
        rel={isExternal ? "noreferrer" : undefined}
        target={isExternal ? "_blank" : undefined}
    >
        <h2>{title}</h2>
        <span class="project-intro__icon" data-project-intro-icon>
            <Link class="size-5" />
        </span>
    </a>
    <p class="project-intro__description">
        <slot />
    </p>
    {
        stack.length > 0 && (
            <ul class="project-intro__stack" aria-label="Stack technique">
                {stack.map((item) => (
                    <li>{item}</li>
                ))}
            </ul>
        )
    }
    <div class="project-intro__actions">
        <a
            class="project-intro__button project-intro__button--site font-regular px-6 py-1.5 rounded-xl h-12 flex text-md justify-center items-center"
            href={href}
            rel={isExternal ? "noreferrer" : undefined}
            target={isExternal ? "_blank" : undefined}
        >
            <span>Voir le site</span>
            <WaveIcon
                class="project-intro__site-icon"
                direction="up"
                trigger="parent"
            >
                <svg
                    aria-hidden="true"
                    fill="none"
                    viewBox="0 0 24 24"
                    xmlns="http://www.w3.org/2000/svg"
                >
                    <circle
                        cx="12"
                        cy="12"
                        r="9"
                        stroke="currentColor"
                        stroke-width="1.7"
                    />
                    <path
                        d="M3.5 12h17"
                        stroke="currentColor"
                        stroke-linecap="round"
                        stroke-width="1.7"
                    />
                    <path
                        d="M12 3.5c2.1 2.2 3.1 5 3.1 8.5s-1 6.3-3.1 8.5c-2.1-2.2-3.1-5-3.1-8.5s1-6.3 3.1-8.5Z"
                        stroke="currentColor"
                        stroke-linejoin="round"
                        stroke-width="1.7"
                    />
                </svg>
            </WaveIcon>
        </a>
        {
            detailsHref && (
                <a
                    class="project-intro__button project-intro__button--details font-regular px-6 py-1.5 rounded-xl h-12 flex text-md justify-center items-center"
                    data-wui-wave-parent
                    href={detailsHref}
                    rel={isDetailsExternal ? "noreferrer" : undefined}
                    target={isDetailsExternal ? "_blank" : undefined}
                >
                    <WaveText text="Détails du projet" trigger="parent" />
                </a>
            )
        }
    </div>
</div>

<style>
    .project-intro {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .project-intro__title {
        align-items: center;
        color: inherit;
        display: flex;
        gap: 1rem;
        text-decoration: none;
        width: fit-content;
    }

    .project-intro__title h2 {
        color: rgb(63 63 70);
        font-size: 1.875rem;
        font-weight: 500;
        line-height: 1;
        margin: 0;
    }

    .project-intro__icon {
        color: rgb(113 113 122);
        display: inline-flex;
        filter: blur(5px);
        opacity: 0;
        transform: translateX(-1.25rem);
        transition:
            opacity 260ms ease,
            transform 420ms cubic-bezier(0.34, 1.56, 0.64, 1),
            filter 260ms ease;
    }

    .project-intro:hover .project-intro__icon,
    .project-intro:focus-within .project-intro__icon,
    :global(.project-showcase:hover) .project-intro__icon,
    :global(.project-showcase:focus-within) .project-intro__icon {
        filter: blur(0);
        opacity: 1;
        transform: translateX(0);
    }

    .project-intro__description {
        color: rgb(113 113 122);
        font-size: 1rem;
        font-weight: 300;
        line-height: 1.5;
        margin: 0;
    }

    .project-intro__description :global(span) {
        color: rgb(63 63 70);
        font-weight: 400;
    }

    .project-intro__stack {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        list-style: none;
        margin: 0;
        padding: 0;
    }

    .project-intro__stack li {
        background: #e8e5e8;
        border-radius: 9999px;
        color: rgb(63 63 70);
        font-size: 0.75rem;
        font-weight: 300;
        line-height: 1;
        padding: 0.45rem 0.7rem;
    }

    .project-intro__actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        margin-top: 0.25rem;
    }

    .project-intro__button {
        align-items: center;
        color: var(--color-coffee-300);
        gap: 0.75rem;
        isolation: isolate;
        position: relative;
        text-decoration: none;
    }

    .project-intro__button::before {
        background: var(--project-button-bg);
        border: 1px solid var(--project-button-border);
        border-radius: inherit;
        content: "";
        inset: 0;
        position: absolute;
        transform: scale(1);
        transition: transform 520ms
            var(--wui-ease-standard, cubic-bezier(0.2, 0, 0, 1));
        z-index: -1;
    }

    .project-intro__button:hover::before,
    .project-intro__button:focus-visible::before {
        transform: scale(0.95);
    }

    .project-intro__button:focus-visible {
        outline: 2px solid var(--color-blue-500);
        outline-offset: 3px;
    }

    .project-intro__button--site {
        --project-button-bg: #e8e5e8;
        --project-button-border: transparent;
    }

    .project-intro__button--details {
        --project-button-bg: transparent;
        --project-button-border: rgba(113, 113, 122, 0.22);
    }

    .project-intro__site-icon {
        flex: 0 0 auto;
    }

    @media (prefers-reduced-motion: reduce) {
        .project-intro__icon {
            filter: none !important;
            opacity: 1 !important;
            transform: none !important;
            transition: none;
        }

        .project-intro__button::before {
            transition: none;
        }
    }
</style>
