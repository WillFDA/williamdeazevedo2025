---
import CalButton from "@/components/CalButton.astro";
import CapabilitiesStrip from "@/components/CapabilitiesStrip.astro";
import DiagnosticCta from "@/components/DiagnosticCta.astro";
import FaqSection from "@/components/FaqSection.astro";
import Marquee from "@/components/Marquee.astro";
import RelatedServicesBento from "@/components/RelatedServicesBento.astro";
import ServiceDiagnosticToggle from "@/components/ServiceDiagnosticToggle.astro";
import ServiceTimelineScroll from "@/components/ServiceTimelineScroll.astro";
import ProjectListItem from "@/components/realisations/ProjectListItem.astro";
import FadeReveal from "@/components/animations/FadeReveal.astro";
import { getProjectById } from "@/data/projects";
import { type Service, getServiceBySlug } from "@/data/services";
import Layout from "@/layout/Layout.astro";

interface Props {
    service: Service;
    canonicalPath?: string;
}

const { service, canonicalPath = service.rootPath ?? `/services/${service.slug}` } =
    Astro.props;
const relatedServices = service.relatedServices
    .map((slug) => getServiceBySlug(slug))
    .filter((item): item is Service => item !== undefined);
const project = getProjectById(service.proof.projectId);
const siteUrl = Astro.site ?? new URL(Astro.url.origin);
const canonicalUrl = new URL(canonicalPath, siteUrl);
type HeroTitlePart = {
    pill?: boolean;
    text: string;
};

const appendTitleWords = (parts: HeroTitlePart[], value: string) => {
    value
        .trim()
        .split(/\s+/)
        .filter(Boolean)
        .forEach((word) => parts.push({ text: word }));
};

const buildHeroTitleParts = (title: string, pillPhrases: string[]) => {
    const parts: HeroTitlePart[] = [];
    let remainingTitle = title;

    while (remainingTitle.trim()) {
        const lowerTitle = remainingTitle.toLowerCase();
        const match = pillPhrases
            .map((phrase) => ({
                index: lowerTitle.indexOf(phrase.toLowerCase()),
                phrase,
            }))
            .filter((item) => item.index >= 0)
            .toSorted((first, second) => first.index - second.index)[0];

        if (!match) {
            appendTitleWords(parts, remainingTitle);
            break;
        }

        appendTitleWords(parts, remainingTitle.slice(0, match.index));
        parts.push({
            pill: true,
            text: remainingTitle.slice(
                match.index,
                match.index + match.phrase.length,
            ),
        });
        remainingTitle = remainingTitle.slice(match.index + match.phrase.length);
    }

    return parts;
};

const heroTitleParts = buildHeroTitleParts(
    service.h1,
    service.heroPillPhrases ?? [],
);
const finalCtaTitleParts = [
    { text: "Vous" },
    { text: "voulez" },
    { text: "vérifier" },
    { text: "si" },
    { text: "ce" },
    { text: "service" },
    { text: "répond" },
    { text: "au" },
    { pill: true, text: "vrai problème ?" },
];
const methodIconCycle = [
    "search",
    "ux",
    "refonte",
    "performance",
    "deploy",
] as const;
const methodToneCycle = ["sky", "violet", "cyan", "green", "orange"] as const;
const methodTitles = [
    "Comprendre",
    "Structurer",
    "Concevoir",
    "Développer",
    "Mettre en ligne",
    "Transmettre",
] as const;
const methodSectionTitle = "Une méthode pour éviter le flou";
const methodSectionDescription =
    "Un cadre clair évite les allers-retours dispersés et garde les décisions reliées à un objectif : mieux faire comprendre, rassurer et déclencher la bonne action.";
const methodSectionLinkLabel = "Comprendre ma méthode";
const methodTimelineItems = service.steps.map((step, index) => ({
    description: step,
    icon: methodIconCycle[index % methodIconCycle.length],
    title: methodTitles[index] ?? `Étape ${index + 1}`,
    tone: methodToneCycle[index % methodToneCycle.length],
}));

const serviceJsonLd = {
    "@context": "https://schema.org",
    "@type": "Service",
    name: service.title,
    serviceType: service.serviceType,
    description: service.description,
    areaServed: "France",
    url: canonicalUrl.href,
    provider: {
        "@type": "Person",
        name: "William De Azevedo",
        url: new URL("/", siteUrl).href,
    },
};

const faqJsonLd = {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: service.faq.map((item) => ({
        "@type": "Question",
        name: item.question,
        acceptedAnswer: {
            "@type": "Answer",
            text: item.answer,
        },
    })),
};

const breadcrumbJsonLd = {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
        {
            "@type": "ListItem",
            position: 1,
            name: "Accueil",
            item: new URL("/", siteUrl).href,
        },
        {
            "@type": "ListItem",
            position: 2,
            name: "Services",
            item: new URL("/services", siteUrl).href,
        },
        {
            "@type": "ListItem",
            position: 3,
            name: service.title,
            item: canonicalUrl.href,
        },
    ],
};
---

<Layout
    title={service.seoTitle}
    description={service.description}
    canonicalPath={canonicalPath}
>
    <script
        type="application/ld+json"
        is:inline
        set:html={JSON.stringify(serviceJsonLd)}
    />
    <script
        type="application/ld+json"
        is:inline
        set:html={JSON.stringify(faqJsonLd)}
    />
    <script
        type="application/ld+json"
        is:inline
        set:html={JSON.stringify(breadcrumbJsonLd)}
    />

    <div
        class:list={[
            "mx-auto flex w-full max-w-5xl flex-col gap-12 px-4",
            "pt-7 pb-12 md:pt-10 md:pb-16",
        ]}
    >
        <FadeReveal delay={0.1}>
            <section class="mx-auto flex w-full min-w-0 max-w-5xl flex-col items-center gap-6 text-center">
                <h1
                    class="page-heading flex w-full max-w-sm flex-wrap justify-center gap-x-[0.18em] px-2 sm:max-w-4xl md:max-w-5xl"
                    data-service-animated-title
                >
                    {
                        heroTitleParts.map((part, index) => (
                            <span
                                class:list={[part.pill && "title-pill"]}
                                style={`--animated-word-index: ${index}`}
                                data-service-animated-title-word
                            >
                                {part.text}
                            </span>
                        ))
                    }
                </h1>
                <p class="page-subheading max-w-sm sm:max-w-lg">
                    {service.intro}
                </p>
                <div
                    class:list={[
                        "flex flex-col items-center gap-3 sm:flex-row",
                        "mt-3 sm:mt-4",
                    ]}
                >
                    <CalButton
                        class="rounded-xl text-base font-normal"
                        label="Échanger sur ce besoin"
                        location={`service-${service.slug}-hero`}
                    />
                    {
                        project && (
                            <a
                                class="flex min-h-14 items-center justify-center rounded-xl px-8 py-3 text-base font-normal text-gray-900 ring-1 ring-gray-200 transition-colors hover:text-blue-500 focus-visible:text-blue-500 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-blue-500"
                                href={`/realisations/${project.id}`}
                            >
                                Voir une réalisation
                            </a>
                        )
                    }
                </div>
                {
                    service.capabilities && (
                        <CapabilitiesStrip
                            capabilities={service.capabilities}
                            class="mt-8 sm:mt-10"
                            compact
                            title="Ce que ce service peut corriger"
                        />
                    )
                }
                {
                    service.diagnostic && (
                        <ServiceDiagnosticToggle
                            afterItems={service.diagnostic.afterItems}
                            afterLabel={service.diagnostic.afterLabel}
                            beforeItems={service.diagnostic.beforeItems}
                            beforeLabel={service.diagnostic.beforeLabel}
                            description={service.diagnostic.description}
                            title={service.diagnostic.title}
                        />
                    )
                }
            </section>
        </FadeReveal>

        {
            service.slug === "developpeur-web-freelance" && (
                <FadeReveal delay={0.18}>
                    <Marquee />
                </FadeReveal>
            )
        }

        {
            !service.diagnostic && (
                <section class="grid gap-6 md:grid-cols-[0.95fr_1.05fr] md:items-start md:gap-12">
                    <div class="flex flex-col gap-4">
                        <h2 class="section-heading text-left">
                            {service.problem.title}
                        </h2>
                        <p class="text-base font-normal leading-relaxed text-gray-600">
                            Avant de parler design ou technologie, il faut
                            comprendre ce qui crée du doute et rend la décision
                            plus difficile pour votre visiteur.
                        </p>
                    </div>
                    <ul class="grid gap-3">
                        {service.problem.items.map((item) => (
                            <li class="rounded-xl bg-gray-100 px-4 py-3 text-base font-normal leading-relaxed text-gray-800 ring-1 ring-gray-200">
                                {item}
                            </li>
                        ))}
                    </ul>
                </section>
            )
        }

        {
            !service.diagnostic && (
                <section class="grid gap-4 md:grid-cols-2">
                    <article class="rounded-xl bg-snow-50 p-6 ring-1 ring-snow-600">
                        <h2 class="mb-4 text-2xl font-normal leading-tight text-gray-900">
                            Cette prestation est faite pour vous si...
                        </h2>
                        <ul class="flex flex-col gap-3">
                            {service.fit.map((item) => (
                                <li class="text-base font-normal leading-relaxed text-gray-600">
                                    {item}
                                </li>
                            ))}
                        </ul>
                    </article>
                    <article class="rounded-xl bg-snow-50 p-6 ring-1 ring-snow-600">
                        <h2 class="mb-4 text-2xl font-normal leading-tight text-gray-900">
                            Ce que je prends en charge
                        </h2>
                        <ul class="flex flex-col gap-3">
                            {service.included.map((item) => (
                                <li class="text-base font-normal leading-relaxed text-gray-600">
                                    {item}
                                </li>
                            ))}
                        </ul>
                    </article>
                </section>
            )
        }

        {
            project && (
                <section>
                    <ProjectListItem
                        project={project}
                        description={service.proof.text}
                        detailsLabel="Lire l'étude de cas"
                        siteLabel="Voir le site"
                    />
                </section>
            )
        }

        <section class="grid gap-4 rounded-xl bg-gray-100 p-6 ring-1 ring-gray-200 md:grid-cols-[1fr_auto] md:items-center md:gap-6">
            <div class="flex flex-col gap-4">
                <h2 class="text-2xl font-normal leading-tight text-gray-900">
                    Budget et périmètre
                </h2>
                <p class="text-base font-normal leading-relaxed text-gray-600">
                    Le prix dépend surtout du nombre de freins à lever : contenu,
                    design, performance, accessibilité, fonctionnalités et
                    autonomie attendue après la mise en ligne.
                </p>
            </div>
            <a
                class="flex min-h-14 items-center justify-center rounded-xl bg-snow-50 px-8 py-3 text-base font-normal text-gray-900 ring-1 ring-snow-600 transition-colors hover:text-blue-500 focus-visible:text-blue-500 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-blue-500"
                href="/tarif-creation-site-internet"
            >
                Comprendre le budget
            </a>
        </section>

        {
            service.formats && (
                <section class="flex flex-col gap-6">
                    <div class="flex max-w-lg flex-col gap-4">
                        <h2 class="section-heading text-left">
                            Un format adapté au besoin réel
                        </h2>
                        <p class="text-base font-normal leading-relaxed text-gray-600">
                            Le bon périmètre dépend de votre offre, de vos contenus et
                            du niveau d'autonomie attendu après la mise en ligne.
                        </p>
                    </div>
                    <div class="grid gap-4 md:grid-cols-2">
                        {service.formats.map((format) => (
                            <article class="rounded-xl bg-gray-100 p-5 ring-1 ring-gray-200">
                                <h3 class="mb-2 text-lg font-normal leading-tight text-gray-900">
                                    {format.title}
                                </h3>
                                <p class="text-base font-normal leading-relaxed text-gray-600">
                                    {format.description}
                                </p>
                            </article>
                        ))}
                    </div>
                </section>
            )
        }

        <section class="mx-auto mt-16 flex w-full max-w-5xl flex-col items-center gap-4 text-center sm:mt-20">
            <h2 class="section-heading">
                {methodSectionTitle}
            </h2>
            <p class="section-subheading">
                {methodSectionDescription}
            </p>
            <a
                class="w-fit text-base font-normal text-gray-900 underline decoration-gray-300 underline-offset-4 transition-colors hover:text-blue-500 focus-visible:text-blue-500 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-blue-500"
                href="/methode"
            >
                {methodSectionLinkLabel}
            </a>
        </section>

        <ServiceTimelineScroll
            class="mt-12 sm:mt-14"
            description={methodSectionDescription}
            id={`${service.slug}-method-timeline`}
            items={methodTimelineItems}
            layout="center"
            showHeader={false}
            title={methodSectionTitle}
        />

        <FaqSection
            id={`${service.slug}-faq`}
            items={service.faq}
            title="Questions fréquentes"
            description="Les détails dépendent toujours du projet, mais ces réponses donnent un premier cadre avant l'appel découverte."
            padded={false}
            showCta={false}
        />

        <RelatedServicesBento services={relatedServices} />

        <DiagnosticCta
            buttonLabel="Vérifier le bon service"
            class="relative left-1/2 w-[calc(100dvw-1rem)] -translate-x-1/2 sm:w-[calc(100dvw-2rem)]"
            copy="On regarde votre situation, ce qui bloque aujourd'hui et la prochaine étape réaliste avant de parler solution."
            location={`service-${service.slug}-final`}
            titleParts={finalCtaTitleParts}
        />
    </div>
</Layout>

<script>
    const revealServiceTitle = (title: HTMLElement) => {
        if (title.dataset.animatedTitleReady === "true") return;
        title.dataset.animatedTitleReady = "true";
    };

    const initServiceTitle = () => {
        const title = document.querySelector<HTMLElement>(
            "[data-service-animated-title]",
        );

        if (!title || title.dataset.animatedTitleReady) return;

        if (
            window.matchMedia("(prefers-reduced-motion: reduce)").matches ||
            !("IntersectionObserver" in window)
        ) {
            revealServiceTitle(title);
            return;
        }

        const observer = new IntersectionObserver(
            ([entry]) => {
                if (!entry?.isIntersecting) return;
                revealServiceTitle(title);
                observer.disconnect();
            },
            { rootMargin: "0px 0px -10% 0px", threshold: 0.2 },
        );

        observer.observe(title);
    };

    initServiceTitle();

    document.addEventListener("astro:page-load", initServiceTitle);
</script>

<style>
    [data-service-animated-title-word] {
        display: inline-block;
    }

    [data-service-animated-title]:not([data-animated-title-ready="true"])
        [data-service-animated-title-word] {
        filter: blur(10px);
        opacity: 0;
        transform: translateY(-0.65em);
    }

    [data-service-animated-title][data-animated-title-ready="true"]
        [data-service-animated-title-word] {
        animation: service-title-word 1100ms cubic-bezier(0.16, 1, 0.3, 1)
            backwards;
        animation-delay: calc(var(--animated-word-index, 0) * 65ms);
    }

    @keyframes service-title-word {
        from {
            filter: blur(10px);
            opacity: 0;
            transform: translateY(-0.65em);
        }

        to {
            filter: none;
            opacity: 1;
            transform: none;
        }
    }

    @media (scripting: none), (prefers-reduced-motion: reduce) {
        [data-service-animated-title] [data-service-animated-title-word] {
            animation: none;
            filter: none;
            opacity: 1;
            transform: none;
        }
    }
</style>
