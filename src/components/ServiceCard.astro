---
interface Props {
    title: string;
    items: string[];
}

const { title, items } = Astro.props;
---

<article
    class="flex min-h-[164px] flex-col justify-start rounded-xl bg-gray-100 px-6 py-5 text-gray-900 ring-1 ring-gray-200/70 shadow-[inset_0_1px_0_rgba(255,255,255,0.55)]"
>
    <h3 class="mb-3 text-center text-lg font-medium leading-tight md:text-xl">
        {title}
    </h3>
    <ul class="flex flex-col gap-1">
        {
            items.map((item) => (
                <li class="flex items-start gap-3 text-sm leading-[1.85] text-gray-800">
                    <span class="mt-[0.55em] size-3 shrink-0 bg-gray-900" />
                    <span>{item}</span>
                </li>
            ))
        }
    </ul>
</article>
