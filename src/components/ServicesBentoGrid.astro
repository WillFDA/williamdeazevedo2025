---
import FadeReveal from "./animations/FadeReveal.astro";
import BentoVisualArtisan from "./bento/BentoVisualArtisan.astro";
import BentoVisualFrontend from "./bento/BentoVisualFrontend.astro";
import BentoVisualProfessional from "./bento/BentoVisualProfessional.astro";
import BentoVisualRefonte from "./bento/BentoVisualRefonte.astro";
import BentoVisualSeo from "./bento/BentoVisualSeo.astro";
import BentoVisualVitrine from "./bento/BentoVisualVitrine.astro";
import ArrowUpRight from "./icons/nucleo/arrow-up-right-fill.svg";
import WaveIcon from "./ui/WaveIcon.astro";

type BentoIcon =
    | "artisan"
    | "code"
    | "deploy"
    | "professional"
    | "refonte"
    | "site";

type BentoItem = {
    description: string;
    href: string;
    icon: BentoIcon;
    layout: "feature" | "small" | "support" | "wide";
    linkLabel: string;
    title: string;
};

const items: BentoItem[] = [
    {
        description:
            "Du cadrage à la mise en ligne, je construis une présence claire, rapide et crédible, avec un parcours pensé pour déclencher le contact.",
        href: "/creation-site-vitrine",
        icon: "site",
        layout: "feature",
        linkLabel: "Découvrir création de site vitrine",
        title: "Création de site vitrine",
    },
    {
        description:
            "Je pars de l'existant : ce qui rassure, ce qui bloque, ce qui ralentit. Puis on reconstruit une expérience plus lisible et plus crédible.",
        href: "/refonte-site-internet",
        icon: "refonte",
        layout: "wide",
        linkLabel: "Découvrir refonte de site internet",
        title: "Refonte de site internet",
    },
    {
        description:
            "J'intègre des maquettes, corrige les états d'interface, le responsive, l'accessibilité et la performance sans casser votre produit.",
        href: "/services/developpeur-web-freelance",
        icon: "code",
        layout: "small",
        linkLabel: "Découvrir renfort front-end",
        title: "Renfort front-end",
    },
    {
        description:
            "Structure, vitesse, métadonnées, formulaires et mise en ligne : je pose une base propre pour être trouvé, compris et contacté.",
        href: "/tarif-creation-site-internet",
        icon: "deploy",
        layout: "small",
        linkLabel: "Découvrir SEO et mise en ligne",
        title: "SEO & mise en ligne",
    },
    {
        description:
            "Un site local qui met en avant vos prestations, vos réalisations, votre zone d'intervention et la demande de devis.",
        href: "/creation-site-internet-artisan",
        icon: "artisan",
        layout: "support",
        linkLabel: "Découvrir création de site internet artisan",
        title: "Site internet artisan",
    },
    {
        description:
            "Une présence plus complète pour structurer vos services, vos preuves, vos pages clés et une base technique durable.",
        href: "/creation-site-internet-professionnel",
        icon: "professional",
        layout: "support",
        linkLabel: "Découvrir création de site internet professionnel",
        title: "Site internet professionnel",
    },
];

const featureItem = items[0];
const secondaryItems = items.slice(1, 4);
const wideItem = secondaryItems[0];
const smallItems = secondaryItems.slice(1);
const supportItems = items.slice(4);
---

<section
    class="mx-auto w-full max-w-7xl px-4 sm:px-8"
    aria-labelledby="services-bento-title"
    data-services-bento
>
    <h2 id="services-bento-title" class="sr-only">
        Ce que je peux prendre en charge
    </h2>

    <div
        class="mx-auto mt-8 grid max-w-7xl items-stretch gap-5 md:mt-10 lg:grid-cols-[0.82fr_1.18fr]"
    >
        <FadeReveal class="flex" delay={0.12}>
            <a
                class="group relative flex w-full flex-col overflow-hidden rounded-[26px] border-[0.5px] border-[#ECEDF1] bg-white text-gray-900 no-underline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-blue-500 lg:min-h-[640px]"
                href={featureItem.href}
                aria-label={featureItem.linkLabel}
            >
                <div
                    class="relative h-[26rem] shrink-0 overflow-hidden rounded-3xl bg-[#F6F8FB] transition-all duration-300 ease-out m-1 lg:h-[27.5rem]"
                >
                    <BentoVisualVitrine />
                </div>

                <div
                    class="relative z-10 flex shrink-0 flex-col px-6 pt-6 pb-6 sm:px-7"
                >
                    <h3
                        class="inline-flex items-start gap-2 text-xl font-normal leading-tight text-gray-900"
                    >
                        {featureItem.title}
                        <WaveIcon
                            class="mt-1.5 text-gray-400 transition-colors duration-300 ease-out group-hover:text-gray-900 group-focus-visible:text-gray-900"
                            direction="up-right"
                            style="--wui-wave-icon-size: 0.75rem;"
                            trigger="parent"
                        >
                            <ArrowUpRight class="size-full" aria-hidden="true" />
                        </WaveIcon>
                    </h3>
                    <p
                        class="mt-4 max-w-md text-sm font-light leading-relaxed text-gray-600"
                    >
                        {featureItem.description}
                    </p>
                </div>
            </a>
        </FadeReveal>

        <div class="grid gap-5">
            <FadeReveal class="flex" delay={0.2}>
                <a
                    class="group relative flex w-full flex-col overflow-hidden rounded-[26px] border-[0.5px] border-[#ECEDF1] bg-white text-gray-900 no-underline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-blue-500 lg:min-h-[300px]"
                    href={wideItem.href}
                    aria-label={wideItem.linkLabel}
                >
                    <div
                        class="relative h-32 shrink-0 overflow-hidden rounded-3xl bg-[#F6F8FB] transition-all duration-300 ease-out m-1 sm:h-36"
                    >
                        <BentoVisualRefonte />
                    </div>

                    <div
                        class="relative z-10 flex flex-1 flex-col px-6 pt-6 pb-6 sm:px-7"
                    >
                        <h3 class="inline-flex items-start gap-2 text-xl font-normal leading-tight text-gray-900">
                            {wideItem.title}
                            <WaveIcon
                                class="mt-1.5 text-gray-400 transition-colors duration-300 ease-out group-hover:text-gray-900 group-focus-visible:text-gray-900"
                                direction="up-right"
                                style="--wui-wave-icon-size: 0.75rem;"
                                trigger="parent"
                            >
                                <ArrowUpRight
                                    class="size-full"
                                    aria-hidden="true"
                                />
                            </WaveIcon>
                        </h3>
                        <p
                            class="mt-4 max-w-lg text-sm font-light leading-relaxed text-gray-600"
                        >
                            {wideItem.description}
                        </p>
                    </div>
                </a>
            </FadeReveal>

            <div class="grid gap-5 md:grid-cols-2">
                {
                    smallItems.map((item, index) => (
                        <FadeReveal class="flex" delay={0.28 + index * 0.08}>
                            <a
                                class="group relative flex w-full flex-col overflow-hidden rounded-[26px] border-[0.5px] border-[#ECEDF1] bg-white text-gray-900 no-underline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-blue-500 lg:min-h-[320px]"
                                href={item.href}
                                aria-label={item.linkLabel}
                            >
                                <div class="relative h-40 shrink-0 overflow-hidden rounded-3xl bg-[#F6F8FB] transition-all duration-300 ease-out m-1">
                                    {item.icon === "code" && (
                                        <BentoVisualFrontend />
                                    )}
                                    {item.icon === "deploy" && (
                                        <BentoVisualSeo />
                                    )}
                                </div>

                                <div class="relative z-10 flex flex-1 flex-col px-6 pt-6 pb-6 sm:px-7">
                                    <h3 class="inline-flex items-start gap-2 text-xl font-normal leading-tight text-gray-900">
                                        {item.title}
                                        <WaveIcon
                                            class="mt-1.5 text-gray-400 transition-colors duration-300 ease-out group-hover:text-gray-900 group-focus-visible:text-gray-900"
                                            direction="up-right"
                                            style="--wui-wave-icon-size: 0.75rem;"
                                            trigger="parent"
                                        >
                                            <ArrowUpRight
                                                class="size-full"
                                                aria-hidden="true"
                                            />
                                        </WaveIcon>
                                    </h3>
                                    <p class="mt-4 max-w-lg text-sm font-light leading-relaxed text-gray-600">
                                        {item.description}
                                    </p>
                                </div>
                            </a>
                        </FadeReveal>
                    ))
                }
            </div>
        </div>
    </div>

    <div class="mx-auto mt-5 grid max-w-7xl gap-5 lg:grid-cols-2">
        {
            supportItems.map((item, index) => (
                <FadeReveal class="flex" delay={0.36 + index * 0.08}>
                    <a
                        class="group relative flex w-full flex-col overflow-hidden rounded-[26px] border-[0.5px] border-[#ECEDF1] bg-white text-gray-900 no-underline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-blue-500 lg:min-h-[370px]"
                        href={item.href}
                        aria-label={item.linkLabel}
                    >
                        <div class="relative h-56 shrink-0 overflow-hidden rounded-3xl bg-[#F6F8FB] transition-all duration-300 ease-out m-1">
                            {item.icon === "artisan" && (
                                <BentoVisualArtisan />
                            )}
                            {item.icon === "professional" && (
                                <BentoVisualProfessional />
                            )}
                        </div>

                        <div class="relative z-10 flex flex-1 flex-col px-6 pt-6 pb-6 sm:px-7">
                            <h3 class="inline-flex items-start gap-2 text-xl font-normal leading-tight text-gray-900">
                                {item.title}
                                <WaveIcon
                                    class="mt-1.5 text-gray-400 transition-colors duration-300 ease-out group-hover:text-gray-900 group-focus-visible:text-gray-900"
                                    direction="up-right"
                                    style="--wui-wave-icon-size: 0.75rem;"
                                    trigger="parent"
                                >
                                    <ArrowUpRight
                                        class="size-full"
                                        aria-hidden="true"
                                    />
                                </WaveIcon>
                            </h3>
                            <p class="mt-4 max-w-xl text-sm font-light leading-relaxed text-gray-600">
                                {item.description}
                            </p>
                        </div>
                    </a>
                </FadeReveal>
            ))
        }
    </div>
</section>

<script>
    import { animateArtisan } from "@/scripts/animations/bento/artisan";
    import { animateFrontend } from "@/scripts/animations/bento/frontend";
    import { animateProfessional } from "@/scripts/animations/bento/professional";
    import { animateRefonte } from "@/scripts/animations/bento/refonte";
    import { animateSeo } from "@/scripts/animations/bento/seo";
    import type { BentoPlayer } from "@/scripts/animations/bento/shared";
    import { animateVitrine } from "@/scripts/animations/bento/vitrine";

    const visualAnimators: Record<
        string,
        (root: HTMLElement, players: BentoPlayer[]) => void
    > = {
        artisan: animateArtisan,
        frontend: animateFrontend,
        professional: animateProfessional,
        refonte: animateRefonte,
        seo: animateSeo,
        vitrine: animateVitrine,
    };

    const activeBentoControllers = new WeakMap<HTMLElement, () => void>();
    const prefersReducedMotion = () =>
        window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    const cleanupPlayer = (player: BentoPlayer) => {
        if (player.revert) {
            player.revert();
            return;
        }

        player.cancel?.();
    };

    const cleanupServicesBentoAnimations = () => {
        document
            .querySelectorAll<HTMLElement>("[data-services-bento]")
            .forEach((bento) => {
                activeBentoControllers.get(bento)?.();
                activeBentoControllers.delete(bento);
                delete bento.dataset.bentoAnimationsReady;
            });
    };

    const initServicesBentoAnimations = () => {
        document
            .querySelectorAll<HTMLElement>("[data-services-bento]")
            .forEach((bento) => {
                if (bento.dataset.bentoAnimationsReady === "true") return;

                const players: BentoPlayer[] = [];

                if (!prefersReducedMotion()) {
                    for (const [name, animator] of Object.entries(
                        visualAnimators,
                    )) {
                        const visual = bento.querySelector<HTMLElement>(
                            `[data-bento-visual="${name}"]`,
                        );
                        if (visual) animator(visual, players);
                    }
                }

                let observer: IntersectionObserver | undefined;
                if ("IntersectionObserver" in window && players.length) {
                    observer = new IntersectionObserver(
                        ([entry]) => {
                            const play = entry?.isIntersecting ?? true;
                            players.forEach((player) => {
                                if (play) player.play?.();
                                else player.pause?.();
                            });
                        },
                        { rootMargin: "96px 0px" },
                    );
                    observer.observe(bento);
                }

                bento.dataset.bentoAnimationsReady = "true";
                activeBentoControllers.set(bento, () => {
                    observer?.disconnect();
                    players.forEach(cleanupPlayer);
                });
            });
    };

    const servicesBentoWindow = window as Window & {
        __wuiServicesBentoReady?: boolean;
    };

    initServicesBentoAnimations();

    if (!servicesBentoWindow.__wuiServicesBentoReady) {
        servicesBentoWindow.__wuiServicesBentoReady = true;
        document.addEventListener(
            "astro:before-swap",
            cleanupServicesBentoAnimations,
        );
        document.addEventListener(
            "astro:page-load",
            initServicesBentoAnimations,
        );

        // Les scènes à trajectoires mesurées (refonte, professionnel)
        // se recalent après un changement de taille de fenêtre.
        let resizeTimer: ReturnType<typeof setTimeout> | undefined;
        window.addEventListener("resize", () => {
            if (resizeTimer) clearTimeout(resizeTimer);
            resizeTimer = setTimeout(() => {
                cleanupServicesBentoAnimations();
                initServicesBentoAnimations();
            }, 320);
        });
    }
</script>
