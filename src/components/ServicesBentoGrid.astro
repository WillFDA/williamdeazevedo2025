---
import { servicesOverviewBentoItems } from "@/data/serviceBento";
import ServiceBentoCard from "./bento/ServiceBentoCard.astro";
import ServicesBentoAnimations from "./bento/ServicesBentoAnimations.astro";

const items = servicesOverviewBentoItems;
const featureItem = items[0];
const secondaryItems = items.slice(1, 4);
const wideItem = secondaryItems[0];
const smallItems = secondaryItems.slice(1);
const supportItems = items.slice(4);
---

<section
    class="mx-auto w-full max-w-7xl px-4 sm:px-8"
    aria-labelledby="services-bento-title"
    data-services-bento
>
    <h2 id="services-bento-title" class="sr-only">
        Ce que je peux prendre en charge
    </h2>

    <div
        class="mx-auto mt-8 grid max-w-7xl items-stretch gap-5 md:mt-10 lg:grid-cols-[0.82fr_1.18fr]"
    >
        <ServiceBentoCard
            delay={0.12}
            item={featureItem}
            variant={featureItem.variant}
        />

        <div class="grid gap-5">
            <ServiceBentoCard
                delay={0.2}
                item={wideItem}
                variant={wideItem.variant}
            />

            <div class="grid gap-5 md:grid-cols-2">
                {
                    smallItems.map((item, index) => (
                        <ServiceBentoCard
                            delay={0.28 + index * 0.08}
                            item={item}
                            variant={item.variant}
                        />
                    ))
                }
            </div>
        </div>
    </div>

    <div class="mx-auto mt-5 grid max-w-7xl gap-5 lg:grid-cols-2">
        {
            supportItems.map((item, index) => (
                <ServiceBentoCard
                    delay={0.36 + index * 0.08}
                    item={item}
                    variant={item.variant}
                />
            ))
        }
    </div>
    <ServicesBentoAnimations />
</section>
