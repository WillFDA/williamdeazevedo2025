---
import { services } from "@/data/services";
import FadeReveal from "./animations/FadeReveal.astro";
import CodeEditor from "./icons/nucleo/code-editor-fill.svg";
import WindowPaintbrush from "./icons/nucleo/window-paintbrush-fill.svg";
import WindowPointer from "./icons/nucleo/window-pointer-fill.svg";

const serviceCardIcons = {
    "creation-site-vitrine": { icon: "window", tint: "#4169e1" },
    "developpeur-web-freelance": { icon: "code", tint: "#a090ee" },
    "refonte-site-internet": { icon: "paintbrush", tint: "#8ed2ec" },
} as const;
---

<section class="grid gap-4 md:grid-cols-3" aria-label="Situations fréquentes">
    {
        services.map((service, index) => {
            const icon =
                serviceCardIcons[service.slug as keyof typeof serviceCardIcons];

            return (
                <FadeReveal delay={0.14 + index * 0.08}>
                    <article class="flex h-full flex-col gap-4 rounded-xl bg-gray-100 p-5">
                        <div class="flex flex-col gap-3">
                            <span
                                class="flex size-11 items-center justify-center rounded-xl text-snow-50 shadow-[inset_0_1px_0_rgba(255,255,255,0.32),0_14px_28px_-20px_rgba(34,42,55,0.42)]"
                                style={`background-color: ${icon.tint}`}
                                aria-hidden="true"
                            >
                                {icon.icon === "window" && <WindowPointer class="size-5" />}
                                {icon.icon === "paintbrush" && <WindowPaintbrush class="size-5" />}
                                {icon.icon === "code" && <CodeEditor class="size-5" />}
                            </span>
                            <h2 class="text-xl font-medium leading-tight text-gray-900">
                                {service.title}
                            </h2>
                            <p class="text-base font-normal leading-relaxed text-gray-600">
                                {service.intro}
                            </p>
                        </div>
                        <a
                            class="group relative mt-auto w-fit text-base font-normal text-gray-900 no-underline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-blue-500"
                            href={`/services/${service.slug}`}
                        >
                            Découvrir {service.navLabel.toLowerCase()}
                            <span
                                class="absolute bottom-0 left-0 h-px w-full origin-left scale-x-0 bg-gray-900 transition-transform duration-300 ease-out group-hover:scale-x-100 group-focus-visible:scale-x-100"
                                aria-hidden="true"></span>
                        </a>
                    </article>
                </FadeReveal>
            );
        })
    }
</section>
