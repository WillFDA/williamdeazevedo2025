---
import type { HTMLAttributes } from "astro/types";

type StyleValue = HTMLAttributes<"div">["style"];
type Props = Omit<HTMLAttributes<"div">, "class"> & {
    animate?: boolean;
    class?: string;
    className?: string;
    delay?: number | string;
};

const joinClasses = (...classes: Array<string | undefined>) =>
    classes.filter(Boolean).join(" ");
const formatDelay = (delay: number | string) =>
    typeof delay === "number" ? `${delay}s` : delay;
const buildStyle = (
    delay: number | string,
    style: StyleValue,
    shouldAnimate: boolean,
) => {
    if (!shouldAnimate) return style;
    const baseStyle = { "--fade-delay": formatDelay(delay) };
    if (typeof style === "string") {
        return `--fade-delay: ${formatDelay(delay)}; ${style}`;
    }
    return { ...baseStyle, ...style };
};

const {
    animate = true,
    class: classAttribute,
    className,
    delay = 0,
    style,
    ...restProps
} = Astro.props as Props;
---

<div
    {...restProps}
    class={joinClasses(animate ? "fade-reveal" : undefined, className, classAttribute)}
    style={buildStyle(delay, style, animate)}
>
    <slot />
</div>

<style>
    .fade-reveal {
        animation: fade-reveal 650ms cubic-bezier(0.2, 0, 0, 1)
            var(--fade-delay, 0s) both;
    }

    @keyframes fade-reveal {
        from {
            filter: blur(2px);
            opacity: 0;
            transform: translate3d(0, 1rem, 0);
        }
        to {
            filter: blur(0);
            opacity: 1;
            transform: translate3d(0, 0, 0);
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .fade-reveal {
            animation: none;
            filter: none;
            opacity: 1;
            transform: none;
        }
    }
</style>
