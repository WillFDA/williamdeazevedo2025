---
import type { HTMLAttributes } from "astro/types";

type StyleValue = HTMLAttributes<"div">["style"];
type Props = Omit<HTMLAttributes<"div">, "class"> & {
    animate?: boolean;
    class?: string;
    className?: string;
    delay?: number | string;
};

const joinClasses = (...classes: Array<string | undefined>) =>
    classes.filter(Boolean).join(" ");
const formatDelay = (delay: number | string) =>
    typeof delay === "number" ? `${delay}s` : delay;
const buildStyle = (
    delay: number | string,
    style: StyleValue,
    shouldAnimate: boolean,
) => {
    if (!shouldAnimate) return style;
    const baseStyle = { "--fade-delay": formatDelay(delay) };
    if (typeof style === "string") {
        return `--fade-delay: ${formatDelay(delay)}; ${style}`;
    }
    return { ...baseStyle, ...style };
};

const {
    animate = true,
    class: classAttribute,
    className,
    delay = 0,
    style,
    ...restProps
} = Astro.props as Props;
---

<div
    {...restProps}
    class={joinClasses(
        animate ? "fade-reveal-on-scroll is-reveal-ready" : undefined,
        className,
        classAttribute,
    )}
    data-reveal-on-scroll={animate ? "" : undefined}
    style={buildStyle(delay, style, animate)}
>
    <slot />
</div>

<style>
    .fade-reveal-on-scroll {
        transition:
            opacity 650ms cubic-bezier(0.2, 0, 0, 1),
            transform 650ms cubic-bezier(0.2, 0, 0, 1),
            filter 650ms cubic-bezier(0.2, 0, 0, 1);
        transition-delay: var(--fade-delay, 0s);
    }

    .fade-reveal-on-scroll.is-reveal-ready {
        filter: blur(2px);
        opacity: 0;
        transform: translate3d(0, 1rem, 0);
        will-change: opacity, transform, filter;
    }

    .fade-reveal-on-scroll.is-reveal-ready.is-visible {
        filter: none;
        opacity: 1;
        transform: none;
        will-change: auto;
    }

    @media (scripting: none), (prefers-reduced-motion: reduce) {
        .fade-reveal-on-scroll,
        .fade-reveal-on-scroll.is-reveal-ready,
        .fade-reveal-on-scroll.is-reveal-ready.is-visible {
            filter: none;
            opacity: 1;
            transform: none;
            transition: none;
            will-change: auto;
        }
    }
</style>

<script>
    import { initFadeInAnimations } from "../../scripts/animations/fadeIn";

    // Bundled module scripts run only once, so this direct call covers the
    // first page load. Under <ClientRouter /> the DOM is swapped in place and
    // this module is not re-executed, so we also (re)observe the freshly
    // rendered reveal targets on every navigation via astro:page-load.
    initFadeInAnimations(document);

    const windowWithRevealFlag = window as unknown as {
        __revealOnScrollBound?: boolean;
    };
    if (!windowWithRevealFlag.__revealOnScrollBound) {
        windowWithRevealFlag.__revealOnScrollBound = true;
        document.addEventListener("astro:page-load", () =>
            initFadeInAnimations(document),
        );
    }
</script>
