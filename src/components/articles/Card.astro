---
interface Props {
    title: string;
    desc: string;
    link: string;
    image?: string;
}

const { title, desc, link, image } = Astro.props;
const isExternal = link.startsWith("http");
---

<a
    class="article-card"
    href={link}
    target={isExternal ? "_blank" : undefined}
    rel={isExternal ? "noopener noreferrer" : undefined}
>
    {
        image && (
            <span class="article-card__media">
                <img src={image} alt="" loading="lazy" decoding="async" />
            </span>
        )
    }
    <span class="article-card__body">
        <span class="article-card__title">{title}</span>
        <span class="article-card__desc">{desc}</span>
    </span>
</a>

<style>
    .article-card {
        align-items: center;
        border: 1px solid var(--color-gray-100);
        border-radius: 0.5rem;
        display: flex;
        gap: 1rem;
        margin: 1.75rem auto 0;
        max-width: 42rem;
        padding: 1rem;
        text-decoration: none;
        transition:
            border-color 200ms ease,
            background-color 200ms ease;
    }

    .article-card:hover {
        background: var(--color-gray-50);
        border-color: var(--color-gray-300);
    }

    .article-card__media {
        block-size: 4rem;
        border-radius: 0.375rem;
        flex: 0 0 auto;
        inline-size: 4rem;
        overflow: hidden;
    }

    .article-card__media img {
        block-size: 100%;
        inline-size: 100%;
        object-fit: cover;
    }

    .article-card__body {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
        min-inline-size: 0;
    }

    .article-card__title {
        color: var(--color-gray-900);
        font-weight: 500;
    }

    .article-card__desc {
        color: var(--color-gray-500);
        font-size: 0.875rem;
    }
</style>
