---
interface Props {
    title: string;
    desc: string;
    link: string;
    image?: string;
}

const { title, desc, link, image } = Astro.props;
const isExternal = link.startsWith("http");
---

<a
    class="mx-auto mt-7 flex max-w-2xl items-center gap-4 rounded-lg border border-gray-100 p-4 no-underline transition-colors duration-200 ease-in hover:bg-gray-50 hover:border-gray-300"
    href={link}
    target={isExternal ? "_blank" : undefined}
    rel={isExternal ? "noopener noreferrer" : undefined}
>
    {
        image && (
            <span class="size-16 shrink-0 overflow-hidden rounded-md">
                <img
                    class="size-full object-cover"
                    src={image}
                    alt=""
                    loading="lazy"
                    decoding="async"
                />
            </span>
        )
    }
    <span class="flex min-w-0 flex-col gap-1">
        <span class="font-medium text-gray-900">{title}</span>
        <span class="text-sm text-gray-500">{desc}</span>
    </span>
</a>
