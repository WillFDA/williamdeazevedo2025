---
// Accessible before/after image comparison slider (no framework, ~25 lines of JS).
// Driven by a native range input so it works with keyboard and touch for free.
const newSrc =
    "https://igpmag5dwziffdrn.public.blob.vercel-storage.com/blog/motivai_new_ui.png";
const oldSrc =
    "https://igpmag5dwziffdrn.public.blob.vercel-storage.com/blog/motivia_old_ui.jpeg";
---

<figure class="ui-compare" data-ui-compare>
    <figcaption class="ui-compare__caption">
        L'ancienne interface vs la nouvelle.
        <span>Glisse pour comparer</span>
    </figcaption>

    <div class="ui-compare__frame" style="--pos: 50%">
        <img
            class="ui-compare__img"
            src={newSrc}
            alt="Nouvelle interface de Motivai"
            loading="lazy"
            decoding="async"
            draggable="false"
        />
        <div class="ui-compare__clip">
            <img
                class="ui-compare__img"
                src={oldSrc}
                alt="Ancienne interface de Motivai"
                loading="lazy"
                decoding="async"
                draggable="false"
            />
        </div>

        <div class="ui-compare__line" aria-hidden="true">
            <span class="ui-compare__handle">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M8 9l4-4 4 4m0 6l-4 4-4-4"></path>
                </svg>
            </span>
        </div>

        <span class="ui-compare__label ui-compare__label--before">Avant</span>
        <span class="ui-compare__label ui-compare__label--after">Après</span>

        <input
            class="ui-compare__range"
            type="range"
            min="0"
            max="100"
            value="50"
            step="0.1"
            aria-label="Comparer l'ancienne et la nouvelle interface de Motivai"
        />
    </div>
</figure>

<script>
    const setup = (root: HTMLElement) => {
        if (root.dataset.uiCompareReady === "true") return;
        root.dataset.uiCompareReady = "true";

        const frame = root.querySelector<HTMLElement>(".ui-compare__frame");
        const range = root.querySelector<HTMLInputElement>(".ui-compare__range");
        if (!frame || !range) return;

        const update = () => {
            frame.style.setProperty("--pos", `${range.value}%`);
        };

        range.addEventListener("input", update);
        update();
    };

    const init = () => {
        document
            .querySelectorAll<HTMLElement>("[data-ui-compare]")
            .forEach(setup);
    };

    init();
    document.addEventListener("astro:page-load", init);
</script>

<style>
    .ui-compare {
        margin: 2rem auto;
        max-width: 42rem;
    }

    .ui-compare__caption {
        color: var(--color-gray-600);
        font-size: 0.875rem;
        margin-bottom: 1rem;
        text-align: center;
    }

    .ui-compare__caption span {
        color: var(--color-gray-400);
    }

    .ui-compare__frame {
        aspect-ratio: 4 / 3;
        border: 1px solid var(--color-gray-100);
        border-radius: 0.5rem;
        overflow: hidden;
        position: relative;
        user-select: none;
    }

    .ui-compare__img {
        height: 100%;
        inset: 0;
        object-fit: cover;
        object-position: top;
        position: absolute;
        width: 100%;
    }

    .ui-compare__clip {
        inset: 0;
        overflow: hidden;
        position: absolute;
        clip-path: inset(0 calc(100% - var(--pos)) 0 0);
    }

    .ui-compare__line {
        background: rgba(255, 255, 255, 0.9);
        bottom: 0;
        left: var(--pos);
        position: absolute;
        top: 0;
        transform: translateX(-50%);
        width: 2px;
    }

    .ui-compare__handle {
        align-items: center;
        background: #fff;
        border: 1px solid var(--color-gray-200);
        border-radius: 9999px;
        box-shadow: 0 1px 6px rgb(17 24 39 / 0.18);
        color: var(--color-gray-400);
        display: flex;
        height: 2rem;
        justify-content: center;
        left: 50%;
        position: absolute;
        top: 50%;
        transform: translate(-50%, -50%);
        width: 2rem;
    }

    .ui-compare__handle svg {
        height: 1rem;
        width: 1rem;
    }

    .ui-compare__label {
        backdrop-filter: blur(4px);
        border-radius: 0.25rem;
        bottom: 0.75rem;
        font-size: 0.75rem;
        font-weight: 500;
        padding: 0.125rem 0.5rem;
        position: absolute;
    }

    .ui-compare__label--before {
        background: rgba(255, 255, 255, 0.9);
        color: var(--color-gray-600);
        left: 0.75rem;
    }

    .ui-compare__label--after {
        background: rgba(17, 24, 39, 0.8);
        color: #fff;
        right: 0.75rem;
    }

    /* Native range input overlaid full-frame, visually hidden but interactive. */
    .ui-compare__range {
        cursor: ew-resize;
        height: 100%;
        inset: 0;
        margin: 0;
        opacity: 0;
        position: absolute;
        width: 100%;
    }

    .ui-compare__range:focus-visible {
        opacity: 1;
    }

    .ui-compare__range:focus-visible ~ .ui-compare__line .ui-compare__handle {
        outline: 2px solid var(--color-blue-500);
        outline-offset: 2px;
    }
</style>
