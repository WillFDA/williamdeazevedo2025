---
const statuses = [
  {
    number: "01",
    title: "Entreprise individuelle",
    subtitle: "EI, micro-entreprise",
    items: [
      "Nom, prénom et mention « EI » ou « entrepreneur individuel »",
      "Adresse, téléphone et e-mail de contact",
      "Numéro d’immatriculation, s’il y en a un",
      "Numéro de TVA intracommunautaire, si vous en avez un",
    ],
  },
  {
    number: "02",
    title: "Société",
    subtitle: "SARL, EURL, SAS, SASU…",
    items: [
      "Dénomination et forme juridique",
      "Adresse du siège social et montant du capital",
      "Téléphone et e-mail de contact",
      "Numéro d’immatriculation et de TVA intracommunautaire",
    ],
  },
];
const shared = ["Directeur de la publication", "Hébergeur : nom, adresse, téléphone", "Autorité d’agrément si l’activité est réglementée"];
---

<div class="publisher-identity">
  <p class="identity-kicker">Qui édite le site ? Repérez votre colonne</p>
  <div class="identity-grid">
    {statuses.map((status) => (
      <div class="identity-card">
        <p class="identity-head">
          <span class="identity-number" aria-hidden="true">{status.number}</span>
          <span>
            <strong>{status.title}</strong>
            <span class="identity-subtitle">{status.subtitle}</span>
          </span>
        </p>
        <ul>
          {status.items.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    ))}
  </div>
  <div class="identity-shared">
    <p>Dans les deux cas</p>
    <ul>
      {shared.map((item) => <li>{item}</li>)}
    </ul>
  </div>
  <p class="identity-footnote">Repères de vérification issus des fiches Service Public : confirmez chaque ligne avec vos données d’entreprise à jour.</p>
</div>

<style>
  .publisher-identity { padding: clamp(1.25rem, 4vw, 2rem); border: 1px solid var(--color-gray-200); border-radius: 1rem; background: var(--color-snow-50); color: var(--color-gray-600); }
  .publisher-identity .identity-kicker { margin: 0 0 1rem; color: var(--color-blue-500); font-size: .75rem; font-weight: 500; letter-spacing: .08em; text-transform: uppercase; }
  .identity-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .75rem; }
  .identity-card { padding: 1rem; border-radius: .75rem; background: var(--color-surface-100); }
  .publisher-identity .identity-head { display: flex; align-items: flex-start; gap: .75rem; margin: 0; line-height: 1.35; }
  .identity-head strong { display: block; color: var(--color-gray-900); font-weight: 500; }
  .identity-subtitle { display: block; margin-top: .15rem; font-size: .8125rem; color: var(--color-gray-500); }
  .identity-number { flex: none; display: grid; place-items: center; width: 1.9rem; height: 1.9rem; border-radius: .5rem; background: var(--color-blue-50); color: var(--color-blue-600); font-size: .75rem; font-variant-numeric: tabular-nums; }
  .publisher-identity .identity-card ul { display: grid; gap: .45rem; margin: 1rem 0 0; padding: 0; list-style: none; font-size: .9375rem; line-height: 1.5; }
  .publisher-identity .identity-card li { position: relative; margin: 0; padding-left: 1.1rem; }
  .identity-card li::before { content: ""; position: absolute; top: .6em; left: .1rem; width: .35rem; height: .35rem; border-radius: 999px; background: var(--color-blue-300); }
  .identity-shared { margin-top: .75rem; padding: .85rem 1rem; border-radius: .75rem; background: var(--color-blue-50); }
  .publisher-identity .identity-shared p { margin: 0 0 .6rem; color: var(--color-blue-600); font-size: .75rem; font-weight: 500; letter-spacing: .06em; text-transform: uppercase; }
  .publisher-identity .identity-shared ul { display: flex; flex-wrap: wrap; gap: .4rem; margin: 0; padding: 0; list-style: none; }
  .publisher-identity .identity-shared li { margin: 0; padding: .3rem .7rem; border-radius: 999px; background: var(--color-snow-50); color: var(--color-gray-900); font-size: .8125rem; line-height: 1.4; }
  .publisher-identity .identity-footnote { margin: 1rem 0 0; font-size: .8125rem; line-height: 1.6; }
  @media (max-width: 560px) { .identity-grid { grid-template-columns: minmax(0, 1fr); } }
</style>
