---
/**
 * Scène animée "Renfort front-end" : un mini éditeur de code sombre où un diff
 * se joue en boucle — ligne rouge barrée, lignes vertes ajoutées,
 * badge "Corrigé". Le curseur clignote sur son propre cycle.
 * Les boucles sont pilotées par Anime.js depuis ServicesBentoGrid.astro.
 */
---

<div class="fe-scene pointer-events-none relative flex h-full w-full items-center justify-center overflow-hidden" data-bento-visual="frontend" aria-hidden="true">
	<div class="fe-stage relative transition-transform duration-500 ease-out group-hover:scale-[1.03]">
		<div class="w-[196px] rounded-xl bg-gray-900 shadow-[0_20px_40px_-22px_rgba(31,38,52,0.7)] ring-1 ring-white/10">
			<div class="flex items-center gap-1.5 border-b border-white/[0.07] px-3 py-2">
				<span class="size-1.5 rounded-full bg-gray-600"></span>
				<span class="size-1.5 rounded-full bg-gray-600"></span>
				<span class="size-1.5 rounded-full bg-gray-600"></span>
				<span class="ml-1.5 rounded-md bg-white/[0.08] px-1.5 py-0.5 font-mono text-[7px] leading-none text-gray-400">header.tsx</span>
			</div>
			<div class="flex flex-col gap-[6px] px-3 pt-2.5 pb-2.5">
				<span class="flex items-center gap-1.5">
					<span class="h-1.5 w-7 rounded-full bg-[#c4b5fd]/70"></span>
					<span class="h-1.5 w-11 rounded-full bg-sky-400/60"></span>
				</span>
				<span class="ml-2.5 flex items-center gap-1.5">
					<span class="h-1.5 w-9 rounded-full bg-sky-300/50"></span>
					<span class="h-1.5 w-6 rounded-full bg-gray-500/50"></span>
				</span>
				<span class="fe-line-del relative ml-2.5 flex items-center gap-1.5" data-bento-fe-line-del>
					<span class="w-2 font-mono text-[9px] leading-none text-rose-400">−</span>
					<span class="relative h-1.5 w-14 rounded-full bg-rose-400/50">
						<span class="fe-strike absolute top-1/2 left-0 h-px w-full bg-rose-300" data-bento-fe-strike></span>
					</span>
				</span>
				<span class="fe-line-add-1 ml-2.5 flex items-center gap-1.5" data-bento-fe-line-add>
					<span class="w-2 font-mono text-[9px] leading-none text-emerald-400">+</span>
					<span class="h-1.5 w-10 rounded-full bg-emerald-400/60"></span>
					<span class="h-1.5 w-5 rounded-full bg-emerald-300/40"></span>
				</span>
				<span class="fe-line-add-2 ml-2.5 flex items-center gap-1.5" data-bento-fe-line-add>
					<span class="w-2 font-mono text-[9px] leading-none text-emerald-400">+</span>
					<span class="h-1.5 w-12 rounded-full bg-emerald-400/50"></span>
				</span>
				<span class="flex items-center gap-1.5">
					<span class="h-1.5 w-4 rounded-full bg-gray-500/50"></span>
					<span class="fe-caret h-2.5 w-px bg-sky-300" data-bento-fe-caret></span>
				</span>
			</div>
		</div>

		<span class="fe-chip absolute -right-3 -bottom-2.5 flex items-center gap-1 rounded-full bg-emerald-500 px-2 py-1 text-[8px] font-semibold text-white shadow-sm" data-bento-fe-chip>
			<svg class="size-2" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
				<path d="M3.5 8.5l3 3 6-7"></path>
			</svg>
			Corrigé
		</span>
	</div>

</div>

<style>
	.fe-strike {
		transform-origin: left center;
		will-change: transform;
	}

	.fe-line-del {
		opacity: 0.45;
	}

	.fe-line-add-1,
	.fe-line-add-2 {
		will-change: opacity, transform;
	}

	.fe-chip {
		opacity: 1;
		transform-origin: center;
		will-change: opacity, transform;
	}

	.fe-caret {
		will-change: opacity;
	}
</style>
