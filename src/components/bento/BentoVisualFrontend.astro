---
/**
 * Scène animée "Renfort front-end" : un mini éditeur de code sombre où un diff
 * se joue en boucle (5.5s) — ligne rouge barrée, lignes vertes ajoutées,
 * badge "Corrigé". Le curseur clignote sur son propre cycle.
 */
---

<div class="fe-scene pointer-events-none relative flex h-full w-full items-center justify-center overflow-hidden" aria-hidden="true">
	<div class="scene-backdrop absolute inset-0"></div>

	<div class="fe-stage relative transition-transform duration-500 ease-out group-hover:scale-[1.03]">
		<div class="w-[196px] rounded-xl bg-gray-900 shadow-[0_20px_40px_-22px_rgba(31,38,52,0.7)] ring-1 ring-white/10">
			<div class="flex items-center gap-1.5 border-b border-white/[0.07] px-3 py-2">
				<span class="size-1.5 rounded-full bg-gray-600"></span>
				<span class="size-1.5 rounded-full bg-gray-600"></span>
				<span class="size-1.5 rounded-full bg-gray-600"></span>
				<span class="ml-1.5 rounded-md bg-white/[0.08] px-1.5 py-0.5 font-mono text-[7px] leading-none text-gray-400">header.tsx</span>
			</div>
			<div class="flex flex-col gap-[6px] px-3 pt-2.5 pb-2.5">
				<span class="flex items-center gap-1.5">
					<span class="h-1.5 w-7 rounded-full bg-[#c4b5fd]/70"></span>
					<span class="h-1.5 w-11 rounded-full bg-sky-400/60"></span>
				</span>
				<span class="ml-2.5 flex items-center gap-1.5">
					<span class="h-1.5 w-9 rounded-full bg-sky-300/50"></span>
					<span class="h-1.5 w-6 rounded-full bg-gray-500/50"></span>
				</span>
				<span class="fe-line-del relative ml-2.5 flex items-center gap-1.5">
					<span class="w-2 font-mono text-[9px] leading-none text-rose-400">−</span>
					<span class="relative h-1.5 w-14 rounded-full bg-rose-400/50">
						<span class="fe-strike absolute top-1/2 left-0 h-px w-full -translate-y-1/2 bg-rose-300"></span>
					</span>
				</span>
				<span class="fe-line-add-1 ml-2.5 flex items-center gap-1.5">
					<span class="w-2 font-mono text-[9px] leading-none text-emerald-400">+</span>
					<span class="h-1.5 w-10 rounded-full bg-emerald-400/60"></span>
					<span class="h-1.5 w-5 rounded-full bg-emerald-300/40"></span>
				</span>
				<span class="fe-line-add-2 ml-2.5 flex items-center gap-1.5">
					<span class="w-2 font-mono text-[9px] leading-none text-emerald-400">+</span>
					<span class="h-1.5 w-12 rounded-full bg-emerald-400/50"></span>
				</span>
				<span class="flex items-center gap-1.5">
					<span class="h-1.5 w-4 rounded-full bg-gray-500/50"></span>
					<span class="fe-caret h-2.5 w-px bg-sky-300"></span>
				</span>
			</div>
		</div>

		<span class="fe-chip absolute -right-3 -bottom-2.5 flex items-center gap-1 rounded-full bg-emerald-500 px-2 py-1 text-[8px] font-semibold text-white shadow-[0_10px_20px_-10px_rgba(16,185,129,0.9)]">
			<svg class="size-2" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
				<path d="M3.5 8.5l3 3 6-7"></path>
			</svg>
			Corrigé
		</span>
	</div>

</div>

<style>
	.fe-scene,
	.fe-scene * {
		animation-play-state: var(--bento-play, running) !important;
	}

	.scene-backdrop {
		background: radial-gradient(
			120% 90% at 50% 0%,
			rgba(47, 143, 214, 0.08),
			transparent 70%
		);
	}

	.fe-strike {
		animation: fe-strike 5.5s ease-out infinite;
		transform-origin: left center;
	}

	@keyframes fe-strike {
		0%,
		18% {
			transform: translateY(-50%) scaleX(0);
		}
		27%,
		90% {
			transform: translateY(-50%) scaleX(1);
		}
		96%,
		100% {
			transform: translateY(-50%) scaleX(0);
		}
	}

	.fe-line-del {
		animation: fe-line-del 5.5s ease-out infinite;
	}

	@keyframes fe-line-del {
		0%,
		20% {
			opacity: 1;
		}
		30%,
		90% {
			opacity: 0.45;
		}
		96%,
		100% {
			opacity: 1;
		}
	}

	.fe-line-add-1 {
		animation: fe-line-add-1 5.5s ease-out infinite;
	}

	@keyframes fe-line-add-1 {
		0%,
		34% {
			opacity: 0;
			transform: translate3d(-6px, 0, 0);
		}
		42%,
		90% {
			opacity: 1;
			transform: translate3d(0, 0, 0);
		}
		96%,
		100% {
			opacity: 0;
			transform: translate3d(-6px, 0, 0);
		}
	}

	.fe-line-add-2 {
		animation: fe-line-add-2 5.5s ease-out infinite;
	}

	@keyframes fe-line-add-2 {
		0%,
		46% {
			opacity: 0;
			transform: translate3d(-6px, 0, 0);
		}
		54%,
		90% {
			opacity: 1;
			transform: translate3d(0, 0, 0);
		}
		96%,
		100% {
			opacity: 0;
			transform: translate3d(-6px, 0, 0);
		}
	}

	.fe-chip {
		animation: fe-chip 5.5s ease-out infinite;
		opacity: 0;
	}

	@keyframes fe-chip {
		0%,
		58% {
			opacity: 0;
			transform: scale(0.8);
		}
		64%,
		88% {
			opacity: 1;
			transform: scale(1);
		}
		94%,
		100% {
			opacity: 0;
			transform: scale(0.9);
		}
	}

	.fe-caret {
		animation: fe-caret 1.1s steps(1, end) infinite;
	}

	@keyframes fe-caret {
		0%,
		49% {
			opacity: 1;
		}
		50%,
		100% {
			opacity: 0;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.fe-scene,
		.fe-scene * {
			animation: none !important;
		}

		.fe-line-del {
			opacity: 0.45;
		}
	}
</style>
