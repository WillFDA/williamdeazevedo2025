---
/**
 * Scène "Site internet professionnel" : l'immeuble qui se construit.
 * La dalle "Base technique" se pose, les niveaux Services puis Preuves
 * s'empilent (chaque pose tasse les étages du dessous), le fil à plomb
 * vérifie l'alignement, le niveau Contact coiffe le tout et son signal
 * pulse comme un phare. "Présence durable" valide.
 * Chorégraphie pilotée par src/scripts/animations/bento/professional.ts.
 * Sans JS : immeuble complet, fil à plomb tendu, signal et badge visibles.
 */
---

<div
    class="pro-scene pointer-events-none relative flex h-full w-full items-center justify-center overflow-hidden px-4 py-4"
    data-bento-visual="professional"
    aria-hidden="true"
>
    <div class="pro-stage relative w-[300px] transition-transform duration-500 ease-out group-hover:scale-[1.03] sm:w-[420px]">
        <span class="pro-glow" data-bento-pro-glow></span>

        <span class="pro-silhouette pro-silhouette--left"></span>
        <span class="pro-silhouette pro-silhouette--right"></span>
        <span class="pro-ground"></span>

        <div class="pro-floor pro-floor--foundation" data-bento-pro-floor>
            <span class="pro-floor__mark pro-floor__mark--foundation"></span>
            Base technique
        </div>

        <div class="pro-floor pro-floor--services" data-bento-pro-floor>
            <span class="pro-floor__mark pro-floor__mark--services"></span>
            Services
            <span class="pro-floor__windows">
                <span></span>
                <span></span>
            </span>
        </div>

        <div class="pro-floor pro-floor--proof" data-bento-pro-floor>
            <span class="pro-floor__mark pro-floor__mark--proof"></span>
            Preuves
            <span class="pro-floor__windows">
                <span></span>
                <span></span>
            </span>
        </div>

        <div class="pro-floor pro-floor--contact" data-bento-pro-floor>
            <span class="pro-floor__mark pro-floor__mark--contact"></span>
            Contact
        </div>

        <span class="pro-beacon" data-bento-pro-beacon>
            <span class="pro-beacon__ping" data-bento-pro-beacon-ping></span>
            <span class="pro-beacon__dot"></span>
            <span class="pro-beacon__stem"></span>
        </span>

        <span class="pro-plumb">
            <span class="pro-plumb__line" data-bento-pro-plumb></span>
            <span class="pro-plumb__bob" data-bento-pro-plumb-bob></span>
        </span>

        <span class="pro-badge" data-bento-pro-badge>
            <span class="pro-badge__check">
                <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M3.5 8.5l3 3 6-7"></path>
                </svg>
            </span>
            Présence durable
        </span>
    </div>
</div>

<style>
    .pro-stage {
        height: 12rem;
    }

    .pro-glow {
        background: radial-gradient(
            closest-side,
            rgba(62, 96, 212, 0.12),
            transparent 72%
        );
        bottom: 0.9rem;
        height: 150px;
        left: calc(50% - 130px);
        position: absolute;
        width: 260px;
        will-change: opacity, transform;
    }

    .pro-silhouette {
        background: rgba(188, 196, 207, 0.26);
        border-radius: 0.5rem 0.5rem 0 0;
        bottom: 1.25rem;
        position: absolute;
    }

    .pro-silhouette--left {
        height: 84px;
        left: 10%;
        width: 38px;
    }

    .pro-silhouette--right {
        background: rgba(188, 196, 207, 0.2);
        height: 60px;
        right: 6%;
        width: 26px;
    }

    .pro-ground {
        background: rgba(148, 163, 184, 0.6);
        border-radius: 999em;
        bottom: 1.125rem;
        height: 2px;
        left: 5%;
        position: absolute;
        right: 5%;
    }

    .pro-floor {
        align-items: center;
        background: #ffffff;
        border: 1px solid rgba(226, 232, 240, 0.95);
        border-radius: 0.45rem;
        box-shadow: 0 14px 26px -18px rgba(34, 42, 55, 0.42);
        color: var(--color-gray-700);
        display: flex;
        font-size: 0.56rem;
        font-weight: 500;
        gap: 0.35rem;
        height: 30px;
        left: 50%;
        line-height: 1;
        padding: 0 0.6rem;
        position: absolute;
        white-space: nowrap;
        will-change: opacity, transform;
    }

    .pro-floor--foundation {
        background:
            repeating-linear-gradient(
                45deg,
                rgba(148, 163, 184, 0.08) 0,
                rgba(148, 163, 184, 0.08) 4px,
                transparent 4px,
                transparent 9px
            ),
            #ffffff;
        border-radius: 0.4rem;
        bottom: 1.25rem;
        margin-left: -89px;
        width: 178px;
    }

    .pro-floor--services {
        bottom: calc(1.25rem + 31px);
        margin-left: -74px;
        width: 148px;
    }

    .pro-floor--proof {
        bottom: calc(1.25rem + 62px);
        margin-left: -74px;
        width: 148px;
    }

    .pro-floor--contact {
        background: #1f2937;
        border-color: rgba(31, 41, 55, 0.9);
        bottom: calc(1.25rem + 93px);
        box-shadow: 0 16px 30px -18px rgba(31, 41, 55, 0.65);
        color: var(--color-snow-50);
        margin-left: -60px;
        width: 120px;
    }

    .pro-floor__mark {
        border-radius: 0.18rem;
        height: 8px;
        width: 8px;
    }

    .pro-floor__mark--foundation {
        background: #94a3b8;
    }

    .pro-floor__mark--services {
        background: #3e60d4;
    }

    .pro-floor__mark--proof {
        background: #22c55e;
    }

    .pro-floor__mark--contact {
        background: rgba(255, 255, 255, 0.38);
    }

    .pro-floor__windows {
        display: flex;
        gap: 0.2rem;
        margin-left: auto;
    }

    .pro-floor__windows span {
        background: var(--color-gray-200);
        border-radius: 999em;
        height: 4px;
        width: 4px;
    }

    .pro-beacon {
        bottom: calc(1.25rem + 122px);
        height: 13px;
        left: calc(50% - 4px);
        position: absolute;
        width: 8px;
        will-change: opacity;
    }

    .pro-beacon__stem {
        background: #1f2937;
        bottom: 0;
        height: 6px;
        left: calc(50% - 1px);
        position: absolute;
        width: 2px;
    }

    .pro-beacon__dot {
        background: #22c55e;
        border-radius: 999em;
        height: 8px;
        left: 0;
        position: absolute;
        top: 0;
        width: 8px;
    }

    .pro-beacon__ping {
        background: rgba(34, 197, 94, 0.5);
        border-radius: 999em;
        height: 8px;
        left: 0;
        position: absolute;
        top: 0;
        width: 8px;
        will-change: opacity, transform;
    }

    .pro-plumb {
        bottom: 1.25rem;
        height: 124px;
        left: calc(50% + 96px);
        position: absolute;
        width: 7px;
    }

    .pro-plumb__line {
        background: repeating-linear-gradient(
            180deg,
            rgba(64, 73, 87, 0.6) 0,
            rgba(64, 73, 87, 0.6) 5px,
            transparent 5px,
            transparent 9px
        );
        bottom: 3px;
        left: calc(50% - 1px);
        position: absolute;
        top: 0;
        transform-origin: top center;
        width: 2px;
        will-change: transform;
    }

    .pro-plumb__bob {
        background: #1f2937;
        border-radius: 999em;
        bottom: 0;
        height: 7px;
        left: calc(50% - 3.5px);
        position: absolute;
        width: 7px;
        will-change: opacity, transform;
    }

    .pro-badge {
        align-items: center;
        background: #ffffff;
        border: 1px solid rgba(226, 232, 240, 0.95);
        border-radius: 999em;
        bottom: 0;
        box-shadow: 0 14px 26px -18px rgba(34, 42, 55, 0.5);
        color: var(--color-gray-700);
        display: flex;
        font-size: 0.56rem;
        font-weight: 500;
        gap: 0.3rem;
        left: 0;
        line-height: 1;
        margin-inline: auto;
        padding: 0.4rem 0.55rem;
        position: absolute;
        right: 0;
        white-space: nowrap;
        width: fit-content;
        will-change: opacity, transform;
    }

    .pro-badge__check {
        align-items: center;
        background: #22c55e;
        border-radius: 999em;
        color: #ffffff;
        display: inline-flex;
        height: 0.8rem;
        justify-content: center;
        width: 0.8rem;
    }

    .pro-badge__check svg {
        height: 0.5rem;
        width: 0.5rem;
    }
</style>
