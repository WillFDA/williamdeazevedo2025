---
/**
 * Scène "Site internet professionnel" : une page Accueil isolée devient
 * une arborescence complète. Services, Preuves et Contact se branchent sur
 * une base technique, puis "Présence complète" valide le site structuré.
 * Chorégraphie pilotée par src/scripts/animations/bento/professional.ts.
 * Sans JS : arborescence finale complète et lisible.
 */
---

<div
	class="pro-scene pointer-events-none relative flex h-full w-full items-center justify-center overflow-hidden px-4 py-4"
	data-bento-visual="professional"
	aria-hidden="true"
>
	<div class="pro-stage relative w-[300px] transition-transform duration-500 ease-out group-hover:scale-[1.03] sm:w-[420px]">
		<span class="pro-glow" data-bento-pro-glow></span>

		<span
			class="pro-line pro-line--trunk"
			data-bento-pro-line
			data-bento-pro-trunk></span>
		<span
			class="pro-line pro-line--rail"
			data-bento-pro-line
			data-bento-pro-rail></span>
		<span
			class="pro-line pro-line--drop pro-line--drop-services"
			data-bento-pro-line
			data-bento-pro-drop></span>
		<span
			class="pro-line pro-line--drop pro-line--drop-proof"
			data-bento-pro-line
			data-bento-pro-drop></span>
		<span
			class="pro-line pro-line--drop pro-line--drop-contact"
			data-bento-pro-line
			data-bento-pro-drop></span>

		<div class="pro-page pro-page--home" data-bento-pro-home>
			<span class="pro-page__header">
				<span class="pro-page__dot"></span>
				Accueil
			</span>
			<span class="pro-page__line pro-page__line--wide"></span>
			<span class="pro-page__line"></span>
		</div>

		<div
			class="pro-page pro-page--child pro-page--services"
			data-bento-pro-page
		>
			<span class="pro-page__header">
				<span class="pro-page__dot pro-page__dot--blue"></span>
				Services
			</span>
			<span class="pro-page__line pro-page__line--wide"></span>
			<span class="pro-page__line"></span>
		</div>

		<div class="pro-page pro-page--child pro-page--proof" data-bento-pro-page>
			<span class="pro-page__header">
				<span class="pro-page__dot pro-page__dot--green"></span>
				Preuves
			</span>
			<span class="pro-page__line pro-page__line--wide"></span>
			<span class="pro-page__line"></span>
		</div>

		<div
			class="pro-page pro-page--child pro-page--contact"
			data-bento-pro-page
			data-bento-pro-contact
		>
			<span class="pro-contact-signal" data-bento-pro-signal>
				<span
					class="pro-contact-signal__ping"
					data-bento-pro-signal-ping></span>
				<span class="pro-contact-signal__dot"></span>
			</span>
			<span class="pro-page__header">
				<span class="pro-page__dot pro-page__dot--dark"></span>
				Contact
			</span>
			<span class="pro-page__line pro-page__line--wide"></span>
			<span class="pro-page__line"></span>
		</div>

		<div class="pro-base" data-bento-pro-base>
			<span class="pro-base__mark"></span>
			Base technique
		</div>

		<span class="pro-badge" data-bento-pro-badge>
			<span class="pro-badge__check">
				<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<path d="M3.5 8.5l3 3 6-7"></path>
				</svg>
			</span>
			Présence complète
		</span>
	</div>
</div>

<style>
	.pro-stage {
		height: 12rem;
	}

	.pro-glow {
		background: radial-gradient(
			closest-side,
			rgba(62, 96, 212, 0.14),
			transparent 72%
		);
		height: 9rem;
		left: 50%;
		position: absolute;
		top: 1.5rem;
		transform: translateX(-50%);
		width: 16rem;
		will-change: opacity, transform;
	}

	.pro-line {
		background: rgba(112, 122, 135, 0.38);
		border-radius: 999em;
		position: absolute;
		will-change: opacity, transform;
	}

	.pro-line--trunk {
		height: 1.65rem;
		left: calc(50% - 1px);
		top: 3.9rem;
		transform-origin: top center;
		width: 2px;
	}

	.pro-line--rail {
		height: 2px;
		left: calc(50% - 8.5rem);
		top: 5.5rem;
		transform-origin: center;
		width: 17rem;
	}

	.pro-line--drop {
		height: 0.95rem;
		top: 5.5rem;
		transform-origin: top center;
		width: 2px;
	}

	.pro-line--drop-services {
		left: calc(50% - 8.5rem);
	}

	.pro-line--drop-proof {
		left: calc(50% - 1px);
	}

	.pro-line--drop-contact {
		left: calc(50% + 8.5rem);
	}

	.pro-page {
		background: rgba(255, 255, 255, 0.92);
		border: 1px solid rgba(217, 222, 230, 0.95);
		border-radius: 0.5rem;
		box-shadow: 0 16px 34px -26px rgba(34, 42, 55, 0.46);
		color: var(--color-gray-700);
		display: grid;
		gap: 0.36rem;
		height: 3.1rem;
		padding: 0.55rem 0.62rem;
		position: absolute;
		width: 5.6rem;
		will-change: opacity, transform;
	}

	.pro-page--home {
		left: calc(50% - 2.8rem);
		top: 0.75rem;
	}

	.pro-page--child {
		top: 6.3rem;
	}

	.pro-page--services {
		left: calc(50% - 11.3rem);
	}

	.pro-page--proof {
		left: calc(50% - 2.8rem);
	}

	.pro-page--contact {
		background: color-mix(in srgb, var(--color-blue-50) 86%, white);
		border-color: rgba(62, 96, 212, 0.32);
		color: var(--color-gray-800);
		left: calc(50% + 5.7rem);
	}

	.pro-page__header {
		align-items: center;
		display: flex;
		font-size: 0.52rem;
		font-weight: 600;
		gap: 0.28rem;
		line-height: 1;
	}

	.pro-page__dot {
		background: var(--color-gray-300);
		border-radius: 999em;
		height: 0.36rem;
		width: 0.36rem;
	}

	.pro-page__dot--blue {
		background: var(--color-blue-500);
	}

	.pro-page__dot--green {
		background: #22c55e;
	}

	.pro-page__dot--dark {
		background: var(--color-blue-500);
	}

	.pro-page__line {
		background: color-mix(in srgb, currentColor 18%, transparent);
		border-radius: 999em;
		display: block;
		height: 0.28rem;
		width: 62%;
	}

	.pro-page__line--wide {
		width: 84%;
	}

	.pro-contact-signal {
		height: 0.5rem;
		position: absolute;
		right: 0.55rem;
		top: 0.52rem;
		width: 0.5rem;
		will-change: opacity;
	}

	.pro-contact-signal__dot,
	.pro-contact-signal__ping {
		background: #22c55e;
		border-radius: 999em;
		inset: 0;
		position: absolute;
	}

	.pro-contact-signal__ping {
		opacity: 0.55;
		will-change: opacity, transform;
	}

	.pro-base {
		align-items: center;
		background:
			repeating-linear-gradient(
				45deg,
				rgba(255, 255, 255, 0.08) 0,
				rgba(255, 255, 255, 0.08) 4px,
				transparent 4px,
				transparent 9px
			),
			rgba(64, 73, 87, 0.56);
		border: 1px solid rgba(255, 255, 255, 0.08);
		border-radius: 0.5rem;
		bottom: 1.45rem;
		color: rgba(255, 255, 255, 0.78);
		display: inline-flex;
		font-size: 0.55rem;
		font-weight: 500;
		gap: 0.35rem;
		left: 50%;
		line-height: 1;
		padding: 0.42rem 0.7rem;
		position: absolute;
		transform: translateX(-50%);
		white-space: nowrap;
		will-change: opacity, transform;
	}

	.pro-base__mark {
		background: rgba(255, 255, 255, 0.46);
		border-radius: 999em;
		height: 0.38rem;
		width: 0.38rem;
	}

	.pro-badge {
		align-items: center;
		background: var(--color-blue-500);
		border-radius: 999em;
		bottom: 0;
		box-shadow: inset 0 2px rgba(184, 200, 255, 0.18);
		color: var(--color-snow-50);
		display: flex;
		font-size: 0.56rem;
		font-weight: 600;
		gap: 0.32rem;
		left: 50%;
		line-height: 1;
		padding: 0.43rem 0.65rem;
		position: absolute;
		transform: translateX(-50%);
		white-space: nowrap;
		will-change: opacity, transform;
	}

	.pro-badge__check {
		align-items: center;
		background: rgba(255, 255, 255, 0.2);
		border-radius: 999em;
		color: #ffffff;
		display: inline-flex;
		height: 0.78rem;
		justify-content: center;
		width: 0.78rem;
	}

	.pro-badge__check svg {
		height: 0.48rem;
		width: 0.48rem;
	}

	@media (max-width: 639px) {
		.pro-line--rail {
			left: calc(50% - 6.3rem);
			width: 12.6rem;
		}

		.pro-line--drop-services {
			left: calc(50% - 6.3rem);
		}

		.pro-line--drop-contact {
			left: calc(50% + 6.3rem);
		}

		.pro-page {
			width: 5.05rem;
		}

		.pro-page--home {
			left: calc(50% - 2.525rem);
		}

		.pro-page--services {
			left: calc(50% - 8.825rem);
		}

		.pro-page--proof {
			left: calc(50% - 2.525rem);
		}

		.pro-page--contact {
			left: calc(50% + 3.775rem);
		}
	}
</style>
