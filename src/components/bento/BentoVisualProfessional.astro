---
/**
 * Scène « Site internet professionnel » : le socle, en vue éclatée
 * isométrique. Un site professionnel se construit en couches sur des
 * fondations : en bas, un socle sombre et massif (la base technique, pistes
 * de circuit et LED « en ligne ») ; au-dessus, trois plaques qui tombent et
 * se posent : Services (petits cubes rangés), Preuves (étoiles gravées) et
 * Pages clés (la face bleue de la marque, avec le bouton de contact).
 *
 * Tout est en unités de viewBox (isométrie 2:1 calculée ici) : aucune mesure
 * de mise en page. Les libellés sont en HTML, placés sur la même grille via
 * --u (un pixel de viewBox à l'écran), pour garder une taille de texte fixe
 * (≥ 10 px) quelle que soit l'échelle de la scène.
 *
 * Chaque étage a deux <g> imbriqués : l'externe (.pro-lift) est piloté en
 * CSS au survol (la vue s'éclate davantage), l'interne par GSAP.
 *
 * Sans JS / reduced motion : état final (pile complète, libellés, LED
 * allumée). Chorégraphie : src/scripts/animations/bento/professional.ts.
 */

type Pt = readonly [number, number];

/** Identifiant unique : plusieurs instances de la scène par page. */
const uid = `pro-${Math.random().toString(36).slice(2, 8)}`;
const ref = (name: string) => `url(#${uid}-${name})`;

const VIEW_W = 340;
const VIEW_H = 210;

const round = (value: number) => Math.round(value * 100) / 100;
const pt = ([x, y]: Pt) => `${round(x)} ${round(y)}`;
const poly = (points: Pt[]) => `M${points.map(pt).join("L")}Z`;
const polyline = (points: Pt[]) => `M${points.map(pt).join("L")}`;
const down = ([x, y]: Pt, by: number): Pt => [x, y + by];

/**
 * Projection isométrique 2:1 d'une face horizontale dont le sommet arrière
 * est (tx, ty) : u file vers le sommet droit, v vers le sommet gauche.
 */
const onFace =
	(tx: number, ty: number) =>
	(u: number, v: number): Pt => [tx + u - v, ty + (u + v) / 2];

/** Dalle isométrique : largeur w (diagonale), épaisseur t, centre du dessus (cx, cy). */
const slab = (cx: number, cy: number, w: number, t: number) => {
	const side = w / 2;
	const at = onFace(cx, cy - w / 4);
	const back = at(0, 0);
	const right = at(side, 0);
	const front = at(side, side);
	const left = at(0, side);
	return {
		at,
		front,
		left: poly([left, front, down(front, t), down(left, t)]),
		right,
		rightFace: poly([front, right, down(right, t), down(front, t)]),
		side,
		top: poly([back, right, front, left]),
		/** Arêtes avant du dessus (reflet). */
		rim: polyline([left, front, right]),
		/** Silhouette complète (liseré). */
		outline: poly([back, right, down(right, t), down(front, t), down(left, t), left]),
		/** Dessus, en points (sens horaire à l'écran). */
		topPoints: [back, right, front, left] as Pt[],
		/** Contour bas (arêtes avant du dessous). */
		under: [down(left, t), down(front, t), down(right, t)] as Pt[],
	};
};

/** Découpe d'un polygone convexe par un autre (Sutherland–Hodgman). */
const clipPolygon = (subject: Pt[], clip: Pt[]) => {
	let output = subject;
	clip.forEach((a, index) => {
		const b = clip[(index + 1) % clip.length] ?? a;
		const inside = ([x, y]: Pt) =>
			(b[0] - a[0]) * (y - a[1]) - (b[1] - a[1]) * (x - a[0]) >= 0;
		const cross = (p: Pt, q: Pt): Pt => {
			const a1 = b[1] - a[1];
			const b1 = a[0] - b[0];
			const c1 = a1 * a[0] + b1 * a[1];
			const a2 = q[1] - p[1];
			const b2 = p[0] - q[0];
			const c2 = a2 * p[0] + b2 * p[1];
			const det = a1 * b2 - a2 * b1;
			return [(b2 * c1 - b1 * c2) / det, (a1 * c2 - a2 * c1) / det];
		};
		const input = output;
		output = [];
		input.forEach((current, k) => {
			const previous = input[(k + input.length - 1) % input.length] ?? current;
			if (inside(current)) {
				if (!inside(previous)) output.push(cross(previous, current));
				output.push(current);
			} else if (inside(previous)) output.push(cross(previous, current));
		});
	});
	return output;
};

/** Petit cube posé sur une face (coin arrière en u, v). */
const cube = (
	at: (u: number, v: number) => Pt,
	u: number,
	v: number,
	size: number,
	height: number,
) => {
	const a = at(u, v);
	const b = at(u + size, v);
	const c = at(u + size, v + size);
	const d = at(u, v + size);
	const up = (p: Pt) => down(p, -height);
	return {
		left: poly([up(d), up(c), c, d]),
		right: poly([up(c), up(b), b, c]),
		top: poly([up(a), up(b), up(c), up(d)]),
	};
};

/** Étoile à 5 branches gravée sur une face (pointe vers l'arrière). */
const star = (
	at: (u: number, v: number) => Pt,
	u: number,
	v: number,
	radius: number,
) => {
	const start = (-3 * Math.PI) / 4;
	const points = Array.from({ length: 10 }, (_, index) => {
		const r = index % 2 ? radius * 0.44 : radius;
		const angle = start + (index * Math.PI) / 5;
		return at(u + r * Math.cos(angle), v + r * Math.sin(angle));
	});
	const center = at(u, v);
	return { d: poly(points), origin: pt(center) };
};

// --- Géométrie ---------------------------------------------------------------
const CX = 100;
const BASE = { cy: 150, t: 14, w: 148 };
const PLATE = { t: 10, w: 120 };
/** Centres des plaques, du bas vers le haut : Services, Preuves, Pages clés. */
const PLATE_CY = [112, 78, 44];

const base = slab(CX, BASE.cy, BASE.w, BASE.t);
const plates = PLATE_CY.map((cy) => slab(CX, cy, PLATE.w, PLATE.t));
const [services, proofs, pages] = plates as [
	ReturnType<typeof slab>,
	ReturnType<typeof slab>,
	ReturnType<typeof slab>,
];

/**
 * Ombre de contact d'un étage sur la face du dessous : une bande qui longe
 * son contour bas, découpée à la face, en dégradé perpendiculaire à chaque
 * arête (deux dégradés par face).
 */
const SHADE = 11;
const shades = (
	[
		[base, services],
		[services, proofs],
		[proofs, pages],
	] as const
).map(([lower, upper], index) => {
	const [l, f, r] = upper.under as [Pt, Pt, Pt];
	const arms = [
		{ from: l, to: f, normal: [-1, 2] as Pt },
		{ from: f, to: r, normal: [1, 2] as Pt },
	];
	return arms.map(({ from, to, normal }, arm) => {
		const band = clipPolygon(
			[from, to, down(to, SHADE), down(from, SHADE)],
			lower.topPoints,
		);
		const norm = Math.hypot(normal[0], normal[1]);
		const depth = (SHADE * normal[1]) / norm;
		const mid: Pt = [(from[0] + to[0]) / 2, (from[1] + to[1]) / 2];
		return {
			d: poly(band),
			id: `${uid}-shade-${index}-${arm}`,
			x1: mid[0],
			x2: mid[0] + (normal[0] / norm) * depth,
			y1: mid[1],
			y2: mid[1] + (normal[1] / norm) * depth,
		};
	});
});

// Socle : pistes de circuit qui partent de la puce avant vers les bords.
const bAt = base.at;
const S = base.side;
const chip = poly([bAt(52, 52), bAt(64, 52), bAt(64, 64), bAt(52, 64)]);
const traces = [
	polyline([bAt(52, 60), bAt(30, 60), bAt(24, 66), bAt(12, 66)]),
	polyline([bAt(52, 56), bAt(40, 56), bAt(34, 50), bAt(20, 50)]),
	polyline([bAt(60, 52), bAt(60, 34), bAt(66, 28), bAt(66, 14)]),
	polyline([bAt(56, 52), bAt(56, 44), bAt(50, 38), bAt(50, 24)]),
	// Vers la LED : longe le bord droit puis descend sur la face.
	polyline([
		bAt(64, 56),
		bAt(70, 56),
		bAt(70, 12),
		bAt(S, 12),
		down(bAt(S, 12), BASE.t / 2 - 2.6),
	]),
];
const pads = [bAt(12, 66), bAt(20, 50), bAt(66, 14), bAt(50, 24)];
const led = down(bAt(S, 12), BASE.t / 2);

// Services : six cubes rangés en V le long des arêtes avant.
const sAt = services.at;
const cubes = [
	cube(sAt, 48, 8, 7, 7),
	cube(sAt, 48, 20, 7, 7),
	cube(sAt, 48, 32, 7, 7),
	cube(sAt, 32, 48, 7, 7),
	cube(sAt, 20, 48, 7, 7),
	cube(sAt, 8, 48, 7, 7),
];

// Preuves : cinq étoiles gravées le long de l'arête avant gauche.
const pAt = proofs.at;
const stars = [9, 19, 29, 39, 49].map((u) => star(pAt, u, 50, 4.7));

// Pages clés : bouton de contact (chevron) sur la face bleue.
const kAt = pages.at;
const pagesTop = kAt(0, 0);
const ctaCenter = kAt(38, 38);
const inset = poly([kAt(6, 6), kAt(54, 6), kAt(54, 54), kAt(6, 54)]);

// Lignes de rappel : du bord droit de chaque étage jusqu'à la colonne des libellés.
const LABEL_X = 210;
const LEADER_END = LABEL_X - 5;
const leaders = [
	{ y: led[1], x: led[0] + 3.5 },
	...plates.map((plate) => ({ y: plate.right[1] + PLATE.t / 2, x: plate.right[0] + 4 })),
];

/**
 * Écart ajouté au survol (unités SVG) : socle, Services, Preuves, Pages clés.
 * Chaque intervalle s'ouvre de 4 unités ; le sommet de Pages clés garde
 * 5 unités de marge en haut du viewBox (le socle descend un peu pour ça).
 */
const LIFT = [3, -1, -5, -9];

/** Ombre au sol : sous le socle, entièrement dans le viewBox (même agrandie au survol). */
const GROUND = { cy: 195, rx: 90, ry: 13 };

const vars = (entries: Record<string, number | string>) =>
	Object.entries(entries)
		.map(([key, value]) => `--${key}: ${value}`)
		.join("; ");

/** Libellé d'un étage : aligné sur sa ligne de rappel, suit son étage au survol. */
const tagStyle = (index: number) =>
	vars({
		lift: LIFT[index] ?? 0,
		x: LABEL_X,
		y: round(leaders[index]?.y ?? 0),
	});
---

<div
	class="pro-scene pointer-events-none relative flex h-full w-full items-center justify-center overflow-hidden"
	data-bento-visual="professional"
	aria-hidden="true"
	style={vars({ "view-w": VIEW_W, "view-h": VIEW_H })}
>
	<svg
		class="pro-svg absolute inset-0 h-full w-full"
		viewBox={`0 0 ${VIEW_W} ${VIEW_H}`}
		preserveAspectRatio="xMidYMid meet"
		fill="none"
	>
		<defs>
			<radialGradient id={`${uid}-ground`} cx="0.5" cy="0.5" r="0.5">
				<stop offset="0" stop-color="#1f2634" stop-opacity="0.22"></stop>
				<stop offset="0.55" stop-color="#1f2634" stop-opacity="0.08"></stop>
				<stop offset="1" stop-color="#1f2634" stop-opacity="0"></stop>
			</radialGradient>
			<linearGradient id={`${uid}-base-top`} x1="0" y1={BASE.cy - BASE.w / 4} x2="0" y2={BASE.cy + BASE.w / 4} gradientUnits="userSpaceOnUse">
				<stop offset="0" stop-color="#3a4250"></stop>
				<stop offset="1" stop-color="#2f3642"></stop>
			</linearGradient>
			<linearGradient id={`${uid}-pages-top`} x1="0" y1={PLATE_CY[2]! - PLATE.w / 4} x2="0" y2={PLATE_CY[2]! + PLATE.w / 4} gradientUnits="userSpaceOnUse">
				<stop offset="0" stop-color="#4a6ae0"></stop>
				<stop offset="1" stop-color="#3e60d4"></stop>
			</linearGradient>
			{
				shades.flat().map((shade) => (
					<linearGradient
						id={shade.id}
						gradientUnits="userSpaceOnUse"
						x1={round(shade.x1)}
						y1={round(shade.y1)}
						x2={round(shade.x2)}
						y2={round(shade.y2)}
					>
						<stop offset="0" stop-color="#1f2634" stop-opacity="0.16"></stop>
						<stop offset="1" stop-color="#1f2634" stop-opacity="0"></stop>
					</linearGradient>
				))
			}
			<radialGradient id={`${uid}-led`} cx="0.5" cy="0.5" r="0.5">
				<stop offset="0" stop-color="#34d399" stop-opacity="0.9"></stop>
				<stop offset="1" stop-color="#34d399" stop-opacity="0"></stop>
			</radialGradient>
		</defs>

		<ellipse
			class="pro-ground"
			cx={CX}
			cy={GROUND.cy}
			rx={GROUND.rx}
			ry={GROUND.ry}
			fill={ref("ground")}
		></ellipse>

		<!-- Socle : base technique. -->
		<g class="pro-lift" style={vars({ lift: LIFT[0]! })}>
			<g data-pro-floor>
				<path d={base.left} fill="#1f2634"></path>
				<path d={base.rightFace} fill="#262d3a"></path>
				<path d={base.top} fill={ref("base-top")}></path>
				<g data-pro-shade>
					{shades[0]!.map((shade) => <path d={shade.d} fill={`url(#${shade.id})`}></path>)}
				</g>
				<path d={base.rim} stroke="#ffffff" stroke-opacity="0.14" stroke-width="1" stroke-linejoin="round"></path>
				<g data-pro-traces opacity="0.6" stroke="#8da5f7" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round">
					{traces.map((d) => <path d={d}></path>)}
				</g>
				<g stroke="#eef3ff" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
					{traces.map((d) => <path d={d} data-pro-pulse opacity="0"></path>)}
				</g>
				<g fill="#8da5f7" opacity="0.8">
					{pads.map(([x, y]) => <ellipse cx={x} cy={y} rx="2.2" ry="1.1"></ellipse>)}
				</g>
				<path d={chip} fill="#1f2634" stroke="#8da5f7" stroke-opacity="0.7" stroke-width="1" stroke-linejoin="round"></path>
				<circle class="pro-led-halo" data-pro-led-halo cx={led[0]} cy={led[1]} r="7" fill={ref("led")} opacity="0.75"></circle>
				<circle class="pro-led" cx={led[0]} cy={led[1]} r="2.2"></circle>
			</g>
		</g>

		<!-- Services : six cubes rangés. -->
		<g class="pro-lift" style={vars({ lift: LIFT[1]! })}>
			<g data-pro-floor data-pro-origin={pt(down(services.front, PLATE.t))}>
				<path d={services.left} fill="#d9dee6"></path>
				<path d={services.rightFace} fill="#eef1f5"></path>
				<path d={services.outline} stroke="#bcc4cf" stroke-opacity="0.55" stroke-width="0.75" stroke-linejoin="round"></path>
				<path d={services.top} fill="#ffffff" stroke="#d9dee6" stroke-width="0.8" stroke-linejoin="round"></path>
				<g data-pro-shade>
					{shades[1]!.map((shade) => <path d={shade.d} fill={`url(#${shade.id})`}></path>)}
				</g>
				{
					cubes.map((c) => (
						<g data-pro-cube>
							<path d={c.left} fill="#8da5f7"></path>
							<path d={c.right} fill="#b8c8ff"></path>
							<path d={c.top} fill="#dce6ff"></path>
						</g>
					))
				}
			</g>
		</g>

		<!-- Preuves : étoiles gravées. -->
		<g class="pro-lift" style={vars({ lift: LIFT[2]! })}>
			<g data-pro-floor data-pro-origin={pt(down(proofs.front, PLATE.t))}>
				<path d={proofs.left} fill="#d9dee6"></path>
				<path d={proofs.rightFace} fill="#eef1f5"></path>
				<path d={proofs.outline} stroke="#bcc4cf" stroke-opacity="0.55" stroke-width="0.75" stroke-linejoin="round"></path>
				<path d={proofs.top} fill="#ffffff" stroke="#d9dee6" stroke-width="0.8" stroke-linejoin="round"></path>
				<g data-pro-shade>
					{shades[2]!.map((shade) => <path d={shade.d} fill={`url(#${shade.id})`}></path>)}
				</g>
				{
					stars.map((s) => (
						<path
							d={s.d}
							data-pro-star
							data-origin={s.origin}
							fill="#3e60d4"
						></path>
					))
				}
			</g>
		</g>

		<!-- Pages clés : face bleue et bouton de contact. -->
		<g class="pro-lift" style={vars({ lift: LIFT[3]! })}>
			<g data-pro-floor data-pro-origin={pt(down(pages.front, PLATE.t))}>
				<path d={pages.left} fill="#2744a8"></path>
				<path d={pages.rightFace} fill="#3152c7"></path>
				<path d={pages.top} fill={ref("pages-top")}></path>
				<path d={inset} stroke="#8da5f7" stroke-opacity="0.45" stroke-width="0.8" stroke-linejoin="round"></path>
				<g transform={`matrix(1 0.5 -1 0.5 ${pt(pagesTop)})`}>
					<rect x="20" y="31" width="34" height="14" rx="7" fill="#ffffff"></rect>
					<path d="M30 38h14M40 34l4 4-4 4" stroke="#3e60d4" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
				</g>
				<ellipse data-pro-ring cx={ctaCenter[0]} cy={ctaCenter[1]} rx="64" ry="32" stroke="#8da5f7" stroke-width="1.2" opacity="0"></ellipse>
				<ellipse data-pro-ring cx={ctaCenter[0]} cy={ctaCenter[1]} rx="64" ry="32" stroke="#8da5f7" stroke-width="1.2" opacity="0"></ellipse>
			</g>
		</g>

		<!-- Lignes de rappel (du socle vers le haut). -->
		<g stroke="#bcc4cf" stroke-width="1" stroke-linecap="round">
			{
				leaders.map((leader, index) => (
					<g class="pro-lift" style={vars({ lift: LIFT[index]! })}>
						<path data-pro-leader d={`M${round(leader.x)} ${round(leader.y)}H${LEADER_END}`}></path>
						{index > 0 && (
							<circle
								data-pro-pin
								cx={round(leader.x)}
								cy={round(leader.y)}
								r="1.7"
								fill="#9ba4b1"
								stroke="none"
							></circle>
						)}
					</g>
				))
			}
		</g>
	</svg>

	<!-- Libellés HTML posés sur la grille du viewBox (du socle vers le haut). -->
	<div class="pro-tag" style={tagStyle(0)}>
		<span class="pro-tag__inner pro-tag__inner--base">
			<span class="pro-tag__title">
				<span class="pro-tag__dot" data-pro-dot></span>Base technique
			</span>
			<span class="pro-tag__sub">rapide · sécurisée</span>
		</span>
	</div>
	<div class="pro-tag" style={tagStyle(1)}>
		<span class="pro-tag__inner" data-pro-label>
			Services<span class="pro-tag__sep">·</span><span class="pro-tag__num">6</span>
		</span>
	</div>
	<div class="pro-tag" style={tagStyle(2)}>
		<span class="pro-tag__inner" data-pro-label>
			Preuves<span class="pro-tag__sep">·</span><svg class="pro-tag__star" viewBox="0 0 12 12"><path d="M6 .9l1.53 3.18 3.47.46-2.53 2.42.63 3.44L6 8.73 2.9 10.4l.63-3.44L1 4.54l3.47-.46z" fill="currentColor"></path></svg><span class="pro-tag__num">4,9</span>
		</span>
	</div>
	<div class="pro-tag" style={tagStyle(3)}>
		<span class="pro-tag__inner" data-pro-label>
			Pages clés<span class="pro-tag__sep">·</span><span class="pro-tag__num">12</span>
		</span>
	</div>
</div>

<style>
	.pro-scene {
		/* Un pixel de viewBox à l'écran (SVG en « meet »). */
		--u: min(100cqw / var(--view-w), 100cqh / var(--view-h));
		font-family: var(--font-sans);
	}

	.pro-led {
		fill: #34d399;
	}

	.pro-tag {
		align-items: center;
		display: flex;
		height: 0;
		left: calc(50cqw + (var(--x) - var(--view-w) / 2) * var(--u));
		position: absolute;
		top: calc(50cqh + (var(--y) - var(--view-h) / 2) * var(--u));
	}

	.pro-tag__inner {
		align-items: center;
		color: var(--color-gray-600);
		display: flex;
		font-size: clamp(11px, 11.5 * var(--u), 14px);
		font-weight: 500;
		line-height: 1;
		white-space: nowrap;
	}

	.pro-tag__inner--base {
		align-items: flex-start;
		flex-direction: column;
		gap: 0.3em;
		/* La 2e ligne pend sous la ligne de rappel. */
		transform: translateY(0.62em);
	}

	.pro-tag__title {
		align-items: center;
		color: var(--color-gray-900);
		display: flex;
	}

	.pro-tag__dot {
		background: var(--color-emerald-500);
		border-radius: 999px;
		height: 6px;
		margin-right: 0.4em;
		width: 6px;
	}

	.pro-tag__sub {
		color: var(--color-gray-500);
		font-size: clamp(10px, 8.6 * var(--u), 12px);
		font-weight: 400;
		padding-left: calc(6px + 0.4em);
	}

	.pro-tag__sep {
		color: var(--color-gray-300);
		margin-inline: 0.36em;
	}

	.pro-tag__num {
		color: var(--color-gray-900);
		font-variant-numeric: tabular-nums;
	}

	.pro-tag__star {
		color: var(--color-blue-500);
		height: 0.9em;
		margin-right: 0.2em;
		width: 0.9em;
	}

	/* « On ouvre le capot » : la vue s'éclate davantage au survol / focus. */
	@media (prefers-reduced-motion: no-preference) {
		.pro-lift,
		.pro-tag,
		.pro-ground,
		.pro-led {
