---
/**
 * Scène animée "Refonte" : une fenêtre "Avant" terne et désalignée, une flèche,
 * puis une fenêtre "Après" dont les blocs se remettent en place en boucle.
 * Les boucles sont pilotées par Anime.js depuis ServicesBentoGrid.astro.
 */
---

<div class="refonte-scene pointer-events-none relative flex h-full w-full items-center justify-center overflow-hidden" data-bento-visual="refonte" aria-hidden="true">
	<div class="refonte-stage relative flex items-center gap-3 transition-transform duration-500 ease-out group-hover:scale-[1.03] sm:gap-4">
		<div class="relative w-[136px] -rotate-[1.5deg] rounded-lg border border-red-200/80 bg-red-50/70 opacity-95 shadow-[0_12px_26px_-18px_rgba(34,42,55,0.35)] sm:w-[152px]">
			<div class="flex items-center gap-1 border-b border-red-100/80 px-2.5 py-1.5">
				<span class="size-1 rounded-full bg-red-300/90"></span>
				<span class="size-1 rounded-full bg-red-300/70"></span>
				<span class="size-1 rounded-full bg-red-300/50"></span>
			</div>
			<div class="flex flex-col gap-[6px] px-2.5 pt-2.5 pb-3">
				<span class="h-2 w-[88%] rounded-full bg-red-300/70"></span>
				<span class="h-2 w-[52%] translate-x-2 -rotate-2 rounded-full bg-red-200/70"></span>
				<span class="h-2 w-[70%] rounded-full bg-red-200/50"></span>
				<span class="h-3 w-8 rotate-1 rounded-sm bg-red-300/60"></span>
			</div>
			<span class="absolute -top-2 left-2 rounded-full border border-red-200 bg-red-50 px-1.5 py-0.5 text-[8px] font-medium text-red-700 shadow-sm">Avant</span>
		</div>

		<span class="refonte-arrow flex size-7 shrink-0 items-center justify-center rounded-full border border-gray-100 bg-white shadow-[0_10px_20px_-12px_rgba(34,42,55,0.45)]" data-bento-refonte-arrow>
			<svg class="size-3 text-emerald-600" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
				<path d="M2.5 8h11M9.5 4l4 4-4 4"></path>
			</svg>
		</span>

		<div class="relative w-[136px] rotate-[1deg] rounded-lg border border-emerald-200/80 bg-white shadow-[0_16px_32px_-22px_rgba(34,42,55,0.35)] sm:w-[152px]">
			<div class="flex items-center gap-1 border-b border-emerald-100/80 px-2.5 py-1.5">
				<span class="size-1 rounded-full bg-emerald-300/90"></span>
				<span class="size-1 rounded-full bg-emerald-300/70"></span>
				<span class="size-1 rounded-full bg-emerald-300/50"></span>
			</div>
			<div class="flex flex-col gap-[6px] px-2.5 pt-2.5 pb-3">
				<span class="refonte-row-1 h-2 w-[85%] rounded-full bg-emerald-300" data-bento-refonte-row></span>
				<span class="refonte-row-2 h-2 w-[62%] rounded-full bg-gray-200" data-bento-refonte-row></span>
				<span class="refonte-row-3 h-2 w-[74%] rounded-full bg-gray-100" data-bento-refonte-row></span>
				<span class="refonte-row-4 h-3.5 w-10 rounded-full bg-emerald-500 shadow-sm" data-bento-refonte-row></span>
			</div>
			<span class="absolute -top-2 left-2 rounded-full border border-emerald-200 bg-emerald-50 px-1.5 py-0.5 text-[8px] font-medium text-emerald-700 shadow-sm">Après</span>
		</div>
	</div>

</div>

<style>
	.refonte-arrow {
		will-change: transform;
	}

	.refonte-row-1,
	.refonte-row-2,
	.refonte-row-3,
	.refonte-row-4 {
		will-change: opacity, transform;
	}
</style>
