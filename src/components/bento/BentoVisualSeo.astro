---
import SquareChartSearch from "@/components/icons/nucleo/square-chart-search-fill.svg";

/**
 * Scène animée "SEO & mise en ligne" : une page de résultats où la ligne du
 * client grimpe de la 3e à la 2e puis à la 1re position (les rangs restent
 * fixes en gouttière), balayage lumineux à l'arrivée, badge "1ʳᵉ position"
 * Chorégraphie pilotée par src/scripts/animations/bento/seo.ts.
 * Sans JS : le client est 1er, badge visible.
 */
---

<div
	class="seo-scene pointer-events-none relative flex h-full w-full items-center justify-center overflow-hidden"
	data-bento-visual="seo"
	aria-hidden="true"
>
	<div class="seo-stage relative scale-[var(--bento-scene-scale,1)] transition-transform duration-500 ease-out group-hover:scale-[calc(var(--bento-scene-scale,1)*1.03)]">
		<div class="w-[196px] rounded-xl border border-gray-200/80 bg-white p-2.5 shadow-[0_18px_36px_-22px_rgba(34,42,55,0.4)]">
			<div class="flex items-center gap-1.5 rounded-full bg-gray-100 px-2.5 py-[5px]">
				<span class="seo-lens flex shrink-0" data-bento-seo-lens>
					<SquareChartSearch class="size-[18px] text-gray-400" />
				</span>
				<span class="truncate text-[8px] font-medium text-gray-500">votre métier + votre ville</span>
			</div>

			<div class="mt-2 flex gap-1.5">
				<div class="flex flex-col gap-[5px]">
					<span class="seo-rank">1</span>
					<span class="seo-rank">2</span>
					<span class="seo-rank">3</span>
				</div>

				<div class="seo-list flex min-w-0 flex-1 flex-col gap-[5px]" data-bento-seo-list>
					<div class="seo-row-mine relative flex h-5 items-center gap-1.5 overflow-hidden rounded-md bg-blue-50 px-1.5 ring-1 ring-blue-200/80" data-bento-seo-row="mine">
						<span class="size-2 shrink-0 rounded-full bg-[#3e60d4]"></span>
						<span class="h-1.5 w-16 rounded-full bg-gray-400/70"></span>
						<span class="h-1.5 w-8 rounded-full bg-gray-200"></span>
						<span class="seo-sweep absolute top-0 bottom-0 left-0 w-7 bg-gradient-to-r from-transparent via-white to-transparent" data-bento-seo-sweep></span>
					</div>
					<div class="seo-row flex h-5 items-center gap-1.5 rounded-md px-1.5" data-bento-seo-row="other-1">
						<span class="size-2 shrink-0 rounded-full bg-gray-200"></span>
						<span class="h-1.5 w-14 rounded-full bg-gray-200"></span>
						<span class="h-1.5 w-6 rounded-full bg-gray-100"></span>
					</div>
					<div class="seo-row flex h-5 items-center gap-1.5 rounded-md px-1.5" data-bento-seo-row="other-2">
						<span class="size-2 shrink-0 rounded-full bg-gray-200"></span>
						<span class="h-1.5 w-12 rounded-full bg-gray-200"></span>
						<span class="h-1.5 w-9 rounded-full bg-gray-100"></span>
					</div>
				</div>
			</div>
		</div>

		<span class="seo-chip absolute -right-3 top-8 flex items-center gap-1 rounded-full bg-blue-500 px-2 py-1 text-[8px] font-semibold text-white shadow-sm" data-bento-seo-chip>
			<svg class="size-2" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
				<path d="M8 13V3M4 7l4-4 4 4"></path>
			</svg>
			1ʳᵉ position
		</span>

	</div>
</div>

<style>
	.seo-rank {
		align-items: center;
		color: rgba(112, 122, 135, 0.55);
		display: flex;
		font-family: var(--font-mono, ui-monospace, monospace);
		font-size: 7px;
		height: 1.25rem;
		justify-content: center;
		line-height: 1;
		width: 0.65rem;
	}

	.seo-lens {
		transform-origin: center;
		will-change: transform;
	}

	.seo-row-mine,
	.seo-row {
		will-change: transform;
	}

	.seo-sweep {
		opacity: 0;
		will-change: opacity, transform;
	}

	.seo-chip {
		transform-origin: center;
		will-change: opacity, transform;
	}

</style>
