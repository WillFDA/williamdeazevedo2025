---
/**
 * Scène animée "SEO & mise en ligne" : une page de résultats de recherche où
 * la ligne du client grimpe de la 3e à la 1re position (boucle 7s), avec un
 * badge "1ʳᵉ position" et une pastille "En ligne" qui pulse.
 */
---

<div class="seo-scene pointer-events-none relative flex h-full w-full items-center justify-center overflow-hidden" aria-hidden="true">
	<div class="scene-backdrop absolute inset-0"></div>

	<div class="seo-stage relative transition-transform duration-500 ease-out group-hover:scale-[1.03]">
		<div class="w-[196px] rounded-xl border border-gray-200/80 bg-white p-2.5 shadow-[0_18px_36px_-22px_rgba(34,42,55,0.4)]">
			<div class="flex items-center gap-1.5 rounded-full bg-gray-100 px-2.5 py-[5px]">
				<svg class="size-2.5 shrink-0 text-gray-400" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
					<circle cx="7" cy="7" r="4.5"></circle>
					<path d="M13.5 13.5L10.5 10.5"></path>
				</svg>
				<span class="truncate text-[8px] font-medium text-gray-500">votre métier + votre ville</span>
			</div>

			<div class="seo-list mt-2 flex flex-col gap-[5px]">
				<div class="seo-row-mine flex h-5 items-center gap-1.5 rounded-md bg-orange-50 px-1.5 ring-1 ring-orange-200/80">
					<span class="size-2 shrink-0 rounded-full bg-[#f6821f]"></span>
					<span class="h-1.5 w-16 rounded-full bg-gray-400/70"></span>
					<span class="h-1.5 w-8 rounded-full bg-gray-200"></span>
				</div>
				<div class="seo-row-other-1 flex h-5 items-center gap-1.5 rounded-md px-1.5">
					<span class="size-2 shrink-0 rounded-full bg-gray-200"></span>
					<span class="h-1.5 w-14 rounded-full bg-gray-200"></span>
					<span class="h-1.5 w-6 rounded-full bg-gray-100"></span>
				</div>
				<div class="seo-row-other-2 flex h-5 items-center gap-1.5 rounded-md px-1.5">
					<span class="size-2 shrink-0 rounded-full bg-gray-200"></span>
					<span class="h-1.5 w-12 rounded-full bg-gray-200"></span>
					<span class="h-1.5 w-9 rounded-full bg-gray-100"></span>
				</div>
			</div>
		</div>

		<span class="seo-chip absolute -right-3 top-8 rounded-full bg-[#f6821f] px-2 py-1 text-[8px] font-semibold text-white shadow-[0_10px_20px_-10px_rgba(246,130,31,0.9)]">1ʳᵉ position</span>

		<span class="absolute -bottom-2.5 -left-2 flex items-center gap-1.5 rounded-full border border-gray-100 bg-white px-2 py-1 shadow-[0_12px_24px_-14px_rgba(34,42,55,0.4)]">
			<span class="relative flex size-1.5">
				<span class="seo-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400"></span>
				<span class="relative inline-flex size-1.5 rounded-full bg-emerald-500"></span>
			</span>
			<span class="text-[8px] font-medium text-gray-600">En ligne</span>
		</span>
	</div>

</div>

<style>
	.seo-scene,
	.seo-scene * {
		animation-play-state: var(--bento-play, running) !important;
	}

	.scene-backdrop {
		background: radial-gradient(
			120% 90% at 50% 0%,
			rgba(246, 130, 31, 0.07),
			transparent 70%
		);
	}

	.seo-list {
		animation: seo-list 7s ease-in-out infinite;
	}

	@keyframes seo-list {
		0%,
		90% {
			opacity: 1;
		}
		92.5%,
		96% {
			opacity: 0;
		}
		99%,
		100% {
			opacity: 1;
		}
	}

	.seo-row-mine,
	.seo-row-other-1,
	.seo-row-other-2 {
		will-change: transform;
	}

	.seo-row-mine {
		animation: seo-row-mine 7s ease-in-out infinite;
	}

	@keyframes seo-row-mine {
		0%,
		28% {
			transform: translate3d(0, 50px, 0);
		}
		38%,
		52% {
			transform: translate3d(0, 25px, 0);
		}
		62%,
		92.5% {
			transform: translate3d(0, 0, 0);
		}
		94.5%,
		100% {
			transform: translate3d(0, 50px, 0);
		}
	}

	.seo-row-other-1 {
		animation: seo-row-other-1 7s ease-in-out infinite;
	}

	@keyframes seo-row-other-1 {
		0%,
		52% {
			transform: translate3d(0, -25px, 0);
		}
		62%,
		92.5% {
			transform: translate3d(0, 0, 0);
		}
		94.5%,
		100% {
			transform: translate3d(0, -25px, 0);
		}
	}

	.seo-row-other-2 {
		animation: seo-row-other-2 7s ease-in-out infinite;
	}

	@keyframes seo-row-other-2 {
		0%,
		28% {
			transform: translate3d(0, -25px, 0);
		}
		38%,
		92.5% {
			transform: translate3d(0, 0, 0);
		}
		94.5%,
		100% {
			transform: translate3d(0, -25px, 0);
		}
	}

	.seo-chip {
		animation: seo-chip 7s ease-out infinite;
		opacity: 0;
	}

	@keyframes seo-chip {
		0%,
		63% {
			opacity: 0;
			transform: scale(0.8);
		}
		68%,
		86% {
			opacity: 1;
			transform: scale(1);
		}
		92%,
		100% {
			opacity: 0;
			transform: scale(0.9);
		}
	}

	.seo-ping {
		animation: seo-ping 2.2s cubic-bezier(0, 0, 0.2, 1) infinite;
	}

	@keyframes seo-ping {
		0% {
			opacity: 0.7;
			transform: scale(1);
		}
		70%,
		100% {
			opacity: 0;
			transform: scale(2.4);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.seo-scene,
		.seo-scene * {
			animation: none !important;
		}
	}
</style>
