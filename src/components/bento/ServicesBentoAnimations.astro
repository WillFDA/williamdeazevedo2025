<script>
    import {
        destroyBentoVisuals,
        initBentoVisuals,
    } from "@/scripts/animations/bento/runtime";

    const servicesBentoWindow = window as Window & {
        __wuiServicesBentoReady?: boolean;
    };

    initBentoVisuals();

    if (!servicesBentoWindow.__wuiServicesBentoReady) {
        servicesBentoWindow.__wuiServicesBentoReady = true;
        document.addEventListener("astro:before-swap", destroyBentoVisuals);
        document.addEventListener("astro:page-load", initBentoVisuals);
    }
</script>
