---
type TagName = "span" | "a" | "button" | "div" | "p" | "strong" | "em";
type Trigger = "self" | "parent";

interface Props {
    as?: TagName;
    text: string;
    stagger?: number;
    trigger?: Trigger;
    class?: string;
}

const {
    as = "span",
    text,
    stagger = 8,
    trigger = "self",
    class: className,
    ...attrs
} = Astro.props;

const Tag = as;
let charIndex = 0;
const splitWords = text.trim()
    ? text.trim().split(/\s+/).map((word) => ({
          word,
          chars: Array.from(word).map((char) => ({
              char,
              index: charIndex++,
          })),
      }))
    : [];
---

<Tag
    {...attrs}
    class:list={["wui-wave-text", className]}
    data-wui-wave-text
    data-wui-wave-stagger={stagger}
    data-wui-wave-trigger={trigger}
>
    <span class="wui-wave-text__screen-reader">{text}</span>

    <span class="wui-wave-text__stage" aria-hidden="true">
        <span class="wui-wave-text__row" data-wui-wave-row="first">
            {
                splitWords.map(({ chars, word }) => (
                    <span class="wui-wave-text__word" data-wui-wave-word={word}>
                        {chars.map(({ char, index }) => (
                            <span
                                data-wui-wave-char
                                data-wui-wave-index={index}
                                style={`--wui-wave-delay: ${index * stagger}ms`}
                            >
                                {char}
                            </span>
                        ))}
                    </span>
                ))
            }
        </span>

        <span class="wui-wave-text__row" data-wui-wave-row="second">
            {
                splitWords.map(({ chars, word }) => (
                    <span class="wui-wave-text__word" data-wui-wave-word={word}>
                        {chars.map(({ char, index }) => (
                            <span
                                data-wui-wave-char
                                data-wui-wave-index={index}
                                style={`--wui-wave-delay: ${index * stagger}ms`}
                            >
                                {char}
                            </span>
                        ))}
                    </span>
                ))
            }
        </span>
    </span>
</Tag>

<script>
    import { animate, spring, stagger } from "animejs";

    const activeAnimations = new WeakMap<HTMLElement, Array<{ cancel: () => void }>>();

    const cancelWaveTextAnimations = (root: HTMLElement) => {
        activeAnimations.get(root)?.forEach((animation) => animation.cancel());
        activeAnimations.delete(root);
    };

    const setWaveTextState = (root: HTMLElement, active: boolean) => {
        root
            .querySelectorAll<HTMLElement>(
                '[data-wui-wave-row="first"] [data-wui-wave-char]',
            )
            .forEach((char) => {
                char.style.transform = `translateY(${active ? "-115%" : "0%"})`;
            });

        root
            .querySelectorAll<HTMLElement>(
                '[data-wui-wave-row="second"] [data-wui-wave-char]',
            )
            .forEach((char) => {
                char.style.transform = `translateY(${active ? "0%" : "115%"})`;
            });
    };

    const animateWaveText = (root: HTMLElement, active: boolean) => {
        if (root.dataset.wuiWaveTextActive === String(active)) return;

        root.dataset.wuiWaveTextActive = String(active);
        cancelWaveTextAnimations(root);

        const firstRowChars = root.querySelectorAll<HTMLElement>(
            '[data-wui-wave-row="first"] [data-wui-wave-char]',
        );
        const secondRowChars = root.querySelectorAll<HTMLElement>(
            '[data-wui-wave-row="second"] [data-wui-wave-char]',
        );
        const charDelay = Number(root.dataset.wuiWaveStagger) || 8;
        const transition = {
            delay: stagger(charDelay),
            ease: spring({ bounce: 0.16, duration: 340 }),
        };

        activeAnimations.set(root, [
            animate(firstRowChars, {
                y: active ? "-115%" : "0%",
                ...transition,
            }),
            animate(secondRowChars, {
                y: active ? "0%" : "115%",
                ...transition,
            }),
        ]);
    };

    const getWaveTextTrigger = (root: HTMLElement) =>
        root.dataset.wuiWaveTrigger === "parent"
            ? root.parentElement ?? root
            : root;

    const initWaveTexts = () => {
        const prefersReducedMotion = window.matchMedia(
            "(prefers-reduced-motion: reduce)",
        ).matches;

        document
            .querySelectorAll<HTMLElement>("[data-wui-wave-text]")
            .forEach((root) => {
                if (root.dataset.wuiWaveTextReady === "true") return;

                root.dataset.wuiWaveTextReady = "true";
                root.dataset.wuiWaveTextActive = "false";
                setWaveTextState(root, false);

                if (prefersReducedMotion) return;

                const trigger = getWaveTextTrigger(root);

                trigger.addEventListener("pointerenter", () =>
                    animateWaveText(root, true),
                );
                trigger.addEventListener("pointerleave", () =>
                    animateWaveText(root, false),
                );
                trigger.addEventListener("focusin", () =>
                    animateWaveText(root, true),
                );
                trigger.addEventListener("focusout", () =>
                    animateWaveText(root, false),
                );
            });
    };

    initWaveTexts();
    document.addEventListener("astro:page-load", initWaveTexts);
</script>

<style>
    .wui-wave-text {
        align-items: center;
        color: inherit;
        display: inline-flex;
        line-height: 1;
        position: relative;
        text-decoration: inherit;
        width: fit-content;
    }

    .wui-wave-text__stage {
        display: grid;
        line-height: inherit;
        overflow: clip;
    }

    .wui-wave-text__row {
        align-items: center;
        display: flex;
        gap: 0.25em;
        grid-area: 1 / 1;
        justify-content: center;
    }

    .wui-wave-text__word {
        display: inline-flex;
        white-space: nowrap;
    }

    [data-wui-wave-char] {
        display: inline-block;
        will-change: transform;
    }

    [data-wui-wave-row="first"] [data-wui-wave-char] {
        transform: translateY(0%);
    }

    [data-wui-wave-row="second"] [data-wui-wave-char] {
        transform: translateY(115%);
    }

    .wui-wave-text:not([data-wui-wave-text-ready="true"])
        [data-wui-wave-char] {
        transition: transform 520ms
            var(--wui-ease-standard, cubic-bezier(0.2, 0, 0, 1));
        transition-delay: var(--wui-wave-delay, 0ms);
    }

    .wui-wave-text:not([data-wui-wave-text-ready="true"]):hover
        [data-wui-wave-row="first"]
        [data-wui-wave-char],
    .wui-wave-text:not([data-wui-wave-text-ready="true"]):focus-visible
        [data-wui-wave-row="first"]
        [data-wui-wave-char],
    :global(:where(a, button, [data-wui-wave-parent]):hover)
        .wui-wave-text[data-wui-wave-trigger="parent"]:not(
            [data-wui-wave-text-ready="true"]
        )
        [data-wui-wave-row="first"]
        [data-wui-wave-char],
    :global(:where(a, button, [data-wui-wave-parent]):focus-visible)
        .wui-wave-text[data-wui-wave-trigger="parent"]:not(
            [data-wui-wave-text-ready="true"]
        )
        [data-wui-wave-row="first"]
        [data-wui-wave-char],
    :global(:where(a, button, [data-wui-wave-parent]):focus-within)
        .wui-wave-text[data-wui-wave-trigger="parent"]:not(
            [data-wui-wave-text-ready="true"]
        )
        [data-wui-wave-row="first"]
        [data-wui-wave-char] {
        transform: translateY(-115%);
    }

    .wui-wave-text:not([data-wui-wave-text-ready="true"]):hover
        [data-wui-wave-row="second"]
        [data-wui-wave-char],
    .wui-wave-text:not([data-wui-wave-text-ready="true"]):focus-visible
        [data-wui-wave-row="second"]
        [data-wui-wave-char],
    :global(:where(a, button, [data-wui-wave-parent]):hover)
        .wui-wave-text[data-wui-wave-trigger="parent"]:not(
            [data-wui-wave-text-ready="true"]
        )
        [data-wui-wave-row="second"]
        [data-wui-wave-char],
    :global(:where(a, button, [data-wui-wave-parent]):focus-visible)
        .wui-wave-text[data-wui-wave-trigger="parent"]:not(
            [data-wui-wave-text-ready="true"]
        )
        [data-wui-wave-row="second"]
        [data-wui-wave-char],
    :global(:where(a, button, [data-wui-wave-parent]):focus-within)
        .wui-wave-text[data-wui-wave-trigger="parent"]:not(
            [data-wui-wave-text-ready="true"]
        )
        [data-wui-wave-row="second"]
        [data-wui-wave-char] {
        transform: translateY(0%);
    }

    .wui-wave-text__screen-reader {
        border: 0;
        clip: rect(0, 0, 0, 0);
        height: 1px;
        margin: -1px;
        overflow: hidden;
        padding: 0;
        position: absolute;
        white-space: nowrap;
        width: 1px;
    }

    @media (prefers-reduced-motion: reduce) {
        [data-wui-wave-row="second"] {
            display: none;
        }

        .wui-wave-text [data-wui-wave-char] {
            transform: translateY(0%) !important;
            transition: none;
            will-change: auto;
        }
    }
</style>
