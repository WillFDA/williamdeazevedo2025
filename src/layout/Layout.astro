---
import { ClientRouter } from "astro:transitions";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import CalDrawer from "../components/CalDrawer.astro";
import "../styles/global.css";

interface Props {
    title?: string;
    description?: string;
    image?: string;
    imageAlt?: string;
    ogType?: "website" | "article" | "profile";
    article?: {
        publishedTime?: string;
        modifiedTime?: string;
        author?: string;
        tags?: string[];
    };
}

const {
    title = "William De Azevedo - Développeur front-end freelance",
    description = "Développeur front-end freelance orienté design et produit, je crée des sites rapides, accessibles et pensés pour convertir.",
    image = "/pictures/william-low.png",
    imageAlt = "William De Azevedo, développeur front-end freelance",
    ogType = "website",
    article,
} = Astro.props;

const siteName = "William De Azevedo";
const siteUrl = Astro.site ?? Astro.url;
const canonicalUrl = new URL(Astro.url.pathname, siteUrl);
const imageUrl = new URL(image, siteUrl);
const googleAnalyticsId = "G-9G8R67JBFF";

const personJsonLd = {
    "@context": "https://schema.org",
    "@type": "Person",
    name: "William De Azevedo",
    url: siteUrl.href,
    image: imageUrl.href,
    jobTitle: "Développeur front-end freelance",
    description:
        "Développeur front-end freelance orienté design et produit, je crée des sites rapides, accessibles et pensés pour convertir.",
    sameAs: [
        "https://www.linkedin.com/in/william-de-azevedo/",
        "https://github.com/WillFDA",
        "https://www.malt.fr/profile/williamferreiradeazevedo",
    ],
    knowsAbout: [
        "Astro",
        "React",
        "Next.js",
        "TypeScript",
        "Tailwind CSS",
        "SEO technique",
        "Accessibilité web",
        "UI design",
    ],
    address: {
        "@type": "PostalAddress",
        addressRegion: "Île-de-France",
        addressCountry: "FR",
    },
    worksFor: {
        "@type": "Organization",
        name: "William De Azevedo — Développeur freelance",
    },
};
---

<html lang="fr">
    <head>
        <meta charset="utf-8" />
        <link rel="icon" href="/favicon.ico" sizes="any" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link
            rel="icon"
            type="image/png"
            sizes="96x96"
            href="/favicon-96x96.png"
        />
        <link
            rel="apple-touch-icon"
            sizes="180x180"
            href="/apple-touch-icon.png"
        />
        <link rel="manifest" href="/site.webmanifest" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="theme-color" content="#ffffff" />
        <meta name="generator" content={Astro.generator} />
        {/* Client-side routing + view transitions. Swaps the DOM in place so
            navigation no longer triggers a full reload (the white flash) and
            fires the astro:page-load / astro:before-swap lifecycle the
            interactive components rely on to (re)initialise. */}
        <ClientRouter />
        <meta name="description" content={description} />
        <link rel="canonical" href={canonicalUrl.href} />
        <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
        <meta property="og:locale" content="fr_FR" />
        <meta property="og:site_name" content={siteName} />
        <meta property="og:type" content={ogType} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={canonicalUrl.href} />
        <meta property="og:image" content={imageUrl.href} />
        <meta property="og:image:alt" content={imageAlt} />
        {
            article && (
                <>
                    {article.publishedTime && (
                        <meta
                            property="article:published_time"
                            content={article.publishedTime}
                        />
                    )}
                    {article.modifiedTime && (
                        <meta
                            property="article:modified_time"
                            content={article.modifiedTime}
                        />
                    )}
                    {article.author && (
                        <meta
                            property="article:author"
                            content={article.author}
                        />
                    )}
                    {article.tags?.map((tag) => (
                        <meta property="article:tag" content={tag} />
                    ))}
                </>
            )
        }
        <meta name="twitter:card" content="summary" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={imageUrl.href} />
        <meta name="twitter:image:alt" content={imageAlt} />
        <script
            type="application/ld+json"
            is:inline
            set:html={JSON.stringify(personJsonLd)}
        />
        <title>{title}</title>
    </head>
    <body class="min-h-screen min-w-0 flex flex-col">
        <a class="skip-link" href="#main-content">
            Aller au contenu principal
        </a>
        <Header pathName={Astro.url.pathname} />
        <main id="main-content" tabindex="-1" class="flex-1 flex flex-col gap-8">
            <slot />
        </main>
        <Footer />
        <CalDrawer />
        <div
            class="cookie-consent"
            data-cookie-banner
            role="region"
            aria-label="Préférences cookies"
        >
            <div class="cookie-consent__copy">
                <p class="cookie-consent__title">Mesure d'audience</p>
                <p>
                    J'utilise Google Analytics pour comprendre les visites du
                    site. Il ne se charge qu'après votre accord.
                </p>
            </div>
            <div class="cookie-consent__actions">
                <button
                    class="cookie-consent__button"
                    data-cookie-consent="refused"
                    type="button"
                >
                    Refuser
                </button>
                <button
                    class="cookie-consent__button cookie-consent__button--primary"
                    data-cookie-consent="accepted"
                    type="button"
                >
                    Accepter
                </button>
            </div>
        </div>
        <script is:inline data-ga-id={googleAnalyticsId}>
            (() => {
                const currentScript = document.currentScript;
                const gaId = currentScript?.dataset.gaId;
                const consentKey = "wui-cookie-consent";
                const accepted = "accepted";
                const refused = "refused";
                const deniedConsent = {
                    ad_personalization: "denied",
                    ad_storage: "denied",
                    ad_user_data: "denied",
                    analytics_storage: "denied",
                };

                const getBanner = () =>
                    document.querySelector("[data-cookie-banner]");

                const showBanner = () => {
                    const banner = getBanner();

                    if (banner instanceof HTMLElement) {
                        banner.dataset.cookieBannerVisible = "";
                    }
                };

                const hideBanner = () => {
                    const banner = getBanner();

                    if (banner instanceof HTMLElement) {
                        delete banner.dataset.cookieBannerVisible;
                    }
                };

                const getChoice = () => {
                    try {
                        return localStorage.getItem(consentKey);
                    } catch {
                        return null;
                    }
                };

                const setChoice = (choice) => {
                    try {
                        localStorage.setItem(consentKey, choice);
                    } catch {
                        // Storage can be unavailable in private or locked-down contexts.
                    }
                };

                const expireCookie = (name, domain) => {
                    // oxlint-disable-next-line unicorn/no-document-cookie -- Cookie Store API support is still uneven.
                    document.cookie = `${name}=; Max-Age=0; path=/${domain ? `; domain=${domain}` : ""}; SameSite=Lax`;
                };

                const clearAnalyticsCookies = () => {
                    const hostname = window.location.hostname;
                    const rootDomain = hostname.split(".").slice(-2).join(".");
                    const domains = new Set([
                        "",
                        hostname,
                        `.${hostname}`,
                        rootDomain,
                        `.${rootDomain}`,
                    ]);

                    // oxlint-disable-next-line unicorn/no-document-cookie -- GA cookies are legacy cookies.
                    document.cookie.split(";").forEach((cookie) => {
                        const name = cookie.split("=")[0]?.trim();

                        if (!name || !/^_(?:ga|gid|gat)/.test(name)) {
                            return;
                        }

                        domains.forEach((domain) => expireCookie(name, domain));
                    });
                };

                const disableAnalytics = () => {
                    if (gaId) {
                        window[`ga-disable-${gaId}`] = true;
                    }

                    if (typeof window.gtag === "function") {
                        window.gtag("consent", "update", deniedConsent);
                    }

                    clearAnalyticsCookies();
                };

                const sendPageView = () => {
                    if (typeof window.gtag !== "function") {
                        return;
                    }

                    const pageKey = `${location.href}|${document.title}`;

                    if (window.__wuiAnalyticsLastPageview === pageKey) {
                        return;
                    }

                    window.__wuiAnalyticsLastPageview = pageKey;
                    window.gtag("event", "page_view", {
                        page_location: location.href,
                        page_path: location.pathname + location.search,
                        page_title: document.title,
                    });
                };

                const loadAnalytics = () => {
                    if (!gaId) {
                        return;
                    }

                    window[`ga-disable-${gaId}`] = false;
                    window.dataLayer ||= [];
                    window.gtag ||=
                        function gtag(...args) {
                            window.dataLayer.push(args);
                        };

                    if (!window.__wuiAnalyticsLoaded) {
                        window.__wuiAnalyticsLoaded = true;

                        const tag = document.createElement("script");
                        tag.async = true;
                        tag.src = `https://www.googletagmanager.com/gtag/js?id=${encodeURIComponent(gaId)}`;
                        document.head.append(tag);

                        window.gtag("consent", "default", deniedConsent);
                        window.gtag("js", new Date());
                        window.gtag("config", gaId, {
                            send_page_view: false,
                        });
                    }

                    window.gtag("consent", "update", {
                        ...deniedConsent,
                        analytics_storage: "granted",
                    });

                    if (!window.__wuiAnalyticsPageviewBound) {
                        window.__wuiAnalyticsPageviewBound = true;
                        document.addEventListener("astro:page-load", sendPageView);
                    }

                    sendPageView();
                };

                const applyChoice = (choice) => {
                    setChoice(choice);
                    document.documentElement.dataset.cookieConsent = choice;
                    hideBanner();

                    if (choice === accepted) {
                        loadAnalytics();
                        return;
                    }

                    disableAnalytics();
                };

                if (!window.__wuiCookieConsentBound) {
                    window.__wuiCookieConsentBound = true;
                    document.addEventListener("click", (event) => {
                        const target = event.target;

                        if (!(target instanceof Element)) {
                            return;
                        }

                        const consentButton = target.closest(
                            "[data-cookie-consent]",
                        );

                        if (consentButton instanceof HTMLElement) {
                            const choice = consentButton.dataset.cookieConsent;

                            if (choice === accepted || choice === refused) {
                                applyChoice(choice);
                            }

                            return;
                        }

                        if (target.closest("[data-cookie-settings]")) {
                            event.preventDefault();
                            showBanner();
                        }
                    });
                }

                const init = () => {
                    const choice = getChoice();

                    if (choice === accepted || choice === refused) {
                        applyChoice(choice);
                        return;
                    }

                    showBanner();
                };

                if (document.readyState === "loading") {
                    document.addEventListener("DOMContentLoaded", init, {
                        once: true,
                    });
                    return;
                }

                init();
            })();
        </script>
    </body>
</html>

<style>
    /* Keyboard "skip to content" shortcut: hidden until focused. */
    .skip-link {
        position: fixed;
        top: 0.75rem;
        left: 0.75rem;
        z-index: 100;
        padding: 0.6rem 1rem;
        border-radius: 0.7rem;
        background: var(--color-coffee-300);
        color: var(--color-snow-50);
        font-size: 0.875rem;
        text-decoration: none;
        transform: translateY(-160%);
        transition: transform 220ms cubic-bezier(0.2, 0, 0, 1);
    }

    .skip-link:focus-visible {
        transform: translateY(0);
        outline: 2px solid var(--color-blue-500);
        outline-offset: 3px;
    }

    /* Don't paint a focus ring around <main> when focus is moved to it. */
    main:focus {
        outline: none;
    }

    .cookie-consent {
        position: fixed;
        right: 1rem;
        bottom: 1rem;
        left: 1rem;
        z-index: 80;
        display: none;
        grid-template-columns: 1fr;
        gap: 1rem;
        max-width: 42rem;
        margin-inline: auto;
        padding: 1rem;
        border: 1px solid rgba(229, 231, 235, 0.9);
        border-radius: 1rem;
        background: rgba(255, 255, 255, 0.96);
        box-shadow: 0 24px 70px -38px rgba(20, 16, 22, 0.45);
        color: var(--color-gray-600);
        backdrop-filter: blur(12px);
    }

    .cookie-consent[data-cookie-banner-visible] {
        display: grid;
    }

    .cookie-consent__copy {
        display: grid;
        gap: 0.35rem;
        font-size: 0.875rem;
        font-weight: 300;
        line-height: 1.55;
    }

    .cookie-consent__title {
        color: var(--color-gray-900);
        font-weight: 500;
    }

    .cookie-consent__actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
    }

    .cookie-consent__button {
        min-height: 2.75rem;
        flex: 1 1 8rem;
        border: 1px solid var(--color-snow-600);
        border-radius: 0.75rem;
        background: #fff;
        color: var(--color-gray-900);
        font: inherit;
        font-weight: 400;
        cursor: pointer;
    }

    .cookie-consent__button--primary {
        border-color: var(--color-blue-500);
        background: var(--color-blue-500);
        color: var(--color-snow-50);
    }

    .cookie-consent__button:focus-visible {
        outline: 2px solid var(--color-blue-500);
        outline-offset: 3px;
    }

    @media (min-width: 640px) {
        .cookie-consent {
            grid-template-columns: 1fr auto;
            align-items: center;
        }

        .cookie-consent__actions {
            min-width: 17rem;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .skip-link {
            transition: none;
        }
    }
</style>
