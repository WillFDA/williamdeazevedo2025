---
import { Image } from "astro:assets";
import Layout from "../layout/Layout.astro";
import AboutCallout from "../components/AboutCallout.astro";
import FadeReveal from "../components/animations/FadeReveal.astro";
import Marquee from "../components/Marquee.astro";
import bourgetPicture from "@/assets/pictures/bourget-opti.jpg";
import desktopPicture from "@/assets/pictures/desktop-opti.jpg";
import gokuPicture from "@/assets/pictures/goku-opti.jpg";
import maderePicture from "@/assets/pictures/madere-opti.jpg";
import majorquePicture from "@/assets/pictures/majorque-opti.jpg";

export const prerender = true;

const aboutHeroTitleWords = [
    "Du",
    "graphisme",
    "au",
    "code,",
    "je",
    "donne",
    "forme",
    "à",
    "des",
    "sites",
    "web",
    "utiles",
    "et",
    "soignés.",
];
const highlightedAboutHeroWords = new Set(["sites", "web", "utiles", "soignés."]);

const pictures = [
    {
        alt: "Photo prise au Bourget",
        className: "rotate-2",
        src: bourgetPicture,
    },
    {
        alt: "Photo de voyage à Majorque",
        className: "-rotate-2",
        src: majorquePicture,
    },
    {
        alt: "Photo de voyage à Madère",
        className: "rotate-2",
        src: maderePicture,
    },
    {
        alt: "Photo de Goku",
        className: "-rotate-2 hidden md:block",
        src: gokuPicture,
    },
    {
        alt: "Photo du setup de travail",
        className: "rotate-2 hidden md:block",
        src: desktopPicture,
    },
];
---

<Layout
    title="À propos - William De Azevedo"
    description="Développeur front-end avec une approche produit, design et full stack. Découvrez mon parcours, mes projets, mes compétences et mes formations."
>
    <div class="mx-auto flex w-full max-w-5xl flex-col gap-12 px-4 pb-16 sm:gap-16 sm:px-4 sm:pb-20">
        <section class="flex flex-col gap-6">
            <h1 class="flex max-w-full flex-wrap justify-center gap-x-[0.18em] text-center text-4xl font-medium leading-tighter tracking-normal text-gray-900 sm:text-6xl md:text-7xl">
                {
                    aboutHeroTitleWords.map((word, index) => (
                        <span
                            class:list={[
                                "about-hero-title-word",
                                highlightedAboutHeroWords.has(word) &&
                                    "text-coffee-300",
                            ]}
                            style={`--about-hero-word-index: ${index}`}
                        >
                            {word}
                        </span>
                    ))
                }
            </h1>
            <FadeReveal delay={0.32}>
                <p class="mx-auto max-w-120 text-center text-md font-light leading-tight text-coffee-300">
                    J'aime partir d'une idée, clarifier l'expérience, puis la
                    transformer en interface rapide, accessible et simple à
                    maintenir.
                </p>
            </FadeReveal>
            <Marquee />
        </section>

        <section class="mx-auto flex w-full max-w-2xl flex-col gap-4 text-center">
            <h2 class="text-base font-medium text-coffee-300">Parcours</h2>
            <div class="flex flex-col gap-4 text-sm font-light leading-6 text-coffee-300">
                <p>
                    Mon parcours dans l'infographie, la 3D et le motion design
                    m'a donné un <span class="font-normal text-coffee-300"
                        >œil aiguisé pour le design</span
                    > et une sensibilité forte pour les interfaces qui se comprennent
                    vite.
                </p>
                <p>
                    En 2022, j'ai fait le choix de me reconvertir dans le
                    développement web pour <span class="font-normal text-coffee-300"
                        >donner vie à mes propres projets</span
                    >. Depuis, je construis des expériences web avec une approche
                    front-end, produit et full stack.
                </p>
                <p>
                    Aujourd'hui, je travaille sur des sites vitrines, des
                    interfaces produit et des applications complètes, avec le
                    même objectif : livrer quelque chose de clair, rapide et
                    réellement utile.
                </p>
            </div>
        </section>

        <AboutCallout title="Je relie mon œil design au code pour créer des interfaces utiles." />

        <section class="relative left-1/2 w-[100dvw] -translate-x-1/2">
            <div class="photo-strip flex items-center justify-start gap-3 overflow-x-auto px-4 sm:px-4 md:justify-center md:gap-5 md:overflow-visible md:px-0">
                {
                    pictures.map((picture, index) => (
                        <div
                            class:list={[
                                "aspect-[9/10] w-36 shrink-0 overflow-hidden rounded-lg bg-gray-100 transition-transform duration-300 hover:scale-[1.02] sm:w-40 md:w-44",
                                picture.className,
                            ]}
                        >
                            <Image
                                alt={picture.alt}
                                class="h-full w-full object-cover"
                                loading={index < 3 ? "eager" : "lazy"}
                                widths={[176, 352]}
                                sizes="176px"
                                src={picture.src}
                            />
                        </div>
                    ))
                }
            </div>
        </section>
    </div>
</Layout>

<style>
    .about-hero-title-word {
        animation: about-hero-title-word 1100ms cubic-bezier(0.16, 1, 0.3, 1)
            backwards;
        animation-delay: calc(var(--about-hero-word-index, 0) * 65ms);
        display: inline-block;
    }

    @keyframes about-hero-title-word {
        from {
            filter: blur(10px);
            opacity: 0;
            transform: translateY(-0.65em);
        }

        to {
            filter: none;
            opacity: 1;
            transform: none;
        }
    }

    .photo-strip {
        scrollbar-width: none;
    }

    .photo-strip::-webkit-scrollbar {
        display: none;
    }

    @media (prefers-reduced-motion: reduce) {
        .about-hero-title-word {
            animation: none;
            filter: none;
            opacity: 1;
            transform: none;
        }
    }
</style>
