---
import { Image } from "astro:assets";
import { render } from "astro:content";
import ChevronLeft from "@/components/icons/nucleo/chevron-left-fill.svg";
import FadeReveal from "@/components/animations/FadeReveal.astro";
import williamPortrait from "@/assets/williamdeazevedo.webp";
import Layout from "@/layout/Layout.astro";
import { type Article, formatArticleDate, getVisibleArticles } from "@/lib/articles";

export async function getStaticPaths() {
    const articles = await getVisibleArticles();
    return articles.map((article) => ({
        params: { slug: article.id },
        props: { article },
    }));
}

interface Props {
    article: Article;
}

const { article } = Astro.props;
const { Content } = await render(article);
const { author, description, pubDate, tags, title, updatedDate } = article.data;

const siteUrl = Astro.site ?? new URL(Astro.url.origin);
const canonicalUrl = new URL(`/articles/${article.id}`, siteUrl);
const ogImage = new URL("/pictures/william-low.png", siteUrl);

const jsonLd = {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: title,
    description,
    inLanguage: "fr-FR",
    datePublished: pubDate.toISOString(),
    dateModified: (updatedDate ?? pubDate).toISOString(),
    image: ogImage.href,
    url: canonicalUrl.href,
    mainEntityOfPage: canonicalUrl.href,
    keywords: tags,
    author: {
        "@type": "Person",
        name: author,
        url: siteUrl.href,
    },
    publisher: {
        "@type": "Person",
        name: author,
        url: siteUrl.href,
    },
};

const breadcrumbJsonLd = {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
        {
            "@type": "ListItem",
            position: 1,
            name: "Accueil",
            item: siteUrl.href,
        },
        {
            "@type": "ListItem",
            position: 2,
            name: "Articles",
            item: new URL("/articles", siteUrl).href,
        },
        {
            "@type": "ListItem",
            position: 3,
            name: title,
            item: canonicalUrl.href,
        },
    ],
};
---

<Layout
    title={`${title} - William De Azevedo`}
    description={description}
    ogType="article"
    article={{
        publishedTime: pubDate.toISOString(),
        modifiedTime: (updatedDate ?? pubDate).toISOString(),
        author,
        tags,
    }}
>
    <script
        type="application/ld+json"
        is:inline
        set:html={JSON.stringify(jsonLd)}
    />
    <script
        type="application/ld+json"
        is:inline
        set:html={JSON.stringify(breadcrumbJsonLd)}
    />

    <article class="mx-auto w-full max-w-2xl px-2 pb-20 sm:px-4">
        <FadeReveal delay={0.1}>
            <header class="mb-12 text-center">
                <a
                    class="mb-6 inline-flex items-center gap-1.5 text-sm font-light text-gray-500 transition-colors hover:text-gray-900"
                    href="/articles"
                >
                    <ChevronLeft aria-hidden="true" class="size-4" />
                    Tous les articles
                </a>
                <h1 class="page-heading mb-4">
                    {title}
                </h1>
                <p class="page-subheading">{description}</p>
                {tags.length > 0 && (
                    <div class="mt-5 flex flex-wrap justify-center gap-2">
                        {tags.map((tag) => (
                            <span class="rounded-md border border-gray-200 bg-gray-50 px-2 py-0.5 text-xs font-normal text-gray-700">
                                {tag}
                            </span>
                        ))}
                    </div>
                )}
                <div class="mt-6 flex items-center justify-center gap-3">
                    <Image
                        class="size-9 rounded-full"
                        src={williamPortrait}
                        alt={`Photo de ${author}`}
                        width={36}
                        height={36}
                        loading="eager"
                    />
                    <div class="text-sm">
                        <p class="font-medium text-gray-900">{author}</p>
                        <time
                            class="font-light text-gray-500"
                            datetime={pubDate.toISOString()}
                        >
                            {formatArticleDate(pubDate)}
                        </time>
                    </div>
                </div>
            </header>
        </FadeReveal>

        <FadeReveal delay={0.25}>
            <div class="article-prose">
                <Content />
            </div>
        </FadeReveal>
    </article>
</Layout>

<style is:global>
    .article-prose {
        color: var(--color-gray-600);
        font-size: 0.9375rem;
        font-weight: 300;
        line-height: 1.75;
    }

    .article-prose > * + * {
        margin-top: 1.15rem;
    }

    .article-prose h2 {
        color: var(--color-gray-900);
        font-size: 1.25rem;
        font-weight: 500;
        line-height: 1.35;
        margin-top: 2.75rem;
    }

    .article-prose h3 {
        color: var(--color-gray-900);
        font-size: 1rem;
        font-weight: 500;
        line-height: 1.45;
        margin-top: 2.25rem;
    }

    .article-prose strong {
        color: var(--color-gray-900);
        font-weight: 500;
    }

    .article-prose a {
        color: inherit;
        text-decoration: underline;
        text-decoration-color: var(--color-gray-300);
        text-underline-offset: 2px;
        transition: color 200ms ease;
    }

    @media (hover: hover) {
        .article-prose a:hover {
            color: var(--color-gray-900);
        }
    }

    .article-prose ul,
    .article-prose ol {
        padding-left: 1.25rem;
    }

    .article-prose ul {
        list-style: disc;
    }

    .article-prose ol {
        list-style: decimal;
    }

    .article-prose li + li {
        margin-top: 0.35rem;
    }

    .article-prose blockquote {
        border-left: 2px solid var(--color-gray-200);
        color: var(--color-gray-500);
        font-style: italic;
        margin-block: 2rem;
        padding-left: 1rem;
    }

    .article-prose blockquote p {
        margin: 0;
    }

    .article-prose :not(pre) > code {
        background: var(--color-gray-100);
        border-radius: 0.25rem;
        color: var(--color-gray-900);
        font-size: 0.85em;
        padding: 0.15em 0.4em;
    }

    .article-prose pre {
        border-radius: 0.5rem;
        font-size: 0.8125rem;
        line-height: 1.6;
        margin-block: 1.75rem;
        overflow-x: auto;
        padding: 1rem 1.15rem;
    }

    .article-prose img {
        border-radius: 0.5rem;
        height: auto;
        margin-block: 1.75rem;
        width: 100%;
    }

    .article-prose hr {
        border: 0;
        border-top: 1px solid var(--color-gray-200);
        margin-block: 2.5rem;
    }
</style>
