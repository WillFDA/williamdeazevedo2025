---
import CalInline from "@/components/CalInline.astro";
import FadeReveal from "@/components/animations/FadeReveal.astro";
import Layout from "@/layout/Layout.astro";

export const prerender = true;

const usefulIf = [
    "vous envisagez un nouveau site vitrine",
    "votre site actuel ne vous représente plus",
    "vous avez une maquette ou une interface à intégrer",
    "vous hésitez entre création, refonte ou amélioration ciblée",
    "vous cherchez un interlocuteur capable de relier design et développement",
];

const prepare = [
    "lien de votre site actuel si vous en avez un",
    "objectif principal du projet",
    "pages ou contenus déjà imaginés",
    "exemples de sites que vous aimez ou n'aimez pas",
    "budget ou ordre de grandeur si vous en avez un",
    "date idéale de lancement",
];
---

<Layout
    title="Contact freelance web - William De Azevedo"
    description="Réservez un appel découverte de 15 minutes pour parler création de site vitrine, refonte ou développement front-end."
>
    <div class="mx-auto flex w-full max-w-5xl flex-col gap-16 px-4 pb-20">
        <FadeReveal delay={0.1}>
            <section class="mx-auto flex max-w-3xl flex-col items-center gap-5 text-center">
                <p class="w-fit rounded-lg bg-blue-500 px-3 py-1.5 text-xs font-light text-snow-50">
                    Contact
                </p>
                <h1 class="text-3xl font-medium leading-tight text-gray-900 sm:text-5xl md:text-6xl">
                    Parlons de votre projet web
                </h1>
                <p class="max-w-2xl text-base font-light leading-7 text-gray-600">
                    Le premier échange dure 15 minutes. L'objectif est simple :
                    comprendre votre besoin, vérifier si je peux vous aider et
                    définir la prochaine étape pertinente.
                </p>
                <div class="flex flex-col items-center gap-3 sm:flex-row">
                    <a
                        class="flex min-h-14 items-center justify-center rounded-xl bg-coffee-300 px-8 py-3 text-sm font-normal text-snow-50 transition-transform hover:scale-[0.98] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-blue-500"
                        href="#cal-booking"
                    >
                        Choisir un créneau
                    </a>
                    <a
                        class="flex min-h-14 items-center justify-center rounded-xl px-8 py-3 text-sm font-normal text-gray-900 ring-1 ring-gray-200 transition-colors hover:text-blue-500 focus-visible:text-blue-500 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-blue-500"
                        href="mailto:william.deazevedopro@gmail.com"
                    >
                        Écrire par e-mail
                    </a>
                </div>
            </section>
        </FadeReveal>

        <CalInline />

        <section class="grid gap-4 md:grid-cols-2">
            <article class="rounded-lg bg-snow-50 p-6 ring-1 ring-snow-600">
                <h2 class="mb-4 text-2xl font-medium leading-tight text-gray-900">
                    Ce rendez-vous est utile si...
                </h2>
                <ul class="flex flex-col gap-3">
                    {
                        usefulIf.map((item) => (
                            <li class="text-sm font-light leading-6 text-gray-600">
                                {item}
                            </li>
                        ))
                    }
                </ul>
            </article>
            <article class="rounded-lg bg-snow-50 p-6 ring-1 ring-snow-600">
                <h2 class="mb-4 text-2xl font-medium leading-tight text-gray-900">
                    Ce que vous pouvez préparer
                </h2>
                <ul class="flex flex-col gap-3">
                    {
                        prepare.map((item) => (
                            <li class="text-sm font-light leading-6 text-gray-600">
                                {item}
                            </li>
                        ))
                    }
                </ul>
            </article>
        </section>

        <section class="grid gap-8 md:grid-cols-[0.9fr_1.1fr] md:items-start">
            <div class="flex flex-col gap-3">
                <h2 class="text-2xl font-medium leading-tight text-gray-900">
                    Pendant les 15 minutes
                </h2>
                <p class="text-sm font-light leading-6 text-gray-600">
                    On parle de votre activité, de la situation actuelle, de ce que
                    le site doit changer et des contraintes principales : contenu,
                    délai, budget, outils et décision.
                </p>
            </div>
            <div class="rounded-lg bg-gray-100 p-6 ring-1 ring-gray-200">
                <h2 class="mb-3 text-lg font-medium leading-tight text-gray-900">
                    Après le rendez-vous
                </h2>
                <p class="text-sm font-light leading-6 text-gray-600">
                    Si le besoin correspond à mon accompagnement, je vous demande les
                    informations nécessaires pour estimer proprement le périmètre. Si
                    ce n'est pas le bon format, je vous le dis clairement.
                </p>
            </div>
        </section>

        <section class="rounded-lg bg-snow-50 p-6 text-center ring-1 ring-snow-600 sm:p-8">
            <div class="mx-auto flex max-w-2xl flex-col items-center gap-4">
                <h2 class="text-2xl font-medium leading-tight text-gray-900">
                    Vous préférez écrire d'abord ?
                </h2>
                <p class="text-sm font-light leading-6 text-gray-600">
                    Le calendrier reste disponible plus haut, mais vous pouvez aussi
                    poser le contexte à l'écrit si le projet demande quelques détails.
                </p>
                <a
                    class="flex min-h-14 items-center justify-center rounded-xl bg-coffee-300 px-8 py-3 text-sm font-normal text-snow-50 transition-transform hover:scale-[0.98] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-blue-500"
                    href="mailto:william.deazevedopro@gmail.com"
                >
                    Écrire par e-mail
                </a>
            </div>
        </section>
    </div>
</Layout>
