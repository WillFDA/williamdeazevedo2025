---
import Layout from "../layout/Layout.astro";
import FadeReveal from "../components/animations/FadeReveal.astro";
import FadeRevealOnScroll from "../components/animations/FadeRevealOnScroll.astro";
import Marquee from "../components/Marquee.astro";
import Carousel from "../components/Carousel.astro";
import HeroDotMatrix from "../components/HeroDotMatrix.astro";
import AboutLogoMatrix from "../components/AboutLogoMatrix.astro";
import ProjectIntro from "../components/ProjectIntro.astro";
import Differenciates from "@/sections/Differenciates.astro";
import ArrowRight from "../components/icons/ArrowRight.svg";
import WaveIcon from "../components/ui/WaveIcon.astro";
import WaveText from "../components/ui/WaveText.astro";
import { homeProjects } from "../data/projects";

const heroTitleWords = [
    "Je",
    "crée",
    "des",
    "sites",
    "web",
    "et",
    "des",
    "interfaces",
    "rapides,",
    "soignés",
    "et",
    "pensés",
    "pour",
    "convertir.",
];

const highlightedHeroWords = new Set(["rapides,", "soignés", "convertir."]);
const aboutTitleWords = [
    "Hello",
    "moi",
    "c'est",
    "William,",
    "un",
    "développeur",
    "à",
    "la",
    "frontière",
    "du",
    "design !",
];
const highlightedAboutWords = new Set(["design !"]);
const aboutPoints = [
    {
        icon: "code",
        text: "3 ans d'expérience dans le développement",
    },
    {
        icon: "users",
        text: "+10 clients satisfaits",
    },
    {
        icon: "product",
        text: "Expérience produit sur des SaaS B2B et IA",
    },
];
---

<Layout>
    <section class="max-w-5xl mx-auto">
        <div class="flex flex-col gap-6">
            <p
                class="mx-auto w-fit rounded-xl bg-blue-500 px-4 py-1.5 text-sm font-light leading-none text-snow-50 shadow-[0_10px_18px_-8px_rgba(37,99,235,0.85)] ring-1 ring-blue-400/70 md:text-base"
                data-hero-eyebrow
            >
                Freelance front-end orienté design et produit
            </p>
            <h1
                class="flex flex-wrap justify-center gap-x-[0.18em] text-7xl text-gray-900 text-center leading-tighter tracking-[-4%] font-medium"
                data-animated-title
            >
                {
                    heroTitleWords.map((word) => (
                        <span
                            class:list={[
                                highlightedHeroWords.has(word) &&
                                    "text-blue-500",
                            ]}
                            data-animated-title-word
                        >
                            {word}
                        </span>
                    ))
                }
            </h1>
            <FadeReveal delay={0.32}>
                <p
                    class="max-w-120 tracking-[-4%] leading-tight text-coffee-300 font-light text-center text-md mx-auto"
                >
                    J’aide les petites structures et les équipes produit à lancer
                    des interfaces & sites performants, accessibles et
                    SEO-friendly.
                </p>
            </FadeReveal>
            <FadeReveal delay={0.44}>
                <div class="flex gap-8 items-center justify-center">
                    <a
                        class="hero-button hero-button--primary font-regular px-6 text-md py-1.5 rounded-xl h-12 flex justify-center items-center"
                        href="#projects"
                        ><WaveText
                            text="Parlons de votre projet"
                            trigger="parent"
                        />
                        <WaveIcon
                            style="--wui-wave-icon-size: 1rem;"
                            direction="right"
                            trigger="parent"
                        >
                            <ArrowRight class="size-full" aria-hidden="true" />
                        </WaveIcon>
                    </a>
                    <a
                        class="hero-button hero-button--secondary font-regular px-6 py-1.5 rounded-xl h-12 flex text-md justify-center items-center"
                        href="#projects"
                        ><WaveText
                            text="Voir mes réalisations"
                            trigger="parent"
                        /></a
                    >
                </div>
            </FadeReveal>
            <FadeReveal delay={0.56}>
                <div
                    class="flex-col gap-2 mx-auto text-center text-xs flex items-center justify-center my-4"
                >
                    <div class="size-8 rounded-full bg-[#E8E5E8]"></div>
                    <span class="">Quentin Leffelic</span>
                    <p class="max-w-70 mx-auto">
                        “Excellente collaboration avec william, site livré
                        rapidement et avec soin”
                    </p>
                </div>
            </FadeReveal>
            <HeroDotMatrix />
        </div>
    </section>
    <FadeRevealOnScroll delay={0.12}>
        <Marquee />
    </FadeRevealOnScroll>
    <section class="about-section relative isolate mx-4 overflow-hidden rounded-2xl bg-coffee-300 py-16 md:rounded-3xl md:py-24">
        <AboutLogoMatrix />
        <div class="relative z-10 mx-auto flex max-w-5xl flex-col gap-12 px-4 md:gap-14">
            <h2
                class="mx-auto flex max-w-4xl flex-wrap justify-center gap-x-[0.18em] text-center text-4xl font-medium leading-tighter tracking-[-4%] text-snow-50 md:text-6xl"
                data-animated-title
            >
                {
                    aboutTitleWords.map((word) => (
                        <>
                            <span
                                class:list={[
                                    highlightedAboutWords.has(word)
                                        ? "text-blue-400"
                                        : "text-snow-50",
                                ]}
                                data-animated-title-word
                            >
                                {word}
                            </span>
                            {word === "William," && (
                                <span
                                    class="about-title-avatar"
                                    data-animated-title-word
                                    aria-hidden="true"
                                />
                            )}
                        </>
                    ))
                }
            </h2>
            <ul class="mx-auto flex flex-col items-center justify-center gap-7 text-sm font-light text-snow-100 md:flex-row md:gap-12 md:text-base">
                {
                    aboutPoints.map((point) => (
                        <li class="flex items-center gap-3">
                            <span class="flex size-9 shrink-0 items-center justify-center rounded-xl bg-snow-50 text-blue-500">
                            {point.icon === "code" && (
                                <svg
                                    aria-hidden="true"
                                    class="size-5"
                                    fill="none"
                                    viewBox="0 0 24 24"
                                    xmlns="http://www.w3.org/2000/svg"
                                >
                                    <path
                                        d="m9 18-6-6 6-6"
                                        stroke="currentColor"
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="1.8"
                                    />
                                    <path
                                        d="m15 6 6 6-6 6"
                                        stroke="currentColor"
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="1.8"
                                    />
                                </svg>
                            )}
                            {point.icon === "users" && (
                                <svg
                                    aria-hidden="true"
                                    class="size-5"
                                    fill="none"
                                    viewBox="0 0 24 24"
                                    xmlns="http://www.w3.org/2000/svg"
                                >
                                    <path
                                        d="M16 19c0-2.2-1.8-4-4-4s-4 1.8-4 4"
                                        stroke="currentColor"
                                        stroke-linecap="round"
                                        stroke-width="1.8"
                                    />
                                    <path
                                        d="M12 11a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z"
                                        stroke="currentColor"
                                        stroke-width="1.8"
                                    />
                                    <path
                                        d="M19 18c-.2-1.7-1.2-3-2.6-3.7"
                                        stroke="currentColor"
                                        stroke-linecap="round"
                                        stroke-width="1.8"
                                    />
                                </svg>
                            )}
                            {point.icon === "product" && (
                                <svg
                                    aria-hidden="true"
                                    class="size-5"
                                    fill="none"
                                    viewBox="0 0 24 24"
                                    xmlns="http://www.w3.org/2000/svg"
                                >
                                    <path
                                        d="M4 7.5 12 3l8 4.5-8 4.5-8-4.5Z"
                                        stroke="currentColor"
                                        stroke-linejoin="round"
                                        stroke-width="1.8"
                                    />
                                    <path
                                        d="M4 12.5 12 17l8-4.5"
                                        stroke="currentColor"
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="1.8"
                                    />
                                    <path
                                        d="M4 17.5 12 22l8-4.5"
                                        stroke="currentColor"
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="1.8"
                                    />
                                </svg>
                            )}
                            </span>
                            <span>{point.text}</span>
                        </li>
                    ))
                }
            </ul>
            <a
                class="hero-button about-cta mx-auto inline-flex h-12 items-center justify-center gap-3 rounded-xl px-6 text-md font-regular focus-visible:outline-2 focus-visible:outline-offset-3 focus-visible:outline-blue-500"
                href="mailto:william.deazevedopro@gmail.com"
            >
                <svg
                    aria-hidden="true"
                    class="size-5"
                    fill="none"
                    viewBox="0 0 24 24"
                    xmlns="http://www.w3.org/2000/svg"
                >
                    <path
                        d="M7.4 4.8 9 8.5c.3.7.1 1.5-.5 2l-1.2 1c.9 1.9 2.4 3.4 4.3 4.3l1-1.2c.5-.6 1.3-.8 2-.5l3.7 1.6c.8.3 1.2 1.2 1 2l-.5 2.1c-.2.8-.9 1.3-1.7 1.3C9.3 21 3 14.7 3 6.9c0-.8.5-1.5 1.3-1.7l2.1-.5c.8-.2 1.7.3 2 1Z"
                        stroke="currentColor"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="1.8"
                    />
                </svg>
                <span>Me contacter</span>
            </a>
        </div>
    </section>
    <section id="projects" class="project-showcase mb-20 md:mt-20" data-project-showcase>
        <div class="project-copy mx-auto max-w-5xl px-4 pb-10">
            {
                homeProjects.map((project, index) => (
                    <article
                        class:list={[
                            "project-copy__panel",
                            index === 0 && "is-active",
                        ]}
                        data-project-panel
                        data-project-index={index}
                        aria-hidden={index === 0 ? undefined : "true"}
                        inert={index === 0 ? undefined : true}
                    >
                        <ProjectIntro
                            href={project.href}
                            title={project.title}
                        >
                            {project.summary}
                        </ProjectIntro>
                    </article>
                ))
            }
        </div>

        <Carousel autoplay autoplayDelay={6500}>
            {
                homeProjects.map((project, index) => (
                    <div class="embla__slide">
                        {project.media.type === "video" ? (
                            <video
                                muted
                                playsinline
                                loop
                                preload={index === 0 ? "metadata" : "none"}
                                tabindex="-1"
                                poster={project.media.poster}
                                aria-hidden="true"
                                class="h-full w-full object-cover rounded-md"
                            >
                                <source src={project.media.src} type="video/mp4" />
                            </video>
                        ) : (
                            <div
                                class="project-placeholder rounded-md"
                                data-project-name={project.title}
                            >
                                <span>{project.media.label}</span>
                            </div>
                        )}
                    </div>
                ))
            }
        </Carousel>
    </section>
    <Differenciates />
</Layout>

<script>
    import { animate, spring, stagger } from "animejs";

    type HomeInteractionState = {
        destroy: () => void;
    };

    const windowWithHomeInteractions = window as Window & {
        __wuiHomeInteractionLifecycleReady?: boolean;
        __wuiHomeInteractionStates?: Set<HomeInteractionState>;
    };
    const activeHomeInteractionStates =
        windowWithHomeInteractions.__wuiHomeInteractionStates ??
        new Set<HomeInteractionState>();
    windowWithHomeInteractions.__wuiHomeInteractionStates =
        activeHomeInteractionStates;
    const activeTitleAnimations = new Set<{ cancel: () => void }>();

    function registerHomeInteractionCleanup(destroy: () => void) {
        let state: HomeInteractionState;

        state = {
            destroy: () => {
                if (!activeHomeInteractionStates.delete(state)) return;
                destroy();
            },
        };

        activeHomeInteractionStates.add(state);
    }

    function resetHomeInteractions() {
        activeTitleAnimations.forEach((animation) => animation.cancel());
        activeTitleAnimations.clear();
        Array.from(activeHomeInteractionStates).forEach((state) =>
            state.destroy(),
        );
    }

    const animateTitle = (title: HTMLElement) => {
        if (title.dataset.animatedTitleReady === "true") return;

        const words = title.querySelectorAll<HTMLElement>(
            "[data-animated-title-word]",
        );

        title.dataset.animatedTitleReady = "running";

        if (
            words.length === 0 ||
            window.matchMedia("(prefers-reduced-motion: reduce)").matches
        ) {
            title.dataset.animatedTitleReady = "true";
            return;
        }

        words.forEach((word) => {
            word.style.willChange = "opacity, transform, filter";
        });

        const animation = animate(words, {
            opacity: [0, 1],
            translateY: ["-0.65em", "0em"],
            filter: ["blur(10px)", "blur(0px)"],
            duration: 1100,
            delay: stagger(65),
            ease: "out(4)",
            onComplete: () => {
                title.dataset.animatedTitleReady = "true";
                words.forEach((word) => {
                    word.style.willChange = "auto";
                });
                activeTitleAnimations.delete(animation);
            },
        });
        activeTitleAnimations.add(animation);
    };

    const initTitleAnimations = () => {
        let observedCount = 0;
        const observer = new IntersectionObserver(
            (entries) => {
                entries.forEach((entry) => {
                    if (!entry.isIntersecting) return;

                    const title = entry.target as HTMLElement;

                    observer.unobserve(title);
                    animateTitle(title);
                });
            },
            { rootMargin: "0px 0px -10% 0px", threshold: 0.2 },
        );

        document
            .querySelectorAll<HTMLElement>("[data-animated-title]")
            .forEach((title) => {
                if (title.dataset.animatedTitleReady) return;

                title.dataset.animatedTitleReady = "pending";
                observer.observe(title);
                observedCount += 1;
            });

        if (observedCount > 0) {
            registerHomeInteractionCleanup(() => observer.disconnect());
        } else {
            observer.disconnect();
        }
    };

    const projectTextAnimations = new WeakMap<HTMLElement, { cancel: () => void }>();

    const animateProjectPanel = (panel: HTMLElement, direction: string) => {
        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

        const items = panel.querySelectorAll<HTMLElement>(
            ".project-intro__title, .project-intro__description, .project-intro__button",
        );
        const fromY = direction === "prev" ? "1.15rem" : "-1.15rem";

        projectTextAnimations.get(panel)?.cancel();
        items.forEach((item) => {
            item.style.willChange = "opacity, transform, filter";
        });

        projectTextAnimations.set(
            panel,
            animate(items, {
                opacity: [0, 1],
                translateY: [fromY, "0rem"],
                filter: ["blur(8px)", "blur(0px)"],
                delay: stagger(130),
                ease: spring({ bounce: 0.12, duration: 760 }),
                onComplete: () => {
                    items.forEach((item) => {
                        item.style.willChange = "auto";
                    });
                },
            }),
        );
    };

    const initProjectShowcases = () => {
        document
            .querySelectorAll<HTMLElement>("[data-project-showcase]")
            .forEach((root) => {
                if (root.dataset.projectShowcaseReady === "true") return;

                const panels =
                    root.querySelectorAll<HTMLElement>("[data-project-panel]");

                const setActivePanel = (
                    index: number,
                    direction = "next",
                    shouldAnimate = true,
                ) => {
                    root.dataset.projectDirection = direction;
                    let activePanel: HTMLElement | undefined;

                    panels.forEach((panel) => {
                        const isActive =
                            Number(panel.dataset.projectIndex) === index;

                        panel.classList.toggle("is-active", isActive);
                        panel.setAttribute("aria-hidden", String(!isActive));
                        panel.toggleAttribute("inert", !isActive);
                        if (isActive) activePanel = panel;
                    });

                    if (shouldAnimate && activePanel) {
                        animateProjectPanel(activePanel, direction);
                    }
                };

                root.dataset.projectShowcaseReady = "true";
                setActivePanel(0, "next", false);
                const handleCarouselSelect = (event: Event) => {
                    const { direction, index } = (
                        event as CustomEvent<{
                            direction?: string;
                            index: number;
                        }>
                    ).detail;

                    setActivePanel(index, direction);
                };

                root.addEventListener("carousel:select", handleCarouselSelect);
                registerHomeInteractionCleanup(() => {
                    root.removeEventListener(
                        "carousel:select",
                        handleCarouselSelect,
                    );
                    panels.forEach((panel) => {
                        projectTextAnimations.get(panel)?.cancel();
                        panel
                            .querySelectorAll<HTMLElement>(
                                ".project-intro__title, .project-intro__description, .project-intro__button",
                            )
                            .forEach((item) => {
                                item.style.willChange = "auto";
                            });
                    });
                    delete root.dataset.projectShowcaseReady;
                });
            });
    };

    initTitleAnimations();
    initProjectShowcases();

    if (windowWithHomeInteractions.__wuiHomeInteractionLifecycleReady !== true) {
        windowWithHomeInteractions.__wuiHomeInteractionLifecycleReady = true;
        document.addEventListener("astro:before-swap", resetHomeInteractions);
        document.addEventListener("astro:page-load", initTitleAnimations);
        document.addEventListener("astro:page-load", initProjectShowcases);
    }
</script>

<style>
    [data-hero-eyebrow] {
        animation: hero-eyebrow-fade 780ms cubic-bezier(0.2, 0, 0, 1) both;
    }

    @keyframes hero-eyebrow-fade {
        from {
            filter: blur(8px);
            opacity: 0;
        }

        to {
            filter: blur(0);
            opacity: 1;
        }
    }

    [data-animated-title-word] {
        display: inline-block;
    }

    .about-title-avatar {
        align-self: center;
        aspect-ratio: 1;
        background: #141016;
        border: 0.09em solid #fff;
        border-radius: 9999px;
        box-shadow:
            0 18px 38px -18px rgba(0, 0, 0, 0.72),
            0 4px 14px rgba(0, 0, 0, 0.24);
        display: inline-flex;
        height: 1.08em;
        margin-inline: -0.05em;
        overflow: hidden;
    }

    [data-animated-title]:not([data-animated-title-ready="true"])
        [data-animated-title-word] {
        filter: blur(10px);
        opacity: 0;
        transform: translateY(-0.65em);
    }

    @media (scripting: none), (prefers-reduced-motion: reduce) {
        [data-hero-eyebrow] {
            animation: none;
        }

        [data-animated-title] [data-animated-title-word] {
            filter: none;
            opacity: 1;
            transform: none;
        }
    }

    .project-copy {
        display: grid;
    }

    .project-copy__panel {
        filter: blur(6px);
        grid-area: 1 / 1;
        opacity: 0;
        pointer-events: none;
        transition:
            opacity 320ms cubic-bezier(0.2, 0, 0, 1),
            filter 420ms cubic-bezier(0.2, 0, 0, 1);
    }

    .project-copy__panel.is-active {
        filter: blur(0);
        opacity: 1;
        pointer-events: auto;
    }

    .project-placeholder {
        align-items: center;
        aspect-ratio: 16 / 9;
        background: #e8e5e8;
        color: rgb(63 63 70);
        display: flex;
        font-size: clamp(2rem, 6vw, 5rem);
        font-weight: 500;
        height: 100%;
        justify-content: center;
        width: 100%;
    }

    .hero-button {
        --hero-button-bg: #e8e5e8;
        --hero-button-border: transparent;
        --hero-button-color: var(--color-coffee-300);

        color: var(--hero-button-color);
        gap: 0.75rem;
        isolation: isolate;
        position: relative;
        text-decoration: none;
    }

    .hero-button::before {
        background: var(--hero-button-bg);
        border: 1px solid var(--hero-button-border);
        border-radius: inherit;
        content: "";
        inset: 0;
        position: absolute;
        transform: scale(1);
        transition: transform 520ms
            var(--wui-ease-standard, cubic-bezier(0.2, 0, 0, 1));
        will-change: transform;
        z-index: -1;
    }

    .hero-button:hover::before,
    .hero-button:focus-visible::before {
        transform: scale(0.95);
    }

    .hero-button:focus-visible {
        outline: 2px solid var(--color-blue-500);
        outline-offset: 3px;
    }

    .hero-button--primary {
        --hero-button-bg: var(--color-coffee-300);
        --hero-button-border: var(--color-coffee-300);
        --hero-button-color: #eef5ff;
    }

    .hero-button--secondary {
        --hero-button-bg: #e8e5e8;
    }

    .hero-button.about-cta {
        --hero-button-bg: var(--color-snow-50);
        --hero-button-color: var(--color-coffee-300);
    }

    @media (prefers-reduced-motion: reduce) {
        .hero-button::before {
            transition: none;
            will-change: auto;
        }
    }
</style>
