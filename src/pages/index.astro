---
import Layout from "../layout/Layout.astro";
import FadeReveal from "../components/animations/FadeReveal.astro";
import Carousel from "../components/Carousel.astro";
import AboutCallout from "../components/AboutCallout.astro";
import ExpertiseShowcase from "../components/ExpertiseShowcase.astro";
import PricingPreview from "../components/PricingPreview.astro";
import ProjectIntro from "../components/ProjectIntro.astro";
import Differenciates from "@/sections/Differenciates.astro";
import ArrowRight from "../components/icons/nucleo/arrow-right-fill.svg";
import SearchContent from "../components/icons/nucleo/search-content-2-fill.svg";
import Star from "../components/icons/nucleo/star-fill.svg";
import XMark from "../components/icons/nucleo/xmark-fill.svg";
import { Image } from "astro:assets";
import WaveIcon from "../components/ui/WaveIcon.astro";
import WaveText from "../components/ui/WaveText.astro";
import { homeProjects } from "../data/projects";
import { temoignages } from "../data/temoignage";

export const prerender = true;

const heroTitleParts = [
    { text: "Je" },
    { text: "crée" },
    { text: "des" },
    { pill: true, text: "sites web" },
    { text: "et" },
    { text: "des" },
    { pill: true, text: "interfaces" },
    { text: "rapides," },
    { text: "accessibles" },
    { text: "et" },
    { text: "pensés" },
    { text: "pour" },
    { text: "inspirer" },
    { text: "confiance." },
];

const problemItems = [
    "Votre site est daté, peu accessible ou pas au niveau de votre travail ?",
    "Vous n'avez pas encore de site et vous ne savez pas par où commencer ?",
    "Votre produit a besoin d'un développeur capable de relier design, front-end et logique métier ?",
    "Vous en avez assez des prestataires flous et des livraisons bancales ?",
] as const;

const expertiseItems = [
    {
        id: "creation",
        label: "Création site vitrine",
        icon: "site",
        title: "Construire une présence claire et crédible",
        description: [
            "Je pars de votre offre, de vos contenus et des objections de vos prospects pour créer un site qui se comprend vite.",
            "L'objectif : transformer une première impression fragile en parcours rassurant, rapide et orienté contact.",
        ],
        pills: [
            "Architecture des pages",
            "Design responsive",
            "SEO technique",
            "Mise en ligne",
        ],
    },
    {
        id: "refonte",
        label: "Refonte web",
        icon: "refresh",
        title: "Repenser ce qui freine votre site actuel",
        description: [
            "Je vous aide à repérer ce qui crée du doute : message confus, hiérarchie faible, mobile pénible, lenteur ou design daté.",
            "On garde ce qui fonctionne, on retire ce qui brouille le parcours et on reconstruit une base plus lisible.",
        ],
        pills: [
            "Audit rapide",
            "UX mobile",
            "Performance",
            "Redirections utiles",
        ],
    },
    {
        id: "front-end",
        label: "Renfort front-end",
        icon: "code",
        title: "Intégrer et faire évoluer vos interfaces",
        description: [
            "J'interviens comme renfort autonome pour transformer des maquettes ou écrans existants en interfaces propres et maintenables.",
            "Le regard reste autant front-end que produit : responsive, accessibilité, performance, états d'interface et détails visuels.",
        ],
        pills: [
            "Intégration Figma",
            "React / Next.js",
            "Accessibilité",
            "Développement IA",
            "DevOps mise en ligne",
        ],
    },
    {
        id: "audit-ux",
        label: "Audit UX",
        icon: "ux",
        title: "Clarifier les points de friction avant de construire",
        description: [
            "Je relis votre parcours, vos pages clés et vos messages pour voir où un visiteur hésite, décroche ou ne comprend pas la suite.",
            "Vous repartez avec des priorités concrètes : quoi clarifier, quoi supprimer, quoi améliorer en premier.",
        ],
        pills: [
            "Parcours utilisateur",
            "Clarté de l'offre",
            "Hiérarchie visuelle",
            "Actions prioritaires",
        ],
    },
    {
        id: "performance",
        label: "Performance web",
        icon: "performance",
        title: "Rendre votre site plus rapide et plus stable",
        description: [
            "J'optimise les pages qui comptent : poids des assets, structure front-end, rendu mobile et points bloquants côté expérience.",
            "Un site plus rapide est aussi un site plus rassurant : il donne moins de raisons de partir avant d'avoir compris l'offre.",
        ],
        pills: [
            "Core Web Vitals",
            "Images optimisées",
            "Chargement rapide",
            "Mobile first",
        ],
    },
    {
        id: "produit",
        label: "Accompagnement produit",
        icon: "site",
        title: "Faire évoluer l'interface avec une logique produit",
        description: [
            "Je vous aide à prioriser les évolutions utiles, à transformer les retours terrain en écrans concrets et à garder une interface cohérente.",
            "C'est un accompagnement pensé pour avancer vite sans accumuler des rustines qui rendent le produit moins clair.",
        ],
        pills: [
            "Priorisation",
            "Design produit",
            "Itérations rapides",
            "Base maintenable",
        ],
    },
] as const;

const testimonialImages = import.meta.glob<{ default: ImageMetadata }>(
    "../assets/temoignages/*.{jpg,jpeg,png,webp}",
    { eager: true },
);
const displayedTestimonials = temoignages
    .filter((temoignage) => temoignage.published !== false)
    .map((temoignage) => ({
        ...temoignage,
        image: temoignage.imageFile
            ? testimonialImages[`../assets/temoignages/${temoignage.imageFile}`]
                  ?.default
            : undefined,
    }));
---

<Layout>
    <section class="mx-auto w-full max-w-[calc(100vw-1rem)] px-2 sm:max-w-5xl sm:px-4">
        <div class="flex min-w-0 flex-col gap-6">
            <a
                aria-label="Avis Google : 5 étoiles sur 5"
                class="mx-auto inline-flex max-w-[calc(100vw-1rem)] items-center gap-2 rounded-xl bg-snow-50 px-3.5 py-2 text-sm font-normal leading-tight text-gray-900 no-underline shadow-[0_10px_22px_-16px_rgba(34,42,55,0.45)] transition-transform hover:scale-[0.98] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-blue-500 sm:text-base"
                data-hero-eyebrow
                href="https://share.google/LlCN4Hr5IlatyVSl2"
                rel="noreferrer"
                target="_blank"
            >
                <span>Avis Google</span>
                <span class="inline-flex items-center gap-1.5 rounded-xl bg-blue-500 px-2.5 py-1 font-medium text-snow-50">
                    <Star aria-hidden="true" class="size-4 text-snow-50" />
                    <span>5.0</span>
                </span>
            </a>
            <h1
                class="page-heading flex w-full max-w-[22rem] flex-wrap justify-center gap-x-[0.18em] px-2 sm:max-w-4xl md:max-w-5xl"
                data-animated-title
            >
                {
                    heroTitleParts.map((part, index) => (
                        <span
                            class:list={[
                                part.pill && "hero-title-pill",
                            ]}
                            style={`--animated-word-index: ${index}`}
                            data-animated-title-word
                        >
                            {part.text}
                        </span>
                    ))
                }
            </h1>
            <FadeReveal delay={0.32}>
                <p
                    class="page-subheading max-w-[22rem] sm:max-w-120"
                >
                    J’aide les petites structures et les équipes produit à lancer
                    des interfaces & sites performants, soignés et SEO-friendly.
                </p>
            </FadeReveal>
            <FadeReveal delay={0.44}>
                <div class="mx-auto mt-5 flex w-full max-w-[22rem] flex-col items-center justify-center gap-3 sm:mt-7 sm:max-w-none sm:flex-row sm:gap-8">
                    <button
                        class="hero-button hero-button--primary font-regular flex min-h-14 w-full max-w-full items-center justify-center gap-5 rounded-xl px-8 py-3 text-md sm:w-auto sm:px-10"
                        data-cal-location="hero"
                        data-cal-open
                        type="button"
                        ><WaveText
                            text="Parlons de votre projet"
                            trigger="parent"
                        />
                        <WaveIcon
                            style="--wui-wave-icon-size: 1rem;"
                            direction="right"
                            trigger="parent"
                        >
                            <ArrowRight class="size-full" aria-hidden="true" />
                        </WaveIcon>
                    </button>
                    <a
                        class="hero-button hero-button--secondary font-regular flex min-h-14 w-full max-w-full items-center justify-center rounded-xl px-8 py-3 text-md sm:w-auto sm:px-10"
                        href="/methode"
                        ><WaveText
                            text="Voir comment je travaille"
                            trigger="parent"
                        /></a
                    >
                </div>
            </FadeReveal>
            <FadeReveal delay={0.56}>
                <div
                    class="testimonial-rotator mx-auto mb-4 mt-0 text-center text-xs"
                    data-testimonial-rotator
                    data-testimonial-interval="5500"
                >
                    {
                        displayedTestimonials.map((temoignage, index) => (
                            <figure
                                class:list={[
                                    "testimonial-rotator__item",
                                    index === 0 && "is-active",
                                ]}
                                data-testimonial-item
                                aria-hidden={index === 0 ? undefined : "true"}
                                inert={index === 0 ? undefined : true}
                            >
                                <blockquote>
                                    “{temoignage.excerpt ?? temoignage.text}”
                                </blockquote>
                                <div class="testimonial-rotator__person">
                                    <div class="testimonial-avatar">
                                        {temoignage.image ? (
                                            <Image
                                                class="testimonial-avatar__image"
                                                src={temoignage.image}
                                                alt={temoignage.imageAlt ?? ""}
                                                width={64}
                                                height={64}
                                                loading={
                                                    index === 0 ? "eager" : "lazy"
                                                }
                                            />
                                        ) : (
                                            <span>{temoignage.initials}</span>
                                        )}
                                    </div>
                                    <figcaption>
                                        <a
                                            class="testimonial-rotator__link"
                                            href={temoignage.href}
                                            target="_blank"
                                            rel="noreferrer"
                                            aria-label={`Voir le site de ${temoignage.name}`}
                                        >
                                            {temoignage.name}
                                        </a>
                                    </figcaption>
                                </div>
                            </figure>
                        ))
                    }
                </div>
            </FadeReveal>
        </div>
    </section>
    <section
        class="mx-auto w-full max-w-5xl px-4 pt-10 pb-16 sm:px-8 md:pt-14 md:pb-20"
        aria-labelledby="problems-title"
    >
        <div class="mx-auto flex max-w-4xl flex-col items-center gap-4 text-center">
            <FadeReveal delay={0.1}>
                <h2
                    id="problems-title"
                    class="section-heading"
                >
                    Vous vous reconnaissez ?
                </h2>
            </FadeReveal>
            <FadeReveal delay={0.18}>
                <p class="section-subheading">
                    Une bonne offre peut rester invisible si votre site ne donne pas
                    assez vite envie de comprendre, de faire confiance et de passer
                    à l'action.
                </p>
            </FadeReveal>
        </div>
        <ul class="mx-auto mt-10 flex max-w-2xl flex-col gap-5">
            {
                problemItems.map((problem, index) => (
                    <FadeReveal delay={0.16 + index * 0.08}>
                        <li class="flex items-center gap-3">
                            <span class="flex size-10 shrink-0 items-center justify-center rounded-lg bg-snow-50 text-[#ef3434] shadow-[0_14px_32px_-24px_rgba(34,42,55,0.55)] ring-[0.5px] ring-gray-200/70">
                                <XMark class="size-4 drop-shadow-[-1px_-1px_2px_rgba(239,52,52,0.24)]" />
                            </span>
                            <p class="text-base font-normal leading-snug text-gray-900 sm:text-lg">
                                {problem}
                            </p>
                        </li>
                    </FadeReveal>
                ))
            }
        </ul>
    </section>
    <AboutCallout title="Hello moi c'est William, un développeur à la frontière du design !" />
    <div class="mx-auto w-full max-w-7xl px-4 pt-20 pb-8 sm:px-8 md:pt-24 md:pb-10">
        <ExpertiseShowcase
            title="Ce que je corrige pour rendre un site plus convaincant"
            description="Chaque accompagnement part d'un frein concret : manque de clarté, expérience lente, design qui ne rassure plus ou interface difficile à faire évoluer."
            items={expertiseItems}
        />
        <div class="mt-10 flex justify-center">
            <button
                class="expertise-cta inline-flex min-h-14 items-center justify-center gap-4 rounded-xl px-8 py-3 text-md font-regular focus-visible:outline-2 focus-visible:outline-offset-3 focus-visible:outline-blue-500"
                data-cal-location="expertise"
                data-cal-open
                type="button"
            >
                <span>Trouver ce qui bloque</span>
                <WaveIcon
                    class="expertise-cta__icon"
                    direction="up"
                    trigger="parent"
                >
                    <SearchContent aria-hidden="true" />
                </WaveIcon>
            </button>
        </div>
    </div>
    <PricingPreview />
    <section
        id="projects"
        class="project-showcase md:mt-8"
        data-project-showcase
        aria-labelledby="projects-title"
    >
        <div class="mx-auto mb-12 flex max-w-4xl flex-col items-center gap-4 px-4 text-center sm:px-8">
            <h2 id="projects-title" class="section-heading">
                Des projets pensés pour inspirer confiance
            </h2>
        </div>
        <div class="project-copy mx-auto max-w-5xl px-2 pb-5 sm:px-4">
            {
                homeProjects.map((project, index) => (
                    <article
                        class:list={[
                            "project-copy__panel",
                            index === 0 && "is-active",
                        ]}
                        data-project-panel
                        data-project-index={index}
                        aria-hidden={index === 0 ? undefined : "true"}
                        inert={index === 0 ? undefined : true}
                    >
                        <ProjectIntro
                            detailsHref={`/realisations/${project.id}`}
                            href={project.href}
                            title={project.title}
                        >
                            {project.summary}
                        </ProjectIntro>
                    </article>
                ))
            }
        </div>

        <Carousel controlsPlacement="top" compactControls>
            {
                homeProjects.map((project) => (
                    <div class="embla__slide">
                        <div
                            class="project-placeholder rounded-md"
                            data-project-name={project.title}
                            aria-hidden="true"
                        >
                            {
                                project.media.type === "video" && (
                                    <img
                                        src={project.media.poster}
                                        alt=""
                                        loading="lazy"
                                        decoding="async"
                                    />
                                )
                            }
                        </div>
                    </div>
                ))
            }
        </Carousel>
    </section>
    <Differenciates />
</Layout>

<script>
    type HomeInteractionState = {
        destroy: () => void;
    };

    const windowWithHomeInteractions = window as Window & {
        __wuiHomeInteractionLifecycleReady?: boolean;
        __wuiHomeInteractionStates?: Set<HomeInteractionState>;
    };
    const activeHomeInteractionStates =
        windowWithHomeInteractions.__wuiHomeInteractionStates ??
        new Set<HomeInteractionState>();
    windowWithHomeInteractions.__wuiHomeInteractionStates =
        activeHomeInteractionStates;

    function registerHomeInteractionCleanup(destroy: () => void) {
        let state: HomeInteractionState;

        state = {
            destroy: () => {
                if (!activeHomeInteractionStates.delete(state)) return;
                destroy();
            },
        };

        activeHomeInteractionStates.add(state);
    }

    function resetHomeInteractions() {
        Array.from(activeHomeInteractionStates).forEach((state) =>
            state.destroy(),
        );
    }

    const revealTitle = (title: HTMLElement) => {
        if (title.dataset.animatedTitleReady === "true") return;
        title.dataset.animatedTitleReady = "true";
    };

    const initTitleAnimations = () => {
        let observedCount = 0;
        const observer = new IntersectionObserver(
            (entries) => {
                entries.forEach((entry) => {
                    if (!entry.isIntersecting) return;

                    const title = entry.target as HTMLElement;

                    observer.unobserve(title);
                    revealTitle(title);
                });
            },
            { rootMargin: "0px 0px -10% 0px", threshold: 0.2 },
        );

        document
            .querySelectorAll<HTMLElement>("[data-animated-title]")
            .forEach((title) => {
                if (title.dataset.animatedTitleReady) return;

                title.dataset.animatedTitleReady = "pending";
                observer.observe(title);
                observedCount += 1;
            });

        if (observedCount > 0) {
            registerHomeInteractionCleanup(() => observer.disconnect());
        } else {
            observer.disconnect();
        }
    };

    const replayProjectPanelAnimation = (panel: HTMLElement) => {
        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

        delete panel.dataset.projectPanelAnimate;
        void panel.offsetWidth;
        panel.dataset.projectPanelAnimate = "true";
    };

    const initTestimonialRotators = () => {
        document
            .querySelectorAll<HTMLElement>("[data-testimonial-rotator]")
            .forEach((root) => {
                if (root.dataset.testimonialRotatorReady === "true") return;

                const items = Array.from(
                    root.querySelectorAll<HTMLElement>(
                        "[data-testimonial-item]",
                    ),
                );

                if (items.length < 2) return;

                const interval = Math.max(
                    1200,
                    Number.parseInt(root.dataset.testimonialInterval ?? "", 10) ||
                        5500,
                );
                let activeIndex = items.findIndex((item) =>
                    item.classList.contains("is-active"),
                );
                let timeout: number | undefined;

                if (activeIndex < 0) activeIndex = 0;

                const setActiveItem = (nextIndex: number) => {
                    activeIndex = nextIndex;
                    items.forEach((item, index) => {
                        const isActive = index === activeIndex;

                        item.classList.toggle("is-active", isActive);
                        item.setAttribute("aria-hidden", String(!isActive));
                        // inert removes the hidden testimonial (and its link)
                        // from the a11y tree AND tab order, so aria-hidden no
                        // longer wraps a focusable descendant.
                        item.toggleAttribute("inert", !isActive);
                    });
                };

                const schedule = () => {
                    window.clearTimeout(timeout);
                    timeout = window.setTimeout(() => {
                        if (!document.hidden) {
                            setActiveItem((activeIndex + 1) % items.length);
                        }

                        schedule();
                    }, interval);
                };

                root.dataset.testimonialRotatorReady = "true";
                setActiveItem(activeIndex);
                schedule();
                registerHomeInteractionCleanup(() => {
                    window.clearTimeout(timeout);
                    delete root.dataset.testimonialRotatorReady;
                });
            });
    };

    const initProjectShowcases = () => {
        document
            .querySelectorAll<HTMLElement>("[data-project-showcase]")
            .forEach((root) => {
                if (root.dataset.projectShowcaseReady === "true") return;

                const panels =
                    root.querySelectorAll<HTMLElement>("[data-project-panel]");

                const setActivePanel = (
                    index: number,
                    direction = "next",
                    shouldAnimate = true,
                ) => {
                    root.dataset.projectDirection = direction;
                    let activePanel: HTMLElement | undefined;

                    panels.forEach((panel) => {
                        const isActive =
                            Number(panel.dataset.projectIndex) === index;

                        delete panel.dataset.projectPanelAnimate;
                        panel.classList.toggle("is-active", isActive);
                        panel.setAttribute("aria-hidden", String(!isActive));
                        panel.toggleAttribute("inert", !isActive);
                        if (isActive) activePanel = panel;
                    });

                    if (shouldAnimate && activePanel) {
                        replayProjectPanelAnimation(activePanel);
                    }
                };

                root.dataset.projectShowcaseReady = "true";
                setActivePanel(0, "next", false);
                const handleCarouselSelect = (event: Event) => {
                    const { direction, index } = (
                        event as CustomEvent<{
                            direction?: string;
                            index: number;
                        }>
                    ).detail;

                    setActivePanel(index, direction);
                };

                root.addEventListener("carousel:select", handleCarouselSelect);
                registerHomeInteractionCleanup(() => {
                    root.removeEventListener(
                        "carousel:select",
                        handleCarouselSelect,
                    );
                    panels.forEach((panel) => {
                        delete panel.dataset.projectPanelAnimate;
                    });
                    delete root.dataset.projectShowcaseReady;
                });
            });
    };

    initTitleAnimations();
    initTestimonialRotators();
    initProjectShowcases();

    if (windowWithHomeInteractions.__wuiHomeInteractionLifecycleReady !== true) {
        windowWithHomeInteractions.__wuiHomeInteractionLifecycleReady = true;
        document.addEventListener("astro:before-swap", resetHomeInteractions);
        document.addEventListener("astro:page-load", initTitleAnimations);
        document.addEventListener("astro:page-load", initTestimonialRotators);
        document.addEventListener("astro:page-load", initProjectShowcases);
    }
</script>

<style>
    [data-hero-eyebrow] {
        animation: hero-eyebrow-fade 780ms cubic-bezier(0.2, 0, 0, 1)
            backwards;
    }

    @keyframes hero-eyebrow-fade {
        from {
            filter: blur(8px);
            opacity: 0;
        }

        to {
            filter: none;
            opacity: 1;
        }
    }

    [data-animated-title-word] {
        display: inline-block;
    }

    .hero-title-pill {
        background: var(--color-blue-500);
        border-radius: 999em;
        box-shadow:
            0 0.2em 0.58em -0.28em rgba(62, 96, 212, 0.62),
            0 0.08em 0.18em -0.1em rgba(34, 42, 55, 0.28);
        color: var(--color-snow-50);
        line-height: 1;
        margin-inline: 0.04em;
        padding: 0 0.28em 0.07em;
    }

    .testimonial-rotator {
        display: grid;
        min-height: 8.5rem;
        place-items: center;
        width: min(100%, 30rem);
    }

    .testimonial-rotator__item {
        align-items: center;
        display: flex;
        filter: blur(6px);
        flex-direction: column;
        gap: 1rem;
        grid-area: 1 / 1;
        opacity: 0;
        pointer-events: none;
        transform: translateY(0.35rem);
        transition:
            opacity 360ms cubic-bezier(0.2, 0, 0, 1),
            filter 520ms cubic-bezier(0.2, 0, 0, 1),
            transform 520ms cubic-bezier(0.2, 0, 0, 1);
        width: 100%;
    }

    .testimonial-rotator__item.is-active {
        filter: none;
        opacity: 1;
        pointer-events: auto;
        transform: none;
    }

    .testimonial-rotator__item.is-active blockquote,
    .testimonial-rotator__item.is-active .testimonial-rotator__person {
        animation: testimonial-content-in 920ms cubic-bezier(0.22, 1.16, 0.36, 1)
            backwards;
    }

    .testimonial-rotator__item.is-active blockquote {
        animation-delay: 120ms;
    }

    .testimonial-rotator__item.is-active .testimonial-rotator__person {
        animation-delay: 360ms;
    }

    @keyframes testimonial-content-in {
        from {
            filter: blur(8px);
            opacity: 0;
            transform: translateY(-0.65rem);
        }

        to {
            filter: none;
            opacity: 1;
            transform: none;
        }
    }

    .testimonial-avatar {
        align-items: center;
        aspect-ratio: 1;
        background: var(--color-snow-600);
        border-radius: 9999px;
        color: var(--color-gray-900);
        display: inline-flex;
        font-size: 0.8rem;
        font-weight: 500;
        height: 2.5rem;
        justify-content: center;
        overflow: hidden;
        width: 2.5rem;
    }

    .testimonial-rotator__person {
        align-items: center;
        display: flex;
        gap: 0.75rem;
        justify-content: center;
    }

    .testimonial-avatar__image {
        display: block;
        height: 100%;
        object-fit: cover;
        width: 100%;
    }

    .testimonial-rotator figcaption {
        color: var(--color-gray-900);
        font-size: 0.875rem;
