---
import Layout from "../layout/Layout.astro";
import FadeReveal from "../components/animations/FadeReveal.astro";
import FadeRevealOnScroll from "../components/animations/FadeRevealOnScroll.astro";
import Marquee from "../components/Marquee.astro";
import Carousel from "../components/Carousel.astro";
import HeroDotMatrix from "../components/HeroDotMatrix.astro";
import ProjectIntro from "../components/ProjectIntro.astro";
import Differenciates from "@/sections/Differenciates.astro";
import ArrowRight from "../components/icons/ArrowRight.svg";
import WaveIcon from "../components/ui/WaveIcon.astro";
import WaveText from "../components/ui/WaveText.astro";

const heroTitleWords = [
    "Je",
    "crée",
    "des",
    "sites",
    "web",
    "et",
    "des",
    "interfaces",
    "rapides,",
    "soignés",
    "et",
    "pensés",
    "pour",
    "convertir.",
];

const highlightedHeroWords = new Set(["rapides,", "soignés", "convertir."]);
const heroTitleParts = heroTitleWords.flatMap((word) =>
    word === "interfaces"
        ? [
              { type: "word" as const, value: word },
              { type: "avatar" as const, value: "william" },
          ]
        : [{ type: "word" as const, value: word }],
);
---

<Layout>
    <section class="max-w-5xl mx-auto">
        <div class="flex flex-col gap-6">
            <p
                class="mx-auto w-fit rounded-xl bg-blue-500 px-4 py-1.5 text-sm font-light leading-none text-snow-50 shadow-[0_10px_18px_-8px_rgba(37,99,235,0.85)] ring-1 ring-blue-400/70 md:text-base"
                data-hero-eyebrow
            >
                Freelance front-end orienté design et produit
            </p>
            <h1
                class="flex flex-wrap justify-center gap-x-[0.18em] text-7xl text-gray-900 text-center leading-tighter tracking-[-4%] font-medium"
                data-hero-title
            >
                {
                    heroTitleParts.map((part) =>
                        part.type === "avatar" ? (
                            <span
                                class="hero-title-avatar"
                                data-hero-title-word
                                aria-hidden="true"
                            >
                                <span class="hero-title-avatar__placeholder" />
                            </span>
                        ) : (
                            <span
                                class:list={[
                                    highlightedHeroWords.has(part.value) &&
                                        "text-blue-500",
                                ]}
                                data-hero-title-word
                            >
                                {part.value}
                            </span>
                        ),
                    )
                }
            </h1>
            <FadeReveal delay={0.08}>
                <p
                    class="max-w-120 tracking-[-4%] leading-tight text-coffee-300 font-light text-center text-md mx-auto"
                >
                    J’aide les petites structures et les équipes produit à lancer
                    des interfaces & sites performants, accessibles et
                    SEO-friendly.
                </p>
            </FadeReveal>
            <FadeReveal delay={0.16}>
                <div class="flex gap-8 items-center justify-center">
                    <a
                        class="hero-button hero-button--primary font-regular px-6 text-md py-1.5 rounded-xl h-12 flex justify-center items-center"
                        href="#projects"
                        ><WaveText
                            text="Parlons de votre projet"
                            trigger="parent"
                        />
                        <WaveIcon
                            style="--wui-wave-icon-size: 1rem;"
                            direction="right"
                            trigger="parent"
                        >
                            <ArrowRight class="size-full" aria-hidden="true" />
                        </WaveIcon>
                    </a>
                    <a
                        class="hero-button hero-button--secondary font-regular px-6 py-1.5 rounded-xl h-12 flex text-md justify-center items-center"
                        href="#projects"
                        ><WaveText
                            text="Voir mes réalisations"
                            trigger="parent"
                        /></a
                    >
                </div>
            </FadeReveal>
            <FadeReveal delay={0.24}>
                <div
                    class="flex-col gap-2 mx-auto text-center text-xs flex items-center justify-center my-4"
                >
                    <div class="size-8 rounded-full bg-[#E8E5E8]"></div>
                    <span class="">Quentin Leffelic</span>
                    <p class="max-w-70 mx-auto">
                        “Excellente collaboration avec william, site livré
                        rapidement et avec soin”
                    </p>
                </div>
            </FadeReveal>
            <HeroDotMatrix />
        </div>
    </section>
    <FadeRevealOnScroll delay={0.12}>
        <Marquee />
    </FadeRevealOnScroll>
    <section id="projects" class="project-showcase mb-20" data-project-showcase>
        <div class="project-copy mx-auto max-w-5xl px-4 pb-10">
            <article
                class="project-copy__panel is-active"
                data-project-panel
                data-project-index="0"
            >
                <ProjectIntro
                    detailsHref="/projets#motivai"
                    href="https://www.motivai.fr/"
                    title="Motivai"
                >
                    SaaS de génération de lettres de motivation par IA, développé
                    en solo depuis 2024. J'ai conçu l'architecture complète avec
                    <span>Next.js</span>, <span>Drizzle ORM</span> et <span
                        >Better Auth</span
                    >. L'intégration du <span>Vercel AI SDK</span> permet aux
                    utilisateurs de choisir leur modèle d'IA.
                </ProjectIntro>
            </article>
            <article
                class="project-copy__panel"
                data-project-panel
                data-project-index="1"
            >
                <ProjectIntro detailsHref="/projets" href="/projets" title="Komin">
                    Site vitrine sobre pour une marque locale, pensé pour
                    clarifier l'offre, structurer le message et guider la prise
                    de contact.
                </ProjectIntro>
            </article>
            <article
                class="project-copy__panel"
                data-project-panel
                data-project-index="2"
            >
                <ProjectIntro
                    detailsHref="/projets"
                    href="/projets"
                    title="Studio Nova"
                >
                    Interface éditoriale fictive avec direction visuelle
                    minimaliste, sections modulaires et rendu responsive.
                </ProjectIntro>
            </article>
        </div>

        <Carousel autoplay>
            <div class="embla__slide">
                <video
                    muted
                    playsinline
                    loop
                    preload="metadata"
                    tabindex="-1"
                    poster="/motivai/motivai-landing.webp"
                    aria-hidden="true"
                    class="h-full w-full object-cover rounded-md"
                >
                    <source
                        src="/motivai/motivai-landing.mp4"
                        type="video/mp4"
                    />
                </video>
            </div>
            <div class="embla__slide">
                <div class="project-placeholder rounded-md" data-project-name="Komin">
                    <span>Komin</span>
                </div>
            </div>
            <div class="embla__slide">
                <div class="project-placeholder rounded-md" data-project-name="Studio Nova">
                    <span>Studio Nova</span>
                </div>
            </div>
        </Carousel>
    </section>
    <Differenciates />
</Layout>

<script>
    import { animate, spring, stagger } from "animejs";

    const initHeroTitleAnimation = () => {
        const title = document.querySelector<HTMLElement>("[data-hero-title]");

        if (!title || title.dataset.heroTitleReady) return;

        const words = title.querySelectorAll<HTMLElement>(
            "[data-hero-title-word]",
        );

        title.dataset.heroTitleReady = "running";

        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
            title.dataset.heroTitleReady = "true";
            return;
        }

        words.forEach((word) => {
            word.style.willChange = "opacity, transform, filter";
        });

        animate(words, {
            opacity: [0, 1],
            translateY: ["-0.65em", "0em"],
            filter: ["blur(10px)", "blur(0px)"],
            duration: 1100,
            delay: stagger(65),
            ease: "out(4)",
            onComplete: () => {
                title.dataset.heroTitleReady = "true";
                words.forEach((word) => {
                    word.style.willChange = "auto";
                });
            },
        });
    };

    const projectTextAnimations = new WeakMap<HTMLElement, { cancel: () => void }>();

    const animateProjectPanel = (panel: HTMLElement, direction: string) => {
        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

        const items = panel.querySelectorAll<HTMLElement>(
            ".project-intro__title, .project-intro__description",
        );
        const fromY = direction === "prev" ? "1.15rem" : "-1.15rem";

        projectTextAnimations.get(panel)?.cancel();
        items.forEach((item) => {
            item.style.willChange = "opacity, transform, filter";
        });

        projectTextAnimations.set(
            panel,
            animate(items, {
                opacity: [0, 1],
                translateY: [fromY, "0rem"],
                filter: ["blur(8px)", "blur(0px)"],
                delay: stagger(130),
                ease: spring({ bounce: 0.12, duration: 760 }),
                onComplete: () => {
                    items.forEach((item) => {
                        item.style.willChange = "auto";
                    });
                },
            }),
        );
    };

    const initProjectShowcases = () => {
        document
            .querySelectorAll<HTMLElement>("[data-project-showcase]")
            .forEach((root) => {
                if (root.dataset.projectShowcaseReady === "true") return;

                const panels =
                    root.querySelectorAll<HTMLElement>("[data-project-panel]");

                const setActivePanel = (
                    index: number,
                    direction = "next",
                    shouldAnimate = true,
                ) => {
                    root.dataset.projectDirection = direction;
                    let activePanel: HTMLElement | undefined;

                    panels.forEach((panel) => {
                        const isActive =
                            Number(panel.dataset.projectIndex) === index;

                        panel.classList.toggle("is-active", isActive);
                        panel.setAttribute("aria-hidden", String(!isActive));
                        if (isActive) activePanel = panel;
                    });

                    if (shouldAnimate && activePanel) {
                        animateProjectPanel(activePanel, direction);
                    }
                };

                root.dataset.projectShowcaseReady = "true";
                setActivePanel(0, "next", false);
                root.addEventListener("carousel:select", (event) => {
                    const { direction, index } = (
                        event as CustomEvent<{
                            direction?: string;
                            index: number;
                        }>
                    ).detail;

                    setActivePanel(index, direction);
                });
            });
    };

    initHeroTitleAnimation();
    initProjectShowcases();
    document.addEventListener("astro:page-load", initHeroTitleAnimation);
    document.addEventListener("astro:page-load", initProjectShowcases);
</script>

<style>
    [data-hero-eyebrow] {
        animation: hero-eyebrow-fade 780ms cubic-bezier(0.2, 0, 0, 1) both;
    }

    @keyframes hero-eyebrow-fade {
        from {
            filter: blur(8px);
            opacity: 0;
        }

        to {
            filter: blur(0);
            opacity: 1;
        }
    }

    [data-hero-title-word] {
        display: inline-block;
    }

    .hero-title-avatar {
        align-self: center;
        aspect-ratio: 1;
        background: #e8e5e8;
        border: 0.08em solid #fff;
        border-radius: 9999px;
        box-shadow:
            0 18px 38px -18px rgba(17, 24, 39, 0.58),
            0 4px 12px rgba(17, 24, 39, 0.14);
        display: inline-flex;
        height: 0.9em;
        margin-inline: -0.04em;
        overflow: hidden;
    }

    .hero-title-avatar__placeholder {
        background:
            radial-gradient(
                circle at 35% 30%,
                rgba(255, 255, 255, 0.95) 0 12%,
                transparent 13%
            ),
            linear-gradient(135deg, #d7e3f8 0%, #e8e5e8 46%, #bac8dc 100%);
        height: 100%;
        width: 100%;
    }

    [data-hero-title]:not([data-hero-title-ready="true"])
        [data-hero-title-word] {
        filter: blur(10px);
        opacity: 0;
        transform: translateY(-0.65em);
    }

    @media (scripting: none), (prefers-reduced-motion: reduce) {
        [data-hero-eyebrow] {
            animation: none;
        }

        [data-hero-title] [data-hero-title-word] {
            filter: none;
            opacity: 1;
            transform: none;
        }
    }

    .project-copy {
        display: grid;
    }

    .project-copy__panel {
        filter: blur(6px);
        grid-area: 1 / 1;
        opacity: 0;
        pointer-events: none;
        transition:
            opacity 320ms cubic-bezier(0.2, 0, 0, 1),
            filter 420ms cubic-bezier(0.2, 0, 0, 1);
    }

    .project-copy__panel.is-active {
        filter: blur(0);
        opacity: 1;
        pointer-events: auto;
    }

    .project-placeholder {
        align-items: center;
        aspect-ratio: 16 / 9;
        background: #e8e5e8;
        color: rgb(63 63 70);
        display: flex;
        font-size: clamp(2rem, 6vw, 5rem);
        font-weight: 500;
        height: 100%;
        justify-content: center;
        width: 100%;
    }

    .hero-button {
        --hero-button-bg: #e8e5e8;
        --hero-button-border: transparent;
        --hero-button-color: var(--color-coffee-300);

        color: var(--hero-button-color);
        gap: 0.75rem;
        isolation: isolate;
        position: relative;
        text-decoration: none;
    }

    .hero-button::before {
        background: var(--hero-button-bg);
        border: 1px solid var(--hero-button-border);
        border-radius: inherit;
        content: "";
        inset: 0;
        position: absolute;
        transform: scale(1);
        transition: transform 520ms
            var(--wui-ease-standard, cubic-bezier(0.2, 0, 0, 1));
        will-change: transform;
        z-index: -1;
    }

    .hero-button:hover::before,
    .hero-button:focus-visible::before {
        transform: scale(0.95);
    }

    .hero-button:focus-visible {
        outline: 2px solid var(--color-blue-500);
        outline-offset: 3px;
    }

    .hero-button--primary {
        --hero-button-bg: var(--color-coffee-300);
        --hero-button-border: var(--color-coffee-300);
        --hero-button-color: #eef5ff;
    }

    .hero-button--secondary {
        --hero-button-bg: #e8e5e8;
    }

    @media (prefers-reduced-motion: reduce) {
        .hero-button::before {
            transition: none;
            will-change: auto;
        }
    }
</style>
