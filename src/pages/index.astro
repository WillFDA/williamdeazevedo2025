---
import Layout from "../layout/Layout.astro";
import Marquee from "../components/Marquee.tsx";
import Carousel from "../components/Carousel.astro";
---

<Layout>
    <section class="flex flex-col gap-4 max-w-5xl w-5xl mx-auto">
        <h1 class="text-4xl max-w-1/2 text-zinc-500">
            Hello, moi c'est <span class="text-zinc-700">William</span>.<br />
            Je suis Développeur Front-end avec un sens du <span
                class="text-zinc-700">design</span
            > et de <span class="text-zinc-700">l'animation</span>
        </h1>
        <p class="max-w-80 text-zinc-500 font-light">
            Je construis des interfaces React soignées, animées et pensées dans
            le détail.
        </p>
        <a class="font-light" href="#projects">Voir mes projets</a>
    </section>
    <Marquee client:load />
    <section id="projects">
        <Carousel>
            <div class="embla__slide">
                <video
                    width="100%"
                    height="auto"
                    muted
                    playsinline
                    autoplay
                    loop
                    preload="metadata"
                    tabindex="-1"
                    poster="motivai/motivai-landing.webp"
                    aria-hidden="true"
                    class="h-full w-full object-cover rounded-md"
                >
                    <source
                        src="motivai/motivai-landing.mp4"
                        type="video/mp4"
                    />
                </video>
            </div>
            <div class="embla__slide">
                <video
                    width="100%"
                    height="auto"
                    muted
                    playsinline
                    autoplay
                    loop
                    preload="metadata"
                    tabindex="-1"
                    poster="motivai/motivai-onboarding.webp"
                    aria-hidden="true"
                    class="h-full w-full object-cover rounded-md"
                >
                    <source
                        src="motivai/motivai-onboarding.mp4"
                        type="video/mp4"
                    />
                </video>
            </div>
            <div class="embla__slide">
                <video
                    width="100%"
                    height="auto"
                    muted
                    playsinline
                    autoplay
                    loop
                    preload="metadata"
                    tabindex="-1"
                    poster="motivai/motivai-aichoose.webp"
                    aria-hidden="true"
                    class="h-full w-full object-cover rounded-md"
                >
                    <source
                        src="motivai/motivai-aichoose.mp4"
                        type="video/mp4"
                    />
                </video>
            </div>
        </Carousel>
    </section>
</Layout>
