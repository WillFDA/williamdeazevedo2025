---
import Layout from "../layout/Layout.astro";
import Marquee from "../components/Marquee.tsx";
import Differenciates from "@/sections/Differenciates.astro";
import ArrowRight from "../components/icons/ArrowRight.svg";
import WaveIcon from "../components/ui/WaveIcon.astro";
import WaveText from "../components/ui/WaveText.astro";

const projects = [
    {
        title: "Motivai",
        description:
            "SaaS IA pour générer des lettres de motivation, avec onboarding, génération et parcours produit complet.",
    },
    {
        title: "Komin",
        description:
            "Site vitrine sobre pour une marque locale, pensé pour clarifier l'offre et guider la prise de contact.",
    },
    {
        title: "Studio Nova",
        description:
            "Interface éditoriale fictive avec direction visuelle minimaliste, sections modulaires et responsive.",
    },
];
---

<Layout>
    <section class="flex flex-col gap-6 max-w-5xl mx-auto">
        <h1
            class="text-7xl text-gray-900 [&_span]:text-blue-500 text-center leading-tighter tracking-[-4%] font-medium"
        >
            Je crée des sites web et des interfaces <span>rapides, soignés</span
            > et pensés pour <span>convertir.</span>
        </h1>
        <p
            class="max-w-120 tracking-[-4%] leading-tight text-coffee-300 font-light text-center text-md mx-auto"
        >
            J’aide les petites structures et les équipes produit à lancer des
            interfaces & sites performants, accessibles et SEO-friendly.
        </p>
        <div class="flex gap-8 items-center justify-center">
            <a
                class="hero-button hero-button--primary font-regular px-6 text-md py-1.5 rounded-xl h-12 flex justify-center items-center"
                href="#projects"
                ><WaveText text="Parlons de votre projet" trigger="parent" />
                <WaveIcon
                    style="--wui-wave-icon-size: 1rem;"
                    direction="right"
                    trigger="parent"
                >
                    <ArrowRight class="size-full" aria-hidden="true" />
                </WaveIcon>
            </a>
            <a
                class="hero-button hero-button--secondary font-regular px-6 py-1.5 rounded-xl h-12 flex text-md justify-center items-center"
                href="#projects"><WaveText text="Voir les études de cas" trigger="parent" /></a
            >
        </div>
        <div
            class="flex-col gap-2 mx-auto text-center text-xs flex items-center justify-center my-4"
        >
            <div class="size-8 rounded-full bg-[#E8E5E8]"></div>
            <span class="">Quentin Leffelic</span>
            <p class="max-w-70 mx-auto">
                “Excellente collaboration avec william, site livré rapidement et
                avec soin”
            </p>
        </div>
    </section>
    <Marquee client:load />
    <section id="projects" class="mb-20 px-4">
        <div class="mx-auto flex max-w-5xl flex-col gap-8">
            <div class="flex items-end justify-between gap-6">
                <h2 class="text-3xl text-zinc-700 font-medium">Projets</h2>
                <a class="text-sm font-light text-zinc-500" href="/projets"
                    >Voir les réalisations</a
                >
            </div>

            <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
                {
                    projects.map((project) => (
                        <article class="flex flex-col gap-4">
                            <div class="aspect-video rounded-lg bg-gray-100" />
                            <div class="flex flex-col gap-2">
                                <h3 class="text-xl font-medium leading-tight text-zinc-700">
                                    {project.title}
                                </h3>
                                <p class="text-sm font-light leading-tight text-zinc-500">
                                    {project.description}
                                </p>
                            </div>
                        </article>
                    ))
                }
            </div>
        </div>
    </section>
    <Differenciates />
</Layout>

<style>
    .hero-button {
        --hero-button-bg: #e8e5e8;
        --hero-button-border: transparent;
        --hero-button-color: var(--color-coffee-300);

        color: var(--hero-button-color);
        gap: 0.75rem;
        isolation: isolate;
        position: relative;
        text-decoration: none;
    }

    .hero-button::before {
        background: var(--hero-button-bg);
        border: 1px solid var(--hero-button-border);
        border-radius: inherit;
        content: "";
        inset: 0;
        position: absolute;
        transform: scale(1);
        transition: transform 520ms
            var(--wui-ease-standard, cubic-bezier(0.2, 0, 0, 1));
        will-change: transform;
        z-index: -1;
    }

    .hero-button:hover::before,
    .hero-button:focus-visible::before {
        transform: scale(0.95);
    }

    .hero-button:focus-visible {
        outline: 2px solid var(--color-blue-500);
        outline-offset: 3px;
    }

    .hero-button--primary {
        --hero-button-bg: var(--color-coffee-300);
        --hero-button-border: var(--color-coffee-300);
        --hero-button-color: #eef5ff;
    }

    .hero-button--secondary {
        --hero-button-bg: #e8e5e8;
    }

    @media (prefers-reduced-motion: reduce) {
        .hero-button::before {
            transition: none;
            will-change: auto;
        }
    }
</style>
