---
import CalButton from "@/components/CalButton.astro";
import FadeReveal from "@/components/animations/FadeReveal.astro";
import FadeRevealOnScroll from "@/components/animations/FadeRevealOnScroll.astro";
import CheckIcon from "@/components/icons/nucleo/check-2-outline.svg";
import XMarkIcon from "@/components/icons/nucleo/xmark-fill.svg";
import Layout from "@/layout/Layout.astro";

export const prerender = true;

const steps = [
    {
        title: "Appel découverte",
        text: "On vérifie votre contexte, l'objectif, le calendrier, le budget approximatif et l'adéquation avec mon accompagnement.",
    },
    {
        title: "Cadrage",
        text: "On clarifie la cible, les pages nécessaires, les contenus disponibles, le parcours de conversion et les contraintes techniques.",
    },
    {
        title: "Structure et contenu",
        text: "Je propose une organisation des sections, des messages principaux et des appels à l'action avant de passer à l'interface.",
    },
    {
        title: "Design",
        text: "Le design traduit la structure en pages lisibles, cohérentes avec votre marque et adaptées aux usages mobile et desktop.",
    },
    {
        title: "Développement",
        text: "J'intègre le site ou l'interface avec une attention forte à la performance, l'accessibilité, la maintenance et les détails responsive.",
    },
    {
        title: "Recette et mise en ligne",
        text: "On contrôle les pages, formulaires, métadonnées, liens, responsive, performances et actions de conversion avant publication.",
    },
    {
        title: "Après la livraison",
        text: "Selon le projet : corrections, prise en main, documentation légère, maintenance ou évolutions futures.",
    },
];

const clientNeeds = [
    "un interlocuteur principal",
    "les contenus et visuels disponibles",
    "les accès utiles au domaine, hébergement ou outils",
    "des retours regroupés à chaque étape",
    "une validation claire avant de passer à l'étape suivante",
];

const delivered = [
    "un site ou une interface publiée",
    "les accès nécessaires",
    "une base technique maintenable",
    "les éléments SEO techniques prévus au périmètre",
    "un point de transmission ou de prise en main",
];

const aiPitfalls = [
    "sections jolies mais génériques",
    "messages qui ne disent pas assez clairement pourquoi vous choisir",
    "parcours pensé pour remplir une page plutôt que pour lever un doute",
    "design difficile à adapter à votre activité, vos contenus et vos vrais clients",
];

const aiUses = [
    "explorer plus vite des angles de contenu",
    "challenger la structure d'une page ou d'un parcours",
    "auditer des points de clarté, d'accessibilité, de performance ou de SEO",
    "accélérer certaines recherches sans déléguer les décisions importantes",
];
---

<Layout
    title="Méthode de création d'un site web - William De Azevedo"
    description="Une méthode de création ou refonte web pour clarifier l'offre, lever les freins, concevoir l'interface, développer, tester et mettre en ligne."
>
    <div class="mx-auto flex w-full max-w-5xl flex-col gap-12 px-4 py-12 md:gap-16 md:py-16">
        <FadeReveal delay={0.1}>
            <section class="mx-auto flex max-w-4xl flex-col items-center gap-5 text-center">
                <h1 class="page-heading">
                    Une méthode pour transformer le flou en parcours clair
                </h1>
                <p class="page-subheading max-w-sm sm:max-w-lg">
                    Un bon site ne se résume pas à de beaux écrans. On part des
                    hésitations de vos visiteurs, puis on clarifie ce qui doit être
                    compris, montré et vérifié avant de développer.
                </p>
                <CalButton
                    class="rounded-xl text-base font-normal"
                    label="Planifier un appel de cadrage"
                    location="methode-hero"
                />
            </section>
        </FadeReveal>

        <ol class="grid gap-3" aria-label="Étapes de la méthode">
            {
                steps.map((step, index) => (
                    <li>
                        <FadeRevealOnScroll delay={Math.min(index * 0.05, 0.2)}>
                            <div class="grid gap-4 rounded-xl bg-snow-50 p-5 ring-1 ring-snow-600 md:grid-cols-[3rem_0.7fr_1.3fr] md:items-start">
                                <span
                                    aria-hidden="true"
                                    class="flex size-10 items-center justify-center rounded-xl bg-blue-500 text-sm font-normal text-snow-50 shadow-[inset_0_1px_0_rgba(255,255,255,0.24),0_14px_24px_-14px_rgba(62,96,212,0.9)]"
                                >
                                    {index + 1}
                                </span>
                                <h2 class="text-xl font-normal leading-tight text-gray-900">
                                    {step.title}
                                </h2>
                                <p class="text-base font-normal leading-relaxed text-gray-600">
                                    {step.text}
                                </p>
                            </div>
                        </FadeRevealOnScroll>
                    </li>
                ))
            }
        </ol>

        <FadeRevealOnScroll>
            <section class="grid gap-6 rounded-4xl bg-gray-100 p-6 ring-1 ring-gray-200 md:grid-cols-[0.9fr_1.1fr] md:gap-12 md:p-8">
                <div class="flex flex-col gap-4">
                    <h2 class="section-heading text-left">
                        L'IA aide, mais elle ne remplace pas le regard
                    </h2>
                    <p class="text-base font-normal leading-relaxed text-gray-600">
                        Faire un site uniquement avec une IA donne souvent une
                        interface propre en apparence, mais trop générique : elle
                        assemble des sections sans comprendre votre offre, vos
                        prospects, vos preuves et les objections qui bloquent
                        vraiment le contact.
                    </p>
                    <CalButton
                        class="w-fit rounded-xl text-base font-normal"
                        label="Cadrer mon projet avec vous"
                        location="methode-ai"
                    />
                </div>
                <div class="grid gap-4 md:grid-cols-2">
                    <article class="rounded-xl bg-snow-50 p-5 ring-1 ring-snow-600">
                        <h3 class="mb-4 text-lg font-normal leading-tight text-gray-900">
                            Quand l'IA décide seule
                        </h3>
                        <ul class="flex flex-col gap-3">
                            {aiPitfalls.map((item) => (
                                <li class="flex items-start gap-3 text-base font-normal leading-relaxed text-gray-600">
                                    <span
                                        class="mt-1 flex size-6 shrink-0 items-center justify-center rounded-lg bg-red-500/10 text-red-500"
                                        aria-hidden="true"
                                    >
                                        <XMarkIcon class="size-2.5" />
                                    </span>
                                    <span>{item}</span>
                                </li>
                            ))}
                        </ul>
                    </article>
                    <article class="rounded-xl bg-snow-50 p-5 ring-1 ring-snow-600">
                        <h3 class="mb-4 text-lg font-normal leading-tight text-gray-900">
                            Comment je l'utilise
                        </h3>
                        <ul class="flex flex-col gap-3">
                            {aiUses.map((item) => (
                                <li class="flex items-start gap-3 text-base font-normal leading-relaxed text-gray-600">
                                    <span
                                        class="mt-1 flex size-6 shrink-0 items-center justify-center rounded-lg bg-emerald-500/10 text-emerald-500"
                                        aria-hidden="true"
                                    >
                                        <CheckIcon class="size-3.5" />
                                    </span>
                                    <span>{item}</span>
                                </li>
                            ))}
                        </ul>
                    </article>
                </div>
            </section>
        </FadeRevealOnScroll>

        <section class="grid gap-4 md:grid-cols-2">
            <FadeRevealOnScroll class="flex">
                <article class="w-full rounded-xl bg-gray-100 p-6 ring-1 ring-gray-200">
                    <h2 class="mb-4 text-2xl font-normal leading-tight text-gray-900">
                        Ce dont j'ai besoin de votre côté
                    </h2>
                    <ul class="flex flex-col gap-3">
                        {
                            clientNeeds.map((item) => (
                                <li class="flex items-start gap-3 text-base font-normal leading-relaxed text-gray-600">
                                    <span
                                        class="mt-1 flex size-6 shrink-0 items-center justify-center rounded-lg bg-blue-50 text-blue-500"
                                        aria-hidden="true"
                                    >
                                        <CheckIcon class="size-3.5" />
                                    </span>
                                    <span>{item}</span>
                                </li>
                            ))
                        }
                    </ul>
                </article>
            </FadeRevealOnScroll>
            <FadeRevealOnScroll class="flex" delay={0.08}>
                <article class="w-full rounded-xl bg-gray-100 p-6 ring-1 ring-gray-200">
                    <h2 class="mb-4 text-2xl font-normal leading-tight text-gray-900">
                        Ce que vous récupérez à la fin
                    </h2>
                    <ul class="flex flex-col gap-3">
                        {
                            delivered.map((item) => (
                                <li class="flex items-start gap-3 text-base font-normal leading-relaxed text-gray-600">
                                    <span
                                        class="mt-1 flex size-6 shrink-0 items-center justify-center rounded-lg bg-emerald-500/10 text-emerald-500"
                                        aria-hidden="true"
                                    >
                                        <CheckIcon class="size-3.5" />
                                    </span>
                                    <span>{item}</span>
                                </li>
                            ))
                        }
                    </ul>
                </article>
            </FadeRevealOnScroll>
        </section>

        <FadeRevealOnScroll>
            <section class="grid gap-6 md:grid-cols-[0.9fr_1.1fr] md:items-start md:gap-12">
                <div class="flex flex-col gap-4">
                    <h2 class="section-heading text-left">
                        Comment éviter les retours dispersés ?
                    </h2>
                    <p class="text-base font-normal leading-relaxed text-gray-600">
                        Les retours sont plus efficaces lorsqu'ils sont regroupés,
                        priorisés et rattachés à l'objectif de la page : clarté,
                        confiance, performance ou conversion. Cela évite les
                        ajustements isolés qui fragilisent le projet.
                    </p>
                </div>
                <div class="rounded-xl bg-snow-50 p-6 ring-1 ring-snow-600">
                    <p class="text-base font-normal leading-relaxed text-gray-600">
                        À chaque étape importante, je vous explique ce qui est
                        attendu : validation de la structure, validation du design,
                        recette du site puis mise en ligne. Une correction reste
                        liée au périmètre validé ; une nouvelle demande peut devenir
                        une évolution séparée.
                    </p>
                </div>
            </section>
        </FadeRevealOnScroll>
    </div>

    <div class="mx-auto w-full max-w-5xl px-4 pb-12 md:pb-16">
        <FadeRevealOnScroll>
            <section class="relative left-1/2 isolate w-[calc(100dvw-1rem)] -translate-x-1/2 overflow-hidden rounded-4xl bg-coffee-300 py-12 text-snow-50 sm:w-[calc(100dvw-2rem)] md:py-16">
                <div class="relative z-10 mx-auto flex max-w-4xl flex-col items-center gap-4 px-4 text-center sm:px-8 md:gap-6">
                    <h2 class="section-heading section-heading--inverse max-w-4xl">
                        Vous voulez savoir si ce cadre convient à votre projet ?
                    </h2>
                    <p class="section-subheading section-subheading--inverse max-w-3xl">
                        On commence par un appel court, sans engagement, pour
                        comprendre ce qui bloque aujourd'hui et éviter de partir
                        dans la mauvaise direction.
                    </p>
                    <CalButton
                        class="mt-2 rounded-xl text-base font-normal"
                        label="Vérifier le bon cadre"
                        location="methode-final"
                        variant="light"
                    />
                </div>
            </section>
        </FadeRevealOnScroll>
    </div>
</Layout>
