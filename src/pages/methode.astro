---
import CalButton from "@/components/CalButton.astro";
import CapabilitiesStrip from "@/components/CapabilitiesStrip.astro";
import ServiceDiagnosticToggle from "@/components/ServiceDiagnosticToggle.astro";
import ServiceTimelineScroll from "@/components/ServiceTimelineScroll.astro";
import FadeReveal from "@/components/animations/FadeReveal.astro";
import FadeRevealOnScroll from "@/components/animations/FadeRevealOnScroll.astro";
import GlobeIcon from "@/components/icons/nucleo/globe-outline.svg";
import MsgsIcon from "@/components/icons/nucleo/msgs-fill.svg";
import SearchContentIcon from "@/components/icons/nucleo/search-content-2-fill.svg";
import WindowLayoutIcon from "@/components/icons/nucleo/window-layout-fill.svg";
import type { ServiceTimelinePoint } from "@/data/services";
import Layout from "@/layout/Layout.astro";

export const prerender = true;

const steps = [
    {
        title: "Appel découverte",
        text: "On vérifie votre contexte, l'objectif, le calendrier, le budget approximatif et l'adéquation avec mon accompagnement.",
    },
    {
        title: "Cadrage",
        text: "On clarifie la cible, les pages nécessaires, les contenus disponibles, le parcours de conversion et les contraintes techniques.",
    },
    {
        title: "Structure et contenu",
        text: "Je propose une organisation des sections, des messages principaux et des appels à l'action avant de passer à l'interface.",
    },
    {
        title: "Design",
        text: "Le design traduit la structure en pages lisibles, cohérentes avec votre marque et adaptées aux usages mobile et desktop.",
    },
    {
        title: "Développement",
        text: "J'intègre le site ou l'interface avec une attention forte à la performance, l'accessibilité, la maintenance et les détails responsive.",
    },
    {
        title: "Recette et mise en ligne",
        text: "On contrôle les pages, formulaires, métadonnées, liens, responsive, performances et actions de conversion avant publication.",
    },
    {
        title: "Après la livraison",
        text: "Search Console configurée, tableau de bord de mesure à votre nom, puis un point à 30 jours pour lire les premières données ensemble. Selon le projet : corrections, prise en main, maintenance ou évolutions.",
    },
];

const stepPresentation = [
    { icon: "form", tone: "sky" },
    { icon: "conversion", tone: "indigo" },
    { icon: "ux", tone: "violet" },
    { icon: "refonte", tone: "cyan" },
    { icon: "cms", tone: "slate" },
    { icon: "deploy", tone: "orange" },
    { icon: "performance", tone: "green" },
] satisfies Pick<ServiceTimelinePoint, "icon" | "tone">[];

const methodTimelineItems = steps.map((step, index) => ({
    description: step.text,
    icon: stepPresentation[index]?.icon ?? "web",
    title: step.title,
    tone: stepPresentation[index]?.tone ?? "blue",
})) satisfies ServiceTimelinePoint[];

const heroTitleParts = [
    { text: "Une" },
    { pill: true, text: "méthode" },
    { text: "pour" },
    { text: "transformer" },
    { text: "le" },
    { text: "flou" },
    { text: "en" },
    { pill: true, text: "parcours clair" },
];

const methodologyCapabilities = [
    { icon: "search", label: "Diagnostic initial", tone: "sky" },
    { icon: "form", label: "Cadrage clair", tone: "pink" },
    { icon: "ux", label: "Structure des pages", tone: "violet" },
    { icon: "refonte", label: "Design utile", tone: "cyan" },
    { icon: "cms", label: "Développement propre", tone: "slate" },
    { icon: "performance", label: "Recette & tests", tone: "green" },
    { icon: "deploy", label: "Mise en ligne", tone: "orange" },
    { icon: "conversion", label: "Suivi 30 jours", tone: "indigo" },
] as const;

const collaborationFlow = [
    {
        description:
            "Vous n'avez pas besoin de tout préparer parfaitement. Il faut surtout les bons éléments au bon moment.",
        icon: "input",
        items: [
            "contenus et visuels",
            "accès utiles",
            "retours regroupés",
        ],
        title: "Vous apportez la matière",
        tone: "blue",
    },
    {
        description:
            "Je transforme ces éléments en décisions lisibles : objectif, structure, priorités et validations.",
        icon: "clarify",
        items: ["objectif", "structure", "validation"],
        title: "Je clarifie le cadre",
        tone: "violet",
    },
    {
        description:
            "Vous repartez avec une base publiée, maintenable, mesurable et compréhensible après la mise en ligne.",
        icon: "delivery",
        items: ["site publié", "SEO technique", "mesure en place"],
        title: "Vous récupérez une base utile",
        tone: "green",
    },
] as const;

const flowToneClasses = {
    blue: {
        icon: "bg-blue-500 text-snow-50",
        marker: "bg-blue-500",
        soft: "bg-blue-50 text-blue-700 ring-blue-100",
    },
    green: {
        icon: "bg-emerald-500 text-snow-50",
        marker: "bg-emerald-500",
        soft: "bg-emerald-500/10 text-emerald-700 ring-emerald-500/15",
    },
    violet: {
        icon: "bg-[#8b73e6] text-snow-50",
        marker: "bg-[#8b73e6]",
        soft: "bg-[#8b73e6]/10 text-gray-800 ring-[#8b73e6]/15",
    },
};

const aiPitfalls = [
    "design neutre et sans âme",
    "messages qui ne disent pas assez clairement pourquoi vous choisir",
    "parcours pensé pour remplir une page plutôt que pour lever un doute",
    "design difficile à adapter à votre activité, vos contenus et vos vrais clients",
];

const aiUses = [
    "explorer plus vite des angles de contenu",
    "challenger la structure d'une page ou d'un parcours",
    "auditer des points de clarté, d'accessibilité, de performance ou de SEO",
    "accélérer certaines recherches sans déléguer les décisions importantes",
];
---

<Layout
    title="Méthode de création d'un site web - William De Azevedo"
    description="Une méthode de création ou refonte web pour clarifier l'offre, lever les freins, concevoir l'interface, développer, tester et mettre en ligne."
>
    <div class="mx-auto flex w-full max-w-5xl flex-col gap-12 px-4 py-12 md:gap-16 md:py-16">
        <FadeReveal delay={0.1}>
            <section class="mx-auto flex w-full min-w-0 max-w-5xl flex-col items-center gap-6 text-center">
                <h1
                    class="page-heading flex w-full max-w-sm flex-wrap justify-center gap-x-[0.18em] px-2 sm:max-w-4xl md:max-w-5xl"
                    aria-label="Une méthode pour transformer le flou en parcours clair"
                >
                    {
                        heroTitleParts.map((part) => (
                            <span class:list={[part.pill && "title-pill"]}>
                                {part.text}
                            </span>
                        ))
                    }
                </h1>
                <p class="page-subheading max-w-sm sm:max-w-lg">
                    Un bon site ne se résume pas à de beaux écrans. On part des
                    hésitations de vos visiteurs, puis on clarifie ce qui doit être
                    compris, montré et vérifié avant de développer.
                </p>
                <CalButton
                    class="rounded-xl text-base font-normal"
                    label="Planifier un appel de cadrage"
                    location="methode-hero"
                />
                <CapabilitiesStrip
                    capabilities={methodologyCapabilities}
                    class="mt-7 sm:mt-9"
                    compact
                    title="Les points clés de ma méthode"
                />
            </section>
        </FadeReveal>

        <ServiceTimelineScroll
            description="Du premier échange au suivi après livraison, chaque étape garde les décisions reliées au bon objectif."
            id="methode-timeline"
            items={methodTimelineItems}
            layout="center"
            showHeader={false}
            title="Étapes de la méthode"
        />

        <FadeRevealOnScroll>
            <ServiceDiagnosticToggle
                afterItems={aiUses}
                beforeItems={aiPitfalls}
                description="Faire un site uniquement avec une IA donne souvent une interface propre en apparence, mais trop générique : elle assemble des sections sans comprendre votre offre, vos prospects, vos preuves et les objections qui bloquent vraiment le contact."
                title="L'IA aide, mais elle ne remplace pas le regard"
            />
        </FadeRevealOnScroll>

        <FadeRevealOnScroll>
            <section class="rounded-4xl bg-surface-100 p-6 ring-1 ring-gray-200/80 sm:p-8">
                <div class="mx-auto flex max-w-3xl flex-col items-center gap-4 text-center">
                    <h2 class="section-heading">
                        Ce qui rend le projet fluide
                    </h2>
                    <p class="section-subheading">
                        On évite les retours dispersés en séparant clairement ce
                        que vous apportez, ce que je clarifie et ce que vous
                        récupérez à la fin.
                    </p>
                </div>

                <div class="relative mt-8 grid gap-4 lg:grid-cols-3">
                    <span
                        class="pointer-events-none absolute top-16 right-[16%] left-[16%] hidden h-px bg-gray-200 lg:block"
                        aria-hidden="true"
                    >
                        <span class="block h-full w-full bg-gradient-to-r from-blue-500 via-[#8b73e6] to-emerald-500"></span>
                    </span>

                    {
                        collaborationFlow.map((step, index) => (
                            <article class="relative z-10 flex min-h-full flex-col rounded-3xl bg-snow-50 p-5 ring-1 ring-gray-200/80 sm:p-6">
                                <div class="flex items-start justify-between gap-4">
                                    <span
                                        class:list={[
                                            "flex size-12 shrink-0 items-center justify-center rounded-2xl shadow-[0_18px_34px_-24px_rgba(34,42,55,0.65)]",
                                            flowToneClasses[step.tone].icon,
                                        ]}
                                        aria-hidden="true"
                                    >
                                        {step.icon === "input" && (
                                            <WindowLayoutIcon class="size-5" />
                                        )}
                                        {step.icon === "clarify" && (
                                            <SearchContentIcon class="size-5" />
                                        )}
                                        {step.icon === "delivery" && (
                                            <GlobeIcon class="size-5" />
                                        )}
                                    </span>
                                    <span class="rounded-full bg-gray-100 px-3 py-1 text-sm font-normal leading-none text-gray-600">
                                        {index + 1}
                                    </span>
                                </div>

                                <h3 class="mt-5 text-2xl font-normal leading-tight text-gray-900">
                                    {step.title}
                                </h3>
                                <p class="mt-3 text-base font-normal leading-relaxed text-gray-600">
                                    {step.description}
                                </p>

                                <div class="mt-6 rounded-2xl bg-surface-100 p-3 ring-1 ring-gray-200/70">
                                    <ul class="grid gap-2">
                                        {step.items.map((item) => (
                                            <li class="flex items-center gap-2.5 text-sm font-normal leading-tight text-gray-700">
                                                <span
                                                    class:list={[
                                                        "size-2 rounded-full",
                                                        flowToneClasses[step.tone].marker,
                                                    ]}
                                                    aria-hidden="true"
                                                />
                                                <span>{item}</span>
                                            </li>
                                        ))}
                                    </ul>
                                </div>
                            </article>
                        ))
                    }
                </div>

                <div class="mt-5 flex flex-col gap-4 rounded-3xl bg-snow-50 p-5 ring-1 ring-gray-200/80 sm:flex-row sm:items-start sm:p-6">
                    <span
                        class="flex size-11 shrink-0 items-center justify-center rounded-2xl bg-blue-50 text-blue-500 ring-1 ring-blue-100"
                        aria-hidden="true"
                    >
                        <MsgsIcon class="size-5" />
                    </span>
                    <div class="min-w-0">
                        <h3 class="text-xl font-normal leading-tight text-gray-900">
                            Une règle simple pour les retours
                        </h3>
                        <p class="mt-2 text-base font-normal leading-relaxed text-gray-600">
                            Les retours sont regroupés par étape et rattachés à un
                            objectif : clarté, confiance, performance ou conversion.
                            Une correction reste liée au périmètre validé ; une
                            nouvelle demande peut devenir une évolution séparée.
                        </p>
                    </div>
                </div>
            </section>
        </FadeRevealOnScroll>
    </div>

    <div class="mx-auto w-full max-w-5xl px-4 pb-12 md:pb-16">
        <FadeRevealOnScroll>
            <section class="relative left-1/2 isolate w-[calc(100dvw-1rem)] -translate-x-1/2 overflow-hidden rounded-4xl bg-coffee-300 py-12 text-snow-50 sm:w-[calc(100dvw-2rem)] md:py-16">
                <div class="relative z-10 mx-auto flex max-w-4xl flex-col items-center gap-4 px-4 text-center sm:px-8 md:gap-6">
                    <h2 class="section-heading section-heading--inverse max-w-4xl">
                        Vous voulez savoir si ce cadre convient à votre projet ?
                    </h2>
                    <p class="section-subheading section-subheading--inverse max-w-3xl">
                        On commence par un appel court, sans engagement, pour
                        comprendre ce qui bloque aujourd'hui et éviter de partir
                        dans la mauvaise direction.
                    </p>
                    <CalButton
                        class="mt-2 rounded-xl text-base font-normal"
                        label="Vérifier le bon cadre"
                        location="methode-final"
                        variant="light"
                    />
                </div>
            </section>
        </FadeRevealOnScroll>
    </div>
</Layout>
