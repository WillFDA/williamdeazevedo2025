---
import CalButton from "@/components/CalButton.astro";
import OfferComparisonTable from "@/components/OfferComparisonTable.astro";
import FadeReveal from "@/components/animations/FadeReveal.astro";
import ArrowRight from "@/components/icons/nucleo/arrow-right-fill.svg";
import CheckIcon from "@/components/icons/nucleo/check-2-outline.svg";
import WaveIcon from "@/components/ui/WaveIcon.astro";
import WaveText from "@/components/ui/WaveText.astro";
import Layout from "@/layout/Layout.astro";

export const prerender = true;

const titleParts = [
    { text: "Choisir" },
    { text: "la" },
    { pill: true, text: "bonne offre" },
    { text: "avant" },
    { text: "de" },
    { text: "parler" },
    { text: "budget." },
];

const scopePoints = [
    "site vitrine ou landing page",
    "refonte d'un site existant",
    "renfort front-end ciblé",
    "SEO technique et mise en ligne",
];
---

<Layout
    title="Offres site internet freelance - William De Azevedo"
    description="Comparer les offres possibles pour créer, refondre ou améliorer un site internet : site seul, intervention ciblée ou accompagnement complet."
    canonicalPath="/offres"
>
    <div class="mx-auto flex w-full max-w-7xl flex-col gap-14 px-4 py-12 sm:px-8 md:gap-20 md:py-16">
        <FadeReveal delay={0.08}>
            <section class="mx-auto flex max-w-5xl flex-col items-center gap-6 text-center">
                <h1 class="page-heading offer-heading flex w-full flex-wrap justify-center gap-x-[0.18em] px-2">
                    {
                        titleParts.map((part, index) => (
                            <span
                                class:list={[part.pill && "title-pill"]}
                                style={`--offer-word-index: ${index}`}
                            >
                                {part.text}
                            </span>
                        ))
                    }
                </h1>
                <p class="page-subheading max-w-2xl">
                    Je ne vends pas un catalogue figé. On choisit le bon niveau
                    d'accompagnement selon votre situation : lancer une présence,
                    clarifier un site existant, renforcer une interface ou poser
                    une base technique plus fiable.
                </p>
                <div class="mt-3 flex w-full max-w-sm flex-col items-center justify-center gap-3 sm:max-w-none sm:flex-row sm:gap-8">
                    <CalButton
                        class="rounded-xl text-base font-normal"
                        label="Parler de mon projet"
                        location="offres-hero"
                    />
                    <a
                        class="offer-hero-button offer-hero-button--secondary flex min-h-14 w-full max-w-full items-center justify-center gap-4 rounded-xl px-8 py-3 text-base font-normal sm:w-auto sm:px-10"
                        href="/realisations"
                    >
                        <WaveText text="Voir les réalisations" trigger="parent" />
                        <WaveIcon
                            style="--wui-wave-icon-size: 1rem;"
                            direction="right"
                            trigger="parent"
                        >
                            <ArrowRight class="size-full" aria-hidden="true" />
                        </WaveIcon>
                    </a>
                </div>
                <ul class="mt-6 grid w-full max-w-4xl gap-3 sm:grid-cols-2 lg:grid-cols-4">
                    {
                        scopePoints.map((point, index) => (
                            <li
                                class="offer-scope-pill flex items-center gap-3 rounded-xl bg-snow-50 px-4 py-3 text-left text-sm font-normal text-gray-900 ring-1 ring-gray-200"
                                style={`--offer-pill-index: ${index}`}
                            >
                                <span
                                    class="inline-flex size-7 flex-none items-center justify-center rounded-lg bg-blue-50 text-blue-500"
                                    aria-hidden="true"
                                >
                                    <CheckIcon class="size-4" />
                                </span>
                                <span>{point}</span>
                            </li>
                        ))
                    }
                </ul>
            </section>
        </FadeReveal>

        <OfferComparisonTable />
    </div>
</Layout>

<style>
    .offer-heading > span {
        animation: offer-title-word 1100ms cubic-bezier(0.16, 1, 0.3, 1)
            backwards;
        animation-delay: calc(var(--offer-word-index, 0) * 65ms);
        display: inline-block;
    }

    .offer-scope-pill {
        animation: offer-pill 740ms cubic-bezier(0.2, 0, 0, 1) backwards;
        animation-delay: calc(520ms + var(--offer-pill-index, 0) * 70ms);
    }

    .offer-hero-button {
        color: var(--offer-button-color);
        isolation: isolate;
        overflow: hidden;
        position: relative;
        text-decoration: none;
    }

    .offer-hero-button::before {
        background: var(--offer-button-bg);
        border: 1px solid var(--offer-button-border);
        border-radius: inherit;
        content: "";
        inset: 0;
        position: absolute;
        transform: scale(1);
        transition: transform 520ms
            var(--wui-ease-standard, cubic-bezier(0.2, 0, 0, 1));
        z-index: -1;
    }

    .offer-hero-button:focus-visible::before {
        transform: scale(0.95);
    }

    @media (hover: hover) {
        .offer-hero-button:hover::before {
            transform: scale(0.95);
        }
    }

    .offer-hero-button:focus-visible {
        outline: 2px solid var(--color-blue-500);
        outline-offset: 3px;
    }

    .offer-hero-button--secondary {
        --offer-button-bg: var(--color-gray-100);
        --offer-button-border: var(--color-gray-200);
        --offer-button-color: var(--color-gray-900);
    }

    @keyframes offer-title-word {
        from {
            filter: blur(10px);
            opacity: 0;
            transform: translateY(-0.65em);
        }

        to {
            filter: none;
            opacity: 1;
            transform: none;
        }
    }

    @keyframes offer-pill {
        from {
            filter: blur(8px);
            opacity: 0;
            transform: translateY(0.75rem);
        }

        to {
            filter: none;
            opacity: 1;
            transform: none;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .offer-heading > span,
        .offer-scope-pill {
            animation: none;
        }

        .offer-hero-button::before {
            transition: none;
        }
    }
</style>
