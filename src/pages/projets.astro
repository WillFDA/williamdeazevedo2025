---
import Layout from "../layout/Layout.astro";
import Carousel from "../components/Carousel.astro";
import Link from "../components/icons/Link.tsx";
---

<Layout title="Projets">
    <section class="mx-auto flex w-full max-w-5xl flex-col gap-10 px-4 pb-20">
        <div class="flex flex-col gap-3">
            <p class="text-sm font-light text-zinc-500">Réalisations</p>
            <h1 class="max-w-[872px] text-4xl font-medium leading-[0.96] text-gray-900 md:text-[56px]">
                Projets web, interfaces et produits lancés
            </h1>
        </div>
    </section>

    <section id="motivai" class="mb-20">
        <div class="flex flex-col gap-4 max-w-5xl mx-auto px-4 pb-10">
            <a
                target="_blank"
                href="https://www.motivai.fr/"
                class="flex items-center gap-4 w-fit"
            >
                <h2 class="text-3xl text-zinc-700 font-medium">Motivai</h2>
                <Link className="size-5 text-zinc-500" />
            </a>
            <p
                class="text-zinc-500 font-light text-base [&_span]:text-zinc-700 [&_span]:font-normal"
            >
                SaaS de génération de lettres de motivation par IA, développé en
                solo depuis 2024. J'ai conçu l'architecture complète avec
                <span>Next.js</span>, <span>Drizzle ORM</span> et <span
                    >Better Auth</span
                >. L'intégration du <span>Vercel AI SDK</span> permet aux utilisateurs
                de choisir leur modèle d'IA. Un projet formateur sur les défis d'un
                produit complet : CI/CD, environnements multiples et déploiements
                versionnés.
            </p>
        </div>

        <Carousel>
            <div class="embla__slide">
                <video
                    muted
                    playsinline
                    loop
                    preload="metadata"
                    tabindex="-1"
                    poster="/motivai/motivai-landing.webp"
                    aria-hidden="true"
                    class="h-full w-full object-cover rounded-md"
                >
                    <source
                        src="/motivai/motivai-landing.mp4"
                        type="video/mp4"
                    />
                </video>
            </div>
            <div class="embla__slide">
                <video
                    muted
                    playsinline
                    loop
                    preload="none"
                    tabindex="-1"
                    poster="/motivai/motivai-onboarding.webp"
                    aria-hidden="true"
                    class="h-full w-full object-cover rounded-md"
                >
                    <source
                        src="/motivai/motivai-onboarding.mp4"
                        type="video/mp4"
                    />
                </video>
            </div>
            <div class="embla__slide">
                <video
                    muted
                    playsinline
                    loop
                    preload="none"
                    tabindex="-1"
                    poster="/motivai/motivai-aichoose.webp"
                    aria-hidden="true"
                    class="h-full w-full object-cover rounded-md"
                >
                    <source
                        src="/motivai/motivai-aichoose.mp4"
                        type="video/mp4"
                    />
                </video>
            </div>
        </Carousel>
    </section>
</Layout>
