---
import type { CollectionEntry } from "astro:content";
import { getCollection, render } from "astro:content";
import FadeReveal from "@/components/animations/FadeReveal.astro";
import FadeRevealOnScroll from "@/components/animations/FadeRevealOnScroll.astro";
import ArrowRight from "@/components/icons/nucleo/arrow-right-fill.svg";
import ChevronLeft from "@/components/icons/nucleo/chevron-left-fill.svg";
import GlobeIcon from "@/components/icons/nucleo/globe-outline.svg";
import WaveIcon from "@/components/ui/WaveIcon.astro";
import WaveText from "@/components/ui/WaveText.astro";
import { getProjectById } from "@/data/projects";
import Layout from "@/layout/Layout.astro";

export const prerender = true;

export async function getStaticPaths() {
    const realisations = await getCollection("realisations");

    return realisations.map((entry) => ({
        params: { slug: entry.id },
        props: { entry },
    }));
}

interface Props {
    entry: CollectionEntry<"realisations">;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { gallery, partners, projectId, siteLabel } = entry.data;

const project = getProjectById(projectId);

if (!project) {
    throw new Error(`Projet introuvable pour ${entry.id}`);
}

const title = project.title;
const description = project.summary;
const siteUrl = project.href;
const resolvedPartners = partners.map((partner) => {
    const linkedProject = partner.projectId
        ? getProjectById(partner.projectId)
        : undefined;
    const href = partner.href ?? linkedProject?.href;
    const label = partner.label ?? linkedProject?.title;

    if (!href || !label) {
        throw new Error(`Partenaire invalide pour ${entry.id}`);
    }

    return {
        description: partner.description,
        href,
        label,
    };
});

const galleryItems = [
    ...(project.media.type === "video"
        ? [
                {
                    src: project.media.poster,
                    alt: `Capture du projet ${project.title}`,
                },
            ]
        : []),
    ...(project.gallery ?? []),
    ...gallery,
];

const site = Astro.site ?? new URL(Astro.url.origin);
const canonicalUrl = new URL(`/realisations/${entry.id}`, site);

const creativeWorkJsonLd = {
    "@context": "https://schema.org",
    "@type": "CreativeWork",
    name: title,
    headline: title,
    description,
    inLanguage: "fr-FR",
    url: canonicalUrl.href,
    mainEntityOfPage: canonicalUrl.href,
    workExample: siteUrl,
    creator: {
        "@type": "Person",
        name: "William De Azevedo",
        url: site.href,
    },
};

const breadcrumbJsonLd = {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
        {
            "@type": "ListItem",
            position: 1,
            name: "Accueil",
            item: site.href,
        },
        {
            "@type": "ListItem",
            position: 2,
            name: "Réalisations",
            item: new URL("/realisations", site).href,
        },
        {
            "@type": "ListItem",
            position: 3,
            name: title,
            item: canonicalUrl.href,
        },
    ],
};
---

<Layout title={`${title} - William De Azevedo`} description={description}>
    <script
        type="application/ld+json"
        is:inline
        set:html={JSON.stringify(creativeWorkJsonLd)}
    />
    <script
        type="application/ld+json"
        is:inline
        set:html={JSON.stringify(breadcrumbJsonLd)}
    />

    <main class="mx-auto w-full max-w-7xl px-4 py-12 md:px-6 md:py-16">
        <FadeReveal delay={0.1}>
            <a
                class="group inline-flex size-12 items-center justify-center rounded-full bg-snow-50 text-gray-700 shadow-[0_12px_30px_-24px_rgba(34,42,55,0.5)] transition-transform hover:scale-[0.96] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-blue-500"
                href="/realisations"
                aria-label="Retour aux réalisations"
            >
                <ChevronLeft class="size-5" aria-hidden="true" />
            </a>
        </FadeReveal>

        <section class="mt-10 grid gap-10 lg:grid-cols-[minmax(0,0.82fr)_minmax(0,1.18fr)] lg:items-start lg:gap-16">
            <FadeReveal delay={0.16}>
                <aside class="flex flex-col gap-8 lg:sticky lg:top-28">
                    <header class="flex flex-col gap-5">
                        <h1 class="max-w-xl text-5xl font-medium leading-none tracking-normal text-gray-900 md:text-6xl">
                            {title}
                        </h1>
                        <p class="max-w-2xl text-base font-normal leading-7 text-gray-600 md:text-lg md:leading-8">
                            {description}
                        </p>
                    </header>

                    <div class="grid gap-3">
                        {siteUrl && (
                            <a
                                class="group relative isolate inline-flex min-h-14 items-center justify-center gap-4 overflow-hidden rounded-xl bg-snow-50 px-6 py-3 text-base font-normal text-gray-900 no-underline shadow-[0_12px_30px_-24px_rgba(34,42,55,0.5)] transition-transform hover:scale-[0.98] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-blue-500"
                                href={siteUrl}
                                rel="noreferrer"
                                target="_blank"
                            >
                                <WaveText text={siteLabel} trigger="parent" />
                                <WaveIcon
                                    style="--wui-wave-icon-size: 1.1rem;"
                                    direction="up"
                                    trigger="parent"
                                >
                                    <GlobeIcon class="size-full" aria-hidden="true" />
                                </WaveIcon>
                            </a>
                        )}

                        {resolvedPartners.map((partner) => (
                            <a
                                class="group grid gap-1 rounded-xl bg-gray-100 px-5 py-4 text-left no-underline transition-transform hover:scale-[0.99] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-blue-500"
                                href={partner.href}
                                rel="noreferrer"
                                target="_blank"
                            >
                                <span class="inline-flex items-center gap-2 text-sm font-medium text-gray-900">
                                    {partner.label}
                                    <ArrowRight class="size-4 transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5" aria-hidden="true" />
                                </span>
                                {partner.description && (
                                    <span class="text-sm font-normal leading-6 text-gray-600">
                                        {partner.description}
                                    </span>
                                )}
                            </a>
                        ))}
                    </div>

                    <div class="realisation-prose">
                        <Content />
                    </div>
                </aside>
            </FadeReveal>

            <div class="grid gap-6">
                {project.media.type === "video" && (
                    <FadeReveal delay={0.24}>
                        <figure class="rounded-3xl bg-snow-50 p-3 shadow-[0_24px_70px_-50px_rgba(34,42,55,0.55)] ring-1 ring-gray-200">
                            <video
                                muted
                                playsinline
                                controls
                                preload="metadata"
                                poster={project.media.poster}
                                aria-label={`Vidéo du projet ${project.title}`}
                                class="aspect-video w-full rounded-2xl object-cover"
                            >
                                <source src={project.media.src} type="video/mp4" />
                            </video>
                        </figure>
                    </FadeReveal>
                )}

                {galleryItems.length > 0 && (
                    <div class="grid gap-6">
                        {galleryItems.map((item, index) => (
                            <FadeRevealOnScroll>
                                <figure class="rounded-3xl bg-snow-50 p-3 shadow-[0_20px_60px_-50px_rgba(34,42,55,0.5)] ring-1 ring-gray-200">
                                    <img
                                        src={item.src}
                                        alt={item.alt}
                                        class="w-full rounded-2xl object-cover"
                                        loading={index === 0 ? "eager" : "lazy"}
                                        decoding="async"
                                    />
                                </figure>
                            </FadeRevealOnScroll>
                        ))}
                    </div>
                )}
            </div>
        </section>
    </main>
</Layout>

<style is:global>
    .realisation-prose {
        color: var(--color-gray-600);
        font-size: 1rem;
        font-weight: 400;
        line-height: 1.75;
    }

    .realisation-prose > * + * {
        margin-top: 1.1rem;
    }

    .realisation-prose h2 {
        color: var(--color-gray-900);
        font-size: 1.25rem;
        font-weight: 500;
        line-height: 1.35;
        margin-top: 2.5rem;
    }

    .realisation-prose strong {
        color: var(--color-gray-900);
        font-weight: 500;
    }

    .realisation-prose a {
        color: inherit;
        text-decoration: underline;
        text-decoration-color: var(--color-gray-300);
        text-underline-offset: 2px;
        transition: color 200ms ease;
    }

    @media (hover: hover) {
        .realisation-prose a:hover {
            color: var(--color-gray-900);
        }
    }

    .realisation-prose ul,
    .realisation-prose ol {
        padding-left: 1.25rem;
    }

    .realisation-prose ul {
        list-style: disc;
    }

    .realisation-prose ol {
        list-style: decimal;
    }

    .realisation-prose li + li {
        margin-top: 0.35rem;
    }
</style>
