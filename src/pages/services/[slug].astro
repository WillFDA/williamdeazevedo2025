---
import CalButton from "@/components/CalButton.astro";
import FadeReveal from "@/components/animations/FadeReveal.astro";
import { homeProjects } from "@/data/projects";
import {
    type Service,
    getServiceBySlug,
    services,
} from "@/data/services";
import Layout from "@/layout/Layout.astro";

export const prerender = true;

export function getStaticPaths() {
    return services.map((service) => ({
        params: { slug: service.slug },
        props: { service },
    }));
}

interface Props {
    service: Service;
}

const { service } = Astro.props;
const relatedServices = service.relatedServices
    .map((slug) => getServiceBySlug(slug))
    .filter(Boolean);
const project = homeProjects.find((item) => item.id === service.proof.projectId);
const siteUrl = Astro.site ?? new URL(Astro.url.origin);
const canonicalUrl = new URL(`/services/${service.slug}`, siteUrl);

const serviceJsonLd = {
    "@context": "https://schema.org",
    "@type": "Service",
    name: service.title,
    serviceType: service.serviceType,
    description: service.description,
    areaServed: "France",
    url: canonicalUrl.href,
    provider: {
        "@type": "Person",
        name: "William De Azevedo",
        url: siteUrl.href,
    },
};

const breadcrumbJsonLd = {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
        {
            "@type": "ListItem",
            position: 1,
            name: "Accueil",
            item: siteUrl.href,
        },
        {
            "@type": "ListItem",
            position: 2,
            name: "Services",
            item: new URL("/services", siteUrl).href,
        },
        {
            "@type": "ListItem",
            position: 3,
            name: service.title,
            item: canonicalUrl.href,
        },
    ],
};
---

<Layout title={service.seoTitle} description={service.description}>
    <script
        type="application/ld+json"
        is:inline
        set:html={JSON.stringify(serviceJsonLd)}
    />
    <script
        type="application/ld+json"
        is:inline
        set:html={JSON.stringify(breadcrumbJsonLd)}
    />

    <div class="mx-auto flex w-full max-w-5xl flex-col gap-16 px-4 pb-20">
        <FadeReveal delay={0.1}>
            <section class="mx-auto flex max-w-3xl flex-col items-center gap-5 text-center">
                <a
                    class="text-sm font-light text-gray-500 transition-colors hover:text-gray-900 focus-visible:text-gray-900 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-blue-500"
                    href="/services"
                >
                    Tous les services
                </a>
                <h1 class="text-3xl font-medium leading-tight text-gray-900 sm:text-5xl md:text-6xl">
                    {service.h1}
                </h1>
                <p class="max-w-2xl text-base font-light leading-7 text-gray-600">
                    {service.intro}
                </p>
                <div class="flex flex-col items-center gap-3 sm:flex-row">
                    <CalButton
                        class="rounded-xl font-regular text-md"
                        location={`service-${service.slug}-hero`}
                    />
                    {
                        project && (
                            <a
                                class="flex min-h-14 items-center justify-center rounded-xl px-8 py-3 text-sm font-normal text-gray-900 ring-1 ring-gray-200 transition-colors hover:text-blue-500 focus-visible:text-blue-500 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-blue-500"
                                href={`/realisations/${project.id}`}
                            >
                                Voir une réalisation
                            </a>
                        )
                    }
                </div>
            </section>
        </FadeReveal>

        <section class="grid gap-8 md:grid-cols-[0.95fr_1.05fr] md:items-start">
            <div class="flex flex-col gap-3">
                <h2 class="text-2xl font-medium leading-tight text-gray-900">
                    {service.problem.title}
                </h2>
                <p class="text-sm font-light leading-6 text-gray-600">
                    Avant de parler design ou technologie, il faut comprendre ce
                    qui crée du doute et rend la décision plus difficile pour
                    votre visiteur.
                </p>
            </div>
            <ul class="grid gap-3">
                {
                    service.problem.items.map((item) => (
                        <li class="rounded-lg bg-gray-100 px-4 py-3 text-sm font-light leading-6 text-gray-800 ring-1 ring-gray-200">
                            {item}
                        </li>
                    ))
                }
            </ul>
        </section>

        <section class="grid gap-4 md:grid-cols-2">
            <article class="rounded-lg bg-snow-50 p-6 ring-1 ring-snow-600">
                <h2 class="mb-4 text-2xl font-medium leading-tight text-gray-900">
                    Cette prestation est faite pour vous si...
                </h2>
                <ul class="flex flex-col gap-3">
                    {
                        service.fit.map((item) => (
                            <li class="text-sm font-light leading-6 text-gray-600">
                                {item}
                            </li>
                        ))
                    }
                </ul>
            </article>
            <article class="rounded-lg bg-snow-50 p-6 ring-1 ring-snow-600">
                <h2 class="mb-4 text-2xl font-medium leading-tight text-gray-900">
                    Ce que je prends en charge
                </h2>
                <ul class="flex flex-col gap-3">
                    {
                        service.included.map((item) => (
                            <li class="text-sm font-light leading-6 text-gray-600">
                                {item}
                            </li>
                        ))
                    }
                </ul>
            </article>
        </section>

        {
            project && (
                <section class="rounded-lg bg-coffee-300 p-6 text-snow-50 sm:p-8">
                    <div class="grid gap-6 md:grid-cols-[1fr_1.2fr] md:items-center">
                        <div class="flex flex-col gap-3">
                            <p class="text-xs font-light uppercase tracking-[0.12em] text-blue-300">
                                Réalisation liée
                            </p>
                            <h2 class="text-2xl font-medium leading-tight">
                                {project.title}
                            </h2>
                            <p class="text-sm font-light leading-6 text-snow-100">
                                {service.proof.text}
                            </p>
                        </div>
                        <div class="flex flex-col gap-3 sm:flex-row md:justify-end">
                            <a
                                class="flex min-h-14 items-center justify-center rounded-xl bg-snow-50 px-8 py-3 text-sm font-normal text-coffee-300 transition-transform hover:scale-[0.98] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-blue-500"
                                href={`/realisations/${project.id}`}
                            >
                                Lire l'étude de cas
                            </a>
                            <CalButton
                                class="rounded-xl font-regular text-md"
                                location={`service-${service.slug}-proof`}
                                variant="light"
                            />
                        </div>
                    </div>
                </section>
            )
        }

        <section class="grid gap-4 rounded-lg bg-gray-100 p-6 ring-1 ring-gray-200 md:grid-cols-[1fr_auto] md:items-center">
            <div class="flex flex-col gap-2">
                <h2 class="text-2xl font-medium leading-tight text-gray-900">
                    Budget et périmètre
                </h2>
                <p class="text-sm font-light leading-6 text-gray-600">
                    Le prix dépend surtout du nombre de freins à lever : contenu,
                    design, performance, accessibilité, fonctionnalités et
                    autonomie attendue après la mise en ligne.
                </p>
            </div>
            <a
                class="flex min-h-14 items-center justify-center rounded-xl bg-snow-50 px-8 py-3 text-sm font-normal text-gray-900 ring-1 ring-snow-600 transition-colors hover:text-blue-500 focus-visible:text-blue-500 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-blue-500"
                href="/tarifs"
            >
                Comprendre les tarifs
            </a>
        </section>

        {
            service.formats && (
                <section class="flex flex-col gap-6">
                    <div class="flex flex-col gap-3 md:max-w-2xl">
                        <h2 class="text-2xl font-medium leading-tight text-gray-900">
                            Un format adapté au besoin réel
                        </h2>
                        <p class="text-sm font-light leading-6 text-gray-600">
                            Le bon périmètre dépend de votre offre, de vos contenus et
                            du niveau d'autonomie attendu après la mise en ligne.
                        </p>
                    </div>
                    <div class="grid gap-4 md:grid-cols-2">
                        {service.formats.map((format) => (
                            <article class="rounded-lg bg-gray-100 p-5 ring-1 ring-gray-200">
                                <h3 class="mb-2 text-lg font-medium leading-tight text-gray-900">
                                    {format.title}
                                </h3>
                                <p class="text-sm font-light leading-6 text-gray-600">
                                    {format.description}
                                </p>
                            </article>
                        ))}
                    </div>
                </section>
            )
        }

        <section class="grid gap-8 md:grid-cols-[0.8fr_1.2fr] md:items-start">
            <div class="flex flex-col gap-3">
                <h2 class="text-2xl font-medium leading-tight text-gray-900">
                    Une méthode pour éviter le flou
                </h2>
                <p class="text-sm font-light leading-6 text-gray-600">
                    Un cadre clair évite les allers-retours dispersés et garde les
                    décisions reliées à un objectif : mieux faire comprendre,
                    rassurer et déclencher la bonne action.
                </p>
                <a
                    class="w-fit text-sm font-normal text-gray-900 underline decoration-gray-300 underline-offset-4 transition-colors hover:text-blue-500 focus-visible:text-blue-500 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-blue-500"
                    href="/methode"
                >
                    Comprendre ma méthode
                </a>
            </div>
            <ol class="grid gap-3">
                {
                    service.steps.map((step, index) => (
                        <li class="grid grid-cols-[2rem_1fr] gap-3 rounded-lg bg-snow-50 p-4 text-sm font-light leading-6 text-gray-600 ring-1 ring-snow-600">
                            <span class="flex size-8 items-center justify-center rounded-lg bg-blue-500 text-xs font-normal text-snow-50">
                                {index + 1}
                            </span>
                            <span>{step}</span>
                        </li>
                    ))
                }
            </ol>
        </section>

        <section class="grid gap-8 md:grid-cols-[0.85fr_1.15fr]">
            <div class="flex flex-col gap-3">
                <h2 class="text-2xl font-medium leading-tight text-gray-900">
                    Questions fréquentes
                </h2>
                <p class="text-sm font-light leading-6 text-gray-600">
                    Les détails dépendent toujours du projet, mais ces réponses
                    donnent un premier cadre avant l'appel découverte.
                </p>
            </div>
            <div class="flex flex-col gap-3">
                {
                    service.faq.map((item) => (
                        <details class="rounded-lg bg-snow-50 p-4 ring-1 ring-snow-600">
                            <summary class="cursor-pointer rounded-md text-sm font-medium text-gray-900 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-blue-500">
                                {item.question}
                            </summary>
                            <p class="mt-3 text-sm font-light leading-6 text-gray-600">
                                {item.answer}
                            </p>
                        </details>
                    ))
                }
            </div>
        </section>

        <section class="grid gap-4 md:grid-cols-2">
            {
                relatedServices.map((relatedService) => (
                    <a
                        class="group rounded-lg bg-gray-100 p-5 ring-1 ring-gray-200 transition-colors hover:bg-snow-50 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-blue-500"
                        href={`/services/${relatedService.slug}`}
                    >
                        <p class="mb-2 text-xs font-light uppercase tracking-[0.12em] text-gray-500">
                            Service lié
                        </p>
                        <h2 class="text-lg font-medium leading-tight text-gray-900 transition-colors group-hover:text-blue-500">
                            {relatedService.title}
                        </h2>
                        <p class="mt-2 text-sm font-light leading-6 text-gray-600">
                            {relatedService.description}
                        </p>
                    </a>
                ))
            }
        </section>

        <section class="rounded-lg bg-snow-50 p-6 text-center ring-1 ring-snow-600 sm:p-8">
            <div class="mx-auto flex max-w-2xl flex-col items-center gap-4">
                <h2 class="text-2xl font-medium leading-tight text-gray-900">
                    Vous voulez vérifier si ce service répond au vrai problème ?
                </h2>
                <p class="text-sm font-light leading-6 text-gray-600">
                    On regarde votre situation, ce qui bloque aujourd'hui et la
                    prochaine étape réaliste avant de parler solution.
                </p>
                <CalButton
                    class="rounded-xl font-regular text-md"
                    location={`service-${service.slug}-final`}
                />
            </div>
        </section>
    </div>
</Layout>
