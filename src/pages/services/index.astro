---
import CalButton from "@/components/CalButton.astro";
import DiagnosticCta from "@/components/DiagnosticCta.astro";
import ProblemComparison from "@/components/ProblemComparison.astro";
import ServicesBentoGrid from "@/components/ServicesBentoGrid.astro";
import FadeReveal from "@/components/animations/FadeReveal.astro";
import FadeRevealOnScroll from "@/components/animations/FadeRevealOnScroll.astro";
import CheckIcon from "@/components/icons/nucleo/check-2-outline.svg";
import ProjectShowcase from "@/components/ProjectShowcase.astro";
import WaveText from "@/components/ui/WaveText.astro";
import Layout from "@/layout/Layout.astro";

export const prerender = true;

const servicesHeroTitleParts = [
    { text: "Votre" },
    { pill: true, text: "site existe." },
    { text: "Est-ce" },
    { text: "qu'il" },
    { text: "inspire" },
    { pill: true, text: "confiance" },
    { text: "assez" },
    { text: "vite ?" },
];

const commonBaseItems = [
    "Cadrage des objectifs",
    "Structure des pages",
    "Design responsive",
    "Développement front-end",
    "Accessibilité et performance",
    "SEO technique initial",
    "Mise en ligne",
    "Suivi des conversions",
] as const;

const servicesComparisonMessyItems = [
    {
        className: "messy-card--performance",
        icon: "content",
        label: "Offre floue",
        note: "On ne sait pas quoi choisir",
        tone: "red",
    },
    {
        className: "messy-card--accessibility",
        icon: "accessibility",
        label: "Parcours fragile",
        note: "Trop d'étapes, CTA discret",
        tone: "orange",
    },
    {
        className: "messy-card--text",
        icon: "ai",
        label: "Design daté",
        note: "Ça rassure moins vite",
        tone: "red",
    },
    {
        className: "messy-card--ai",
        icon: "performance",
        label: "Technique dispersée",
        note: "Mobile, SEO, vitesse oubliés",
        tone: "red",
    },
] as const;

const servicesComparisonClearItems = [
    "Priorité définie",
    "Service adapté",
    "Parcours clarifié",
    "Interface crédible",
    "Technique propre",
    "Mise en ligne suivie",
] as const;

const servicesComparisonWorkingPoints = [
    {
        icon: "target",
        text: "On identifie le frein principal : message, parcours, design, technique, SEO ou mise en ligne.",
    },
    {
        icon: "sparkle",
        text: "Je choisis le format utile : création complète, refonte ciblée, renfort front-end ou socle SEO.",
    },
    {
        icon: "gauge",
        text: "Le résultat doit aider à comprendre, décider et vous contacter, avec une base rapide et crédible.",
    },
] as const;

const servicesDiagnosticTitleParts = [
    { text: "Vous" },
    { text: "ne" },
    { text: "savez" },
    { text: "pas" },
    { text: "encore" },
    { text: "quel" },
    { media: true, text: "frein" },
    { text: "traiter" },
    { text: "en" },
    { pill: true, text: "premier ?" },
] as const;
---

<Layout
    title="Services web - création, refonte et SEO - William De Azevedo"
    description="Création de site vitrine, refonte et développement front-end pour corriger les sites flous, lents ou datés et construire des interfaces claires, rapides et crédibles."
>
    <div class="mx-auto flex w-full max-w-5xl flex-col gap-12 px-4 pt-12 pb-4 md:gap-16 md:pt-16 md:pb-6">
        <section class="mx-auto flex max-w-5xl flex-col items-center gap-6 text-center">
            <h1
                class="page-heading flex w-full max-w-sm flex-wrap justify-center gap-x-[0.18em] px-2 sm:max-w-4xl md:max-w-5xl"
                data-services-animated-title
            >
                {
                    servicesHeroTitleParts.map((part, index) => (
                        <span
                            class:list={[part.pill && "title-pill"]}
                            style={`--animated-word-index: ${index}`}
                            data-services-animated-title-word
                        >
                            {part.text}
                        </span>
                    ))
                }
            </h1>
            <FadeReveal delay={0.32}>
                <p class="page-subheading">
                    J'aide les indépendants, petites structures et équipes produit
                    à corriger ce qui fait hésiter : offre floue, design daté,
                    lenteur, mobile inconfortable ou parcours de contact fragile.
                </p>
            </FadeReveal>
            <FadeReveal delay={0.44}>
                <div class="flex flex-col items-center justify-center gap-3 sm:flex-row">
                    <CalButton
                        class="rounded-xl text-base font-normal"
                        label="Réserver un appel gratuit"
                        location="services-hero"
                    />
                    <a
                        class="services-hero-button services-hero-button--secondary flex min-h-14 w-full max-w-full items-center justify-center rounded-xl px-8 py-3 text-base font-normal sm:w-auto sm:px-10"
                        href="/tarifs"
                    >
                        <WaveText text="Voir les tarifs" trigger="parent" />
                    </a>
                </div>
            </FadeReveal>
        </section>
    </div>

    <ServicesBentoGrid />

    <ProblemComparison
        headingLines={[
            "Tout peut sembler prioritaire.",
            "Le bon service commence par le bon diagnostic.",
        ]}
        description="Création, refonte, front-end ou SEO : je commence par identifier ce qui bloque vraiment votre site pour intervenir au bon endroit, sans empiler des prestations."
        leftLabel="Sans priorité"
        rightLabel="Service cadré"
        messyItems={servicesComparisonMessyItems}
        clearItems={servicesComparisonClearItems}
        contentTitle="Ce n'est pas une simple liste de prestations."
        contentText="Chaque service répond à une situation précise : lancer une présence claire, remettre un site à niveau, renforcer une interface ou poser une base technique plus saine."
        workingPoints={servicesComparisonWorkingPoints}
    />

    <div class="mx-auto flex w-full max-w-5xl flex-col gap-12 px-4 py-12 md:gap-16 md:py-16">
        <section class="flex flex-col items-center text-center">
            <FadeRevealOnScroll>
                <div class="mx-auto flex max-w-4xl flex-col items-center gap-4">
                    <h2 class="section-heading">
                        Le socle commun : enlever les freins visibles
                    </h2>
                    <p class="section-subheading">
                        Le format change selon votre situation, mais le socle reste
                        le même : clarifier le message, structurer le parcours,
                        soigner l'interface, puis vérifier vitesse, accessibilité
                        et contact.
                    </p>
                </div>
            </FadeRevealOnScroll>
            <ul class="mx-auto mt-12 grid w-full max-w-sm gap-4 sm:max-w-2xl sm:grid-cols-2 md:gap-6 lg:max-w-5xl lg:grid-cols-4">
                {
                    commonBaseItems.map((item, index) => (
                        <li class="flex">
                            <FadeRevealOnScroll
                                class="flex"
                                delay={0.05 + (index % 4) * 0.05}
                            >
                                <span class="flex items-center gap-3 text-left">
                                    <span class="flex size-10 shrink-0 items-center justify-center rounded-xl bg-snow-50 text-emerald-500 shadow-[0_14px_32px_-24px_rgba(34,42,55,0.55)] ring-1 ring-gray-200/70">
                                        <CheckIcon
                                            aria-hidden="true"
                                            class="size-4"
                                        />
                                    </span>
                                    <span class="text-base font-normal leading-snug text-gray-900">
                                        {item}
                                    </span>
                                </span>
                            </FadeRevealOnScroll>
                        </li>
                    ))
                }
            </ul>
        </section>

    </div>

    <DiagnosticCta
        class="relative left-1/2 w-[calc(100dvw-1rem)] -translate-x-1/2 py-16 sm:w-[calc(100dvw-2rem)] md:py-24"
        titleParts={servicesDiagnosticTitleParts}
        copy="Un échange de 15 minutes suffit souvent à distinguer une création, une refonte ou une simple amélioration ciblée."
        buttonLabel="Faire le point en 15 min"
        location="services-final"
    />

    <ProjectShowcase id="services-projects" class="mt-12 md:mt-16" />
</Layout>

<script>
    const revealServicesTitle = (title: HTMLElement) => {
        if (title.dataset.animatedTitleReady === "true") return;
        title.dataset.animatedTitleReady = "true";
    };

    const initServicesTitle = () => {
        const title = document.querySelector<HTMLElement>(
            "[data-services-animated-title]",
        );

        if (!title || title.dataset.animatedTitleReady) return;

        if (
            window.matchMedia("(prefers-reduced-motion: reduce)").matches ||
            !("IntersectionObserver" in window)
        ) {
            revealServicesTitle(title);
            return;
        }

        const observer = new IntersectionObserver(
            ([entry]) => {
                if (!entry?.isIntersecting) return;
                revealServicesTitle(title);
                observer.disconnect();
            },
            { rootMargin: "0px 0px -10% 0px", threshold: 0.2 },
        );

        observer.observe(title);
    };

    initServicesTitle();

    document.addEventListener("astro:page-load", initServicesTitle);
</script>

<style>
    .services-hero-button {
        --services-hero-button-bg: var(--color-snow-600);
        --services-hero-button-border: transparent;
        --services-hero-button-color: var(--color-coffee-300);

        color: var(--services-hero-button-color);
        isolation: isolate;
        position: relative;
        text-decoration: none;
    }

    .services-hero-button::before {
        background: var(--services-hero-button-bg);
        border: 1px solid var(--services-hero-button-border);
        border-radius: inherit;
        content: "";
        inset: 0;
        position: absolute;
        transform: scale(1);
        transition: transform 520ms
            var(--wui-ease-standard, cubic-bezier(0.2, 0, 0, 1));
        z-index: -1;
    }

    .services-hero-button:focus-visible::before {
        transform: scale(0.95);
    }

    @media (hover: hover) {
        .services-hero-button:hover::before {
            transform: scale(0.95);
        }
    }

    .services-hero-button:focus-visible {
        outline: 2px solid var(--color-blue-500);
        outline-offset: 3px;
    }

    .services-hero-button--secondary {
        --services-hero-button-bg: var(--color-gray-100);
    }

    [data-services-animated-title-word] {
        display: inline-block;
    }

    [data-services-animated-title]:not([data-animated-title-ready="true"])
        [data-services-animated-title-word] {
        filter: blur(10px);
        opacity: 0;
        transform: translateY(-0.65em);
    }

    [data-services-animated-title][data-animated-title-ready="true"]
        [data-services-animated-title-word] {
        animation: services-title-word 1100ms cubic-bezier(0.16, 1, 0.3, 1)
            backwards;
        animation-delay: calc(var(--animated-word-index, 0) * 65ms);
    }

    @keyframes services-title-word {
        from {
            filter: blur(10px);
            opacity: 0;
            transform: translateY(-0.65em);
        }

        to {
            filter: none;
            opacity: 1;
            transform: none;
        }
    }

    @media (scripting: none), (prefers-reduced-motion: reduce) {
        .services-hero-button::before {
            transition: none;
        }

        [data-services-animated-title] [data-services-animated-title-word] {
            animation: none;
            filter: none;
            opacity: 1;
            transform: none;
        }

    }
</style>
