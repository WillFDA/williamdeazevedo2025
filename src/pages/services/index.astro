---
import CalButton from "@/components/CalButton.astro";
import ProblemComparison from "@/components/ProblemComparison.astro";
import ServicesBentoGrid from "@/components/ServicesBentoGrid.astro";
import FadeReveal from "@/components/animations/FadeReveal.astro";
import FadeRevealOnScroll from "@/components/animations/FadeRevealOnScroll.astro";
import CheckIcon from "@/components/icons/nucleo/check-2-outline.svg";
import Msgs from "@/components/icons/nucleo/msgs-fill.svg";
import TargetIcon from "@/components/icons/nucleo/target-fill.svg";
import ViewAllIcon from "@/components/icons/nucleo/view-all-fill.svg";
import WindowLayoutIcon from "@/components/icons/nucleo/window-layout-fill.svg";
import ProjectShowcase from "@/components/ProjectShowcase.astro";
import Layout from "@/layout/Layout.astro";

export const prerender = true;

const servicesHeroTitleParts = [
    { text: "Votre" },
    { pill: true, text: "site existe." },
    { text: "Est-ce" },
    { text: "qu'il" },
    { text: "inspire" },
    { pill: true, text: "confiance" },
    { text: "assez" },
    { text: "vite ?" },
];

const commonBaseItems = [
    "Cadrage des objectifs",
    "Structure des pages",
    "Design responsive",
    "Développement front-end",
    "Accessibilité et performance",
    "SEO technique initial",
    "Mise en ligne",
    "Suivi des conversions",
] as const;

const servicesComparisonMessyItems = [
    {
        className: "messy-card--performance",
        icon: "content",
        label: "Offre floue",
        note: "On ne sait pas quoi choisir",
        tone: "red",
    },
    {
        className: "messy-card--accessibility",
        icon: "accessibility",
        label: "Parcours fragile",
        note: "Trop d'étapes, CTA discret",
        tone: "orange",
    },
    {
        className: "messy-card--text",
        icon: "ai",
        label: "Design daté",
        note: "Ça rassure moins vite",
        tone: "red",
    },
    {
        className: "messy-card--ai",
        icon: "performance",
        label: "Technique dispersée",
        note: "Mobile, SEO, vitesse oubliés",
        tone: "red",
    },
] as const;

const servicesComparisonClearItems = [
    "Priorité définie",
    "Service adapté",
    "Parcours clarifié",
    "Interface crédible",
    "Technique propre",
    "Mise en ligne suivie",
] as const;

const servicesComparisonWorkingPoints = [
    {
        icon: "target",
        text: "On identifie le frein principal : message, parcours, design, technique, SEO ou mise en ligne.",
    },
    {
        icon: "sparkle",
        text: "Je choisis le format utile : création complète, refonte ciblée, renfort front-end ou socle SEO.",
    },
    {
        icon: "gauge",
        text: "Le résultat doit aider à comprendre, décider et vous contacter, avec une base rapide et crédible.",
    },
] as const;

const servicesDiagnosticTitleParts = [
    { text: "Vous" },
    { text: "ne" },
    { text: "savez" },
    { text: "pas" },
    { text: "encore" },
    { text: "quel" },
    { media: true, text: "frein" },
    { text: "traiter" },
    { text: "en" },
    { pill: true, text: "premier ?" },
] as const;
---

<Layout
    title="Services web - création, refonte et SEO - William De Azevedo"
    description="Création de site vitrine, refonte et développement front-end pour corriger les sites flous, lents ou datés et construire des interfaces claires, rapides et crédibles."
>
    <div class="mx-auto flex w-full max-w-5xl flex-col gap-12 px-4 pt-12 pb-10 md:gap-16 md:pt-16">
        <section class="mx-auto flex max-w-5xl flex-col items-center gap-6 text-center">
            <h1
                class="page-heading flex w-full max-w-sm flex-wrap justify-center gap-x-[0.18em] px-2 sm:max-w-4xl md:max-w-5xl"
                data-services-animated-title
            >
                {
                    servicesHeroTitleParts.map((part, index) => (
                        <span
                            class:list={[part.pill && "title-pill"]}
                            style={`--animated-word-index: ${index}`}
                            data-services-animated-title-word
                        >
                            {part.text}
                        </span>
                    ))
                }
            </h1>
            <FadeReveal delay={0.32}>
                <p class="page-subheading">
                    J'aide les indépendants, petites structures et équipes produit
                    à corriger ce qui fait hésiter : offre floue, design daté,
                    lenteur, mobile inconfortable ou parcours de contact fragile.
                </p>
            </FadeReveal>
            <FadeReveal delay={0.44}>
                <CalButton
                    class="rounded-xl text-base font-normal"
                    label="Réserver un appel gratuit"
                    location="services-hero"
                />
            </FadeReveal>
        </section>
    </div>

    <ServicesBentoGrid />

    <ProblemComparison
        headingLines={[
            "Tout peut sembler prioritaire.",
            "Le bon service commence par le bon diagnostic.",
        ]}
        description="Création, refonte, front-end ou SEO : je commence par identifier ce qui bloque vraiment votre site pour intervenir au bon endroit, sans empiler des prestations."
        leftLabel="Sans priorité"
        rightLabel="Service cadré"
        messyItems={servicesComparisonMessyItems}
        clearItems={servicesComparisonClearItems}
        contentTitle="Ce n'est pas une simple liste de prestations."
        contentText="Chaque service répond à une situation précise : lancer une présence claire, remettre un site à niveau, renforcer une interface ou poser une base technique plus saine."
        workingPoints={servicesComparisonWorkingPoints}
    />

    <div class="mx-auto flex w-full max-w-5xl flex-col gap-12 px-4 py-12 md:gap-16 md:py-16">
        <section class="flex flex-col items-center text-center">
            <FadeRevealOnScroll>
                <div class="mx-auto flex max-w-4xl flex-col items-center gap-4">
                    <h2 class="section-heading">
                        Le socle commun : enlever les freins visibles
                    </h2>
                    <p class="section-subheading">
                        Le format change selon votre situation, mais le socle reste
                        le même : clarifier le message, structurer le parcours,
                        soigner l'interface, puis vérifier vitesse, accessibilité
                        et contact.
                    </p>
                </div>
            </FadeRevealOnScroll>
            <ul class="mx-auto mt-12 grid w-full max-w-sm gap-4 sm:max-w-2xl sm:grid-cols-2 md:gap-6 lg:max-w-5xl lg:grid-cols-4">
                {
                    commonBaseItems.map((item, index) => (
                        <li class="flex">
                            <FadeRevealOnScroll
                                class="flex"
                                delay={0.05 + (index % 4) * 0.05}
                            >
                                <span class="flex items-center gap-3 text-left">
                                    <span class="flex size-10 shrink-0 items-center justify-center rounded-xl bg-snow-50 text-emerald-500 shadow-[0_14px_32px_-24px_rgba(34,42,55,0.55)] ring-1 ring-gray-200/70">
                                        <CheckIcon
                                            aria-hidden="true"
                                            class="size-4"
                                        />
                                    </span>
                                    <span class="text-base font-normal leading-snug text-gray-900">
                                        {item}
                                    </span>
                                </span>
                            </FadeRevealOnScroll>
                        </li>
                    ))
                }
            </ul>
        </section>

    </div>

    <div class="relative left-1/2 w-[calc(100dvw-1rem)] -translate-x-1/2 py-16 sm:w-[calc(100dvw-2rem)] md:py-24">
        <section
            class="services-diagnostic-cta relative isolate overflow-hidden rounded-3xl bg-coffee-300 py-14 text-snow-50 sm:py-24 md:rounded-4xl md:py-28"
            data-reveal-on-scroll=""
            data-services-diagnostic-cta
        >
            <div class="relative z-10 mx-auto flex max-w-5xl flex-col gap-8 px-4 sm:gap-10 sm:px-8 md:gap-12">
                <div class="mx-auto flex max-w-4xl flex-col items-center gap-6 text-center md:gap-7">
                    <h2
                        class="services-diagnostic-cta__title section-heading section-heading--inverse flex flex-wrap justify-center gap-x-[0.18em]"
                        data-services-diagnostic-title
                    >
                        {
                            servicesDiagnosticTitleParts.map((part, index) => (
                                <span
                                    class:list={[
                                        part.pill && "title-pill",
                                        "inline-flex items-center text-snow-50",
                                    ]}
                                    style={`--services-diagnostic-word-index: ${index}`}
                                    data-services-diagnostic-word
                                >
                                    {part.media && (
                                        <span
                                            class="services-diagnostic-cta__inline-image"
                                            aria-hidden="true"
                                            data-services-diagnostic-media
                                        ></span>
                                    )}
                                    {part.text}
                                </span>
                            ))
                        }
                    </h2>

                    <p
                        class="section-subheading section-subheading--inverse max-w-3xl"
                        data-services-diagnostic-copy
                    >
                        Un échange de 15 minutes suffit souvent à distinguer une
                        création, une refonte ou une simple amélioration ciblée.
                    </p>
                </div>

                <ul class="mx-auto grid w-full max-w-5xl gap-4 sm:grid-cols-3">
                    <li
                        class="services-diagnostic-cta__card"
                        data-services-diagnostic-card
                    >
                        <div class="flex items-center gap-3">
                            <span class="services-diagnostic-cta__card-icon">
                                <WindowLayoutIcon aria-hidden="true" class="size-5" />
                            </span>
                            <h3>Créer</h3>
                        </div>
                        <p>Une présence à poser clairement : offre, pages, contact.</p>
                    </li>
                    <li
                        class="services-diagnostic-cta__card"
                        data-services-diagnostic-card
                    >
                        <div class="flex items-center gap-3">
                            <span class="services-diagnostic-cta__card-icon">
                                <TargetIcon aria-hidden="true" class="size-5" />
                            </span>
                            <h3>Refaire</h3>
                        </div>
                        <p>Un site qui bloque : message, crédibilité, parcours.</p>
                    </li>
                    <li
                        class="services-diagnostic-cta__card"
                        data-services-diagnostic-card
                    >
                        <div class="flex items-center gap-3">
                            <span class="services-diagnostic-cta__card-icon">
                                <ViewAllIcon aria-hidden="true" class="size-5" />
                            </span>
                            <h3>Améliorer</h3>
                        </div>
                        <p>Une base à renforcer : vitesse, mobile, SEO.</p>
                    </li>
                </ul>

                <button
                    class="services-diagnostic-cta__button mx-auto inline-flex min-h-14 w-fit max-w-full items-center justify-center gap-5 rounded-xl px-8 py-3 text-base font-normal focus-visible:outline-2 focus-visible:outline-offset-3 focus-visible:outline-blue-500"
                    data-cal-location="services-final"
                    data-cal-open
                    type="button"
                >
                    <Msgs aria-hidden="true" class="size-5" />
                    <span>Faire le point en 15 min</span>
                </button>
            </div>
        </section>
    </div>

    <ProjectShowcase id="services-projects" class="mt-12 md:mt-16" />
</Layout>

<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    const activeDiagnosticCtaControllers = new WeakMap<HTMLElement, () => void>();

    const revealServicesTitle = (title: HTMLElement) => {
        if (title.dataset.animatedTitleReady === "true") return;
        title.dataset.animatedTitleReady = "true";
    };

    const initServicesTitle = () => {
        const title = document.querySelector<HTMLElement>(
            "[data-services-animated-title]",
        );

        if (!title || title.dataset.animatedTitleReady) return;

        if (
            window.matchMedia("(prefers-reduced-motion: reduce)").matches ||
            !("IntersectionObserver" in window)
        ) {
            revealServicesTitle(title);
            return;
        }

        const observer = new IntersectionObserver(
            ([entry]) => {
                if (!entry?.isIntersecting) return;
                revealServicesTitle(title);
                observer.disconnect();
            },
            { rootMargin: "0px 0px -10% 0px", threshold: 0.2 },
        );

        observer.observe(title);
    };

    const cleanupDiagnosticCtas = () => {
        document
            .querySelectorAll<HTMLElement>("[data-services-diagnostic-cta]")
            .forEach((cta) => {
                activeDiagnosticCtaControllers.get(cta)?.();
                activeDiagnosticCtaControllers.delete(cta);
                delete cta.dataset.diagnosticCtaReady;
            });
    };

    const initDiagnosticCtas = () => {
        document
            .querySelectorAll<HTMLElement>("[data-services-diagnostic-cta]")
            .forEach((cta) => {
                if (cta.dataset.diagnosticCtaReady === "true") return;
                cta.dataset.diagnosticCtaReady = "true";

                if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
                    return;
                }

                const context = gsap.context(() => {
                    const words = gsap.utils.toArray<HTMLElement>(
                        "[data-services-diagnostic-word]",
                        cta,
                    );
                    const cards = gsap.utils.toArray<HTMLElement>(
                        "[data-services-diagnostic-card]",
                        cta,
                    );
                    const media = cta.querySelector<HTMLElement>(
                        "[data-services-diagnostic-media]",
                    );
                    const decision = cta.querySelector<HTMLElement>(
                        "[data-services-diagnostic-decision]",
                    );
                    const copy = cta.querySelector<HTMLElement>(
                        "[data-services-diagnostic-copy]",
                    );

                    const timeline = gsap.timeline({
                        scrollTrigger: {
                            trigger: cta,
                            start: "top 82%",
                            end: "bottom 48%",
                            scrub: 0.8,
                        },
                    });

                    timeline.fromTo(
                        words,
                        { autoAlpha: 0.72, y: 10 },
                        {
                            autoAlpha: 1,
                            y: 0,
                            duration: 0.62,
                            ease: "none",
                            stagger: 0.025,
                        },
                        0,
                    );

                    if (media) {
                        timeline.fromTo(
                            media,
                            { autoAlpha: 0.72, rotation: -4, scale: 0.86 },
                            {
                                autoAlpha: 1,
                                rotation: 0,
                                scale: 1,
                                duration: 0.58,
                                ease: "none",
                            },
                            0.06,
                        );
                    }

                    if (copy) {
                        timeline.fromTo(
                            copy,
                            { autoAlpha: 0.78, y: 10 },
                            {
                                autoAlpha: 1,
                                y: 0,
                                duration: 0.48,
                                ease: "none",
                            },
                            0.18,
                        );
                    }

                    if (cards.length) {
                        timeline.fromTo(
                            cards,
                            {
                                autoAlpha: 0.58,
                                scale: 0.98,
                                y: 24,
                            },
                            {
                                autoAlpha: 1,
                                scale: 1,
                                y: 0,
                                duration: 0.72,
                                ease: "none",
                                stagger: 0.05,
                            },
                            0.16,
                        );
                    }

                    if (decision) {
                        timeline.fromTo(
                            decision,
                            {
                                autoAlpha: 0.54,
                                scale: 0.96,
                                y: 14,
                            },
                            {
                                autoAlpha: 1,
                                scale: 1,
                                y: 0,
                                duration: 0.42,
                                ease: "none",
                            },
                            0.55,
                        );
                    }
                }, cta);

                activeDiagnosticCtaControllers.set(cta, () => context.revert());
            });

        ScrollTrigger.refresh();
    };

    initServicesTitle();
    initDiagnosticCtas();

    document.addEventListener("astro:before-swap", cleanupDiagnosticCtas);
    document.addEventListener("astro:page-load", initServicesTitle);
    document.addEventListener("astro:page-load", initDiagnosticCtas);
</script>

<style>
    .services-diagnostic-cta {
        min-height: min(42rem, calc(100dvh - 2rem));
    }

    .services-diagnostic-cta__title
        :global([data-services-diagnostic-word]) {
        will-change: opacity, transform;
    }

    .services-diagnostic-cta__inline-image {
        align-self: center;
        aspect-ratio: 1;
        background-color: var(--color-snow-600);
        background-image: url("/pictures/william-low.png");
        background-position: center 34%;
        background-size: cover;
        border: 0.06em solid #fff;
        border-radius: 9999px;
        box-shadow:
            0 18px 38px -18px rgba(0, 0, 0, 0.72),
            0 4px 14px rgba(0, 0, 0, 0.24);
        display: inline-block;
        height: 1.08em;
        margin-right: 0.08em;
        overflow: hidden;
        transform-origin: center;
        width: 1.08em;
        will-change: opacity, transform;
    }

    .services-diagnostic-cta__card {
        background: var(--color-gray-800);
        border-radius: 0.75rem;
        box-shadow: 0 18px 44px -30px rgba(14, 20, 32, 0.55);
        color: var(--color-snow-50);
        display: flex;
        flex-direction: column;
        gap: 1rem;
        padding: 1rem;
        will-change: opacity, transform;
    }

    .services-diagnostic-cta__card h3 {
        color: var(--color-snow-50);
        font-size: 1rem;
        font-weight: 500;
        line-height: 1.1;
        margin: 0;
    }

    .services-diagnostic-cta__card p {
        color: var(--color-coffee-50);
        font-size: 0.875rem;
        font-weight: 300;
        line-height: 1.7;
        margin: 0;
    }

    .services-diagnostic-cta__card-icon {
        align-items: center;
        background: var(--color-blue-500);
        border-radius: 0.5rem;
        box-shadow:
            inset 0 1px 0 rgba(255, 255, 255, 0.22),
            inset 0 -1px 0 rgba(31, 54, 130, 0.14),
            0 12px 26px -20px rgba(141, 165, 247, 0.55),
            0 5px 12px -10px rgba(62, 96, 212, 0.58);
        color: var(--color-snow-50);
        display: inline-flex;
        flex-shrink: 0;
        height: 2rem;
        justify-content: center;
        width: 2rem;
    }

    .services-diagnostic-cta__button {
        background: transparent;
        border: 0;
        color: var(--color-snow-50);
        isolation: isolate;
        overflow: hidden;
        position: relative;
        transition: box-shadow 280ms cubic-bezier(0.2, 0, 0, 1);
    }

    .services-diagnostic-cta__button::before {
        background: var(--color-blue-500);
        border: 1px solid
            color-mix(in srgb, var(--color-blue-500) 70%, var(--color-blue-600));
        border-radius: inherit;
        box-shadow: inset 0 2px rgba(184, 200, 255, 0.18);
        content: "";
        inset: 0;
        position: absolute;
        transform: scale(1);
        transition: transform 520ms
            var(--wui-ease-standard, cubic-bezier(0.2, 0, 0, 1));
        z-index: -1;
    }

    .services-diagnostic-cta__button:focus-visible::before {
        transform: scale(0.95);
    }

    @media (hover: hover) {
        .services-diagnostic-cta__button:hover::before {
            transform: scale(0.95);
        }
    }

    [data-services-animated-title-word] {
        display: inline-block;
    }

    [data-services-animated-title]:not([data-animated-title-ready="true"])
        [data-services-animated-title-word] {
        filter: blur(10px);
        opacity: 0;
        transform: translateY(-0.65em);
    }

    [data-services-animated-title][data-animated-title-ready="true"]
        [data-services-animated-title-word] {
        animation: services-title-word 1100ms cubic-bezier(0.16, 1, 0.3, 1)
            backwards;
        animation-delay: calc(var(--animated-word-index, 0) * 65ms);
    }

    @keyframes services-title-word {
        from {
            filter: blur(10px);
            opacity: 0;
            transform: translateY(-0.65em);
        }

        to {
            filter: none;
            opacity: 1;
            transform: none;
        }
    }

    @media (scripting: none), (prefers-reduced-motion: reduce) {
        [data-services-animated-title] [data-services-animated-title-word] {
            animation: none;
            filter: none;
            opacity: 1;
            transform: none;
        }

        .services-diagnostic-cta__title
            :global([data-services-diagnostic-word]) {
            opacity: 1;
        }
    }

    @media (max-width: 1023px) {
        .services-diagnostic-cta {
            min-height: auto;
        }
    }
</style>
