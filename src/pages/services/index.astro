---
import CalButton from "@/components/CalButton.astro";
import ServicesBentoGrid from "@/components/ServicesBentoGrid.astro";
import FadeReveal from "@/components/animations/FadeReveal.astro";
import FadeRevealOnScroll from "@/components/animations/FadeRevealOnScroll.astro";
import CheckIcon from "@/components/icons/nucleo/check-2-outline.svg";
import ProjectShowcase from "@/components/ProjectShowcase.astro";
import Layout from "@/layout/Layout.astro";

export const prerender = true;

const servicesHeroTitleParts = [
    { text: "Votre" },
    { pill: true, text: "site existe." },
    { text: "Est-ce" },
    { text: "qu'il" },
    { text: "inspire" },
    { pill: true, text: "confiance" },
    { text: "assez" },
    { text: "vite ?" },
];

const commonBaseItems = [
    "Cadrage des objectifs",
    "Structure des pages",
    "Design responsive",
    "Développement front-end",
    "Accessibilité et performance",
    "SEO technique initial",
    "Mise en ligne",
    "Suivi des conversions",
] as const;

const aiGenericIssues = [
    "un design propre mais interchangeable",
    "des textes qui ressemblent à tout le monde",
    "une hiérarchie pensée pour faire joli, pas pour aider à décider",
    "des détails mobile, accessibilité, performance ou SEO vite oubliés",
] as const;
---

<Layout
    title="Services web freelance - William De Azevedo"
    description="Création de site vitrine, refonte et développement front-end pour corriger les sites flous, lents ou datés et construire des interfaces claires, rapides et crédibles."
>
    <div class="mx-auto flex w-full max-w-5xl flex-col gap-12 px-4 pt-12 pb-10 md:gap-16 md:pt-16">
        <section class="mx-auto flex max-w-5xl flex-col items-center gap-6 text-center">
            <h1
                class="page-heading flex w-full max-w-sm flex-wrap justify-center gap-x-[0.18em] px-2 sm:max-w-4xl md:max-w-5xl"
                data-services-animated-title
            >
                {
                    servicesHeroTitleParts.map((part, index) => (
                        <span
                            class:list={[part.pill && "title-pill"]}
                            style={`--animated-word-index: ${index}`}
                            data-services-animated-title-word
                        >
                            {part.text}
                        </span>
                    ))
                }
            </h1>
            <FadeReveal delay={0.32}>
                <p class="page-subheading">
                    J'aide les indépendants, petites structures et équipes produit
                    à corriger ce qui fait hésiter : offre floue, design daté,
                    lenteur, mobile inconfortable ou parcours de contact fragile.
                </p>
            </FadeReveal>
            <FadeReveal delay={0.44}>
                <CalButton class="rounded-xl text-base font-normal" location="services-hero" />
            </FadeReveal>
        </section>
    </div>

    <ServicesBentoGrid />

    <div class="mx-auto flex w-full max-w-5xl flex-col gap-12 px-4 py-12 md:gap-16 md:py-16">
        <FadeRevealOnScroll>
            <section class="grid gap-8 rounded-4xl bg-snow-50 p-6 ring-1 ring-gray-200 md:p-8 lg:grid-cols-2 lg:gap-12">
                <div class="flex flex-col justify-between gap-8">
                    <div class="flex flex-col gap-5">
                        <h2 class="text-left text-5xl font-semibold leading-none text-gray-900 sm:text-6xl lg:text-7xl">
                            Pourquoi ne pas juste générer le site avec l'IA ?
                        </h2>
                        <p class="max-w-xl text-lg font-normal leading-relaxed text-gray-600">
                            L'IA peut accélérer une partie du travail, mais sans cadrage
                            elle produit surtout une moyenne : une page correcte,
                            souvent jolie, mais rarement pensée pour votre offre,
                            vos preuves, votre cible et le doute à lever.
                        </p>
                    </div>
                    <div class="grid gap-3 sm:grid-cols-[0.8fr_1.45fr]">
                        <a
                            class="inline-flex min-h-16 items-center justify-center rounded-xl bg-gray-100 px-8 py-4 text-center text-base font-normal leading-snug text-gray-900 shadow-sm transition-colors hover:text-blue-500 focus-visible:text-blue-500 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-blue-500"
                            href="/methode"
                        >
                            Voir comment j'utilise l'IA
                        </a>
                        <CalButton
                            class="rounded-xl text-base font-normal"
                            label="Parler d'un site utile"
                            location="services-ai"
                        />
                    </div>
                </div>
                <ul class="grid gap-4">
                    {
                        aiGenericIssues.map((issue) => (
                            <li class="flex min-h-28 items-start rounded-2xl bg-gray-100 px-5 py-5 text-lg font-medium leading-snug text-gray-700 ring-1 ring-gray-200 md:min-h-32 md:px-6 md:py-6 md:text-xl">
                                {issue}
                            </li>
                        ))
                    }
                </ul>
            </section>
        </FadeRevealOnScroll>

        <section class="flex flex-col items-center text-center">
            <FadeRevealOnScroll>
                <div class="mx-auto flex max-w-4xl flex-col items-center gap-4">
                    <h2 class="section-heading">
                        Le socle commun : enlever les freins visibles
                    </h2>
                    <p class="section-subheading">
                        Le format change selon votre situation, mais le socle reste
                        le même : clarifier le message, structurer le parcours,
                        soigner l'interface, puis vérifier vitesse, accessibilité
                        et contact.
                    </p>
                </div>
            </FadeRevealOnScroll>
            <ul class="mx-auto mt-12 grid w-full max-w-sm gap-4 sm:max-w-2xl sm:grid-cols-2 md:gap-6 lg:max-w-5xl lg:grid-cols-4">
                {
                    commonBaseItems.map((item, index) => (
                        <li class="flex">
                            <FadeRevealOnScroll
                                class="flex"
                                delay={0.05 + (index % 4) * 0.05}
                            >
                                <span class="flex items-center gap-3 text-left">
                                    <span class="flex size-10 shrink-0 items-center justify-center rounded-xl bg-snow-50 text-emerald-500 shadow-[0_14px_32px_-24px_rgba(34,42,55,0.55)] ring-1 ring-gray-200/70">
                                        <CheckIcon
                                            aria-hidden="true"
                                            class="size-4"
                                        />
                                    </span>
                                    <span class="text-base font-normal leading-snug text-gray-900">
                                        {item}
                                    </span>
                                </span>
                            </FadeRevealOnScroll>
                        </li>
                    ))
                }
            </ul>
        </section>

    </div>

    <ProjectShowcase id="services-projects" class="mt-12 md:mt-16" />

    <div class="mx-auto w-full max-w-5xl px-4 py-12 md:py-16">
        <FadeRevealOnScroll>
            <section class="relative left-1/2 isolate w-[calc(100dvw-1rem)] -translate-x-1/2 overflow-hidden rounded-4xl bg-coffee-300 py-12 text-snow-50 sm:w-[calc(100dvw-2rem)] md:py-16">
                <div class="relative z-10 mx-auto flex max-w-4xl flex-col items-center gap-4 px-4 text-center sm:px-8 md:gap-6">
                    <h2 class="section-heading section-heading--inverse max-w-4xl">
                        Vous ne savez pas encore quel frein traiter en premier ?
                    </h2>
                    <p class="section-subheading section-subheading--inverse max-w-3xl">
                        Un échange de 15 minutes suffit souvent à distinguer une
                        création, une refonte ou une simple amélioration ciblée.
                    </p>
                    <CalButton
                        class="mt-2 rounded-xl text-base font-normal"
                        location="services-final"
                        variant="light"
                    />
                </div>
            </section>
        </FadeRevealOnScroll>
    </div>
</Layout>

<script>
    const revealServicesTitle = (title: HTMLElement) => {
        if (title.dataset.animatedTitleReady === "true") return;
        title.dataset.animatedTitleReady = "true";
    };

    const initServicesTitle = () => {
        const title = document.querySelector<HTMLElement>(
            "[data-services-animated-title]",
        );

        if (!title || title.dataset.animatedTitleReady) return;

        if (
            window.matchMedia("(prefers-reduced-motion: reduce)").matches ||
            !("IntersectionObserver" in window)
        ) {
            revealServicesTitle(title);
            return;
        }

        const observer = new IntersectionObserver(
            ([entry]) => {
                if (!entry?.isIntersecting) return;
                revealServicesTitle(title);
                observer.disconnect();
            },
            { rootMargin: "0px 0px -10% 0px", threshold: 0.2 },
        );

        observer.observe(title);
    };

    initServicesTitle();
    document.addEventListener("astro:page-load", initServicesTitle);
</script>

<style>
    [data-services-animated-title-word] {
        display: inline-block;
    }

    [data-services-animated-title]:not([data-animated-title-ready="true"])
        [data-services-animated-title-word] {
        filter: blur(10px);
        opacity: 0;
        transform: translateY(-0.65em);
    }

    [data-services-animated-title][data-animated-title-ready="true"]
        [data-services-animated-title-word] {
        animation: services-title-word 1100ms cubic-bezier(0.16, 1, 0.3, 1)
            backwards;
        animation-delay: calc(var(--animated-word-index, 0) * 65ms);
    }

    @keyframes services-title-word {
        from {
            filter: blur(10px);
            opacity: 0;
            transform: translateY(-0.65em);
        }

        to {
            filter: none;
            opacity: 1;
            transform: none;
        }
    }

    @media (scripting: none), (prefers-reduced-motion: reduce) {
        [data-services-animated-title] [data-services-animated-title-word] {
            animation: none;
            filter: none;
            opacity: 1;
            transform: none;
        }
    }
</style>
