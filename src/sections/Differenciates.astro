---
import SectionHeading from "../components/SectionHeading.astro";
import ServiceCard from "../components/ServiceCard.astro";

const services = [
    {
        title: "Stratégie & contenu",
        items: [
            "Analyse concurrentielle",
            "Collaboration sur le copywriting",
            "Structure des pages pensée pour guider le visiteur",
            "Analyse de votre offre",
        ],
    },
    {
        title: "Design d’interface",
        items: [
            "Direction visuelle adaptée à votre marque",
            "Maquettes soignées, modernes et responsive",
            "Parcours utilisateur simple et fluide",
            "Interface réfléchie et user friendly",
        ],
    },
    {
        title: "Développement front-end",
        items: [
            "Intégration propre et performante",
            "Site rapide, accessible et SEO-friendly",
            "Animations et détails premiums",
            "Code maintenable, propre et prêt à évoluer",
        ],
    },
];
---

<section class="bg-snow-500 py-20 md:py-28">
    <div class="mx-auto flex w-full max-w-[1180px] flex-col items-center gap-12 px-4 sm:px-6">
        <SectionHeading>
            Concrètement, je construis<span class="md:hidden"> </span><br
                class="hidden md:block"
            /> un site qui travaille pour vous
        </SectionHeading>

        <div class="grid w-full grid-cols-1 gap-6 md:grid-cols-3 md:gap-10">
            {services.map((service) => <ServiceCard {...service} />)}
        </div>
    </div>
</section>
